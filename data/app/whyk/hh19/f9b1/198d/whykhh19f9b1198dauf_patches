{"data":{"list":[{"author":"installer","facet":"js","label":"install sync","new":"// webgl.js — the one WebGL capability probe. Tiny, THREE-free, so the router\n// can decide between floweditor3d (WebGL) and the 2D floweditor fallback\n// WITHOUT pulling in the 684KB THREE bundle on the fallback path. flow3d\n// routing (frame.js) and the 3D control both read it.\n\nlet cached = null;\n\n/** True when a WebGL (or WebGL2) context is creatable in this browser. */\nexport function hasWebGL() {\n  if (cached !== null) return cached;\n  try {\n    const c = document.createElement(\"canvas\");\n    cached = Boolean(\n      window.WebGLRenderingContext &&\n      (c.getContext(\"webgl2\") || c.getContext(\"webgl\")));\n  } catch {\n    cached = false;\n  }\n  return cached;\n}\n","old":"","patch_id":"p1","time":1785013049667},{"author":"claude","facet":"move","label":"moved from bench to app","new":"app","old":"bench","patch_id":"p2","time":1785372127230}]},"id":"whykhh19f9b1198dauf_patches","readers":[],"time":1785372127230,"username":"system","writers":[]}