uthor":"agent","facet":"css","label":"settings phase 2: footer, dots, errors, warnings, restart overlay styles","new":".system-settings .ss-frame { position: relative; }\n\n/* Footer: status on the left, buttons on the right; errors take a full row. */\n.system-settings .ss-foot {\n  flex: none; border-top: 1px solid var(--line-soft); padding: 12px 20px;\n  display: flex; align-items: center; justify-content: space-between; gap: 8px 12px; flex-wrap: wrap;\n}\n.system-settings .ss-foot-status { font-size: 13px; color: var(--text-dim); min-height: 20px; display: flex; align-items: center; }\n.system-settings .ss-foot-status.ss-restart { color: var(--accent); }\n.system-settings .ss-foot-btns { display: flex; gap: 8px; margin-left: auto; flex-wrap: wrap; justify-content: flex-end; }\n.system-settings .ss-foot-btns button { font-family: inherit; line-height: 1.2; padding: 10px 14px; white-space: nowrap; }\n.system-settings .ss-foot-btns button[hidden] { display: none; }\n.system-settings .ss-foot-btns button:disabled { opacity: 0.45; cursor: default; pointer-events: none; }\n.system-settings .ss-foot-err { flex: 1 0 100%; font-size: 13px; color: #e08585; display: none; overflow-wrap: anywhere; }\n.system-settings .ss-foot-err.ss-show { display: block; }\n\n/* Change tracking, validation, warnings. */\n.system-settings .ss-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); display: none; flex: none; }\n.system-settings .ss-field.ss-dirty .ss-dot { display: inline-block; }\n.system-settings .ss-err { font-size: 13px; color: #e08585; margin-top: 6px; display: none; }\n.system-settings .ss-err.ss-show { display: block; }\n.system-settings .textinput.ss-bad, .system-settings .textinput.ss-bad:focus { border-color: var(--danger); }\n.system-settings .ss-warn { font-size: 13px; color: var(--accent); margin-top: 12px; display: none; }\n.system-settings .ss-warn.ss-show { display: block; }\n\n/* Restart overlay, inside the frame. */\n.system-settings .ss-overlay {\n  position: absolute; inset: 0; z-index: 3; background: rgba(23, 26, 30, 0.94);\n  display: none; flex-direction: column; align-items: center; justify-content: center; gap: 12px;\n  text-align: center; padding: 24px;\n}\n.system-settings .ss-overlay.ss-show { display: flex; }\n.system-settings .ss-spinner { width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--accent); border-top-color: transparent; animation: ss-spin .9s linear infinite; }\n.system-settings .ss-overlay.ss-stopped .ss-spinner { display: none; }\n@keyframes ss-spin { to { transform: rotate(360deg); } }\n.system-settings .ss-ov-msg { font-size: 15px; color: var(--text); }\n.system-settings .ss-ov-msg2 { font-size: 13px; color: var(--text-dim); max-width: 360px; overflow-wrap: anywhere; }\n.system-settings .ss-ov-msg2 a { color: var(--accent); font-family: var(--mono); }\n.system-settings .ss-ov-msg3 { font-size: 13px; color: #e08585; max-width: 360px; }\n.system-settings .ss-ov-msg3:empty { display: none; }","old":".system-settings .ss-foot { flex: none; flex-wrap: wrap; padding: 12px 20px; }","patch_id":"p38","time":1793795124423},{"author":"agent","facet":"css","label":"settings phase 2: lit Network tag shows with help off","new":"/* Help off: only titles, labels and fields. */\n.system-settings:not(.ss-showhelp) .ss-hint { display: none; }\n/* ...but a lit \"Needs restart\" tag is a state, not an explanation: always shown. */\n.system-settings:not(.ss-showhelp) .ss-tag.ss-on { display: inline-block; }","old":"/* Help off: only titles, labels and fields. */\n.system-settings:not(.ss-showhelp) .ss-hint { display: none; }","patch_id":"p39","time":1793795128070},{"author":"agent","facet":"css","label":"settings phase 2: short screens hide the footer status","new":"  .system-settings .regularbutton, .system-settings .clearbutton, .system-settings .coloredbutton { padding: 8px 14px; }\n  .system-settings .ss-foot-btns button { padding: 8px 12px; }\n  .system-settings .ss-fo