c(100vh - 32px);\n  max-height: calc(100dvh - 32px);\n}\n.system-settings .ss-head {\n  flex: none;\n  background: var(--panel-2);\n  border-bottom: 1px solid var(--line);\n  padding: 14px 12px 14px 20px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n.system-settings .ss-head-left { min-width: 0; }\n.system-settings .ss-title { font-size: 18px; font-weight: 500; color: var(--text); }\n.system-settings .ss-sub { font-family: var(--mono); font-size: 11px; color: var(--text-dim); margin-top: 2px; }\n.system-settings .ss-head-right { display: flex; align-items: center; gap: 6px; flex: none; }\n.system-settings .ss-helpsw { display: flex; align-items: center; gap: 8px; color: var(--text-dim); font-size: 12px; cursor: pointer; user-select: none; white-space: nowrap; }\n\n/* \"Show help\" switch: copied from the agent Mind tab's \"Show config keys\" (.tg). */\n.system-settings .tg { position: relative; flex: none; width: 36px; height: 22px; display: inline-block; }\n.system-settings .tg input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; z-index: 1; }\n.system-settings .tg span { display: block; width: 36px; height: 22px; border-radius: 20px; background: var(--line); transition: background .15s; }\n.system-settings .tg span::after { content: \"\"; position: absolute; width: 16px; height: 16px; border-radius: 50%; left: 3px; top: 3px; background: var(--text-dim); transition: left .15s; }\n.system-settings .tg input:checked + span { background: var(--accent-dim); }\n.system-settings .tg input:checked + span::after { left: 17px; background: var(--text); }\n.system-settings .tg input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }\n\n/* Help off: only titles, labels and fields. */\n.system-settings:not(.ss-showhelp) .ss-hint { display: none; }\n\n.system-settings .ss-body {\n  flex: 1 1 auto;\n  min-height: 0;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  padding: 4px 20px 20px;\n  scrollbar-width: thin;\n  scrollbar-color: var(--line) transparent;\n}\n.system-settings .ss-foot { flex: none; flex-wrap: wrap; padding: 12px 20px; }\n\n.system-settings .ss-section { padding-top: 18px; }\n.system-settings .ss-section + .ss-section { border-top: 1px solid var(--line-soft); margin-top: 18px; }\n.system-settings .ss-sec-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 14px; }\n.system-settings .ss-sec-title { font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text); }\n.system-settings .ss-tag {\n  font-family: var(--mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;\n  padding: 3px 8px; border-radius: 10px; border: 1px solid var(--line);\n  color: var(--text-faint); white-space: nowrap; transition: all .2s;\n}\n.system-settings .ss-tag.ss-on { color: var(--accent); border-color: var(--accent-dim); background: rgba(240, 166, 60, 0.12); }\n\n.system-settings .ss-field + .ss-field { margin-top: 16px; }\n.system-settings .ss-label { display: flex; align-items: center; gap: 8px; }\n.system-settings .textinput { font-size: 15px; }\n.system-settings .ss-mono { font-family: var(--mono); font-size: 14px; }\n.system-settings .ss-help { font-size: 13px; color: var(--text-dim); margin-top: 6px; }\n.system-settings .ss-help-top { margin-top: 0; }\n\n/* \"Who can open this device\": real radios inside cards. */\n.system-settings .ss-choices { display: grid; gap: 6px; }\n.system-settings .ss-choice { position: relative; display: block; cursor: pointer; }\n.system-settings .ss-choice input { position: absolute; opacity: 0; pointer-events: none; }\n.system-settings .ss-choice-box {\n  display: grid; grid-template-columns: 16px 1fr auto; gap: 10px; align-items: start;\n  padding: 10px 12px; border: 1px solid var(--line); border-radius: var(--border-radius-sm);\n  background: var(--ground);\n}\n.system-settings .ss-radio {\n  width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid var(--text-faint); margin-top: 2px;\n  display: flex; align-items: center; justify-content: center;\n}\n.system-settings .ss-choice input:checked + .ss-choice-box { border-color: var(--accent-dim); background: rgba(240, 166, 60, 0.05); }\n.system-settings .ss-choice input:checked + .ss-choice-box .ss-radio { border-color: var(--accent); }\n.system-settings .ss-choice input:checked + .ss-choice-box .ss-radio::after { content: \"\"; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }\n.system-settings .ss-choice input:focus-visible + .ss-choice-box { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(240, 166, 60, 0.25); }\n.system-settings .ss-choice-title { font-size: 14px; color: var(--text); }\n.system-settings .ss-choice-desc { display: block; font-size: 12.5px; color: var(--text-dim); }\n.system-settings .ss-choice-code { font-family: var(--mono); font-size: 12px; color: var(--text-faint); margin-top: 1px; }\n.system-settings .ss-custom-ip { margin-top: 8px; display: none; }\n.system-settings .ss-custom-ip.ss-show { display: block; }\n\n.system-settings .ss-addr {\n  margin-top: 16px; background: var(--ground); border: 1px dashed var(--line);\n  border-radius: var(--border-radius-sm); padding: 10px 12px; font-size: 13px; color: var(--text-dim);\n}\n.system-settings .ss-addr-row { display: grid; gap: 2px; }\n.system-settings .ss-addr-row + .ss-addr-row { margin-top: 8px; }\n.system-settings .ss-addr code { font-family: var(--mono); font-size: 12.5px; color: var(--text); word-break: break-all; }\n.system-settings .ss-addr code.ss-dim { color: var(--text-faint); }\n\n/* Advanced · Platform engine */\n.system-settings details.ss-adv { border-top: 1px solid var(--line-soft); margin-top: 20px; }\n.system-settings details.ss-adv > summary {\n  list-style: none; cursor: pointer; padding: 18px 0 2px;\n  display: flex; align-items: center; justify-content: space-between; gap: 8px;\n}\n.system-settings details.ss-adv > summary::-webkit-details-marker { display: none; }\n.system-settings .ss-chev { color: var(--text-dim); transition: transform .2s; flex: none; }\n.system-settings details.ss-adv[open] .ss-chev { transform: rotate(180deg); }\n.system-settings .ss-sum-left { display: flex; flex-direction: column; gap: 4px; min-width: 0; }\n.system-settings .ss-sum-meta { font-family: var(--mono); font-size: 12px; color: var(--text-dim); }\n.system-settings .ss-sub-block { margin-top: 16px; }\n.system-settings .ss-sub-title { font-size: 14px; font-weight: 500; margin: 0 0 4px; color: var(--text); }\n.system-settings .ss-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 12px; }\n.system-settings .ss-ver-help { margin-top: 8px; }\n.system-settings .ss-btn-row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; align-items: center; }\n.system-settings .crate-update-status {\n  white-space: pre-wrap; font-family: var(--mono); font-size: 11.5px; color: var(--text-dim);\n  margin-top: 8px; padding: 8px 10px; max-height: 160px; overflow: auto;\n  background: var(--ground); border: 1px solid var(--line-soft); border-radius: var(--border-radius-sm);\n}\n.system-settings .ss-danger {\n  margin-top: 20px; padding: 14px;\n  border: 1px solid rgba(193, 90, 90, 0.45); background: rgba(193, 90, 90, 0.10);\n  border-radius: var(--border-radius-sm);\n}\n.system-settings .ss-danger .ss-sub-title { color: #e08585; }\n.system-settings .ss-danger .ss-help { color: var(--text-dim); }\n.system-settings .regularbutton.ss-btn-danger { background: transparent; border-color: var(--danger); color: #e08585; }\n.system-settings .regularbutton.ss-btn-danger:hover { background: rgba(193, 90, 90, 0.10); }\n.system-settings button.regularbutton { font-family: inherit; line-height: 1.2; }","old":".appbutton {\n  margin-bottom: 5px;\n  display: none;\n}","patch_id":"p25","time":1793627942469},{"author":"agent","facet":"css","label":"settings dialog: hold the height cap for the short-screens commit","new":"  flex-direction: column;\n}","old":"  flex-direction: column;\n  max-height: calc(100vh - 32px);\n  max-height: calc(100dvh - 32px);\n}","patch_id":"p26","time":1793627949711},{"author":"agent","facet":"js","label":"settings dialog: read side for the new fields, Show help switch","new":"// --- Settings dialog: read side ---\nvar SS = ME.querySelector('.system-settings');\n\n// \"Show help\": remembered per browser. Storage may be missing or throw; then help starts off.\nme.readShowHelp = function(store) {\n  try { return (store || window.localStorage).getItem('app-settings-showhelp') === '1'; } catch (e) { return false; }\n};\nme.writeShowHelp = function(on, store) {\n  try { (store || window.localStorage).setItem('app-settings-showhelp', on ? '1' : '0'); } catch (e) {}\n};\n(function() {\n  var sw = SS.querySelector('.ss-showhelp-input');\n  var on = me.readShowHelp();\n  sw.checked = on;\n  SS.classList.toggle('ss-showhelp', on);\n  sw.addEventListener('change', function() {\n    SS.classList.toggle('ss-showhelp', sw.checked);\n    me.writeShowHelp(sw.checked);\n  });\n})();\n\n// \"Who can open this device\": the radios map to http_address.\nfunction bindChoice() {\n  var r = SS.querySelector('input[name=ss-bind]:checked');\n  return r ? r.value : '0.0.0.0';\n}\nme.httpAddress = function() {\n  var v = bindChoice();\n  return v == 'custom' ? dget('ipaddr').value.trim() : v;\n};\nfunction setBind(addr) {\n  var v = (addr == '127.0.0.1' || addr == '0.0.0.0') ? addr : 'custom';\n  SS.querySelector('input[name=ss-bind][value=\"' + v + '\"]').checked = true;\n  dget('ipaddr').value = v == 'custom' ? (addr || '') : '';\n}\n\n// The LAN IPv4 other devices would use: the page's own hostname when it was\n// opened from elsewhere, else the first private IPv4 (not docker's 172.17.0.1),\n// else the first non-loopback IPv4.\nme.lanAddress = function(addresses, hostname) {\n  var h = hostname || '';\n  if (h && h != 'localhost' && h != '127.0.0.1' && h != '::1' && h != '[::1]') return h;\n  var v4 = (addresses || []).filter(function(a) {\n    return /^\\d{1,3}(\\.\\d{1,3}){3}$/.test(a) && a.indexOf('127.') != 0 && a.indexOf('169.254.') != 0;\n  });\n  var priv = v4.filter(function(a) {\n    if (a == '172.17.0.1') return false;\n    if (a.indexOf('192.168.') == 0 || a.indexOf('10.') == 0) return true;\n    var m = /^172\\.(\\d+)\\./.exec(a);\n    return m && +m[1] >= 16 && +m[1] <= 31;\n  });\n  return priv[0] || v4[0] || null;\n};\n\nfunction refreshSettings() {\n  var choice = bindChoice();\n  SS.querySelector('.ss-custom-ip').classList.toggle('ss-show', choice == 'custom');\n  var addr = me.httpAddress();\n  var port = dget('portnum').value.trim();\n  var p = port === '' ? '…' : (+port === 0 ? '<port chosen at start>' : port);\n  var local = SS.querySelector('.ss-addr-local');\n  var lan = SS.querySelector('.ss-addr-lan');\n  local.textContent = (choice == 'custom' ? 'http://' + (addr || '…') + ':' : 'http://localhost:') + p;\n  var other = null;\n  if (choice == '0.0.0.0') other = me.lanIP || '<this computer\\'s IP>';\n  else if (choice == 'custom') other = addr || '…';\n  lan.textContent = other ? 'http://' + other + ':' + p : 'Not reachable';\n  lan.classList.toggle('ss-dim', !other);\n}\nSS.querySelectorAll('input[name=ss-bind]').forEach(function(r) {\n  r.addEventListener('change', function() {\n    refreshSettings();\n    if (r.value == 'custom' && r.checked) dget('ipaddr').focus();\n  });\n});\n['ipaddr', 'portnum'].forEach(function(id) { dget(id).addEventListener('input', refreshSettings); });\n\n// Start page options: active apps, built as elements. A saved start page that\n// isn't active still gets an option, so an untouched save never changes it.\nfunction fillStartPage(dbval, apps) {\n  var active = apps ? String(apps).split(',').map(function(s) { return s.trim(); }) : null;\n  var names = {};\n  for (var i in me.list) if (!me.list[i].remote) names[me.list[i].id] = me.list[i].name;\n  var select = dget('defaultbot');\n  select.options.length = 0;\n  var found = false;\n  var add = function(id, label) {\n    var opt = document.createElement('option');\n    opt.value = id;\n    opt.textContent = label;\n    select.appendChild(opt);\n  };\n  for (var j in me.list) {\n    var rdi = me.list[j];\n    if (rdi.remote) continue;\n    if (active ? active.indexOf(rdi.id) != -1 : rdi.active) {\n      add(rdi.id, rdi.name);\n      if (rdi.id == dbval) found = true;\n    }\n  }\n  if (dbval && !found) add(dbval, (names[dbval] || dbval) + ' (inactive)');\n  select.value = dbval;\n}\n\nME.querySelector('.save-system-settings').addEventListener('click', function() {\n  var o = {\n    machineid: dget(\"devicename\").value,\n    http_address: me.httpAddress(),\n    http_port: dget(\"portnum\").value,\n    default_app: dget(\"defaultbot\").value\n  };\n  send_settings(o, function(result) {});\n});\n\nME.querySelector('.open-system-settings').addEventListener('click', function() {\n  send_settings({}, function(result) {\n    if (result.data) {\n      dget(\"devicename\").value = result.data.machineid;\n      setBind(result.data.http_address);\n      dget(\"portnum\").value = parseInt(result.data.http_port);\n      fillStartPage(result.data.default_app, result.data.apps);\n      refreshSettings();\n    }\n  });\n  json('../peer/info', null, function(r) {\n    var d = r && r.data ? r.data : r;\n    me.lanIP = me.lanAddress(d && d.addresses, location.hostname);\n    refreshSettings();\n  });\n});","old":"ME.querySelector('.save-system-settings').addEventListener('click', function() {\n  var o = {\n    machineid: dget(\"devicename\").value,\n    http_address: dget(\"ipaddr\").value,\n    http_port: dget(\"portnum\").value,\n    default_app: dget(\"defaultbot\").value\n  };\n  send_settings(o, function(result) {});\n});\n\nME.querySelector('.open-system-settings').addEventListener('click', function() {\n  send_settings({}, function(result) {\n    if (result.data) {\n      dget(\"devicename\").value = result.data.machineid;\n      dget(\"ipaddr\").value = result.data.http_address;\n      dget(\"portnum\").value = parseInt(result.data.http_port);\n\n      var dbval = result.data.default_app;\n      var select = dget('defaultbot');\n      select.options.length = 0;\n      var defaultbot = \"\";\n      for (var item in me.list) {\n        var rdi = me.list[item];\n        if (rdi.active)\n          defaultbot += \"<option value='\" + rdi.id + \"'>\" + rdi.name + \"</option>\";\n      }\n      select.innerHTML = defaultbot;\n      select.value = dbval;\n    }\n  });\n});","patch_id":"p27","time":1793627973102},{"author":"agent","facet":"js","label":"settings dialog: engine summary line","new":"      section.style.display = '';\n      dget('flowlangver').value = r.flowlang;\n      dget('ndataver').value = r.ndata;\n      section.querySelector('.ss-sum-meta').textContent = 'flowlang ' + r.flowlang + ' · ndata ' + r.ndata;","old":"      section.style.display = 'block';\n      dget('flowlangver').value = r.flowlang;\n      dget('ndataver').value = r.ndata;","patch_id":"p28","time":1793627978781},{"author":"agent","facet":"js","label":"settings dialog: Save and Restart reads the address from the radios","new":"    machineid: dget('devicename').value,\n    http_address: me.httpAddress(),","old":"    machineid: dget('devicename').value,\n    http_address: dget('ipaddr').value,","patch_id":"p29","time":1793627982135},{"author":"agent","facet":"css","label":"settings dialog: cap the frame at the viewport; the body scrolls","new":".system-settings .ss-frame {\n  display: flex;\n  flex-direction: column;\n  max-height: calc(100vh - 32px);\n  max-height: calc(100dvh - 32px);\n}","old":".system-settings .ss-frame {\n  display: flex;\n  flex-direction: column;\n}","patch_id":"p30","time":1793628146707},{"author":"agent","facet":"css","label":"settings dialog: short-screen and narrow-screen rules","new":".system-setti