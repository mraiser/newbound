textinputlabel\" for=\"prompt-input-${me.UUID}\">${d.text}</label>\n          <input class=\"textinput\" type=\"text\" id=\"prompt-input-${me.UUID}\" value=\"${val}\">\n        </div>\n        <div class=\"subtext card-description pad16\" style=\"padding-top:0;\">${sub}</div>\n        <div class=\"card-button-wrap\">\n          <a class=\"continuebutton coloredbutton\">${ok}</a>\n        </div>\n      </div>\n    </div>\n  `);\n\n  $(document.body).append(el);\n  d.selector = el.find('.card')[0];\n  d.closeselector = el.find('.close-prompt-dialog')[0];\n  d.modal = true;\n  d.close = function() { el.remove(); };\n  d.clientX = window.innerWidth / 2;\n  d.clientY = window.innerHeight / 2;\n\n  me.popup(d, function() {\n    el.find('input.textinput').select().focus();\n  });\n\n  el.find('.continuebutton').click(function() {\n    var val = el.find('input.textinput').val();\n    if (d.validate) {\n      if (d.validate(val)) {\n        d.cb(val);\n        me.closePopup(d);\n      } else {\n        el.find('.subtext').css(\"color\", \"var(--error-color)\");\n      }\n    } else {\n      d.cb(val);\n      me.closePopup(d);\n    }\n  });\n};\n\nme.confirm = function(d) {\n    var text = d.text ? d.text : \"\";\n    var ok = d.ok ? d.ok : \"OK\";\n    var cancel = d.cancel ? d.cancel : \"Cancel\";\n\n    var el = $(`\n    <div class=\"fixed-wrap\">\n        <div class=\"card modal mydialog\">\n            <div class=\"pad16 card-header dialog-header\">\n                <span class=\"title\">${d.title}</span>\n                 <button class=\"popupcard-close close-prompt-dialog\">\n                    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\"></line><line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\"></line></svg>\n                 </button>\n            </div>\n            <div class=\"subtext card-description pad16\">${text}</div>\n            <div class=\"card-button-wrap\">\n                <a class=\"cancelbutton regularbutton\">${cancel}</a>\n                <a class=\"continuebutton coloredbutton\">${ok}</a>\n            </div>\n        </div>\n    </div>`);\n\n    $(document.body).append(el);\n    d.selector = el.find('.card')[0];\n    d.closeselector = '.close-prompt-dialog, .cancelbutton';\n    d.modal = true;\n    d.close = function(){ el.remove(); };\n    d.clientX = window.innerWidth / 2;\n    d.clientY = window.innerHeight / 2;\n    \n    me.popup(d);\n    \n    el.find('.continuebutton').click(function(){\n        if(d.cb) d.cb(true); // Confirm true\n        me.closePopup(d);\n    });\n\n    el.find('.cancelbutton').click(function(){\n        if(d.cb) d.cb(false); // Confirm false\n        me.closePopup(d);\n    });\n};\n\n\nme.initProgress = function(el) {\n  var bars = $(el).find('.progressbar').toArray();\n  for (var i in bars) {\n    var bar = bars[i];\n    $(bar).html('<div class=\"progressbar-inner\"></div>');\n    $(bar).data('percent', 0);\n    bar.indeterminate = false;\n    bar.setProgress = function(val) {\n      var progbar = $(this).find('.progressbar-inner');\n      if (val == 'indeterminate') {\n        this.indeterminate = true;\n        progbar.css({\n            'transition': 'all 0.8s ease-in-out',\n            'animation': 'indeterminate-progress 2s infinite linear'\n        });\n        if (!$('#indeterminate-keyframes').length) {\n            $('<style id=\"indeterminate-keyframes\">@keyframes indeterminate-progress { 0% { left: -50%; width: 50%; } 100% { left: 100%; width: 50%; } }</style>').appendTo('head');\n        }\n      } else {\n        this.indeterminate = false;\n        progbar.css({\n            'animation': 'none',\n            'transition': 'width 0.3s ease',\n            'width': val + '%',\n            'left': '0%'\n        });\n        $(this).data('percent', val);\n      }\n    };\n  }\n};\n\n\nif (typeof componentHandler == 'undefined') componentHandler = {\n  upgradeAllRegistered: function() {}\n};\n","patch_id":"p2","time":1788780069946},{"author":"newbound-agent","facet":"css","label":"graphite kit: bridge legacy variable names onto the bench token palette; one theme, flat, no shadows","new":"/* --- Newbound UI Kit — graphite -------------------------------------\n   The legacy kit's class vocabulary (.titlebar, .card, .textinput, …)\n   restyled onto the bench's graphite palette. Custom-property VALUES\n   here are synced from app.tokens (kit contract v1: the token NAMES\n   are frozen there; this sheet bridges the legacy names onto them).\n   One theme: graphite. body.dark is inert and the dark-mode toggle is\n   retired (ui doctrine, 2026-09). Flat panels, 1px lines, no shadows. */\n\n:root {\n  /* graphite palette — value-synced with app.tokens */\n  --ground: #171a1e;\n  --panel: #1f242a;\n  --panel-2: #262c33;\n  --panel-3: #2d343c;\n  --line: #333b44;\n  --line-soft: #2a313a;\n  --text: #d8dee6;\n  --text-dim: #8a94a0;\n  --text-faint: #5c6672;\n  --accent: #f0a63c;\n  --accent-dim: #a9762e;\n  --good: #4fae6e;\n  --danger: #c15a5a;\n  --sans: system-ui, \"Segoe UI\", Roboto, sans-serif;\n  --mono: ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, monospace;\n  --disp: \"Futura\", \"Avenir Next\", \"URW Gothic\", \"Century Gothic\", \"Trebuchet MS\", sans-serif;\n\n  /* legacy kit names, bridged onto the palette */\n  --primary-color: var(--accent);\n  --primary-color-dark: var(--accent-dim);\n  --accent-color: var(--panel-3);\n  --text-color: var(--text);\n  --text-color-light: var(--text-dim);\n  --background-color: var(--ground);\n  --surface-color: var(--panel);\n  --border-color: var(--line);\n  --border-color-light: var(--line-soft);\n  --error-color: var(--danger);\n  --success-color: var(--good);\n  --font-family: var(--sans);\n  --border-radius-sm: 3px;\n  --border-radius-md: 6px;\n  --border-radius-lg: 12px;\n  /* flat look: shadows collapse to borders */\n  --shadow-sm: none;\n  --shadow-md: none;\n  --shadow-lg: none;\n}\n\n/* --- Base Styles --- */\nhtml, body {\n  height: 100%; /* Ensure body fills the viewport */\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n}\nbody {\n  background-color: var(--background-color);\n  color: var(--text-color);\n}\n\n/* the uppercase mono label role — shared with the bench (tokens.css) */\n.lbl {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--text-dim);\n}\n\n/* theme toggles are retired everywhere: one theme */\n.dark-mode-toggle-container { display: none; }\n\na {\n  color: var(--primary-color);\n  font-weight: 500;\n  text-decoration: none;\n  transition: color 0.2s ease;\n}\n\na:hover {\n  color: var(--primary-color-dark);\n}\n\ntextarea {\n  font-family: var(--font-family);\n  font-weight: 400;\n  background-color: var(--background-color);\n  color: var(--text-color);\n  border: 1px solid var(--border-color);\n}\n\ntextarea::placeholder {\n  font-family: var(--font-family);\n  font-weight: 400;\n  color: var(--text-color-light);\n}\n\n.background {\n  background-color: var(--background-color);\n  position: fixed;\n  top: 0px;\n  left: 0px;\n  width: 100%;\n  height: 100%;\n  z-index: -1; /* Keep background behind all content */\n}\n\n.wrap, .fixed-wrap {\n  font-family: var(--font-family);\n  position: relative;\n  color: var(--text-color);\n}\n\n.titlebar {\n  background-color: var(--panel);\n  color: var(--text);\n  border-bottom: 1px solid var(--line);\n  padding: 16px 20px;\n  font-size: 1.25rem;\n  font-weight: 500;\n  position: sticky;\n  top: 0px;\n  z-index: 10;\n  display: flex;\n  align-items: center;\n}\n\n.menuicon, .mediumicon {\n  cursor: pointer;\n  vertical-align: middle;\n}\n\n.menuicon {\n  width: 24px;\n  height: 24px;\n  margin-right: 16px;\n  fill: var(--text);\n}\n\n/* nb-head convention: tiny home link + unlinked app title.\n   Reference markup: app.ui_reference titlebar. */\n.nb-home {\n  color: inherit;\n  text-decoration: none;\n  opacity: 0.75;\n  margin-right: 12px;\n}\n.nb-home:hover { opacity: 1; }\n.nb-title { letter-spacing: 0.06em; }\n\n\n.mediumicon {\n  width: 24px;\n  height: 24px;\n}\n\n.upper-right {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  right: 16px;\n  display: flex; /* Added for alignment of multiple items */\n  align-items: center;\n}\n\n.hideme {\n  display: none;\n}\n\n.floatright {\n  float: right;\n}\n\n.roundbutton-small, .roundbutton-small-white, .icon-small-white {\n  width: 32px;\n  height: 32px;\n  cursor: pointer;\n  vertical-align: middle;\n  background-color: transparent;\n  border-radius: 50%;\n  border: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  transition: background-color 0.2s ease;\n}\n\n.roundbutton-small {\n  background-color: rgba(255, 255, 255, 0.10);\n}\n\n.roundbutton-small:hover {\n  background-color: rgba(255, 255, 255, 0.18);\n}\n\n.roundbutton-small-white {\n  color: var(--text); /* Explicitly set color for child SVGs */\n}\n.roundbutton-small-white:hover {\n  background-color: rgba(255, 255, 255, 0.12);\n}\n\n\n/* --- Navbar --- */\n.navbar, .navbar-dark, .navbar-light, .navbar-accent {\n  display: flex;\n  width: 100%;\n  position: sticky;\n  top: 61px; /* Adjust based on titlebar height */\n  z-index: 9;\n  background-color: var(--surface-color);\n  border-bottom: 1px solid var(--border-color);\n}\n\n.navbar-accent {\n  background-color: var(--panel-2);\n}\n\n.navbar-dark {\n  background-color: var(--panel-2);\n  border-bottom-color: var(--line);\n}\n\n.navbar-light {\n  background-color: var(--surface-color);\n  color: var(--text-color);\n  border-bottom-color: var(--border-color);\n}\n\n.navbar-tab {\n  flex: 1;\n  padding: 14px 20px;\n  text-align: center;\n  text-decoration: none;\n  cursor: pointer;\n  color: var(--text-color-light);\n  font-weight: 500;\n  text-transform: uppercase;\n  border-bottom: 3px solid transparent;\n  transition: color 0.2s ease, border-color 0.2s ease;\n}\n\n.navbar-tab:hover {\n  color: var(--text-color);\n}\n\n.navbar-tab.selected {\n  color: var(--accent);\n  border-bottom-color: var(--accent);\n}\n\n.main, .padme {\n  padding: 24px;\n}\n.pad16 { padding: 16px; }\n.pad10 { padding: 10px; }\n\n.tab-content { display: none; }\n.tab-content.selected { display: block; }\n\n/* --- Cards --- */\n.card {\n  border: 1px solid var(--border-color);\n  background-color: var(--surface-color);\n  border-radius: var(--border-radius-md);\n  overflow: hidden;\n}\n\n.modal {\n  width: 380px;\n  max-width: 90vw;\n  display: none;\n}\n\n.card-header {\n  font-size: 1.5rem;\n  font-weight: 500;\n  padding: 16px;\n  border-bottom: 1px solid var(--border-color-light);\n}\n\n.dialog-header {\n  background-color: var(--panel-2);\n  color: var(--text);\n  border-bottom: 1px solid var(--line);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.card-description, .card-text {\n  color: var(--text-color-light);\n  font-size: 1rem;\n  font-weight: 400;\n  line-height: 1.5;\n  padding: 16px;\n}\n\n.card-button-wrap {\n  border-top: 1px solid var(--border-color-light);\n  padding: 12px 16px;\n  background-color: transparent;\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n}\n\n\n/* --- Form Elements --- */\n.textinput {\n  padding: 10px 12px;\n  border: 1px solid var(--border-color);\n  border-radius: var(--border-radius-sm);\n  width: 100%;\n  background-color: var(--background-color);\n  color: var(--text-color);\n  font-size: 1rem;\n  transition: border-color 0.2s ease, box-shadow 0.2s ease;\n}\n\n.textinputlabel {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--text-dim);\n  display: block;\n  margin-bottom: 6px;\n}\n\n.textinput:focus {\n  outline: none;\n  border-color: var(--accent);\n  box-shadow: 0 0 0 2px rgba(240, 166, 60, 0.25);\n}\n\n.chip {\n  height: 32px;\n  line-height: 32px;\n  padding: 0 12px;\n  border: 0;\n  border-radius: var(--border-radius-lg);\n  background-color: var(--panel-3);\n  font-size: 0.875rem;\n  vertical-align: middle;\n  display: inline-flex;\n  align-items: center;\n  color: var(--text-color);\n  margin: 2px;\n  white-space: nowrap;\n}\n\n.chipbutton {\n  background-color: var(--text-color-light);\n  border: none;\n  vertical-align: middle;\n  margin-right: -8px;\n  margin-left: 6px;\n  color: var(--ground);\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  cursor: pointer;\n  transition: background-color 0.2s ease;\n}\n.chipbutton:hover {\n  background-color: var(--text-color);\n}\n\n/* --- Buttons --- */\n.regularbutton, .accentbutton, .coloredbutton, .clearbutton {\n  padding: 10px 20px;\n  font-size: 0.9rem;\n  font-weight: 500;\n  color: inherit;\n  text-transform: uppercase;\n  text-decoration: none;\n  border-radius: var(--border-radius-sm);\n  border: 1px solid transparent;\n  cursor: pointer;\n  transition: all 0.2s ease-in-out;\n}\n\n.regularbutton {\n  background-color: var(--panel-2);\n  color: var(--text-color);\n  border-color: var(--line);\n}\n.regularbutton:hover {\n  background-color: var(--panel-3);\n}\n\n.accentbutton {\n  background-color: var(--panel-3);\n  color: var(--text);\n  border-color: var(--line);\n}\n.accentbutton:hover {\n  filter: brightness(1.15);\n}\n\n.coloredbutton {\n  background-color: var(--accent);\n  color: var(--ground);\n  border-color: var(--accent);\n}\n.coloredbutton:hover {\n  background-color: var(--accent-dim);\n  border-color: var(--accent-dim);\n  color: var(--ground);\n}\n\n.clearbutton {\n  background-color: transparent;\n  border-color: transparent;\n  color: var(--accent);\n  font-weight: 500;\n}\n.clearbutton:hover {\n  background-color: rgba(240, 166, 60, 0.12);\n}\n\n/* --- Snackbar --- */\n.snackbar {\n  position: fixed;\n  bottom: -100px;\n  left: 0;\n  width: 100%;\n  display: flex;\n  justify-content: cen