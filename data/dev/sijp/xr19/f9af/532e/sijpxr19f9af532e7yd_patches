height: 1.5;\n  max-width: 62ch;\n}\n.nb-workbench .wb-note code { font-family: var(--mono); font-size: 11px; }\n.nb-workbench .wb-cmd-rows { padding: 8px 0; }\n.nb-workbench .wb-cmd-row {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 11px 18px;\n  border-bottom: 1px solid var(--line-soft);\n  font: 12.5px var(--mono);\n}\n.nb-workbench .wb-cmd-row:last-child { border-bottom: none; }\n.nb-workbench .wb-cmd-row .cname { color: var(--text); min-width: 140px; }\n.nb-workbench .wb-cmd-type {\n  font-size: 9px;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  padding: 2.5px 7px;\n  border-radius: 4px;\n  color: var(--ground);\n  font-weight: 700;\n  background: var(--text-dim);\n}\n.nb-workbench .wb-cmd-type.t-rust { background: var(--f-data); }\n.nb-workbench .wb-cmd-type.t-js { background: var(--f-js); }\n.nb-workbench .wb-cmd-type.t-java { background: var(--f-css); }\n.nb-workbench .wb-cmd-type.t-python { background: var(--f-3d); }\n.nb-workbench .wb-cmd-type.t-flow { background: var(--f-cmd); }\n.nb-workbench .wb-cmd-open {\n  margin-left: auto;\n  font: 11px var(--mono);\n  color: var(--accent);\n  border: 1px solid var(--accent-dim);\n  border-radius: 6px;\n  padding: 4px 10px;\n}\n.nb-workbench .wb-cmd-open:hover { background: rgba(240, 166, 60, 0.1); }\n.nb-workbench .wb-phase {\n  display: inline-block;\n  margin: 16px 18px 0;\n  font: 9px var(--mono);\n  letter-spacing: 0.12em;\n  color: var(--f-3d);\n  border: 1px solid var(--f-3d);\n  border-radius: 99px;\n  padding: 3px 9px;\n}\n.nb-workbench .wb-three-slot { padding: 4px 0 14px; height: 60%; }\n.nb-workbench .wb-absent {\n  padding: 24px 18px;\n  color: var(--text-faint);\n  font-size: 12.5px;\n}\n\n/* local history strip */\n.nb-workbench .wb-history {\n  grid-column: 1 / -1;\n  grid-row: 2;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  border-top: 1px solid var(--line);\n  background: var(--panel);\n  padding: 9px 28px;\n  overflow-x: auto;\n}\n.nb-workbench .w