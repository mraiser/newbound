 ? desc : \"\";\n          const gArg = groups && groups !== meta.groups ? groups : \"\";\n          if ((meta.desc && !desc) || (meta.groups && !groups)) {\n            note.textContent = \"v1 can't clear a field\";\n          }\n          if (!dArg && !gArg) {\n            if (!note.textContent) note.textContent = \"nothing changed\";\n            return;\n          }\n          const r = await store.setCommandMeta(lib, name, cmdEntry.name, dArg, gArg);\n          if (r.status !== \"ok\") {\n            note.textContent = `failed: ${r.msg}`;\n            return;\n          }\n          if (dArg) meta.desc = dArg;\n          if (gArg) meta.groups = gArg;\n          store.invalidateControl(lib, cmdEntry.id);\n          store.invalidateControl(lib, meta.implId);\n          note.textContent = \"\";\n          toast.show(\"set_command_meta → saved\");\n        });","patch_id":"p28","time":1785503548981},{"author":"claude","facet":"js","label":"tags not groups: meta tooltip","new":"      metaBtn.title = \"the command's desc and tags\";","old":"      metaBtn.title = \"the command's desc and groups\";","patch_id":"p29","time":1785503717825},{"author":"claude","facet":"html","label":"command editor: first-class imports","new":"          <label class=\"wcc-imports-row\" hidden>\n            <span class=\"lbl\">imports</span>\n            <textarea class=\"wcc-imports\" rows=\"2\" spellcheck=\"false\"\n              title=\"file-level use/import statements (the impl record's import field) — saved via set_command_imports\"></textarea>\n          </label>\n          <pre class=\"wcc-err\" hidden></pre>\n          <div class=\"wcc-editor\"></div>","old":"          <pre class=\"wcc-err\" hidden></pre>\n          <div class=\"wcc-editor\"></div>","patch_id":"p30","time":1785598887370},{"author":"claude","facet":"css","label":"command editor: first-class imports","new":".nb-workbench .wcc-imports-row { display: flex; gap: 8px; align-items: flex-start;\n  padding: 4px 0 6px; }\n.nb-workbench .wcc-imports-row[hidden] { display: none; }\n.nb-workbench .wcc-imports { flex: 1; font: 12px var(--mono);\n  background: var(--panel); color: var(--text); border: 1px solid var(--line);\n  border-radius: 6px; padding: 4px 6px; resize: vertical; }\n.nb-workbench .wcc-err {","old":".nb-workbench .wcc-err {","patch_id":"p31","time":1785598900273},{"author":"claude","facet":"js","label":"command editor: first-class imports","new":"      codeApi = await mountControl(\"editor\", codeEl.querySelector(\".wcc-editor\"), {\n        language: \"js\",   // closest tinting for rust/python; not semantic\n        readOnly: !patchMode,\n        onChange: () => updateCodeDirty(),\n        onSave: () => saveCommandBody(),\n      });\n    }\n    codeApi.setSource(source);\n    const impEl = codeEl.querySelector(\".wcc-imports\");\n    codeEl.querySelector(\".wcc-imports-row\").hidden = false;\n    impEl.value = r.import ?? \"\";\n    impEl.readOnly = !patchMode;\n    codeState = { cmdName: cmdEntry.name, ext, lang: r.type ?? lang,\n                  params: r.params ?? [], returntype: r.returntype ?? \"\",\n                  baseline: source, importsBaseline: r.import ?? \"\", dirty: false };","old":"      codeApi = await mountControl(\"editor\", codeEl.querySelector(\".wcc-editor\"), {\n        language: \"js\",   // closest tinting for rust/python; not semantic\n        readOnly: !patchMode,\n        onChange: () => {\n          if (!codeState) return;\n          codeState.dirty = codeApi.getValue() !== codeState.baseline;\n          codeEl.querySelector(\".wcc-save\").disabled = !codeState.dirty;\n        },\n        onSave: () => saveCommandBody(),\n      });\n    }\n    codeApi.setSource(source);\n    codeState = { cmdName: cmdEntry.name, ext, lang: r.type ?? lang,\n                  params: r.params ?? [], returntype: r.returntype ?? \"\",\n                  baseline: source, dirty: false };","patch_id":"p32","time":1785598969010},{"author":"claude","facet":"js","label":"command editor: first-class imports","new":"  host.querySelector(\".wcc-save\").addEventListener(\"click\", () => saveCommandBody());\n  host.querySelector(\".wcc-imports\").addEventListener(\"input\", () => updateCodeDirty());\n\n  function updateCodeDirty() {\n    if (!codeState) return;\n    const impEl = codeEl.querySelector(\".wcc-imports\");\n    codeState.dirty = codeApi.getValue() !== codeState.baseline\n      || impEl.value !== (codeState.importsBaseline ?? \"\");\n    codeEl.querySelector(\".wcc-save\").disabled = !codeState.dirty;\n  }\n\n  async function saveCommandBody() {\n    if (!codeState?.dirty || !patchMode) return;\n    const errEl = codeEl.querySelector(\".wcc-err\");\n    const impEl = codeEl.querySelector(\".wcc-imports\");\n    const source = codeApi.getValue();\n    const notes = [];\n    errEl.hidden = true;\n\n    // imports first (set_command_imports recompiles): a body edit that\n    // needs a new `use` compiles on the second call, not on ordering luck\n    if (impEl.value !== (codeState.importsBaseline ?? \"\")) {\n      const r = await store.setCommandImports(lib, name, codeState.cmdName, impEl.value);\n      if (r.status !== \"ok\" && r.kind !== \"compile_error\") {\n        errEl.hidden = false;\n        errEl.textContent = `set_command_imports failed: ${r.msg}`;\n        return;\n      }\n      codeState.importsBaseline = impEl.value;\n      notes.push(r.status === \"ok\" ? \"imports · compiled\" : \"imports · compile FAILED\");\n      if (r.status !== \"ok\") {\n        errEl.hidden = false;\n        errEl.textContent = `compile failed (the imports were stored):\\n${r.msg}`;\n      }\n    }\n\n    const patch = computePatch(codeState.baseline, source);\n    if (patch && !(patch.oldSnippet === \"\" && codeState.baseline !== \"\")) {\n      const r = await store.patchCommandBody(lib, name, codeState.cmdName,\n        patch.oldSnippet, patch.newSnippet);\n      if (r.status !== \"ok\") {\n        errEl.hidden = false;\n        errEl.textContent = r.kind === \"compile_error\"\n          ? `compile failed (the patch was stored):\\n${r.msg}`\n          : `patch failed: ${r.msg}`;\n        if (/snippet not found/i.test(r.msg ?? \"\")) {\n          errEl.textContent += \"\\n\\nthe body changed on the server — reopen the command to load the current copy\";\n        }\n        if (r.kind !== \"compile_error\") return;\n      }\n      codeState.baseline = source;\n      notes.push(r.status === \"ok\" ? \"body · compiled\" : \"body · compile FAILED\");\n    }\n\n    updateCodeDirty();\n    if (notes.length) toast.show(`${notes.join(\" · \")} · ${codeState.cmdName}`);\n  }","old":"  host.querySelector(\".wcc-save\").addEventListener(\"click\", () => saveCommandBody());\n\n  async function saveCommandBody() {\n    if (!codeState?.dirty || !patchMode) return;\n    const errEl = codeEl.querySelector(\".wcc-err\");\n    const source = codeApi.getValue();\n    const patch = computePatch(codeState.baseline, source);\n    if (!patch) return;\n    if (patch.oldSnippet === \"\" && codeState.baseline !== \"\") return; // never whole-replace via snippet\n    const r = await store.patchCommandBody(lib, name, codeState.cmdName,\n      patch.oldSnippet, patch.newSnippet);\n    if (r.status !== \"ok\") {\n      errEl.hidden = false;\n      errEl.textContent = r.kind === \"compile_error\"\n        ? `compile failed (the patch was stored):\\n${r.msg}`\n        : `patch failed: ${r.msg}`;\n      if (/snippet not found/i.test(r.msg ?? \"\")) {\n        errEl.textContent += \"\\n\\nthe body changed on the server — reopen the command to load the current copy\";\n      }\n      if (r.kind !== \"compile_error\") return;\n    } else {\n      errEl.hidden = true;\n    }\n    codeState.baseline = source;\n    codeState.dirty = false;\n    codeEl.querySelector(\".wcc-save\").disabled = true;\n    toast.show(r.status === \"ok\"\n      ? `patch_command_body → applied · compiled · ${codeState.cmdName}`\n      : `patch_command_body → applied · compile FAILED · ${codeState.cmdName}`);\n  }","patch_id":"p33","time":1785598969024},{"author":"claude","facet":"css","label":"imports strip: 50px right margin (resize grip vs scrollbar)","new":".nb-workbench .wcc-imports { flex: 1; font: 12px var(--mono);\n  background: var(--panel); color: var(--text); border: 1px solid var(--line);\n  border-radius: 6px; padding: 4px 6px; resize: vertical;\n  /* keep the resize grip clear of the page scrollbar */\n  margin-right: 50px; }","old":".nb-workbench .wcc-imports { flex: 1; font: 12px var(--mono);\n  background: var(--panel); color: var(--text); border: 1px solid var(--line);\n  border-radius: 6px; padding: 4px 6px; resize: vertical; }","patch_id":"p34","time":1785672687303},{"author":"claude","facet":"html","label":"preview resize handle","new":"  <div class=\"wb-left\"></div>\n  <div class=\"wb-resize\" role=\"separator\" aria-orientation=\"vertical\" tabindex=\"0\"\n       aria-label=\"preview width\" title=\"drag to resize the preview — double-click to reset\"></div>","old":"  <div class=\"wb-left\"></div>","patch_id":"p35","time":1785782482882},{"author":"claude","facet":"html","label":"preview show/hide toggle","new":"      <button class=\"wm-preview\" aria-pressed=\"true\" title=\"show or hide the preview pane\">preview</button>\n      <button class=\"wm-edit\" hidden>meta ▸</button>","old":"      <button class=\"wm-edit\" hidden>meta ▸</button>","patch_id":"p36","time":1785782482896},{"author":"claude","facet":"css","label":"preview pane: width variable, collapse, fullscreen","new":".nb-workbench {\n  display: grid;\n  /* the preview's width is one custom property, so the drag handle, the\n     collapse and the fullscreen state are all just different values of it */\n  grid-template-columns: var(--pv-w, 400px) 1fr;\n  grid-template-rows: 1fr auto;\n  height: 100%;\n  overflow: hidden;\n  position: relative;\n}\n.nb-workbench.pv-off { grid-template-columns: 0 1fr; }\n.nb-workbench.pv-off .wb-left { display: none; }\n.nb-workbench.pv-full { grid-template-columns: 1fr 0; }\n.nb-workbench.pv-full .wb-right { display: none; }\n/* A wide grab target over a hairline: the pointer wants ~9px, the eye wants\n   1px. The handle sits ON the column boundary rather than inside either\n   pane, so neither pane's overflow can clip it. */\n.nb-workbench .wb-resize {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  left: var(--pv-w, 400px);\n  width: 9px;\n  margin-left: -5px;\n  cursor: col-resize;\n  z-index: 6;\n  background: none;\n  border: none;\n}\n.nb-workbench .wb-resize::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  left: 4px;\n  width: 1px;\n  background: transparent;\n}\n.nb-workbench .wb-resize:hover::before,\n.nb-workbench .wb-resize:focus-visible::before { background: var(--accent); }\n.nb-workbench.pv-off .wb-resize,\n.nb-workbench.pv-full .wb-resize { display: none; }\n.nb-workbench.wb-resizing { cursor: col-resize; user-select: none; }","old":".nb-workbench {\n  display: grid;\n  grid-template-columns: 400px 1fr;\n  grid-template-rows: 1fr auto;\n  height: 100%;\n  overflow: hidden;\n}","patch_id":"p37","time":1785782482903},{"author":"claude","facet":"css","label":"stacked layout has no resize handle","new":"@media (max-width: 900px) {\n  /* stacked: there is no column boundary left to drag */\n  .nb-workbench { grid-template-columns: 1fr; grid-template-rows: auto 1fr auto; overflow: auto; }\n  .nb-workbench.pv-off, .nb-workbench.pv-full { grid-template-columns: 1fr; }\n  .nb-workbench .wb-left { border-right: none; border-bottom: 1px solid var(--line); }\n  .nb-workbench .wb-resize { display: none; }\n}","old":"@media (max-width: 900px) {\n  .nb-workbench { grid-template-columns: 1fr; grid-template-rows: auto 1fr auto; overflow: auto; }\n  .nb-workbench .wb-left { border-right: none; border-bottom: 1px solid var(--line); }\n}","patch_id":"p38","time":1785782482911},{"author":"claude","facet":"css","label":"fullscreen toggle sits at the far end of the preview bar","new":".nb-workbench .wb-pv-bar { display: flex; gap: 6px; padding: 8px 10px 0; }\n.nb-workbench .wb-pv-bar .wb-pv-full { margin-left: auto; }","old":".nb-workbench .wb-pv-bar { display: flex; gap: 6px; padding: 8px 10px 0; }","patch_id":"p39","time":1785782482918},{"author":"claude","facet":"js","label":"preview pane geometry: hide, resize, fullscreen","new":"  const previewSlot = host.querySelector(\".wb-left\");\n  const PREVIEW_MODE_KEY = \"bench.preview.mode\";\n\n  // ── the preview pane's geometry: hidden / width / fullscreen ────────\n  // Width and hidden PERSIST (they are a working preference). Fullscreen\n  // does not: reloading into a pane that covers the editor, with no memory\n  // of having asked for it, is a puzzle rather than a convenience.\n  const PV_W_KEY = \"bench.preview.w\", PV_OFF_KEY = \"bench.preview.off\";\n  const PV_DEFAULT = 400, PV_MIN = 220;\n  const wbRoot = host.querySelector(\".nb-workbench\") || host;\n  const pvToggle = host.querySelector(\".wm-preview\");\n  const resizer = host.querySelector(\".wb-resize\");\n  let pvOff = localStorage.getItem(PV_OFF_KEY) === \"1\";\n  let pvFull = false;\n  let pvW = Math.max(PV_MIN, Number(localStorage.getItem(PV_W_KEY)) || PV_DEFAULT);\n\n  const pvMax = () => Math.max(PV_MIN, (wbRoot.clientWidth || 1200) - 320);\n  function applyPv() {\n    pvW = Math.min(Math.max(pvW, PV_MIN), pvMax());\n    wbRoot.style.setProperty(\"--pv-w\", pvW + \"px\");\n    wbRoot.classList.toggle(\"pv-off\", pvOff && !pvFull);\n    wbRoot.classList.toggle(\"pv-full\", pvFull);\n    if (pvToggle) {\n      pvToggle.setAttribute(\"aria-pressed\", String(!pvOff));\n      pvToggle.classList.toggle(\"on\", !pvOff);\n    }\n    const fs = host.querySelector(\".wb-pv-full\");\n    if (fs) {\n      fs.setAttribute(\"aria-pressed\", String(pvFull));\n      fs.textContent = pvFull ? \"⛶ exit\" : \"⛶\";\n      fs.title = pvFull ? \"leave fullscreen (Esc)\" : \"fill the workbench with the preview\";\n    }\n  }\n  function setPvOff(off) {\n    pvOff = off;\n    if (!off) pvFull = pvFull && false;   // showing it again leaves fullscreen alone\n    localStorage.setItem(PV_OFF_KEY, off ? \"1\" : \"0\");\n    applyPv();\n  }\n  function setPvFull(full) {\n    pvFull = full;\n    if (full) pvOff = false;              // fullscreen implies visible\n    localStorage.setItem(PV_OFF_KEY, pvOff ? \"1\" : \"0\");\n    applyPv();\n  }\n  if (pvToggle) pvToggle.addEventListener(\"click\", () => setPvOff(!pvOff));\n\n  if (resizer) {\n    // Pointer capture, so a fast drag that outruns the handle (or leaves the\n    // window) still steers it and still ends cleanly.\n    resizer.addEventListener(\"pointerdown\", (e) => {\n      e.preventDefault();\n      resizer.setPointerCapture(e.pointerId);\n      wbRoot.classList.add(\"wb-resizing\");\n      const x0 = e.clientX, w0 = pvW;\n      const move = (ev) => { pvW = w0 + (ev.clientX - x0); applyPv(); };\n      const up = () => {\n        resizer.removeEventListener(\"pointermove\", move);\n        resizer.removeEventListener(\"pointerup\", up);\n        resizer.removeEventListener(\"pointercancel\", up);\n        wbRoot.classList.remove(\"wb-resizing\");\n        localStorage.setItem(PV_W_KEY, String(Math.round(pvW)));\n      };\n      resizer.addEventListener(\"pointermove\", move);\n      resizer.addEventListener(\"pointerup\", up);\n      resizer.addEventListener(\"pointercancel\", up);\n    });\n    resizer.addEventListener(\"dblclick\", () => {\n      pvW = PV_DEFAULT; applyPv();\n      localStorage.setItem(PV_W_KEY, String(PV_DEFAULT));\n    });\n    resizer.addEventListener(\"keydown\", (e) => {\n      const step = e.shiftKey ? 48 : 16;\n      if (e.key === \"ArrowLeft\") pvW -= step;\n      else if (e.key === \"ArrowRight\") pvW += step;\n      else return;\n      e.preventDefault();\n      applyPv();\n      localStorage.setItem(PV_W_KEY, String(Math.round(pvW)));\n    });\n  }\n  host.addEventListener(\"keydown\", (e) => {\n    if (e.key === \"Escape\" && pvFull) { e.preventDefault(); setPvFull(false); }\n  });\n  applyPv();","old":"  const previewSlot = host.querySelector(\".wb-left\");\n  const PREVIEW_MODE_KEY = \"bench.preview.mode\";","patch_id":"p40","time":1785782482927},{"author":"claude","facet":"js","label":"fullscreen toggle on the preview bar","new":"    bar.append(\n      mk(\"static\", \"static\", \"html+css in a shadow root — safe everywhere, with source picking\"),\n      mk(\"live\", \"live ▸\", \"a real stock mount (js runs) via the platform's /dev/preview.html — needs a live connection\"),\n    );\n    const full = document.createElement(\"button\");\n    full.className = \"wb-pv-full\";\n    full.addEventListener(\"click\", () => setPvFull(!pvFull));\n    bar.appendChild(full);\n    previewSlot.appendChild(bar);","old":"    bar.append(\n      mk(\"static\", \"static\", \"html+css in a shadow root — safe everywhere, with source picking\"),\n      mk(\"live\", \"live ▸\", \"a real stock mount (js runs) via the platform's /dev/preview.html — needs a live connection\"),\n    );\n    previewSlot.appendChild(bar);","patch_id":"p41","time":1785782482934},{"author":"claude","facet":"js","label":"showing the pane leaves fullscreen alone","new":"  function setPvOff(off) {\n    pvOff = off;\n    localStorage.setItem(PV_OFF_KEY, off ? \"1\" : \"0\");","old":"  function setPvOff(off) {\n    pvOff = off;\n    if (!off) pvFull = pvFull && false;   // showing it again leaves fullscreen alone\n    localStorage.setItem(PV_OFF_KEY, off ? \"1\" : \"0\");","patch_id":"p42","time":1785782505041},{"author":"claude","facet":"js","label":"state classes land on the grid element itself","new":"  const wbRoot = host.classList.contains(\"nb-workbench\")\n    ? host : host.querySelector(\".nb-workbench\");","old":"  const wbRoot = host.querySelector(\".nb-workbench\") || host;","patch_id":"p43","time":1785782505049},{"author":"claude","facet":"css","label":"pin the preview pane to column 1","new":".nb-workbench .wb-left {\n  grid-row: 1;\n  grid-column: 1;","old":".nb-workbench .wb-left {\n  grid-row: 1;","patch_id":"p44","time":1785782614354},{"author":"claude","facet":"css","label":"pin the editor pane to column 2","new":".nb-workbench .wb-right {\n  grid-row: 1;\n  grid-column: 2;","old":".nb-workbench .wb-right {\n  grid-row: 1;","patch_id":"p45","time":1785782614366},{"author":"claude","facet":"css","label":"stacked layout keeps both panes in the single column","new":"  .nb-workbench.pv-off, .nb-workbench.pv-full { grid-template-columns: 1fr; }\n  /* one column: the explicit placement above would put the editors off-grid */\n  .nb-workbench .wb-left, .nb-workbench .wb-right { grid-column: 1; grid-row: auto; }\n  .nb-workbench .wb-left { border-right: none; border-bottom: 1px solid var(--line); }","old":"  .nb-workbench.pv-off, .nb-workbench.pv-full { grid-template-columns: 1fr; }\n  .nb-workbench .wb-left { border-right: none; border-bottom: 1px solid var(--line); }","patch_id":"p46","time":1785782614374},{"author":"claude","facet":"html","label":"groups-ui","new":"      <span class=\"wm-groups-view\" title=\"security groups — who can see and run this control; empty = admin only\"></span>","old":"      <span class=\"wm-groups-view\" title=\"security groups — the permission field; edited via the deliberate set_groups act, not here\"></span>","patch_id":"p47","time":1786308808513},{"author":"claude","facet":"html","label":"groups-ui","new":"      <button class=\"wm-wiring\">timers/events ▸</button>\n      <button class=\"wm-groups-btn\" hidden\n        title=\"security groups — the deliberate set_groups act: writes the groups string and derives the enforced readers on this control and its inline data\">groups ▸</button>\n      <form class=\"wm-form\" hidden>\n        <input class=\"wm-desc\" placeholder=\"describe this control — agents discover it through desc\">\n        <input class=\"wm-tags\" placeholder=\"tags (comma-delimited —