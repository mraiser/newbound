rg && !tChanged) {\n      if (!note.textContent) note.textContent = \"nothing changed\";\n      return;\n    }\n    if (dArg) {\n      const r = await store.setControlMeta(lib, name, dArg, \"\");\n      if (r.status !== \"ok\") { note.textContent = `failed: ${r.msg}`; return; }\n      record.desc = dArg;\n    }\n    if (tChanged) {\n      const r = await store.setTags(lib, name, \"\", tags);\n      if (r.status !== \"ok\") { note.textContent = `failed: ${r.msg}`; return; }\n      record.tags = tags;\n    }\n    store.invalidateControl(lib, ctlId);\n    form.hidden = true;\n    renderMeta();\n    toast.show(dArg && tChanged ? \"meta + tags → saved\"\n      : dArg ? \"set_control_meta → saved\" : \"set_tags → saved\");\n  });\n","old":"  // ── desc + groups (G-4/G-8) ───────────────────────────────\n  // Every level gets visible, encouraged descriptions; groups is the\n  // platform's comma-delimited string, verbatim. Empty string = leave\n  // untouched (CONTRACT §6) — v1 cannot clear a field, the UI says so.\n  const metaEl = host.querySelector(\".wb-meta\");\n\n  function renderMeta() {\n    const view = metaEl.querySelector(\".wm-view\");\n    view.textContent = record.desc\n      || \"no description — agents discover this control through desc\";\n    view.classList.toggle(\"empty\", !record.desc);\n    const g = metaEl.querySelector(\".wm-groups-view\");\n    g.textContent = record.groups ? `groups: ${record.groups}` : \"\";\n    metaEl.querySelector(\".wm-edit\").hidden = !patchMode;\n    // publish rides dev commands, not the agent lib — live mode is enough\n    metaEl.querySelector(\".wm-publish\").hidden = store.mode() !== \"live\";\n  }\n\n  metaEl.querySelector(\".wm-edit\").addEventListener(\"click\", () => {\n    const form = metaEl.querySelector(\".wm-form\");\n    form.hidden = !form.hidden;\n    if (!form.hidden) {\n      form.querySelector(\".wm-desc\").value = record.desc ?? \"\";\n      form.querySelector(\".wm-groups\").value = record.groups ?? \"\";\n      form.querySelector(\".wm-note\").textContent = \"\";\n      form.querySelector(\".wm-desc\").focus();\n    }\n  });\n\n  metaEl.querySelector(\".wm-form\").addEventListener(\"submit\", async (ev) => {\n    ev.preventDefault();\n    const form = metaEl.querySelector(\".wm-form\");\n    const note = form.querySelector(\".wm-note\");\n    const desc = form.querySelector(\".wm-desc\").value.trim();\n    const groups = form.querySelector(\".wm-groups\").value.trim();\n    const dArg = desc && desc !== (record.desc ?? \"\") ? desc : \"\";\n    const gArg = groups && groups !== (record.groups ?? \"\") ? groups : \"\";\n    if ((record.desc && !desc) || (record.groups && !groups)) {\n      note.textContent = \"v1 can't clear a field — set a new value instead\";\n    }\n    if (!dArg && !gArg) {\n      if (!note.textContent) note.textContent = \"nothing changed\";\n      return;\n    }\n    const r = await store.setControlMeta(lib, name, dArg, gArg);\n    if (r.status !== \"ok\") {\n      note.textContent = `failed: ${r.msg}`;\n      return;\n    }\n    if (dArg) record.desc = dArg;\n    if (gArg) record.groups = gArg;\n    store.invalidateControl(lib, ctlId);\n    form.hidden = true;\n    renderMeta();\n    toast.show(\"set_control_meta → saved\");\n  });\n","patch_id":"p22","time":1785503548899},{"author":"claude","facet":"js","label":"tags not groups: meta forms edit tags; groups read-only (2/7)","new":"    // desc/tags/groups live on the command's implementation record (CONTRACT §6).","old":"    // desc/groups live on the command's implementation record (CONTRACT §6).","patch_id":"p23","time":1785503548907},{"author":"claude","facet":"js","label":"tags not groups: meta forms edit tags; groups read-only (3/7)","new":"    return { desc: impl.desc ?? \"\", tags: impl.tags ?? \"\", groups: impl.groups ?? \"\", implId };","old":"    return { desc: impl.desc ?? \"\", groups: impl.groups ?? \"\", implId };","patch_id":"p24","time":1785503548916},{"author":"claude","fa