ss=\"ww-lbl\">on <input class=\"we-bot\" placeholder=\"app (e.g. app, peer)\" required>\n              : <input class=\"we-event\" placeholder=\"event name\" required></label>\n            <label class=\"ww-lbl\">runs <select class=\"we-cmd\"></select></label>\n            <button type=\"submit\" class=\"ww-apply\">set handler</button>\n            <span class=\"ww-note\"></span>\n          </form>\n        </section>\n      </div>\n    </div>\n    <div class=\"wb-conflict\" role=\"alert\" aria-live=\"assertive\" hidden>\n      <span class=\"wc-msg\"></span>\n      <button class=\"wc-theirs\">load theirs</button>\n      <button class=\"wc-mine\">overwrite anyway</button>\n    </div>\n    <div class=\"wb-pane\">\n      <div class=\"wb-editors\"></div>\n      <div class=\"wb-cmds\" hidden>\n        <p class=\"wb-note\">Commands are the control's verbs — callable from its\n        js, from other controls, and by agents.</p>\n        <form class=\"wb-newcmd\" hidden>\n          <input class=\"wc-name\" placeholder=\"new command name\" aria-label=\"New command name\">\n          <select class=\"wc-lang\" aria-label=\"Language\">\n            <option value=\"rust\">rust</option>\n            <option value=\"python\">python</option>\n            <option value=\"flow\">flow</option>\n          </select>\n          <label class=\"wc-lbl\">returns <select class=\"wc-ret\" aria-label=\"Return type\"></select></label>\n          <input class=\"wc-params\" placeholder=\"params — a: String, n: Integer\"\n                 aria-label=\"Parameters\">\n          <button type=\"submit\" class=\"wc-go\">+ new command</button>\n          <span class=\"wc-note\"></span>\n        </form>\n        <div class=\"wb-cmd-rows\"></div>\n        <div class=\"wb-cmd-code\" hidden>\n          <div class=\"wcc-head\">\n            <button class=\"wcc-back\">◂ commands</button>\n            <span class=\"wcc-name\"></span>\n            <span class=\"wcc-type wb-cmd-type\"></span>\n            <span 