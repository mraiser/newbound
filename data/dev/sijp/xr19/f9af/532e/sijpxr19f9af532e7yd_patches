preview modes, ellipsized chips, action toast, focus ring, contrast floor","new":".nb-workbench {\n  display: grid;\n  /* the preview's width is one custom property, so the drag handle, the\n     collapse and the fullscreen state are all just different values of it */\n  grid-template-columns: var(--pv-w, 400px) 1fr;\n  grid-template-rows: 1fr auto;\n  height: 100%;\n  overflow: hidden;\n  position: relative;\n}\n.nb-workbench.pv-off { grid-template-columns: 0 1fr; }\n.nb-workbench.pv-off .wb-left { display: none; }\n.nb-workbench.pv-full { grid-template-columns: 1fr 0; }\n.nb-workbench.pv-full .wb-right { display: none; }\n.nb-workbench :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n\n/* A discoverable grab target on the column boundary: a 13px hit area, a\n   visible grip pill, and the line + grip turn accent on hover/focus/drag.\n   The handle sits ON the boundary rather than inside either pane, so\n   neither pane's overflow can clip it. */\n.nb-workbench .wb-resize {\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  left: var(--pv-w, 400px);\n  width: 13px;\n  margin-left: -7px;\n  cursor: col-resize;\n  z-index: 6;\n  background: none;\n  border: none;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  touch-action: none;\n  padding: 0;\n}\n.nb-workbench .wb-resize::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  left: 6px;\n  width: 1px;\n  background: transparent;\n}\n.nb-workbench .wb-resize .grip {\n  position: relative;\n  width: 5px;\n  height: 36px;\n  border-radius: 3px;\n  background: var(--panel-3);\n  border: 1px solid var(--line);\n  pointer-events: none;\n}\n.nb-workbench .wb-resize:hover::before,\n.nb-workbench .wb-resize:focus-visible::before,\n.nb-workbench.wb-resizing .wb-resize::before { background: var(--accent); }\n.nb-workbench .wb-resize:hover .grip,\n.nb-workbench .wb-resize:focus-visible .grip,\n.nb-workbench.wb-resizing .wb-resize .grip { background: var(--accent); border-color: var(--accent); }\n.nb-workbench .wb-resize:focus-visible { outline: none; }\n.nb-workbench.pv-off .wb-resize,\n.nb-workbench.pv-full .wb-resize { display: none; }\n.nb-workbench.wb-resizing { cursor: col-resize; user-select: none; }\n.nb-workbench .wb-left {\n  grid-row: 1;\n  grid-column: 1;\n  border-right: 1px solid var(--line);\n  padding: 26px 28px;\n  overflow: auto;\n}\n.nb-workbench .wb-right {\n  grid-row: 1;\n  grid-column: 2;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n/* ── shared primitives ───────────────────────────────────── */\n/* Toggles: text-only — no frame, no fill, at rest or active. Active/\n   pressed/open = the text turns accent (the owner's explicit request);\n   hover = plain text. The caret rotates when its panel is open. */\n.nb-workbench .wb-tog {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  min-height: 28px;\n  padding: 0 8px;\n  border: none;\n  background: none;\n  border-radius: 6px;\n  font: 11.5px var(--mono);\n  letter-spacing: 0.03em;\n  color: var(--text-dim);\n  white-space: nowrap;\n  cursor: pointer;\n}\n.nb-workbench .wb-tog:hover { color: var(--text); }\n.nb-workbench .wb-tog[aria-pressed=\"true\"],\n.nb-workbench .wb-tog[aria-expanded=\"true\"] { color: var(--accent); }\n.nb-workbench .car { display: inline-block; transition: transform 0.12s; }\n.nb-workbench [aria-expanded=\"true\"] > .car { transform: rotate(90deg); }\n.nb-workbench .wb-tog.del {\n  color: var(--danger);\n  border: 1px solid var(--danger);\n  padding: 0 10px;\n  margin-left: 4px;\n}\n.nb-workbench .wb-tog.del:hover { background: rgba(224, 122, 122, 0.1); color: var(--danger); }\n.nb-workbench .wb-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 30px;\n  padding: 0 12px;\n  border-radius: 7px;\n  border: 1px solid var(--line);\n  background: var(--panel-3);\n  color: var(--text);\n  font: 11.5px var(--mono);\n  white-space: nowrap;\n  cursor: pointer