{"data":{"list":[{"author":"installer","facet":"html","label":"install sync","new":"<div class=\"nb-toast\" role=\"status\" aria-live=\"polite\"></div>\n","old":"","patch_id":"p1","time":1785011188713},{"author":"installer","facet":"css","label":"install sync","new":".nb-toast {\n  position: fixed;\n  bottom: 26px;\n  left: 50%;\n  transform: translate(-50%, 90px);\n  z-index: 90;\n  background: var(--panel-3);\n  border: 1px solid var(--line);\n  color: var(--text);\n  font: 12px var(--mono);\n  padding: 10px 18px;\n  border-radius: 99px;\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);\n  transition: transform 0.25s ease;\n}\n.nb-toast.show { transform: translate(-50%, 0); }\n","old":"","patch_id":"p2","time":1785011188716},{"author":"installer","facet":"js","label":"install sync","new":"// toast — transient status messages. Frame mounts one instance and passes its\n// api ({show}) to every other control that needs to speak.\n\nexport function init(host) {\n  const el = host.querySelector(\".nb-toast\");\n  let timer = null;\n\n  return {\n    show(message) {\n      el.textContent = message;\n      el.classList.add(\"show\");\n      clearTimeout(timer);\n      timer = setTimeout(() => el.classList.remove(\"show\"), 2600);\n    },\n  };\n}\n","old":"","patch_id":"p3","time":1785011188718},{"author":"claude","facet":"move","label":"moved from bench to dev","new":"dev","old":"bench","patch_id":"p4","time":1785372127267}]},"id":"gvnriw19f9af532e4qc_patches","readers":[],"time":1785372127267,"username":"system","writers":[]}