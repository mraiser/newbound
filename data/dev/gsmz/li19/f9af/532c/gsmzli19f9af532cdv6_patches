ameOf(c, dest.idx)}.${dest.term}`,\n          undo: () => { const k = c.cons.indexOf(nw); if (k >= 0) c.cons.splice(k, 1); c.cons.splice(idx, 0, oldWire); },\n          redo: () => { const k = c.cons.indexOf(oldWire); if (k >= 0) c.cons.splice(k, 1); if (c.cons.indexOf(nw) < 0) c.cons.push(nw); },\n        });\n      } else { c.cons.splice(idx, 0, oldWire); }      // cancelled → restore\n      reprojectLive();\n    });\n  }\n\n  // Shared wiring drag: a ghost tube from the source socket follows the pointer;\n  // legal input targets (I-1/I-2) preview; drop calls onDrop(destMeta|null).\n  function beginWireDrag(c, src, ev, onDrop) {\n    const srcPos = terminalWorld(c, src.idx, \"out\", src.term);\n    if (!srcPos) { onDrop(null); return; }\n    const plane = { point: srcPos, normal: { x: 0, y: 0, z: 1 } };\n    let target = null;\n    stage.upsert(\"edit/ghostwire\", { kind: \"tube\", position: { x: 0, y: 0, z: 0 }, params: { from: srcPos, to: srcPos, r: 0.045 }, material: \"accent\", pickable: false });\n    editObjs.set(\"edit/ghostwire\", { id: \"edit/ghostwire\", meta: { role: \"ghost\" } });\n    stage.capturePointer({\n      onMove: (p) => {\n        const world = stage.screenToPlane(p.x, p.y, plane) || srcPos;\n        const hs = specById.get(stage.pick(p.x, p.y)?.id);\n        target = null; let toPos = world;\n        if (hs?.meta?.role === \"terminal\" && hs.meta.which === \"in\" && activeSpec(hs.id)) {\n          const chk = doc.canWire(c, [src.idx, src.term], [hs.meta.idx, hs.meta.term]);\n          if (chk.ok) { target = hs.meta; toPos = terminalWorld(c, hs.meta.idx, \"in\", hs.meta.term); flashTag(\"→ wire here\", p); }\n          else flashTag(\"✗ \" + chk.reason, p);\n        } else tagEl.hidden = true;\n        stage.patch([{ id: \"edit/ghostwire\", params: { from: srcPos, to: toPos, r: 0.045 } }]);\n      },\n      onEnd: () => { stage.remove(\"edit/ghostwire\"); editObjs.delete(\"edit/ghostwire\"); tagEl.hidden = true; onDrop(target); },\n    });\