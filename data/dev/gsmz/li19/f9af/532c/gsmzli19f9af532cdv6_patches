  const map = {\n    ground: \"--ground\", panel: \"--panel\", panel2: \"--panel-2\",\n    line: \"--line\", lineSoft: \"--line-soft\",\n    text: \"--text\", textDim: \"--text-dim\", textFaint: \"--text-faint\",\n    paper: \"--paper\", paperEdge: \"--paper-edge\", ink: \"--ink\", inkDim: \"--ink-dim\",\n    accent: \"--accent\", accentDim: \"--accent-dim\",\n    \"hue:html\": \"--f-html\", \"hue:css\": \"--f-css\", \"hue:js\": \"--f-js\",\n    \"hue:data\": \"--f-data\", \"hue:3d\": \"--f-3d\", \"hue:cmd\": \"--f-cmd\", \"hue:commands\": \"--f-cmd\",\n    good: \"--good\", danger: \"--danger\", sky: \"--f-css\",\n  };\n  const theme = {};\n  for (const [k, v] of Object.entries(map)) { const val = s.getPropertyValue(v).trim(); if (val) theme[k] = val; }\n  return theme;\n}\n\nexport function init(host, { title, graph, source, onBack }) {\n  const titleEl = host.querySelector(\".fx-title\");\n  titleEl.replaceChildren(document.createTextNode((title?.prefix || \"\") + \" \"));\n  const t = document.createElement(\"span\"); t.className = \"t\"; t.textContent = title?.name || \"flow\";\n  titleEl.append(t, ` ${title?.suffix ?? \"(flowlang · 3D)\"}`);\n\n  const crumbsEl = host.querySelector(\".fx-crumbs\");\n  const stageHost = host.querySelector(\".fx-stage\");\n  const labelsEl = host.querySelector(\".fx-labels\");\n  const tagEl = host.querySelector(\".fx-tag\");\n  const fallbackEl = host.querySelector(\".fx-fallback\");\n  const decksEl = host.querySelector(\".fx-decks\");\n  const projBtn = host.querySelector(\".fx-proj\");\n  const frameBtn = host.querySelector(\".fx-frame\");\n  const runBtn = host.querySelector(\".fx-run\");\n  const saveBtn = host.querySelector(\".fx-save\");\n  const statusEl = host.querySelector(\".fx-status\");\n  const conflictEl = host.querySelector(\".fx-conflict\");\n  const inspectBody = host.querySelector(\".fx-inspect-body\");\n  const diagBox = host.querySelector(\".fx-diag\");\n  const diagList = host.querySelector(\".fx-diag-list\");\n  const journalBox = host.querySelector(\".fx-journal\");\n  const journalList = host.querySelector(\".fx-journal-list\");\n  const layoutBar = host.querySelector(\".fx-layout-bar\");\n\n  let doc = parse(graph);\n  let stack = [{ label: \"case 1\", case: doc.root, path: \"case\" }];\n  let activeDeck = 0;\n  let stage = null;\n  let specById = new Map();\n  let specJson = new Map();       // id -> JSON of the last spec sent (delta diffing)\n  const editObjs = new Map();     // control-owned stage objects (handles, ghost wire)\n  const labelEls = new Map();\n  const lodLevels = new Map();    // glass-op id -> current miniature LOD level\n  let selectedId = null;\n  let hoverId = null;\n  let pointer = { x: 0, y: 0 };\n\n  // editing state\n  let editable = false;\n  let baseHash = \"\";\n  let dirty = false;\n  let saving = false;\n  let undoStack = [];\n  let redoStack = [];\n  let pendingLabels = [];\n  let handleIds = [];\n\n  if (!hasWebGL()) return showFallback(\"WebGL isn’t available in this browser.\");\n  try { stage = mount(stageHost, { theme: readTheme() }); }\n  catch (e) { return showFallback(`the 3D stage failed to start: ${e.message}`); }\n\n  function showFallback(msg) {\n    fallbackEl.hidden = false;\n    fallbackEl.innerHTML = `${msg}<br><br>Open this flow in the 2D viewer instead — it reads any ` +\n      `graph without WebGL. (Editing lives only in the 3D editor.)`;\n    host.querySelector(\".fx-back\").addEventListener(\"click\", () => onBack?.());\n    return { dispose() {} };\n  }\n\n  const projArgs = () => ({ activeDeck, basePath: stack[stack.length - 1].path });\n  const focusedCase = () => { let c = stack[stack.length - 1].case; for (let i = 0; i < activeDeck && c.nextcase; i++) c = c.nextcase; return c; };\n  const focusedPath = () => { let p = stack[stack.length - 1].path; for (let i = 0; i < activeDeck; i++) p += \".next\"; return p; };\n  const activeSpec = (id) => id && id.startsWith(`d${activeDeck}/`);\n\n  // ── labels ─────────────────────────────────────────────────────────────────\n  function clearLabels() { for (const { el } of labelEls.values()) { stage.unanchor(el); el.remove(); } labelEls.clear(); }\n  function addLabel(id, text, cls) {\n    const el = document.createElement(\"div\");\n    el.className = `fx-label ${cls}`; el.innerHTML = text;\n    labelsEl.appendChild(el); stage.anchor(id, el, { occlusionFade: true });\n    labelEls.set(id, { el, cls });\n  }\n\n  // ── full render (drill / deck change / conflict reload) ────────────────────\n  function render() {\n    closePopover(); closePicker(); cancelLayoutPreview();\n    wireMode = null;      // stage.clear() below disposes the ghost with the rest\n    stage.clear(); clearLabels(); clearHandles();\n    selectedId = null; hoverId = null; editObjs.clear(); lodLevels.clear();\n    const proj = project(stack[stack.length - 1].case, projArgs());\n    specById = new Map(proj.specs.map((s) => [s.id, s]));\n    specJson = new Map(proj.specs.map((s) => [s.id, JSON.stringify(s)]));\n    stage.patch(proj.specs);\n    for (const s of proj.specs) {\n      if (!s.label) continue;\n      if (s.label.role === \"op\") addLabel(s.id, `${escape(s.label.text)}${s.label.sub ? ` <span class=\"sub\">${s.label.sub}</span>` : \"\"}`, \"op\");\n      else if (s.label.role === \"bar\") addLabel(s.id, escape(s.label.text), \"bar\");\n    }\n    crumbsEl.textContent = stack.length > 1 ? stack.map((s) => s.label).join(\" ▸ \") : \"\";\n    renderDeckTabs(proj.deckCount);\n    stage.setProjection(projBtn.getAttribute(\"aria-pressed\") === \"true\" ? \"ortho-front\" : \"persp\");\n    if (proj.bounds) stage.frame(proj.bounds);\n    renderDiagnostics(); inspectEmpty(); updateLod();\n  }\n\n  // ── live re-project after a gesture: MINIMAL deltas ────────────────────────\n  // Only specs that actually changed reach the stage; a pure position change\n  // travels as a position-only delta (no rebuild). During a drag this touches\n  // O(moved op + its wires) — the practical half of the §7.2 drag budget.\n  const stripPos = (s) => { const { position, ...rest } = s; return JSON.stringify(rest); };\n  function reprojectLive() {\n    const proj = project(stack[stack.length - 1].case, projArgs());\n    const nextJson = new Map();\n    const deltas = [];\n    for (const s of proj.specs) {\n      const j = JSON.stringify(s);\n      nextJson.set(s.id, j);\n      const pj = specJson.get(s.id);\n      if (pj === j) continue;\n      if (pj !== undefined) {\n        const prev = specById.get(s.id);\n        if (prev && stripPos(s) === stripPos(prev)) { deltas.push({ id: s.id, position: s.position }); continue; }\n      }\n      deltas.push(s);\n    }\n    for (const id of specById.keys()) {\n      if (!nextJson.has(id) && !id.startsWith(\"edit/\")) { stage.remove(id); lodLevels.delete(id); }\n    }\n    if (deltas.length) stage.patch(deltas);\n    specById = new Map(proj.specs.map((s) => [s.id, s]));\n    specJson = nextJson;\n    for (const [id, s] of editObjs) specById.set(id, s);\n  }\n\n  // ── miniature LOD (§7.5): full (bodies+wires) · mid (bodies) · far (glyph) ─\n  let lodTimer = 0;\n  function updateLod() {\n    const cam = stage.getPose().position;\n    const patches = [];\n    for (const [id, s] of specById) {\n      if (s.meta?.role !== \"op\" || !s.meta.hasLocal || !activeSpec(id)) continue;\n      const d = Math.hypot(cam.x - s.position.x, cam.y - s.position.y, cam.z - s.position.z);\n      const level = d < 8 ? 2 : d < 18 ? 1 : 0;\n      if (lodLevels.get(id) === level) continue;\n      lodLevels.set(id, level);\n      for (const mid of specById.keys()) {\n        if (!mid.startsWith(id + \"/mini\")) continue;\n        patches.push({ id: mid, visible: mid.includes(\"/miniwire/\") ? level === 2 : level >= 1 });\n      }\n    }\n    if (patches.length) stage.patch(patches);\n  }\n  stage.onCameraChange(() => { clearTimeout(lodTimer); lodTimer = setTimeout(updateLod, 120); });\n\n  function renderDeckTabs(count) {\n    decksEl.replaceChildren();\n    if (count > 1) {\n      for (let i = 0; i < count; i++) {\n        const b = document.createElement(\"button\");\n        b.className = \"fx-deck-tab\" + (i === activeDeck ? \" on\" : \"\");\n        b.textContent = `case ${i + 1}`; b.setAttribute(\"role\", \"tab\"); b.setAttribute(\"aria-selected\", String(i === activeDeck));\n        b.addEventListener(\"click\", () => setActiveDeck(i));\n        if (editable && i === activeDeck) {\n          const x = document.createElement(\"span\"); x.className = \"x\"; x.textContent = \"×\";\n          x.title = \"delete this case (splices the chain; I-4 guarded)\";\n          x.addEventListener(\"click\", (e) => {\n            e.stopPropagation();\n            const cmd = doc.removeCase(stack[stack.length - 1].case, i);\n            if (cmd.error) { setStatus(cmd.error, \"bad\"); return; }\n            commitApplied(cmd);\n            setActiveDeck(Math.max(0, i - 1));\n          });\n          b.appendChild(x);\n        }\n        decksEl.appendChild(b);\n      }\n    }\n    if (editable) {\n      const add = document.createElement(\"button\");\n      add.className = \"fx-deck-tab add\"; add.textContent = \"+\";\n      add.title = \"add a case — the fall-through program (`next` jumps here)\";\n      add.addEventListener(\"click\", () => {\n        const cmd = doc.addCase(stack[stack.length - 1].case);\n        if (cmd.error) { setStatus(cmd.error, \"bad\"); return; }\n        commitApplied(cmd);\n        setActiveDeck(count); // jump to the new deck\n      });\n      decksEl.appendChild(add);\n    }\n  }\n  function setActiveDeck(i) {\n    const proj = project(stack[stack.length - 1].case, {});\n    activeDeck = Math.max(0, Math.min(proj.deckCount - 1, i));\n    render();\n  }\n\n  // ── selection + emphasis ────────────────────────────────────────────────────\n  function setEmphasis(id, state) {\n    if (!id) return;\n    stage.patch([{ id, emphasis: state }]);\n    const lbl = labelEls.get(id); if (lbl) lbl.el.classList.toggle(\"sel\", state === \"select\");\n  }\n  function select(id) {\n    endKeyboardWiring();   // any new selection abandons an in-flight W gesture\n    if (selectedId && selectedId !== id) { setEmphasis(selectedId, hoverId === selectedId ? \"hover\" : null); }\n    if (popAnchorId && popAnchorId !== id) closePopover();\n    selectedId = id;\n    clearHandles();\n    if (id) {\n      setEmphasis(id, \"select\");\n      const spec = specById.get(id);\n      inspect(spec);\n      if (editable && spec?.meta?.role === \"op\" && activeSpec(id)) showHandles(spec.meta.opIndex);\n    } else inspectEmpty();\n  }\n\n  // ── hover / pick / drill ────────────────────────────────────────────────────\n  stage.onHover((hit) => {\n    const id = hit?.id ?? null;\n    if (id === hoverId) return;\n    if (hoverId && hoverId !== selectedId) setEmphasis(hoverId, null);\n    hoverId = id;\n    if (id) { if (id !== selectedId) setEmphasis(id, \"hover\"); showTag(specById.get(id)); }\n    else tagEl.hidden = true;\n  });\n  stage.onPick((hit) => select(hit?.id ?? null));\n\n  stageHost.addEventListener(\"pointermove\", (e) => {\n    const r = stageHost.getBoundingClientRect();\n    pointer = { x: e.clientX - r.left, y: e.clientY - r.top };\n    if (!tagEl.hidden) { tagEl.style.left = pointer.x + \"px\"; tagEl.style.top = pointer.y + \"px\"; }\n  });\n  stageHost.addEventListener(\"pointerdown\", () => host.focus());\n  stageHost.addEventListener(\"dblclick\", (e) => {\n    const hit = stage.pick(e.clientX, e.clientY);\n    const spec = hit && specById.get(hit.id);\n    if (spec?.meta?.role === \"op\" && spec.meta.hasLocal) drill(spec.meta.opIndex);\n  });\n  function drill(opIndex) {\n    const op = focusedCase().cmds[opIndex];\n    if (!op?.localdata) return;\n    stack.push({ label: `local: ${op.name}`, case: op.localdata, path: `${focusedPath()}.cmds[${opIndex}].local` });\n    activeDeck = 0; render();\n  }\n\n  // ── editing gestures (only when editable) ──────────────────────────────────\n  stage.onPointerDown((hit, ev) => {\n    if (!editable || !hit) return false;\n    const spec = specById.get(hit.id);\n    const m = spec?.meta;\n    if (!m) return false;\n    if (m.role === \"op\" && activeSpec(hit.id)) { startMove(m.opIndex, ev); return true; }\n    if (m.role === \"widthHandle\") { startResize(m, ev); return true; }\n    if (m.role === \"terminal\" && activeSpec(hit.id)) {\n      if (ev.altKey) { startTerminalMove(hit.id, m, ev); return true; }\n      if (m.which === \"out\") { startWiring(m, ev); return true; }\n      if (m.which === \"in\" && focusedCase().cons.some((w) => w.dest[0] === m.idx && w.dest[1] === m.term)) { startRewire(m, ev); return true; }\n    }\n    return false;\n  });\n\n  function startMove(opIndex, ev) {\n    const c = focusedCase(), op = c.cmds[opIndex];\n    const opId = `d${activeDeck}/op/${opIndex}`;\n    const from = { ...op.pos };\n    clearHandles();\n    stage.beginDrag(opId, {\n      plane: ev.altKey ? \"xz\" : \"xy\", snap: SNAP, clientX: ev.clientX, clientY: ev.clientY,\n      onMove: (pos) => { op.pos = { x: pos.x, y: pos.y, z: pos.z }; reprojectLive(); },\n      onEnd: (pos) => {\n        op.pos = { x: pos.x, y: pos.y, z: pos.z };\n        const moved = Math.abs(pos.x - from.x) + Math.abs(pos.y - from.y) + Math.abs(pos.z - from.z) > 1e-6;\n        if (moved) commitApplied({ label: `move ${op.name || \"op\"}`, undo: () => { op.pos = { ...from }; }, redo: () => { op.pos = { x: pos.x, y: pos.y, z: pos.z }; } });\n        else { reprojectLive(); select(opId); }\n        if (moved) { reprojectLive(); select(opId); }\n      },\n    });\n  }\n\n  function startResize(m, ev) {\n    const c = focusedCase(), op = c.cmds[m.opIndex];\n    const from = op.width;\n    const handleId = `edit/wh/${m.side < 0 ? \"l\" : \"r\"}`;\n    stage.beginDrag(handleId, {\n      plane: \"xy\", snap: SNAP, clientX: ev.clientX, clientY: ev.clientY,\n      onMove: (pos) => { op.width = Math.max(0.6, 2 *