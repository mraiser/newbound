ttom: 1px solid var(--line-soft);\n  z-index: 5;\n}\n.nb-floweditor3d .fx-spacer { flex: 1; }\n.nb-floweditor3d .fx-back,\n.nb-floweditor3d .fx-proj,\n.nb-floweditor3d .fx-frame,\n.nb-floweditor3d .fx-run,\n.nb-floweditor3d .fx-save {\n  font: 12px var(--mono);\n  color: var(--text-dim);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 6px 12px;\n  background: var(--panel);\n}\n.nb-floweditor3d .fx-back:hover,\n.nb-floweditor3d .fx-proj:hover,\n.nb-floweditor3d .fx-frame:hover,\n.nb-floweditor3d .fx-run:hover,\n.nb-floweditor3d .fx-save:hover { color: var(--accent); border-color: var(--accent-dim); }\n.nb-floweditor3d .fx-run:disabled { opacity: 0.4; cursor: default; }\n.nb-floweditor3d .fx-run.running { color: var(--good); border-color: var(--good); }\n.nb-floweditor3d .fx-save.dirty { color: var(--ground); background: var(--accent); border-color: var(--accent); }\n.nb-floweditor3d .fx-save.dirty::before { content: \"● \"; }\n.nb-floweditor3d .fx-save:disabled { opacity: 0.4; cursor: default; }\n\n.nb-floweditor3d .fx-conflict {\n  position: absolute;\n  top: 14px; left: 50%;\n  transform: translateX(-50%);\n  display: flex; align-items: center; gap: 12px;\n  background: var(--panel-2);\n  border: 1px solid var(--danger);\n  border-radius: 10px;\n  padding: 10px 16px;\n  font: 12px var(--mono);\n  color: var(--text);\n  z-index: 20;\n  box-shadow: 0 6px 20px rgba(0,0,0,0.4);\n}\n.nb-floweditor3d .fx-conflict button {\n  font: 11px var(--mono);\n  color: var(--text-dim);\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  padding: 5px 10px;\n  background: var(--panel);\n}\n.nb-floweditor3d .fx-conflict button:hover { color: var(--accent); border-color: var(--accent-dim); }\n.nb-floweditor3d .fx-proj[aria-pressed=\"true\"] { color: var(--accent); border-color: var(--accent-dim); }\n.nb-floweditor3d .fx-title { font: 13px var(--mono); }\n.nb-floweditor3d .fx-title .t { color: var(--f-cmd); }\n.nb-floweditor3d .fx-crumbs { font: 11px var(--m