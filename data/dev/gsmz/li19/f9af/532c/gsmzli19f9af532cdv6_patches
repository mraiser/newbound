ere;\n  display: flex; gap: 5px; align-items: baseline; text-align: left;\n  background: none; border: 0; padding: 0; font: inherit; cursor: pointer;\n}\n.nb-floweditor3d .fx-journal-list .jl-label:hover { color: var(--accent); }\n.nb-floweditor3d .fx-journal-list .jl-caret { color: var(--text-faint); font-size: 9px; }\n.nb-floweditor3d .jl-diff { margin: 4px 0 8px 12px; }\n.nb-floweditor3d .jl-note { color: var(--text-faint); font: 10px var(--mono); margin: 2px 0; }\n.nb-floweditor3d .jl-diff-list { list-style: none; margin: 4px 0 0; }\n.nb-floweditor3d .jl-ch {\n  display: flex; gap: 6px; align-items: baseline;\n  padding: 1px 0; color: var(--text-dim); font: 10px var(--mono);\n  overflow-wrap: anywhere;\n}\n.nb-floweditor3d .jl-ch .jl-g { width: 9px; flex: none; text-align: center; }\n.nb-floweditor3d .jl-ch.jl-add .jl-g { color: var(--good, #6ea87a); }\n.nb-floweditor3d .jl-ch.jl-del .jl-g { color: var(--bad, #c15a5a); }\n.nb-floweditor3d .jl-ch.jl-mod .jl-g { color: var(--accent); }\n.nb-floweditor3d .fx-journal-list .jl-author { color: var(--text-faint); }\n.nb-floweditor3d .fx-journal-list .jl-revert {\n  font: 10px var(--mono); color: var(--text-dim);\n  border: 1px solid var(--line-soft); border-radius: 5px;\n  padding: 1px 6px; background: var(--panel);\n}\n.nb-floweditor3d .fx-journal-list .jl-revert:hover { color: var(--accent); border-color: var(--accent-dim); }\n\n.nb-floweditor3d .fx-fallback {\n  position: absolute; inset: 0;\n  display: flex; align-items: center; justify-content: center;\n  text-align: center;\n  padding: 40px;\n  font: 12px var(--mono);\n  color: var(--text-dim);\n  line-height: 1.7;\n}\n\n/* ── inspector (right) ──────────────────────────────────── */\n.nb-floweditor3d .fx-inspect {\n  border-left: 1px solid var(--line);\n  padding: 22px 20px;\n  overflow: auto;\n  display: flex;\n  flex-direction: column;\n}\n.nb-floweditor3d .fx-inspect-body { margin-top: 14px; font-size: 12.5px; color: var(--text-dim); line-height: 1.6; }\n.nb-