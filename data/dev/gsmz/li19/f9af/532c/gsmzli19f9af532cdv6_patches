order-radius: 5px;\n  padding: 2px 8px;\n  pointer-events: none;\n  transform: translate(12px, 12px);\n  z-index: 10;\n  white-space: nowrap;\n}\n\n/* ── edit popover (anchored) + pickers (centered) ────────── */\n.nb-floweditor3d .fx-pop {\n  position: absolute; left: 0; top: 0;\n  pointer-events: none;\n  z-index: 15;\n}\n.nb-floweditor3d .fx-pop-panel {\n  pointer-events: auto;\n  transform: translate(-50%, 16px);\n  min-width: 230px;\n  max-width: 320px;\n  background: var(--panel-2);\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  padding: 12px 14px;\n  font: 11.5px var(--mono);\n  color: var(--text);\n  box-shadow: 0 8px 26px rgba(0,0,0,0.45);\n}\n.nb-floweditor3d .fx-pop-panel .lbl { display: block; margin-bottom: 8px; }\n.nb-floweditor3d .fx-pop-row {\n  display: flex; gap: 8px; align-items: center;\n  margin: 7px 0;\n}\n.nb-floweditor3d .fx-pop-row > span:first-child { color: var(--text-faint); min-width: 54px; }\n.nb-floweditor3d .fx-pop input,\n.nb-floweditor3d .fx-pop select {\n  flex: 1; min-width: 0;\n  font: 11.5px var(--mono);\n  color: var(--text);\n  background: var(--panel);\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  padding: 4px 7px;\n}\n.nb-floweditor3d .fx-pop-sentence { color: var(--text-dim); font-size: 10.5px; line-height: 1.5; margin: 6px 0; }\n.nb-floweditor3d .fx-pop-btn {\n  font: 11px var(--mono);\n  color: var(--text-dim);\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  padding: 4px 9px;\n  background: var(--panel);\n}\n.nb-floweditor3d .fx-pop-btn:hover { color: var(--accent); border-color: var(--accent-dim); }\n.nb-floweditor3d .fx-pop-btn.danger:hover { color: var(--danger); border-color: var(--danger); }\n.nb-floweditor3d .fx-pop-terms { margin: 6px 0; }\n.nb-floweditor3d .fx-pop-terms button {\n  font: 10.5px var(--mono); color: var(--text-dim);\n  border: 1px solid var(--line-soft); border-radius: 5px;\n  padding: 2px 7px; margin: 2px 3px 2px 0; background: var(--panel);\n}\n.nb-floweditor3d .fx-pop-terms button:hover { color: var(--accent); border-color: var(--accent-dim); }\n\n.nb-floweditor3d .fx-picker {\n  position: absolute; inset: 0;\n  display: flex; align-items: center; justify-content: center;\n  background: rgba(23, 26, 30, 0.55);\n  z-index: 18;\n}\n.nb-floweditor3d .fx-picker-panel {\n  width: 380px; max-height: 70%;\n  display: flex; flex-direction: column;\n  background: var(--panel-2);\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  padding: 14px 16px;\n  font: 11.5px var(--mono);\n  box-shadow: 0 10px 32px rgba(0,0,0,0.5);\n}\n.nb-floweditor3d .fx-picker-panel .lbl { margin-bottom: 10px; }\n.nb-floweditor3d .fx-picker input,\n.nb-floweditor3d .fx-picker select {\n  font: 12px var(--mono); color: var(--text);\n  background: var(--panel); border: 1px solid var(--line);\n  border-radius: 7px; padding: 6px 9px; margin-bottom: 8px;\n}\n.nb-floweditor3d .fx-picker-list { overflow: auto; min-height: 0; }\n.nb-floweditor3d .fx-picker-list .fam { margin: 8px 0 3px; }\n.nb-floweditor3d .fx-picker-list button {\n  display: flex; justify-content: space-between; gap: 12px;\n  width: 100%; text-align: left;\n  font: 11.5px var(--mono); color: var(--text);\n  padding: 4px 8px; border-radius: 6px;\n}\n.nb-floweditor3d .fx-picker-list button:hover { background: var(--panel); color: var(--accent); }\n.nb-floweditor3d .fx-picker-list .sig { color: var(--text-faint); }\n.nb-floweditor3d .fx-picker-foot { display: flex; gap: 8px; justify-content: flex-end; margin-top: 10px; }\n\n/* ── journal strip (inspector) ───────────────────────────── */\n.nb-floweditor3d .fx-journal { margin-top: 20px; border-top: 1px solid var(--line-soft); padding-top: 14px; }\n.nb-floweditor3d .fx-journal-list { list-style: none; margin-top: 8px; font: 10.5px var(--mono); }\n.nb-floweditor3d .fx-journal-list li {\n  display: flex; gap: 8px; align-items: baseline;\n  padding: 4px 0;\n  color: var(--text-dim);\n}\n.nb-floweditor3d .fx-journal-list .jl-label { flex: 1