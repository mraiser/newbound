{"data":{"list":[{"author":"claude","facet":"js","label":"the flip: dev.dev becomes the Development boot (R-2, D10)","new":"// dev — the Development app's boot (the R-2 flip: this control's facets\n// ARE the app the platform serves at /dev/; its commands — compile,\n// rebuild_lib, lib_archive… — predate the boot and stay). It runs under\n// the STOCK mount: the shell's body is a data-control that\n// activateControls wraps as `el.api = new function(){ ...this facet... }`,\n// so this file is CLASSIC-script code — no import/export statements;\n// dynamic import() only.\n//\n// What it does (the owner's correction, 2026-07-25 — code lives in\n// CONTROLS; _ASSETS holds media and the vendored bundles only): reads the\n// shared ES modules out of their module controls' facets via app/read,\n// builds the module graph as blob URLs (dependency-first, specifiers\n// rewritten), injects the tokens css, then imports the loader and mounts\n// the frame. The static entry (index.html, repo-only) never runs this —\n// it imports ./assets/loader.js off real files.\n//\n// MODMAP is the single source of truth mapping module controls to their\n// repo authoring paths AND their home libraries (the Great Refactoring's\n// R-1: controls span libraries, so every entry carries \"lib\" — an absent\n// lib means the boot's own library). tools/install-bench.py and\n// tools/export-bench.py parse it from this facet between the MODMAP\n// markers, so it must stay a pure JSON object literal (quoted keys, no\n// trailing commas, no comments inside). Add an entry when adding a shared\n// module; `deps` maps an import specifier that appears verbatim in the\n// module's source to the module control that satisfies it. An entry with\n// \"optional\": true is SKIPPED when its control is missing (the notebook\n// seam: the agent lib is an add-on — consumers check\n// __benchPlatform.moduleUrls before importing); an optional module may\n// only be depended on by other optional modules.\n//\n// The boot also builds a UNION control directory over every library MODMAP\n// names (plus its own): __benchPlatform.controls = {name: {lib, id}}. The\n// loader mounts controls cross-library with it. VENDORS maps each vendored\n// bundle namespace to the library whose _ASSETS serves it (same parseable-\n// marker contract as MODMAP); the loader rewrites vendor imports through\n// __benchPlatform.assetRoots.\n\n// MODMAP-BEGIN\nconst MODMAP = {\n  \"nb\":          {\"lib\": \"app\", \"path\": \"assets/nb.js\",          \"facet\": \"js\",  \"deps\": {}},\n  \"store\":       {\"lib\": \"app\", \"path\": \"assets/store.js\",       \"facet\": \"js\",  \"deps\": {\"./nb.js\": \"nb\"}},\n  \"facets\":      {\"lib\": \"dev\", \"path\": \"assets/facets.js\",      \"facet\": \"js\",  \"deps\": {}},\n  \"chatctx\":     {\"lib\": \"dev\", \"path\": \"assets/chatctx.js\",     \"facet\": \"js\",  \"deps\": {}},\n  \"agentloop\":   {\"lib\": \"agent\", \"path\": \"assets/agentloop.js\",   \"facet\": \"js\",  \"deps\": {\"./store.js\": \"store\"}, \"optional\": true},\n  \"agentprompt\": {\"lib\": \"agent\", \"path\": \"assets/agentprompt.js\", \"facet\": \"js\",  \"deps\": {}, \"optional\": true},\n  \"webgl\":       {\"lib\": \"app\", \"path\": \"assets/webgl.js\",       \"facet\": \"js\",  \"deps\": {}},\n  \"flowdoc\":     {\"lib\": \"dev\", \"path\": \"assets/flowdoc.js\",     \"facet\": \"js\",  \"deps\": {}},\n  \"flowprims\":   {\"lib\": \"dev\", \"path\": \"assets/flowprims.js\",   \"facet\": \"js\",  \"deps\": {}},\n  \"flowproject\": {\"lib\": \"dev\", \"path\": \"assets/flowproject.js\", \"facet\": \"js\",  \"deps\": {}},\n  \"flowlayout\":  {\"lib\": \"dev\", \"path\": \"assets/flowlayout.js\",  \"facet\": \"js\",  \"deps\": {}},\n  \"sceneexpr\":   {\"lib\": \"app\", \"path\": \"assets/sceneexpr.js\",   \"facet\": \"js\",  \"deps\": {}},\n  \"scenetokens\": {\"lib\": \"app\", \"path\": \"assets/scenetokens.js\", \"facet\": \"js\",  \"deps\": {}},\n  \"scenedoc\":    {\"lib\": \"app\", \"path\": \"assets/scenedoc.js\",    \"facet\": \"js\",  \"deps\": {\"./sceneexpr.js\": \"sceneexpr\", \"./scenetokens.js\": \"scenetokens\"}},\n  \"sceneproject\":{\"lib\": \"app\", \"path\": \"assets/sceneproject.js\",\"facet\": \"js\",  \"deps\": {\"./scenedoc.js\": \"scenedoc\", \"./scenetokens.js\": \"scenetokens\"}},\n  \"scenerun\":    {\"lib\": \"app\", \"path\": \"assets/scenerun.js\",    \"facet\": \"js\",  \"deps\": {\"./sceneexpr.js\": \"sceneexpr\", \"./scenedoc.js\": \"scenedoc\", \"./sceneproject.js\": \"sceneproject\"}},\n  \"forcelayout\": {\"lib\": \"app\", \"path\": \"assets/forcelayout.js\", \"facet\": \"js\",  \"deps\": {}},\n  \"loader\":      {\"lib\": \"app\", \"path\": \"assets/loader.js\",      \"facet\": \"js\",  \"deps\": {\"./store.js\": \"store\"}},\n  \"tokens\":      {\"lib\": \"app\", \"path\": \"assets/tokens.css\",     \"facet\": \"css\", \"deps\": {}}\n};\n// MODMAP-END\n\n// VENDORS-BEGIN\nconst VENDORS = {\"vendor/nb_three\": \"app\", \"vendor/nb_codemirror\": \"dev\"};\n// VENDORS-END\n\n(async () => {\n  const host = document.querySelector(\".nb-bench-boot\") || document.body;\n  const fail = (msg) => {\n    host.innerHTML = \"\";\n    const p = document.createElement(\"p\");\n    p.className = \"nb-boot-err\";\n    p.textContent = \"development failed to boot: \" + msg +\n      \"\\n\\nIf this is a session problem, sign in via the instance's own UI \" +\n      \"(the sessionid cookie) and reload. If modules are missing, rerun \" +\n      \"tools/install-bench.py against this instance.\";\n    host.appendChild(p);\n  };\n  try {\n    // The shell's body carries {\"lib\",\"id\"} — this boot control's own\n    // library. Module controls live wherever MODMAP says.\n    let lib = \"dev\";\n    try {\n      const dc = JSON.parse(document.body.dataset.control);\n      if (dc && dc.lib) lib = dc.lib;\n    } catch (e) { /* not the published shell — keep the default */ }\n\n    const read = async (l, id) => {\n      const r = await fetch(\"/app/read?lib=\" + encodeURIComponent(l) +\n                            \"&id=\" + encodeURIComponent(id));\n      const j = await r.json();\n      if (j.status !== \"ok\") throw new Error(j.msg || \"app/read failed\");\n      return j;\n    };\n\n    // One controls-index read per library MODMAP names (plus this one);\n    // the union directory maps every control name to its home {lib, id}.\n    // First library wins on a name — the walk keeps names collision-free.\n    const libs = [];\n    for (const n of Object.keys(MODMAP)) {\n      const l = MODMAP[n].lib || lib;\n      if (!libs.includes(l)) libs.push(l);\n    }\n    if (!libs.includes(lib)) libs.push(lib);\n    const dir = {};\n    await Promise.all(libs.map(async (l) => {\n      const idx = await read(l, \"controls\");\n      const local = {};\n      for (const c of (idx.data.list || [])) local[c.name] = c.id;\n      dir[l] = local;\n    }));\n    const controls = {};\n    for (const l of libs) {\n      for (const name of Object.keys(dir[l])) {\n        if (!controls[name]) controls[name] = { lib: l, id: dir[l][name] };\n      }\n    }\n\n    const srcs = {};\n    const skipped = new Set();\n    await Promise.all(Object.keys(MODMAP).map(async (name) => {\n      const l = MODMAP[name].lib || lib;\n      const id = (dir[l] || {})[name];\n      if (!id) {\n        // the agent lib is an add-on: its modules are optional and simply\n        // absent from the graph when not installed (the notebook seam)\n        if (MODMAP[name].optional) { skipped.add(name); return; }\n        throw new Error(\"module control '\" + name + \"' is missing from '\" +\n                        l + \"'\");\n      }\n      const rec = await read(l, id);\n      srcs[name] = rec.data[MODMAP[name].facet] || \"\";\n    }));\n\n    // tokens: the css facet plays the role of the static <link>.\n    const style = document.createElement(\"style\");\n    style.dataset.module = \"tokens\";\n    style.textContent = srcs.tokens || \"\";\n    document.head.appendChild(style);\n\n    // Build the module graph dependency-first; every import of a sibling\n    // module is rewritten to that sibling's blob URL, so module identity\n    // is shared by URL string. Blob URLs are never revoked — they ARE the\n    // module world for the life of the page.\n    const urls = {};   // module control name -> blob url\n    const paths = {};  // repo path -> blob url (the loader rewrites with this)\n    const pending = Object.keys(MODMAP).filter((n) =>\n      MODMAP[n].facet === \"js\" && !skipped.has(n));\n    while (pending.length) {\n      const name = pending.find((n) =>\n        Object.values(MODMAP[n].deps).every((d) => urls[d]));\n      if (!name) throw new Error(\"dependency cycle in MODMAP\");\n      pending.splice(pending.indexOf(name), 1);\n      let src = srcs[name];\n      for (const spec of Object.keys(MODMAP[name].deps)) {\n        src = src.split('\"' + spec + '\"')\n                 .join('\"' + urls[MODMAP[name].deps[spec]] + '\"');\n      }\n      urls[name] = URL.createObjectURL(\n        new Blob([src], { type: \"text/javascript\" }));\n      paths[MODMAP[name].path] = urls[name];\n    }\n\n    const assetRoots = {};\n    for (const prefix of Object.keys(VENDORS)) {\n      assetRoots[prefix] = \"/app/asset/\" + VENDORS[prefix] + \"/\";\n    }\n    globalThis.__benchPlatform =\n      { lib: lib, moduleUrls: paths, controls: controls, assetRoots: assetRoots };\n    const loader = await import(urls.loader);\n    host.innerHTML = \"\";\n    await loader.mountControl(\"frame\", host);\n  } catch (e) {\n    fail(e && e.message ? e.message : String(e));\n  }\n})();\n","old":"var me = this;\nvar ME = $('#'+me.UUID)[0];\nme.uiReady = function(ui){\n  me.ui = ui;\n  ui.initPopups(ME);\n  $(ME).find('.wrap').css('display', 'block');\n\n  // --- Dark Mode Logic ---\n  const darkModePref = localStorage.getItem('darkMode');\n  const toggle = $(ME).find('#dark-mode-switch-dev');\n\n  if (darkModePre