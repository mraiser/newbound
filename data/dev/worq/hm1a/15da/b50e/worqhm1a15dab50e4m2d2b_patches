ost\");","old":"  function init() {\n    const hostEl = $(\".fe-host\");","patch_id":"p31","time":1792595891108},{"author":"executive","facet":"js","label":"P4: save moves the diff baseline + refreshes the journal","new":"    if (r && r.status === \"ok\") { baseHash = r.hash || baseHash; dirty = false; pendingLabels = []; savedBody = JSON.stringify(body); status(`saved · ${r.patch_id || \"ok\"}`, \"ok\"); pushJournal(\"saved\"); gate(\".fe-g-save\", true, \"write_flow_body ok\"); renderChanges(); refreshJournal(); }","old":"    if (r && r.status === \"ok\") { baseHash = r.hash || baseHash; dirty = false; pendingLabels = []; status(`saved · ${r.patch_id || \"ok\"}`, \"ok\"); pushJournal(\"saved\"); gate(\".fe-g-save\", true, \"write_flow_body ok\"); }","patch_id":"p32","time":1792595902108},{"author":"executive","facet":"js","label":"P4: load-theirs rides loadBody (baseline moves)","new":"      if (r && r.status === \"ok\" && r.exists) {\n        loadBody(r.body, r.hash || \"\");\n        el.hidden = true; status(\"loaded theirs — your edits discarded\", \"bad\"); refreshJournal();\n      }","old":"      if (r && r.status === \"ok\" && r.exists) {\n        doc = parseFlow(r.body); baseHash = r.hash || \"\";\n        focusPath = [{ root: doc.root, title: \"case 1\" }]; activeDeck = 0;\n        undoStack = []; redoStack = []; pendingLabels = []; dirty = false;\n        el.hidden = true; renderAll(); refreshSaveUi(); status(\"loaded theirs — your edits discarded\", \"bad\");\n      }","patch_id":"p33","time":1792595902112},{"author":"executive","facet":"js","label":"P4: keep-mine moves the baseline + refreshes the journal","new":"      if (w && w.status === \"ok\") { baseHash = w.hash || baseHash; dirty = false; pendingLabels = []; savedBody = JSON.stringify(body); status(\"saved mine over theirs\", \"ok\"); pushJournal(\"saved (overwrite)\"); renderChanges(); refreshJournal(); }","old":"      if (w && w.status === \"ok\") { baseHash = w.hash || baseHash; dirty = false;