ve","facet":"js","label":"wire select/delete: reconcile selection by reference after mutations","new":"  function afterMutation() { reconcileFocus(); reconcileSelWire(); cancelWireGhost(); renderAll(); refreshSaveUi(); renderChanges(); refreshInspector(); }\n  // a mutation can re-index cons (removeWire/removeOp/undo): follow the\n  // selected wire OBJECT to its new index, or drop the selection if it is gone\n  function reconcileSelWire() {\n    if (selWire == null) return;\n    const c = focusedCase();\n    const i = c && selWireRef ? c.cons.indexOf(selWireRef) : -1;\n    if (i >= 0) selWire = i; else { selWire = null; selWireRef = null; }\n  }","old":"  function afterMutation() { reconcileFocus(); cancelWireGhost(); renderAll(); refreshSaveUi(); renderChanges(); refreshInspector(); }","patch_id":"p130","time":1792697587602},{"author":"executive","facet":"js","label":"wire select/delete: facade wires keep tap affordance + selected-wire highlight","new":"    const selTok = String(tokens(\"--f-3d\") || \"\").trim();\n    const selColor = /^#[0-9a-f]{3,8}$/i.test(selTok) ? selTok : \"#62bd8c\";   // = the op halo's colour\n    const specs = sceneDoc.nodes.map((n) => {\n      const s = { ...n, id: \"fx_\" + n.id };\n      if (n.parent !== undefined) s.parent = \"fx_\" + n.parent;\n      if (n.kind === \"link\") { s.from = \"fx_\" + n.from; s.to = \"fx_\" + n.to; }\n      delete s.affordances;                 // facade is scenery; instances are picked —\n      // EXCEPT wires: a wire is no instance, so its facade link stays tappable\n      // (the host forwards the tap to onSceneTap → selectWire), and the\n      // selected wire draws in the selection colour, thicker\n      if (n.kind === \"link\" && n.meta && n.meta.role === \"wire\") {\n        s.affordances = { tap: true, hover: true };\n        if (selWire != null && n.meta.index === selWire) {\n          s.material = { ...(n.material || {}), color: selColor };\n          s.r = (n.r || 0.035) * 1.8;\n          s.meta = { ...n.meta, selected: true };\n        }\n      }","old":"    const specs = sceneDoc.nodes.map((n) => {\n      const s = { ...n, id: \"fx_\" + n.id };\n      if (n.parent !== undefined) s.parent = \"fx_\" + n.parent;\n      if (n.kind === \"link\") { s.from = \"fx_\" + n.from; s.to = \"fx_\" + n.to; }\n      delete s.affordances;                 // facade is scenery; instances are picked","patch_id":"p131","time":1792697595445},{"author":"executive","facet":"js","label":"wire select/delete: selectWire + onSceneTap (facade wire taps)","new":"  // ── select: a tap on a facade wire (host.state.onSceneTap) ───────────────\n  // The facade wire's spec carries meta {role:\"wire\", index}; the id is the\n  // fallback (fx_ + slug(`d<deck>/wire/<i>`)) — the headless null stage keeps\n  // no objects, and the id math is the same slug the facade is built with.\n  function wireIndexOfSpec(specId) {\n    if (!specId) return null;\n    const o = stage && stage.objects && stage.objects.get ? stage.objects.get(specId) : null;\n    const m = o && o.spec && o.spec.meta;\n    if (m && m.role === \"wire\" && typeof m.index === \"number\") return m.index;\n    const r = /^fx_d(\\d+)_wire_(\\d+)$/.exec(String(specId));\n    return r && +r[1] === activeDeck ? +r[2] : null;\n  }\n  // select wire i of the focused case (null/absent clears). ONE selection:\n  // a wire selection clears the op selection (and renderInspector drops the\n  // wire when an op is selected after it).\n  function selectWire(i) {\n    const c = focusedCase();\n    if (i == null || !c || !c.cons[i]) {\n      const had = selWire != null;\n      selWire = null; selWireRef = null;\n      if (had) renderFacade();\n      refreshInspector();\n      return null;\n    }\n    selWire = i; selWireRef = c.cons[i];\n    if (hostApi && hostApi.state && hostApi.state.selectedKey) hostApi.setState(\"selectedKey\", null);\n    renderFacade(); renderInspector(null);\n    const w = c.cons[i];\n    status(`wire ${nameOf(c, w.src[0])}.${w.src[1]} → ${nameOf(c, w.dest[0])}.${w.dest[1]} selected — Del unwires`, \"ok\");\n    return i;\n  }\n  function onSceneTap(specId) {\n    if (armSrc || wireMode) return;            // mid wiring gesture: not a selection\n    const wi = wireIndexOfSpec(specId);\n    if (wi != null) { selectWire(wi); return; }\n    if (specId == null && selWire != null) selectWire(null);   // background tap drops it\n  }\n\n  // ── delete: Del unwires the selected wire (frees its input, I-1) ─────────\n  function deleteSelectedWire() {\n    const c = focusedCase(); if (!c) return;\n    if (selWire == null) return status(\"select a wire first (click it)\", \"bad\");\n    const cmd = doc.removeWire(c, selWire);\n    selWire = null; selWireRef = null;","old":"  // ── delete: Del unwires the selected wire (frees its input, I-1) ─────────\n  function deleteSelectedWire() {\n    const c = focusedCase(); if (!c) return;\n    if (selWire == null) return status(\"select a wire first (click it)\", \"bad\");\n    const cmd = doc.removeWire(c, selWire);\n    selWire = null;","patch_id":"p132","time":1792697606310},{"author":"executive","facet":"js","label":"wire select/delete: keep selection on a refused unwire","new":"    const cmd = doc.removeWire(c, selWire);\n    if (cmd.error) return status(cmd.error, \"bad\");\n    // a committed unwire: afterMutation's reconcileSelWire drops the selection\n    // (its wire is gone); a refused one (read-only / mid-run) keeps it\n    if (!commitApplied(cmd)) return;\n    selWire = null; selWireRef = null;","old":"    const cmd = doc.removeWire(c, selWire);\n    selWire = null; selWireRef = null;\n    if (cmd.error) return status(cmd.error, \"bad\");\n    if (!commitApplied(cmd)) return;","patch_id":"p133","time":1792697620245},{"author":"executive","facet":"js","label":"wire select/delete: inspector exclusivity + unwire button","new":"    const body = $(\".fe-inspect-body\"); if (!body) return;\n    // ONE selection: selecting a wire clears selectedKey, so a key alongside\n    // a wire means an op was selected AFTER it — the op wins\n    if (selWire != null && key) { selWire = null; selWireRef = null; renderFacade(); }\n    if (selWire != null) {\n      const c = focusedCase(); const w = c && c.cons[selWire];\n      if (!w) { selWire = null; selWireRef = null; body.innerHTML = \"\"; return; }\n      body.innerHTML = `<p class=\"fe-ed-head\"><b>wire</b> ${esc(nameOf(c, w.src[0]))}.${esc(w.src[1])} → ${esc(nameOf(c, w.dest[0]))}.${esc(w.dest[1])}</p>` +\n        `<p class=\"fe-empty\"><kbd>Del</kbd> unwires · click a palette op to <b>splice</b> it into this wire</p>`;\n      const btns = edBtns(body);\n      edButton(btns, \"unwire\", \"fe-del fe-unwire danger\", deleteSelectedWire);\n      return;\n    }","old":"    const body = $(\".fe-inspect-body\"); if (!body) return;\n    if (selWire != null) {\n      const c = focusedCase(); const w = c.cons[selWire];\n      body.innerHTML = w ? `<p><b>wire</b> ${nameOf(c, w.src[0])}.${w.src[1]} → ${nameOf(c, w.dest[0])}.${w.dest[1]}</p>` +\n        `<p class=\"fe-empty\"><kbd>Del</kbd> unwires · click a palette op to <b>splice</b> it into this wire</p>` : \"\";\n      return;\n    }","patch_id":"p134","time":1792697628705},{"author":"executive","facet":"js","label":"wire select/delete: register host.state.onSceneTap","new":"      hostApi.setState(\"onPortTap\", onPortTap);\n      // taps no flownode claims (facade wires; null = background) → wire selection\n      hostApi.setState(\"onSceneTap\", onSceneTap);","old":"      hostApi.setState(\"onPortTap\", onPortTap);","patch_id":"p135","time":1792697636818},{"author":"executive","facet":"js","label":"wire select/delete: api surface (selectWire, selectedWire, sceneTap, deleteSelectedWire)","new":"        selectWire, selectedWire: () => selWire, sceneTap: onSceneTap, deleteSelectedWire,","old":"        selectWire: (i) => { selWire = i; renderInspector(null); },","patch_id":"p136","time":1792697636822},{"author":"executive","facet":"js","label":"wire select/delete: highlight in the bench accent (matches the op halo)","new":"    // selection = the bench accent, read exactly as flownode's halo reads it\n    const selTok = getComputedStyle(document.documentElement).getPropertyValue(\"--accent\").trim();\n    const selColor = /^#[0-9a-f]{3,8}$/i.test(selTok) ? selTok : \"#f0a63c\";","old":"    const selTok = String(tokens(\"--f-3d\") || \"\").trim();\n    const selColor = /^#[0-9a-f]{3,8}$/i.test(selTok) ? selTok : \"#62bd8c\";   // = the op halo's colour","patch_id":"p137","time":1792697707310},{"author":"executive","facet":"js","label":"wire select/delete: clearSelection drops the wire highlight too","new":"  function clearSelection() { if (hostApi) hostApi.setState(\"selectedKey\", null); const had = selWire != null; selWire = null; selWireRef = null; if (had) renderFacade(); renderInspector(null); }","old":"  function clearSelection() { if (hostApi) hostApi.setState(\"selectedKey\", null); selWire = null; renderInspector(null); }","patch_id":"p138","time":1792698143738},{"author":"executive","facet":"js","label":"wire select/delete: selectOp drops the wire highlight","new":"    if (selWire != null) { selWire = null; selWireRef = null; renderFacade(); }\n    hostApi.setState(\"selectedKey\", `d${activeDeck}_op${i}`);","old":"    selWire = null; hostApi.setState(\"selectedKey\", `d${activeDeck}_op${i}`);","patch_id":"p139","time":1792698143741},{"author":"executive","facet":"js","label":"wire select/delete: background tap drops the wire selection","new":"      hostEl.addEventListener(\"click\", () => renderInspector(hostApi.state.selectedKey));\n      // a BACKGROUND tap drops a wire selection. The GL stage emits no tap for\n      // empty space (a press there is an orbit gesture), so the editor reads\n      // it here: a click inside the canvas box that did not travel (not an\n      // orbit/pan) and that the stage's own pick finds nothing under.\n      let bgDown = null;\n      hostEl.addEventListener(\"pointerdown\", (e) => { bgDown = { x: e.clientX, y: e.clientY }; });\n      hostEl.addEventListener(\"click\", (e) => {\n        const d = bgDown; bgDown = null;\n        if (selWire == null || !d || !stage || !stage.pickAt || !stage.canvas) return;\n        const box = stage.canvas.parentElement;\n        if (!box || !box.contains(e.target)) return;\n        if (Math.hypot(e.clientX - d.x, e.clientY - d.y) > 4) return;\n        if (stage.pickAt(e.clientX, e.clientY) == null) onSceneTap(null);\n      });","old":"      hostEl.addEventListener(\"click\", () => renderInspector(hostApi.state.selectedKey));","patch_id":"p140","time":1792698150864},{"author":"executive","facet":"js","label":"wire select/delete: decide 'background' at pointerdown (race-free vs the facade rebuild)","new":"      // a BACKGROUND tap drops a wire selection. The GL stage emits no tap for\n      // empty space (a press there is an orbit gesture), so the editor reads\n      // it here: a press inside the canvas box over NOTHING pickable, released\n      // without travelling (not an orbit/pan). \"Nothing\" is judged at\n      // pointerdown — the stage's own orbit-vs-node moment — never at click:\n      // by then a tap may have rebuilt the facade (selectWire → setScene), and\n      // a rebuilt wire has no tube until the next frame re-resolves its ends.\n      let bgDown = null;\n      hostEl.addEventListener(\"pointerdown\", (e) => {\n        bgDown = null;\n        if (!stage || !stage.pickAt || !stage.canvas) return;\n        const box = stage.canvas.parentElement;\n        if (!box || !box.contains(e.target)) return;\n        if (stage.pickAt(e.clientX, e.clientY) == null) bgDown = { x: e.clientX, y: e.clientY };\n      });\n      hostEl.addEventListener(\"click\", (e) => {\n        const d = bgDown; bgDown = null;\n        if (!d || selWire == null) return;\n        if (Math.hypot(e.clientX - d.x, e.clientY - d.y) > 4) return;\n        onSceneTap(null);\n      });","old":"      // a BACKGROUND tap drops a wire selection. The GL stage emits no tap for\n      // empty space (a press there is an orbit gesture), so the editor reads\n      // it here: a click inside the canvas box that did not travel (not an\n      // orbit/pan) and that the stage's own pick finds nothing under.\n      let bgDown = null;\n      hostEl.addEventListener(\"pointerdown\", (e) => { bgDown = { x: e.clientX, y: e.clientY }; });\n      hostEl.addEventListener(\"click\", (e) => {\n        const d = bgDown; bgDown = null;\n        if (selWire == null || !d || !stage || !stage.pickAt || !stage.canvas) return;\n        const box = stage.canvas.parentElement;\n        if (!box || !box.contains(e.target)) return;\n        if (Math.hypot(e.clientX - d.x, e.clientY - d.y) > 4) return;\n        if (stage.pickAt(e.clientX, e.clientY) == null) onSceneTap(null);\n      });","patch_id":"p141","time":1792698194230},{"author":"executive","facet":"js","label":"Del deletes the selected op (deleteSelection routes op XOR wire)","new":"    selWire = null; selWireRef = null;\n    status(\"unwired — ⌘Z undoes\", \"ok\");\n  }\n  // Del/Backspace deletes THE selection. There is one selection at a time\n  // (op XOR wire), so the key routes to whichever is held: a selected wire\n  // unwires; a selected op is removed with every wire touching it\n  // (deleteSelectedOp → FlowDoc.removeOp, one undoable mutation).\n  function deleteSelection() {\n    if (armSrc || wireMode) return status(\"finish or Esc the wiring first\", \"bad\");\n    if (selWire != null) return deleteSelectedWire();\n    if (selectedOpIndex() != null) return deleteSelectedOp();\n    status(\"select an op or a wire first (click it)\", \"bad\");\n  }\n","old":"    selWire = null; selWireRef = null;\n    status(\"unwired — ⌘Z undoes\", \"ok\");\n  }\n","patch_id":"p142","time":1792698952181},{"author":"executive","facet":"js","label":"Del/Backspace key → deleteSelection","new":"        else if (e.key === \"Delete\" || e.key === \"Backspace\") { e.preventDefault(); deleteSelection(); }","old":"        else if (e.key === \"Delete\" || e.key === \"Backspace\") { e.preventDefault(); deleteSelectedWire(); }","patch_id":"p143","time":1792698955757},{"author":"executive","facet":"js","label":"deleteSelectedOp: deck-aware via selectedOpIndex","new":"  function deleteSelectedOp() {\n    // selectedOpIndex is deck-aware: a selection key from another deck\n    // (d<k>_op<i>, k ≠ activeDeck) must never delete op i of the focused case\n    const c = focusedCase(); const i = selectedOpIndex();\n    if (i == null || !c) return;\n    const op = c.cmds[i]; if (!op) return;","old":"  function deleteSelectedOp() {\n    const key = hostApi.state && hostApi.state.selectedKey;\n    const m = key && /^d(\\d+)_op(\\d+)$/.exec(key);\n    const c = focusedCase(); if (!m || !c) return;\n    const i = +m[2]; const op = c.cmds[i]; if (!op) return;","patch_id":"p144","time":1792698960860},{"author":"executive","facet":"js","label":"op inspector hint: Del deletes","new":"    edNote(body, op.type === \"local\" ? \"dblclick to drill in · Del deletes\" : \"W wires from its first output · drag body moves · Enter edits · Del deletes\");","old":"    edNote(body, op.type === \"local\" ? \"dblclick to drill in\" : \"W wires from its first output · drag body moves · Enter edits\");","patch_id":"p145","time":1792698965932},{"author":"executive","facet":"js","label":"expose deleteSelection on the api","new":"sceneTap: onSceneTap, deleteSelectedWire, deleteSelection,","old":"sceneTap: onSceneTap, deleteSelectedWire,","patch_id":"p146","time":1792698972633},{"author":"executive","facet":"js","label":"header doc: Del deletes op or wire","new":"//   delete     — Del/Backspace deletes THE selection: a selected wire unwires\n//                (FlowDoc.removeWire — frees its input, I-1); a selected op is\n//                removed with its wires (FlowDoc.removeOp). The inspector's\n//                \"unwire\" / \"delete op\" buttons do the same.","old":"//   delete     — Del/Backspace or the inspector's \"unwire\" button removes the\n//                selected wire (FlowDoc.removeWire — frees its input, I-1).","patch_id":"p147","time":1792698972636},{"author":"executive","facet":"js","label":"op body tap → onOpSelect → selectOp (status names Del), parity with wire selection","new":"    hostApi.setState(\"selectedKey\", `d${activeDeck}_op${i}`);\n    refreshInspector();\n    const op = c.cmds[i];\n    status(`op ${op.name || op.type} selected — Del deletes it (and its wires)`, \"ok\");\n    return i;\n  }\n  // a tap on an op BODY: flownode.click hands it here via host.state.onOpSelect\n  // — the op twin of onSceneTap's wire pick, so op selection takes the SAME\n  // path as wire selection (one selection, op XOR wire; inspector + status\n  // follow; Del then deletes it). Mid wiring gesture the tap only moves the\n  // emphasis, as before; a key from another deck never selects op i here.\n  function onOpSelect(p) {\n    const key = p && p.key; if (!key || !hostApi) return null;\n    const m = /^d(\\d+)_op(\\d+)$/.exec(key);\n    if (armSrc || wireMode || !m || +m[1] !== activeDeck) { hostApi.setState(\"selectedKey\", key); return null; }\n    return selectOp(+m[2]);\n  }\n  function walkOps(dir) {","old":"    hostApi.setState(\"selectedKey\", `d${activeDeck}_op${i}`);\n    refreshInspector();\n    return i;\n  }\n  function walkOps(dir) {","patch_id":"p148","time":1792699539480},{"author":"executive","facet":"js","label":"register host.state.onOpSelect hook","new":"      hostApi.setState(\"onSceneTap\", onSceneTap);\n      // taps on an op BODY (flownode.click) → op selection, the same path as wires\n      hostApi.setState(\"onOpSelect\", onOpSelect);\n","old":"      hostApi.setState(\"onSceneTap\", onSceneTap);\n","patch_id":"p149","time":1792699547048},{"author":"executive","facet":"js","label":"expose opSelect on the editor api + header doc","new":"sceneTap: onSceneTap, opSelect: onOpSelect, deleteSelectedWire,","old":"sceneTap: onSceneTap, deleteSelectedWire,","patch_id":"p150","time":1792699550441},{"author":"executive","facet":"js","label":"header doc: op selection path","new":"//                the wire highlights; one selection at a time (op XOR wire).\n//                Tap an OP body: flownode.click → host.state.onOpSelect →\n//                selectOp (halo + inspector + \"Del deletes\" status) — the\n//                same path, so an op is selected exactly like a wire.\n","old":"//                the wire highlights; one selection at a time (op XOR wire).\n","patch_id":"p151","time":1792699554446},{"author":"agent","facet":"js","label":"doc: wiring is a drag from an input to an output","new":"//   wire drag  — press an INPUT socket, drag to an OUTPUT (an op's out socket\n//                or a params-bar terminal), release: the wire commits. The\n//                ghost is a REAL hang link from the pointer into the input;\n//                over a legal output it snaps there and the status previews\n//                the wire (I-1/I-2 via canWire). Socket drags dispatch\n//                flownode.drag → host.state.onOpDrag → onSocketDrag. A plain\n//                socket TAP wires nothing (onPortTap just says how).\n","old":"//   port tap   — tap an output socket to arm a wire; tap a legal input to\n//                commit. Taps dispatch to flownode.click → host.state.onPortTap.\n//   drag ghost — dragging from an output socket rides a REAL hang link whose\n//                tip tracks the pointer; legal input targets preview (I-1/I-2).\n","patch_id":"p152","time":1792707872066},{"author":"agent","facet":"js","label":"armSrc now holds the dragged input","new":"  let armSrc = null;              // pointer wiring: the INPUT being dragged { idx, term, key }","old":"  let armSrc = null;              // pointer wiring: the armed output { idx, term, key }","patch_id":"p153","time":1792707875715},{"author":"agent","facet":"js","label":"wiring: drag input → output replaces tap-output/tap-input","new":"  // ── wiring: DRAG from an input socket to an output terminal ──────────────\n  // The pointer wiring gesture: press an op's input socket, drag, release over\n  // an output — an op's out socket or a params-bar terminal. Socket drags\n  // route here from flownode.drag (host.state.onOpDrag → onSocketDrag).\n  // armSrc holds the input being dragged; the ghost hangs from the pointer\n  // into it, snapping onto a legal output under the pointer while the status\n  // previews the wire (I-1/I-2 via canWire). Release over a legal output\n  // commits ONE doc.addWire (⌘Z undoes); anywhere else cancels; Esc cancels\n  // mid-drag. A plain TAP on a socket wires nothing — it says how.\n  function onPortTap(p) {\n    const m = p && /^(in|out)(\\d+)$/.exec(p.node || \"\"); if (!m) return;\n    status(m[1] === \"in\" ? \"drag from this input to an output to wire it\"\n      : \"drag from an input to this output to wire it\", \"ok\");\n  }\n\n  // the drag's point on its plane (world); the front-ortho fallback otherwise\n  function dragPoint(evt) {\n    if (evt && typeof evt.x === \"number\" && typeof evt.y === \"number\") return { x: evt.x, y: evt.y, z: typeof evt.z === \"number\" ? evt.z : 0 };\n    return evt && typeof evt.clientX === \"number\" ? clientToWorld(evt) : null;\n  }\n\n  // the output terminal under the pointer: the out socket the stage picks\n  // there (a hosted op on the active deck), else the nearest output terminal\n  // — op outs and params-bar terminals (bars are facade scenery, never\n  // picked) — within DROP_PX on screen (DROP_WORLD units when headless).\n  const DROP_PX = 24, DROP_WORLD = 0.3;\n  function outTerminalAt(c, evt) {\n    if (!c || !evt) return null;\n    const hasClient = typeof evt.clientX === \"number\" && typeof evt.clientY === \"number\";\n    if (hasClient && stage && stage.pickAt) {\n      const m = /^d(\\d+)_op(\\d+):out(\\d+)$/.exec(String(stage.pickAt(evt.clientX, evt.clientY) || \"\"));\n      if (m && +m[1] === activeDeck) {\n        const op = c.cmds[+m[2]]; const term = op && Object.keys(op.out || {})[+m[3]];\n        if (term !== undefined) return { idx: +m[2], term };\n      }\n    }\n    const cands = [];\n    c.cmds.forEach((op, i) => Object.keys((op && op.out) || {}).forEach((term) => cands.push({ idx: i, term })));\n    Object.keys(c.input || {}).forEach((term) => cands.push({ idx: -1, term }));\n    const screen = hasClient && stage && stage.anchor && stage.canvas;\n    const r = screen ? stage.canvas.getBoundingClientRect() : null;\n    const pt = screen ? null : dragPoint(evt);\n    let best = null, bd = Infinity;\n    for (const t of cands) {\n      const w = terminalWorld(c, t.idx, \"out\", t.term); if (!w) continue;\n      let d;\n      if (screen) { const a = stage.anchor(w); if (!a.visible) continue; d = Math.hypot(a.x - (evt.clientX - r.left), a.y - (evt.clientY - r.top)) / DROP_PX; }\n      else if (pt) d = Math.hypot(w.x - pt.x, w.y - pt.y) / DROP_WORLD;\n      else continue;\n      if (d < bd) { bd = d; best = t; }\n    }\n    return bd <= 1 ? best : null;\n  }\n\n  function onSocketDrag(p) {\n    const c = focusedCase(); if (!c || !p) return;\n    const evt = p.evt || {};\n    if (p.phase === \"start\") {\n      if (p.which !== \"in\" || running) return;      // only an INPUT starts a wire\n      const op = c.cmds[p.opIndex]; const term = op && Object.keys(op.in || {})[p.ord];\n      if (term === undefined) return;\n      if (c.cons.some((w) => w.dest[0] === p.opIndex && w.dest[1] === term)) {\n        status(`✗ ${nameOf(c, p.opIndex)}.${term} is already wired (I-1) — select its wire and Del first`, \"bad\");\n        return;\n      }\n      if (wireMode) cancelWireGhost();\n      armSrc = { idx: p.opIndex, term, key: p.key }; selWire = null;\n      hostApi.setState(\"wireSrc\", armSrc);\n      showGhost(dragPoint(evt) || terminalWorld(c, p.opIndex, \"in\", term));\n      status(`wiring ${nameOf(c, p.opIndex)}.${term} — drag to an output and release (Esc cancels)`, \"ok\");\n      return;\n    }\n    if (!armSrc || p.key !== armSrc.key) return;    // not our gesture (or Esc'd)\n    const dest = [armSrc.idx, armSrc.term];\n    const label = `${nameOf(c, dest[0])}.${dest[1]}`;\n    const tgt = outTerminalAt(c, evt);\n    const chk = tgt ? doc.canWire(c, [tgt.idx, tgt.term], dest) : null;\n    if (p.phase === \"move\") {\n      moveGhost((chk && chk.ok && terminalWorld(c, tgt.idx, \"out\", tgt.term)) || dragPoint(evt) || ghostTip);\n      if (!tgt) status(`wiring ${label} — drag to an output and release (Esc cancels)`, \"ok\");\n      else if (chk.ok) status(`release to wire ${nameOf(c, tgt.idx)}.${tgt.term} → ${label}`, \"ok\");\n      else status(\"✗ \" + chk.reason, \"bad\");\n      return;\n    }\n    if (p.phase !== \"end\") return;\n    cancelWireGhost();\n    if (!tgt) return status(\"wiring cancelled — release over an output to wire\");\n    if (!chk.ok) { status(\"✗ \" + chk.reason, \"bad\"); gate(\".fe-g-i1i2\", true, chk.reason); return; }\n    const cmd = doc.addWire(c, { src: [tgt.idx, tgt.term], dest });\n    if (cmd.error) return status(\"wire refused: \" + cmd.error, \"bad\");\n    if (!commitApplied(cmd)) return;\n    status(`wired ${nameOf(c, tgt.idx)}.${tgt.term} → ${label} — ⌘Z undoes`, \"ok\");\n    gate(\".fe-g-wiretap\", true, \"drag wire committed\");\n  }","old":"  // ── wiring: port tap → arm / commit ───────────────────────────────────────\n  // A tap on an outN socket arms wiring from that terminal; a tap on a legal\n  // inN socket commits via doc.addWire. Taps route here from flownode.click.\n  function onPortTap(p) {\n    const c = focusedCase(); if (!c) return;\n    const m = /^(in|out)(\\d+)$/.exec(p.node); if (!m) return;\n    const which = m[1], k = +m[2];\n    const op = c.cmds[p.opIndex]; if (!op) return;\n    const terms = which === \"in\" ? Object.keys(op.in || {}) : Object.keys(op.out || {});\n    const term = terms[k]; if (term === undefined) return;\n\n    if (which === \"out\") { armWire({ idx: p.opIndex, term, key: p.key }); return; }\n    // an INPUT tap: commit the armed wire if legal (I-1/I-2 via canWire)\n    if (armSrc) {\n      const from = { idx: armSrc.idx, term: armSrc.term };   // capture: commitApplied nulls armSrc\n      const chk = doc.canWire(c, [from.idx, from.term], [p.opIndex, term]);\n      if (!chk.ok) { status(\"✗ \" + chk.reason, \"bad\"); gate(\".fe-g-i1i2\", true, chk.reason); return; }\n      const cmd = doc.addWire(c, { src: [from.idx, from.term], dest: [p.opIndex, term] });\n      if (cmd.error) return status(\"wire refused: \" + cmd.error, \"bad\");\n      if (!commitApplied(cmd)) return;\n      status(`wired ${nameOf(c, from.idx)}.${from.term} → ${nameOf(c, p.opIndex)}.${term} — ⌘Z undoes`, \"ok\");\n      gate(\".fe-g-wiretap\", true, \"port-tap wire committed\");\n      armSrc = null;\n    }\n  }\n\n  function armWire(src) {\n    armSrc = src; selWire = null;\n    const c = focusedCase();\n    const from = terminalWorld(c, src.idx, \"out\", src.term);\n    if (from) showGhost(from);\n    hostApi.setState(\"wireSrc\", src);\n    status(`wiring from ${nameOf(c, src.idx)}.${src.term} — tap a legal input (or Esc)`, \"ok\");\n  }","patch_id":"p154","time":1792707899628},{"author":"agent","facet":"js","label":"ghost: drag hangs pointer → input; keyboard keeps output → candidate","new":"  // ── the wire ghost: facade tip sphere + hang link tracking the pointer ────\n  // pointer drag (armSrc = the dragged INPUT): the tip is the output end, the\n  // link hangs from it into the input. keyboard (wireMode): from the selected\n  // output down to the tip on the candidate input.\n  function ghostSpecs() {\n    if (!armSrc && !wireMode) return [];\n    const c = focusedCase(); if (!c) return [];\n    const tipSpec = (t) => ({ id: \"fx_ghosttip\", kind: \"sphere\", pos: { x: t.x, y: t.y, z: t.z },\n      params: { radius: 0.05 }, material: { color: \"#62bd8c\", emissive: true } });\n    const linkSpec = (from, to) => ({ id: \"fx_ghostwire\", kind: \"link\", curve: \"hang\", from, to,\n      r: GEO.wireR, material: { color: \"#62bd8c\", dash: true } });\n    if (armSrc) {\n      const inId = `fx_${slug(`d${activeDeck}/op/${armSrc.idx}/in/${armSrc.term}`)}`;\n      const at = terminalWorld(c, armSrc.idx, \"in\", armSrc.term) || { x: 0, y: 0, z: 0 };\n      return [tipSpec(ghostTip || at), linkSpec(\"fx_ghosttip\", inId)];\n    }\n    const src = wireMode.src;\n    if (!src) return [];\n    const fromId = `fx_${slug(`d${activeDeck}/op/${src.idx}/out/${src.term}`)}`;\n    const from = terminalWorld(c, src.idx, \"out\", src.term) || { x: 0, y: 0, z: 0 };\n    return [tipSpec(ghostTip || from), linkSpec(fromId, \"fx_ghosttip\")];\n  }","old":"  // ── the wire ghost: facade tip sphere + hang link tracking the pointer ────\n  function ghostSpecs() {\n    if (!armSrc && !wireMode) return [];\n    const c = focusedCase(); if (!c) return [];\n    const src = armSrc || (wireMode && wireMode.src);\n    if (!src) return [];\n    const fromId = `fx_${slug(`d${activeDeck}/op/${src.idx}/out/${src.term}`)}`;\n    const from = terminalWorld(c, src.idx, \"out\", src.term) || { x: 0, y: 0, z: 0 };\n    const tip = ghostTip || from;\n    return [\n      { id: \"fx_ghosttip\", kind: \"sphere\", pos: { x: tip.x, y: tip.y, z: tip.z },\n        params: { radius: 0.05 }, material: { color: \"#62bd8c\", emissive: true } },\n      { id: \"fx_ghostwire\", kind: \"link\", curve: \"hang\", from: fromId, to: \"fx_ghosttip\",\n        r: GEO.wireR, material: { color: \"#62bd8c\", dash: true } },\n    ];\n  }","patch_id":"p155","time":1792707910248},{"author":"agent","facet":"js","label":"drop onStageMove (the socket drag drives the ghost)","new":"  // the front-ortho client→world projection (headless fallback for a drag\n  // point, and an op-drag end that carries no plane delta)","old":"  // pointer move on the stage tracks the ghost tip + previews legal targets\n  function onStageMove(ev) {\n    if (!armSrc) return;\n    const c = focusedCase(); if (!c) return;\n    // convert client px → world via the front-ortho plane (z=0) as the editor\n    // does for its wiring ghost; the stage's own raycast is GL-only, so the\n    // headless path uses the same plane math as the front view.\n    const world = clientToWorld(ev);\n    if (world) moveGhost(world);\n  }\n\n  // the front-ortho client→world projection (the wiring ghost's plane)","patch_id":"p156","time":1792707915421},{"author":"agent","facet":"js","label":"remove the pointermove ghost listener","new":"      // (the wire ghost rides the socket DRAG itself — onSocketDrag)\n","old":"      // stage pointer moves track the wire ghost\n      hostEl.addEventListener(\"pointermove\", onStageMove);\n","patch_id":"p157","time":1792707921275},{"author":"agent","facet":"js","label":"onOpDrag routes socket drags to onSocketDrag","new":"        if (!p) return;\n        if (p.which) { onSocketDrag(p); return; }   // socket drags WIRE (input → output)","old":"        if (!p || p.which) return;                 // socket drags: not an op move","patch_id":"p158","time":1792707921303},{"author":"agent","facet":"js","label":"api: export onSocketDrag in place of armWire","new":"        onSocketDrag, undo, doc: () => doc,","old":"        armWire, undo, doc: () => doc,","patch_id":"p159","time":1792707933389},{"author":"agent","facet":"js","label":"inspector hint: drag input → output","new":"    else body.innerHTML = `<p class=\"fe-empty\">Select an element. Drag from an input socket to an output to wire.</p>`;","old":"    else body.innerHTML = `<p class=\"fe-empty\">Select an element. Output sockets start wires.</p>`;","patch_id":"p160","time":1792707933410},{"author":"agent","facet":"js","label":"inspector hint (bar view): drag input → output","new":"    edNote(body, \"Select an element. Drag from an input socket to an output to wire.\");","old":"    edNote(body, \"Select an element. Output sockets start wires.\");","patch_id":"p161","time":1792707933437},{"author":"agent","facet":"js","label":"op note: drag an input to an output wires","new":"\"drag an input to an output wires · drag body moves · Enter edits · Del deletes\"","old":"\"W wires from its first output · drag body moves · Enter edits · Del deletes\"","patch_id":"p162","time":1792707933482},{"author":"agent","facet":"html","label":"help: drag from an input to an output to wire","new":"      <p class=\"fe-ro\">Drag from an input socket to an output to wire them\n        (or press <kbd>W</kbd> to wire from the selection). Click a node kind to add it; with","old":"      <p class=\"fe-ro\">Tap an output socket (or press <kbd>W</kbd>) to start a\n        wire, then tap an input to connect it. Click a node kind to add it; with","patch_id":"p163","time":1792707945112},{"author":"agent","facet":"html","label":"gate: drag wire (in → out)","new":"<li class=\"fe-g-wiretap\">drag wire (in → out) — <b>pending</b></li>","old":"<li class=\"fe-g-wiretap\">port-tap wire — <b>pending</b></li>","patch_id":"p164","time":1792707945149}]},"id":"worqhm1a15dab50e4m2d2b_patches","readers":[],"time":1792707945149,"username":"system","writers":[]}