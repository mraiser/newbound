pan class=\"lbl\">inspector</span>\n      <div class=\"fe-inspect-body\">\n        <p class=\"fe-empty\">Select an element. Output sockets start wires.</p>\n      </div>\n      <div class=\"fe-journal\">\n        <span class=\"lbl\">mutations · this session</span>\n        <ul class=\"fe-journal-list\"></ul>\n      </div>\n    </aside>\n  </div>\n</section>\n<div class=\"data-control\" data-control=\"dev:flowdoc\" hidden></div>\n<div class=\"data-control\" data-control=\"dev:flowproject\" hidden></div>\n<div class=\"data-control\" data-control=\"dev:flowlayout\" hidden></div>\n","old":"    <button class=\"fe-proj\" aria-pressed=\"false\" title=\"Front-orthographic (2) / perspective (3)\">persp</button>\n    <button class=\"fe-frame\" title=\"Frame the deck (A)\">frame</button>\n    <button class=\"fe-undo\" title=\"Undo (⌘Z)\" disabled>undo</button>\n  </div>\n\n  <div class=\"fe-main\">\n    <!-- the ONE runtime: an app:scenehost; ops are addControl'd into it and the\n         deck's scene facet (toSceneDoc) rides the stage as the facade. Wiring\n         gestures are flownode behaviors; the flow body stays authoritative. -->\n    <div class=\"data-control fe-host\" data-control=\"app:scenehost:{}\"></div>\n\n    <aside class=\"fe-rail\">\n      <span class=\"lbl\">P2 · wiring gestures ride scenehost</span>\n      <ul class=\"fe-gate\">\n        <li class=\"fe-g-host\">host booted — <b>pending</b></li>\n        <li class=\"fe-g-wiretap\">port-tap wire — <b>pending</b></li>\n        <li class=\"fe-g-i1i2\">I-1/I-2 refused — <b>pending</b></li>\n        <li class=\"fe-g-kbd\">keyboard wire (W/→/Enter) — <b>pending</b></li>\n        <li class=\"fe-g-undo\">undo restores — <b>pending</b></li>\n      </ul>\n      <p class=\"fe-ro\"><b>editing on</b> — wiring gestures are flownode\n        behaviors on the host. Tap an output socket (or select an op and press\n        <kbd>W</kbd>) to start a wire; legal input targets preview; tap / Enter\n        commits, <kbd>Esc</kbd> cancels. The flow body is authoritative — every\n        wire is a FlowDoc mutation; the facade re-derives. <kbd>⌘Z</kbd> undoes.</p>\n      <p class=\"fe-keys lbl\">keys</p>\n      <ul class=\"fe-keys-list\">\n        <li><kbd>2</kbd> front-ortho · <kbd>3</kbd> perspective · <kbd>A</kbd> frame deck</li>\n        <li><kbd>[</kbd> <kbd>]</kbd> walk case chain · <kbd>Esc</kbd> back / cancel</li>\n        <li><kbd>W</kbd> wire from selection · <kbd>←</kbd><kbd>→</kbd> choose target · <kbd>Enter</kbd> commit</li>\n        <li><kbd>Del</kbd> unwires the selected wire · <kbd>⌘Z</kbd> undo</li>\n      </ul>\n    </aside>\n\n    <aside class=\"fe-inspect\">\n      <span class=\"lbl\">inspector</span>\n      <div class=\"fe-inspect-body\">\n        <p class=\"fe-empty\">Select an element. Output sockets start wires.</p>\n      </div>\n      <div class=\"fe-journal\">\n        <span class=\"lbl\">mutations · this session</span>\n        <ul class=\"fe-journal-list\"></ul>\n      </div>\n    </aside>\n  </div>\n</section>\n<div class=\"data-control\" data-control=\"dev:flowdoc\" hidden></div>\n<div class=\"data-control\" data-control=\"dev:flowproject\" hidden></div>\n","patch_id":"p14","time":1792577126281},{"author":"executive","facet":"css","label":"P3: palette, conflict bar, save button styles","new":".nb-flowedit3d .fe-journal-list { list-style:none; margin:0; padding:0; font-size:11px; }\n.nb-flowedit3d .fe-journal-list li { padding:2px 0; border-bottom:1px solid #f0f2f4; color:#4a525c; }\n/* P3 */\n.nb-flowedit3d .fe-save:not(:disabled) { background:#62bd8c; border-color:#62bd8c; color:#fff; }\n.nb-flowedit3d .fe-palette { margin:8px 0 6px; }\n.nb-flowedit3d .fe-pal-row { display:flex; gap:4px; flex-wrap:wrap; }\n.nb-flowedit3d .fe-pal-item { flex:1; min-width:0; background:#2d343c; color:#fff; border-color:#2d343c; }\n.nb-flowedit3d .fe-pal-item:hover { background:#3c4650; }\n.nb-flowedit3d .fe-conflict { display:flex; align-items:center; gap:8px; padding:8px 12px;\n  background:#fdecea; border-bottom:1px solid #f5c6c0; color:#8a2f22; font-size:12px; }\n.nb-flowedit3d .fe-conflict-msg { flex:1; }\n.nb-flowedit3d .fe-inspect-body button { margin-right:4px; }\n","old":".nb-flowedit3d .fe-journal-list { list-style:none; margin:0; padding:0; font-size:11px; }\n.nb-flowedit3d .fe-journal-list li { padding:2px 0; border-bottom:1px solid #f0f2f4; color:#4a525c; }\n","patch_id":"p15","time":1792577151060},{"author":"executive","facet":"js","label":"P3 fix: deleteSelectedOp uses FlowDoc.removeOp (wire-safe, index-renumbering, undoable)","new":"  // delete the selected op: FlowDoc.removeOp removes it + every wire touching\n  // it AND renumbers the surviving wires' op indices — one undoable mutation.\n  function deleteSelectedOp() {\n    const key = hostApi.state && hostApi.state.selectedKey;\n    const m = key && /^d(\\d+)_op(\\d+)$/.exec(key);\n    const c = focusedCase(); if (!m || !c) return;\n    const i = +m[2]; const op = c.cmds[i]; if (!op) return;\n    const cmd = doc.removeOp(c, i);\n    if (cmd.error) { status(\"delete refused: \" + cmd.error, \"bad\"); return; }\n    commitApplied(cmd);\n    clearSelection();\n    status(`deleted ${op.name || op.type}`, \"ok\");\n    gate(\".fe-g-delop\", true, \"op removed with its wires\");\n  }","old":"  // delete the selected op: removes it + every wire touching it, as one undo.\n  function deleteSelectedOp() {\n    const key = hostApi.state && hostApi.state.selectedKey;\n    const m = key && /^d(\\d+)_op(\\d+)$/.exec(key);\n    const c = focusedCase(); if (!m || !c) return;\n    const i = +m[2]; const op = c.cmds[i]; if (!op) return;\n    const touching = doc.wiresTouching ? doc.wiresTouching(c, i) : [];\n    const removed = [];\n    // remove wires touching it, highest cons index first so indices stay valid\n    const idxs = (touching || []).map((t) => (t.wireIndex !== undefined ? t.wireIndex : t)).sort((a, b) => b - a);\n    for (const wi of idxs) {\n      const w = c.cons[wi]; if (!w) continue;\n      removed.push({ wi, wire: { src: [w.src[0], w.src[1]], dest: [w.dest[0], w.dest[1]] } });\n      c.cons.splice(wi, 1);\n    }\n    const [gone] = c.cmds.splice(i, 1);\n    commitApplied({ label: `delete ${op.name || op.type}`,\n      undo: () => { c.cmds.splice(i, 0, gone); removed.sort((a, b) => a.wi - b.wi).forEach((r) => c.cons.splice(r.wi, 0, r.wire)); },\n      redo: () => { removed.slice().sort((a, b) => b.wi - a.wi).forEach((r) => c.cons.splice(r.wi, 1)); c.cmds.splice(i, 1); } });\n    clearSelection();\n    status(`deleted ${op.name || op.type}`, \"ok\");\n    gate(\".fe-g-delop\", true, \"op removed with its wires\");\n  }","patch_id":"p16","time":1792577630545},{"author":"executive","facet":"js","label":"P3 cleanup: redo() drops dead noop expression","new":"    try { if (cmd.redo) cmd.redo(); } catch (e) {}","old":"    try { cmd.redo ? cmd.redo() : cmd.undo && null; } catch (e) {}","patch_id":"p17","time":1792577896356},{"author":"executive","facet":"html","label":"P4: run ▸ button in the toolbar","new":"    <button class=\"fe-run\" title=\"Run: tokens deliver along the wires in propagation order (R)\">run ▸</button>\n    <button class=\"fe-save\" title=\"Save the flow body (write_flow_body)\" disabled>save</button>","old":"    <button class=\"fe-save\" title=\"Save the flow body (write_flow_body)\" disabled>save</button>","patch_id":"p18","time":1792595753142},{"author":"executive","facet":"html","label":"P4: run/diff/journal gates + rail heading","new":"        <li class=\"fe-g-save\">save (write_flow_body) — <b>pending</b></li>\n        <li class=\"fe-g-run\">run tokens in propagation order — <b>pending</b></li>\n        <li class=\"fe-g-diff\">changes since save (diffFlow) — <b>pending</b></li>\n        <li class=\"fe-g-journal\">server journal + entry diff — <b>pending</b></li>\n      </ul>","old":"        <li class=\"fe-g-save\">save (write_flow_body) — <b>pending</b></li>\n      </ul>","patch_id":"p19","time":1792595756800},{"author":"executive","facet":"html","label":"P4: changes-since-save + server journal panels in the inspector","new":"      <div class=\"fe-journal\">\n        <span class=\"lbl\">mutations · this session</span>\n        <ul class=\"fe-journal-list\"></ul>\n      </div>\n      <div class=\"fe-changes\">\n        <span class=\"lbl\">changes since save · <span class=\"fe-changes-count\">—</span></span>\n        <ul class=\"fe-changes-list\"></ul>\n      </div>\n      <div class=\"fe-sjournal\">\n        <span class=\"lbl\">journal · write_flow_body history <button class=\"fe-sj-refresh\" title=\"Reload the server journal\">↻</button></span>\n        <ul class=\"fe-sjournal-list\"><li class=\"fe-empty\">loading…</li></ul>\n      </div>\n    </aside>","old":"      <div class=\"fe-journal\">\n        <span class=\"lbl\">mutations · this session</span>\n        <ul class=\"fe-journal-list\"></ul>\n      </div>\n    </aside>","patch_id":"p20","time":1792595761418},{"author":"executive","facet":"html","label":"P4: rail heading + run key","new":"      <span class=\"lbl\">P4 · run tokens + journal ride scenehost</span>","old":"      <span class=\"lbl\">P3 · authoring + save ride scenehost</span>","patch_id":"p21","time":1792595764164},{"author":"executive","facet":"html","label":"P4: run key in the keys list","new":"        <li><kbd>Del</kbd> unwires a wire / deletes an op · <kbd>⌘Z</kbd>/<kbd>⇧⌘Z</kbd> undo/redo</li>\n        <li><kbd>R</kbd> run — tokens deliver along each wire, round by round</li>","old":"        <li><kbd>Del</kbd> unwires a wire / deletes an op · <kbd>⌘Z</kbd>/<kbd>⇧⌘Z</kbd> undo/redo</li>","patch_id":"p22","time":1792595767740},{"author":"executive","facet":"css","label":"P4: run button, changes + server journal panels","new":".nb-flowedit3d .fe-inspect-body button { margin-right:4px; }\n/* P4 */\n.nb-flowedit3d .fe-run { border-color:#62bd8c; color:#2f9e63; }\n.nb-flowedit3d .fe-run.running { background:#62bd8c; color:#fff; }\n.nb-flowedit3d .fe-changes, .nb-flowedit3d .fe-sjournal { margin-top:8px; }\n.nb-flowedit3d .fe-changes-list, .nb-flowedit3d .fe-sjournal-list, .nb-flowedit3d .fe-run-list,\n.nb-flowedit3d .jl-diff-list { list-style:none; margin:0; padding:0; font-size:11px; }\n.nb-flowedit3d .fe-changes-list li, .nb-flowedit3d .jl-diff-list li { padding:1px 0; color:#4a525c; }\n.nb-flowedit3d .jl-g { display:inline-block; width:14px; font-weight:600; }\n.nb-flowedit3d .jl-add .jl-g { color:#2f9e63; } .nb-flowedit3d .jl-del .jl-g { color:#c0392b; }\n.nb-flowedit3d .jl-mod .jl-g { color:#b7791f; }\n.nb-flowedit3d .fe-sjournal-list > li { border-bottom:1px solid #f0f2f4; padding:2px 0; }\n.nb-flowedit3d .jl-row { display:flex; align-items:center; gap:4px; }\n.nb-flowedit3d .jl-label { flex:1; min-width:0; text-align:left; border:none; background:none; padding:1px 0;\n  overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#2d343c; }\n.nb-flowedit3d .jl-author { font-size:10px; color:#8a929c; max-width:9ch; overflow:hidden; white-space:nowrap; }\n.nb-flowedit3d .jl-revert { padding:0 5px; font-size:10px; }\n.nb-flowedit3d .jl-diff { padding:2px 0 4px 14px; }\n.nb-flowedit3d .jl-note { margin:2px 0; font-size:11px; color:#6b7480; }\n.nb-flowedit3d .fe-sj-refresh { padding:0 4px; font-size:10px; margin-left:4px; text-transform:none; }\n.nb-flowedit3d .fe-run-list li { padding:1px 0; color:#4a525c; }\n.nb-flowedit3d .fe-run-list .rd { color:#2f9e63; font-weight:600; margin-right:4px; }","old":".nb-flowedit3d .fe-inspect-body button { margin-right:4px; }","patch_id":"p23","time":1792595777074},{"author":"executive","facet":"js","label":"P4: pull propagationRounds + diffFlow from flowdoc; listPatches plumbing","new":"  const { parse: parseFlow, propagationRounds, diffFlow } = document.querySelector('[data-control=\"dev:flowdoc\"]').api;","old":"  const { parse: parseFlow } = document.querySelector('[data-control=\"dev:flowdoc\"]').api;","patch_id":"p24","time":1792595797829},{"author":"executive","facet":"js","label":"P4: listPatches plumbing","new":"  const readFlowBody = (l2, c2, m2) => codeCmd(\"read_flow_body\", { lib: l2, ctl: c2, cmd: m2 });\n  const listPatches = (l2, c2, n2) => codeCmd(\"list_control_patches\", { lib: l2, ctl: c2, limit: n2 || 0 });","old":"  const readFlowBody = (l2, c2, m2) => codeCmd(\"read_flow_body\", { lib: l2, ctl: c2, cmd: m2 });","patch_id":"p25","time":1792595797830},{"author":"executive","facet":"js","label":"P4: run + journal state","new":"  let redoStack = [];\n\n  // ── P4: run tokens + journal state ────────────────────────────────────────\n  let savedBody = null;           // JSON snapshot of the last loaded/saved body (diff baseline)\n  let running = false, runSeq = 0, lastRun = null;\n  let journalRows = [];           // the server journal's flow entries for this command\n  const snap = () => { const b = doc.serialize(); return typeof b === \"string\" ? b : JSON.stringify(b); };","old":"  let redoStack = [];","patch_id":"p26","time":1792595801604},{"author":"executive","facet":"js","label":"P4: refuse mutations mid-run; afterMutation refreshes the diff","new":"  function commitApplied(cmd) {\n    if (!cmd || cmd.error) return;\n    // a run owns the stage: an edit mid-run would re-project the facade under\n    // the tokens — revert it at once (the doc stays exactly as before)\n    if (running) { try { cmd.undo(); } catch (e) {} status(\"running — edit refused until the run delivers\", \"bad\"); return; }\n    undoStack.push(cmd);","old":"  function commitApplied(cmd) {\n    if (!cmd || cmd.error) return;\n    undoStack.push(cmd);","patch_id":"p27","time":1792595808515},{"author":"executive","facet":"js","label":"P4: afterMutation renders changes-since-save","new":"  function afterMutation() { cancelWireGhost(); renderAll(); refreshSaveUi(); renderChanges(); }","old":"  function afterMutation() { cancelWireGhost(); renderAll(); refreshSaveUi(); }","patch_id":"p28","time":1792595808516},{"author":"executive","facet":"js","label":"P4: undo waits for a run","new":"  function undo() {\n    if (running) return;\n    const cmd = undoStack.pop(); if (!cmd) return;","old":"  function undo() {\n    const cmd = undoStack.pop(); if (!cmd) return;","patch_id":"p29","time":1792595814340},{"author":"executive","facet":"js","label":"P4: redo waits for a run","new":"  function redo() {\n    if (running) return;\n    const cmd = redoStack.pop(); if (!cmd) return;","old":"  function redo() {\n    const cmd = redoStack.pop(); if (!cmd) return;","patch_id":"p30","time":1792595814343},{"author":"executive","facet":"js","label":"P4: run tokens (flowtoken behaviors) + changes diff + server journal","new":"  // ── P4: run tokens — deliveries ride a flowtoken BEHAVIOR on the host ─────\n  // The schedule is local and pure (design §3.5 — the platform returns only\n  // the result): flowdoc.propagationRounds gives the focused case's firing\n  // order. One dev:flowtoken instance per wire is addControl'd into the\n  // scenehost, seeded with its round; ONE shared clock (host.state.run.t0)\n  // starts them together, so the token behaviors deliver round by round and\n  // report via host.state.onTokenDelivered. The editor schedules and audits;\n  // the motion is the behavior's.\n  const esc = (s) => String(s == null ? \"\" : s).replace(/[&<>\"]/g, (ch) => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" }[ch]));\n  function wireEnd(c, end, which) {\n    return terminalWorld(c, end[0], which, end[1]) || terminalWorld(c, end[0], which === \"out\" ? \"in\" : \"out\", end[1]) || null;\n  }\n  async function runFlow() {\n    if (running || !hostApi) return null;\n    const c = focusedCase(); if (!c) return null;\n    const { rounds, unreached } = propagationRounds(c);\n    if (!rounds.length) { status(\"nothing to run — no wire can fire\", \"bad\"); return null; }\n    if (armSrc || wireMode) { cancelWireGhost(); renderFacade(); }\n    running = true;\n    const runBtn = $(\".fe-run\"); if (runBtn) { runBtn.disabled = true; runBtn.classList.add(\"running\"); runBtn.textContent = \"running…\"; }\n    const runId = ++runSeq;\n    const reduced = typeof matchMedia !== \"undefined\" && matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n    const dur = reduced ? 0.34 : 0.42;\n    const expected = rounds.reduce((n, r) => n + r.length, 0);\n    const delivered = [], keys = [];\n    let finish; const allDone = new Promise((res) => { finish = res; });\n    hostApi.setState(\"run\", { id: runId, t0: null });\n    hostApi.setState(\"onTokenDelivered\", (ev) => {\n      if (!ev || ev.runId !== runId) return;\n      delivered.push({ k: ev.k, round: ev.round });\n      if (delivered.length >= expected) finish(true);\n    });\n    const started = performance.now();\n    try {\n      for (let r = 0; r < rounds.length; r++) {\n        for (const k of rounds[r]) {\n          const w = c.cons[k]; if (!w) continue;\n          const key = `run${runId}_w${k}`;\n          await hostApi.addControl(\"dev\", \"flowtoken\", {\n            runId, k, round: r, dur, reduced,\n            wire: \"fx_\" + slug(`d${activeDeck}/wire/${k}`),\n            from: wireEnd(c, w.src, \"out\"), to: wireEnd(c, w.dest, \"in\"),\n          }, key);\n          keys.push(key);\n        }\n      }\n      // every token is booted — start the ONE clock they all ride\n      hostApi.setState(\"run\", { id: runId, t0: performance.now() });\n      const budget = (rounds.length * dur + 3) * 1000;\n      const complete = await Promise.race([allDone, new Promise((res) => setTimeout(() => res(false), budget))]);\n      lastRun = auditRun(runId, rounds, unreached, delivered, !!complete, Math.round(performance.now() - started));\n    } catch (e) {\n      lastRun = { runId, error: String(e && e.message ? e.message : e), rounds, unreached, delivered: delivered.slice(), order: delivered.map((d) => d.k), complete: false, inOrder: false, ms: null };\n    } finally {\n      for (const key of keys) { try { hostApi.removeControl(key); } catch (e) {} }\n      hostApi.setState(\"run\", null);\n      hostApi.setState(\"onTokenDelivered\", null);\n      running = false;\n      if (runBtn) { runBtn.disabled = false; runBtn.classList.remove(\"running\"); runBtn.textContent = \"run ▸\"; }\n    }\n    const R = lastRun;\n    R.tokensHosted = keys.length;\n    pushJournal(`run · ${R.delivered.length}/${expected} deliveries · ${rounds.length} round${rounds.length === 1 ? \"\" : \"s\"}` + (unreached.length ? ` · ${unreached.length} unreached` : \"\"));\n    if (R.complete && R.inOrder) status(`ran · ${expected} deliveries in ${rounds.length} rounds · ${R.ms}ms`, \"ok\");\n    else status(R.error ? \"run failed: \" + R.error : `run incomplete · ${R.delivered.length}/${expected} delivered`, \"bad\");\n    gate(\".fe-g-run\", !!(R.complete && R.inOrder), R.complete ? `${expected} deliveries, ${rounds.length} rounds, in order` : \"incomplete\");\n    renderRunInspector(R);\n    return R;\n  }\n  // audit: every scheduled wire delivered exactly once, in its own round,\n  // rounds non-decreasing in delivery order\n  function auditRun(runId, rounds, unreached, delivered, complete, ms) {\n    const order = delivered.map((d) => d.k);\n    const want = [].concat(...rounds);\n    const once = order.length === want.length && new Set(order).size === order.length && want.every((k) => order.includes(k));\n    const monotone = delivered.every((d, i) => i === 0 || d.round >= delivered[i - 1].round);\n    const ownRound = delivered.every((d) => rounds[d.round] && rounds[d.round].includes(d.k));\n    return { runId, rounds, unreached, delivered, order, complete, inOrder: once && monotone && ownRound, ms };\n  }\n  function renderRunInspector(R) {\n    const body = $(\".fe-inspect-body\"); if (!body || !R) return;\n    const c = focusedCase();\n    const wl = (k) => { const w = c && c.cons[k]; return esc(w ? `${nameOf(c, w.src[0])}.${w.src[1]} → ${nameOf(c, w.dest[0])}.${w.dest[1]}` : `wire ${k}`); };\n    let h = `<p><b>run</b> <span class=\"lbl\">${R.complete && R.inOrder ? \"delivered in propagation order\" : \"incomplete\"}${R.ms != null ? ` · ${R.ms}ms` : \"\"}</span></p><ul class=\"fe-run-list\">`;\n    R.rounds.forEach((round, r) => { h += `<li><span class=\"rd\">${r + 1}</span>${round.map(wl).join(\" · \")}</li>`; });\n    h += `</ul>`;\n    if (R.unreached.length) h += `<p class=\"fe-empty\">never fires (I-1/I-2): ${R.unreached.map(wl).join(\" · \")}</p>`;\n    body.innerHTML = h;\n  }\n\n  // ── P4: the in-editor journal + diff ─────────────────────────────────────\n  // Two views, both speaking the GRAPH's vocabulary via flowdoc.diffFlow:\n  //   unsaved changes — diffFlow(last loaded/saved body, the working body),\n  //                     refreshed on every mutation;\n  //   server journal  — the control's _patches flow entries for this command\n  //                     (write_flow_body history), each expandable to its\n  //                     structural diff, revertible as a NEW journaled write.\n  const DIFF_GLYPH = { \"op+\": \"+\", \"op-\": \"−\", \"op~\": \"~\", \"wire+\": \"⌁\", \"wire-\": \"⌁\", sig: \"▤\", \"deck+\": \"▤\", \"deck-\": \"▤\" };\n  const DIFF_CLASS = { \"op+\": \"add\", \"op-\": \"del\", \"op~\": \"mod\", \"wire+\": \"add\", \"wire-\": \"del\", sig: \"mod\", \"deck+\": \"add\", \"deck-\": \"del\" };\n  const noteEl = (t, tag) => { const el = document.createElement(tag || \"p\"); el.className = tag === \"li\" ? \"fe-empty\" : \"jl-note\"; el.textContent = t; return el; };\n  function changeItems(changes, max) {\n    const multi = changes.some((x) => x.deck !== changes[0].deck);\n    const out = changes.slice(0, max).map((ch) => {\n      const li = document.createElement(\"li\"); li.className = \"jl-ch jl-\" + (DIFF_CLASS[ch.kind] || \"mod\");\n      const g = document.createElement(\"span\"); g.className = \"jl-g\"; g.textContent = DIFF_GLYPH[ch.kind] || \"·\";\n      const t = document.createElement(\"span\"); t.textContent = (multi ? `case ${ch.deck + 1}: ` : \"\") + ch.text;\n      li.append(g, t); return li;\n    });\n    if (changes.length > max) out.push(noteEl(`…and ${changes.length - max} more`, \"li\"));\n    return out;\n  }\n  let lastChanges = null;\n  function renderChanges() {\n    const ul = $(\".fe-changes-list\"), cnt = $(\".fe-changes-count\");\n    if (!ul || savedBody == null || !doc) return null;\n    let d; try { d = diffFlow(savedBody, snap()); } catch (e) { if (cnt) cnt.textContent = \"diff failed\"; return null; }\n    lastChanges = d;\n    if (cnt) cnt.textContent = d.changes.length ? `+${d.counts.added} −${d.counts.removed} ~${d.counts.changed}` : \"none\";\n    ul.replaceChildren(...(d.changes.length ? changeItems(d.changes, 14) : [noteEl(\"no structural change\", \"li\")]));\n    if (d.changes.length) gate(\".fe-g-diff\", true, `${d.changes.length} change${d.changes.length === 1 ? \"\" : \"s\"} vs saved`);\n    return d;\n  }\n\n  async function refreshJournal() {\n    const ul = $(\".fe-sjournal-list\"); if (!ul) return [];\n    const r = await listPatches(source.lib, source.ctl, 40);\n    if (!r || r.status !== \"ok\") { ul.replaceChildren(noteEl(\"journal unavailable: \" + ((r && r.msg) || \"no response\"), \"li\")); journalRows = []; return []; }\n    journalRows = (r.patches || []).filter((p) => p.facet === \"flow\" && p.cmd === source.cmd).slice(0, 12);\n    ul.replaceChildren();\n    if (!journalRows.length) { ul.appendChild(noteEl(\"no saved history yet\", \"li\")); return journalRows; }\n    journalRows.forEach((p, i) => {\n      const li = document.createElement(\"li\"); li.dataset.ji = String(i);\n      const row = document.createElement(\"div\"); row.className = \"jl-row\";\n      // the label is the disclosure: an entry's real content is WHAT CHANGED\n      const label = document.createElement(\"button\"); label.className = \"jl-label\";\n      label.setAttribute(\"aria-expanded\", \"false\");\n      label.innerHTML = `<span class=\"jl-caret\" aria-hidden=\"true\">▸</span> <span>${esc(p.label || p.patch_id || \"—\")}</span>`;\n      const author = document.createElement(\"span\"); author.className = \"jl-author\"; author.textContent = p.author || \"\";\n      row.append(label, author);\n      if (p.old) { // no `old` = the creation entry — nothing to revert to\n        const rv = document.createElement(\"button\"); rv.className = \"jl-revert\"; rv.textContent = \"revert\";\n        rv.title = \"write this entry's before-state as a NEW journaled patch\";\n        rv.addEventListener(\"click\", () => revertTo(p));\n        row.appendChild(rv);\n      }\n      const box = document.createElement(\"div\"); box.className = \"jl-diff\"; box.hidden = true;\n      li.append(row, box);\n      label.addEventListener(\"click\", () => toggleJournalDiff(i));\n      ul.appendChild(li);\n    });\n    return journalRows;\n  }\n  function toggleJournalDiff(i) {\n    const ul = $(\".fe-sjournal-list\"); const li = ul && ul.querySelector(`li[data-ji=\"${i}\"]`); const p = journalRows[i];\n    if (!li || !p) return null;\n    const label = li.querySelector(\".jl-label\"), box = li.querySelector(\".jl-diff\");\n    const open = label.getAttribute(\"aria-expanded\") === \"true\";\n    // accordion: one entry open at a time\n    for (const other of ul.querySelectorAll(\".jl-label[aria-expanded='true']\")) {\n      other.setAttribute(\"aria-expanded\", \"false\");\n      other.querySelector(\".jl-caret\").textContent = \"▸\";\n      other.closest(\"li\").querySelector(\".jl-diff\").hidden = true;\n    }\n    if (open) return null;\n    label.setAttribute(\"aria-expanded\", \"true\");\n    label.querySelector(\".jl-caret\").textContent = \"▾\";\n    box.hidden = false;\n    if (!box.dataset.built) { box.dataset.built = \"1\"; box.replaceChildren(...renderEntryDiff(p)); }\n    gate(\".fe-g-journal\", true, `${journalRows.length} entr${journalRows.length === 1 ? \"y\" : \"ies\"}, diff shown`);\n    return box.textContent;\n  }\n  function renderEntryDiff(p) {\n    if (!p.new) return [noteEl(\"this entry recorded no body\")];\n    if (!p.old) {\n      const c = parseFlow(p.new).root;\n      return [noteEl(`created · ${c.cmds.length} op${c.cmds.length === 1 ? \"\" : \"s\"}, ${c.cons.length} wire${c.cons.length === 1 ? \"\" : \"s\"}`)];\n    }\n    const { changes, counts } = diffFlow(p.old, p.new);\n    if (!changes.length) return [noteEl(\"no structural change (formatting or identical bodies)\")];\n    const ul = document.createElement(\"ul\"); ul.className = \"jl-diff-list\";\n    ul.append(...changeItems(changes, 12));\n    return [noteEl(`+${counts.added} −${counts.removed} ~${counts.changed}`), ul];\n  }\n  // (re)load a body as the authoritative doc — the diff baseline moves with it\n  function loadBody(body, hash) {\n    doc = parseFlow(body); baseHash = hash || \"\";\n    focusPath = [{ root: doc.root, title: \"case 1\" }]; activeDeck = 0;\n    undoStack = []; redoStack = []; pendingLabels = []; dirty = false;\n    $(\".fe-undo\").disabled = true;\n    savedBody = snap();\n    renderAll(); refreshSaveUi(); renderChanges();\n  }\n  async function revertTo(p) {\n    if (running || saving) return null;\n    let body;\n    try { body = typeof p.old === \"string\" ? JSON.parse(p.old) : p.old; }\n    catch (e) { status(\"journal entry has no readable body\", \"bad\"); return null; }\n    const cur = await readFlowBody(source.lib, source.ctl, source.cmd);\n    const w = await writeFlowBody(source.lib, source.ctl, source.cmd, body,\n      { base: cur && cur.status === \"ok\" ? (cur.hash || \"\") : \"\", label: `revert: ${p.label || p.patch_id}` });\n    if (!w || w.status !== \"ok\") { status(`revert failed: ${(w && w.msg) || \"no response\"}`, \"bad\"); return w; }\n    loadBody(body, w.hash);\n    pushJournal(`reverted to before ${p.patch_id}`);\n    status(\"reverted — as a new journal entry\", \"ok\");\n    await refreshJournal();\n    return w;\n  }\n\n  function init() {\n    const hostEl = $(\".fe-host\");","old":"  function init() {\n    const hostEl = $(\".fe-host\");","patch_id":"p31","time":1792595891108},{"author":"executive","facet":"js","label":"P4: save moves the diff baseline + refreshes the journal","new":"    if (r && r.status === \"ok\") { baseHash = r.hash || baseHash; dirty = false; pendingLabels = []; savedBody = JSON.stringify(body); status(`saved · ${r.patch_id || \"ok\"}`, \"ok\"); pushJournal(\"saved\"); gate(\".fe-g-save\", true, \"write_flow_body ok\"); renderChanges(); refreshJournal(); }","old":"    if (r && r.status === \"ok\") { baseHash = r.hash || baseHash; dirty = false; pendingLabels = []; status(`saved · ${r.patch_id || \"ok\"}`, \"ok\"); pushJournal(\"saved\"); gate(\".fe-g-save\", true, \"write_flow_body ok\"); }","patch_id":"p32","time":1792595902108},{"author":"executive","facet":"js","label":"P4: load-theirs rides loadBody (baseline moves)","new":"      if (r && r.status === \"ok\" && r.exists) {\n        loadBody(r.body, r.hash || \"\");\n        el.hidden = true; status(\"loaded theirs — your edits discarded\", \"bad\"); refreshJournal();\n      }","old":"      if (r && r.status === \"ok\" && r.exists) {\n        doc = parseFlow(r.body); baseHash = r.hash || \"\";\n        focusPath = [{ root: doc.root, title: \"case 1\" }]; activeDeck = 0;\n        undoStack = []; redoStack = []; pendingLabels = []; dirty = false;\n        el.hidden = true; renderAll(); refreshSaveUi(); status(\"loaded theirs — your edits discarded\", \"bad\");\n      }","patch_id":"p33","time":1792595902112},{"author":"executive","facet":"js","label":"P4: keep-mine moves the baseline + refreshes the journal","new":"      if (w && w.status === \"ok\") { baseHash = w.hash || baseHash; dirty = false; pendingLabels = []; savedBody = JSON.stringify(body); status(\"saved mine over theirs\", \"ok\"); pushJournal(\"saved (overwrite)\"); renderChanges(); refreshJournal(); }","old":"      if (w && w.status === \"ok\") { baseHash = w.hash || baseHash; dirty = false;