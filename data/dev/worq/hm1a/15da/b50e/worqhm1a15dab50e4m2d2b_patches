 }\n      // ⌘S must reach the editor's keydown (it blurs this field so the edit\n      // commits, then saves); every other key stays the field's own\n      if ((e.metaKey || e.ctrlKey) && (e.key === \"s\" || e.key === \"S\")) return;\n      e.stopPropagation();","old":"      else if (e.key === \"Escape\") { e.preventDefault(); i.value = value ?? \"\"; i.blur(); }\n      e.stopPropagation();","patch_id":"p104","time":1792602922029},{"author":"executive","facet":"js","label":"P5 4c: Cmd+S commits a pending field value explicitly (change), not via blur","new":"        // ⌘S saves from anywhere in the editor. A focused text field's pending\n        // value is committed EXPLICITLY (a change event — blur alone does not\n        // fire change when the value was not set by real typing, and some\n        // engines skip it on removal); every inspector change handler is\n        // guarded on \"value differs\", so a second change from the blur is a\n        // no-op. Then the save runs on the next tick, after the commit.\n        if ((e.metaKey || e.ctrlKey) && (e.key === \"s\" || e.key === \"S\")) {\n          e.preventDefault();\n          if (inField && /^(INPUT|TEXTAREA)$/.test(tg.tagName || \"\")) tg.dispatchEvent(new Event(\"change\", { bubbles: true }));\n          if (inField && tg.isConnected && tg.blur) tg.blur();\n          setTimeout(() => { saveFlow(); }, 0);\n          return;\n        }","old":"        // ⌘S saves from anywhere in the editor: a focused field is blurred\n        // first so its change event commits the edit, then the save runs\n        if ((e.metaKey || e.ctrlKey) && (e.key === \"s\" || e.key === \"S\")) {\n          e.preventDefault();\n          if (inField && tg.blur) tg.blur();\n          setTimeout(() => { saveFlow(); }, 0);\n          return;\n        }","patch_id":"p105","time":1792603023870},{"author":"executive","facet":"js","label":"P5 step5: disposed flag","new":"  let running = false, runSeq = 0, lastRun = null;\n  let disposed =