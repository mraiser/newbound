ad\"); return false; }\n    // a debug session's tape describes THIS body: edits wait for stop (⇧F5)\n    if (dbgActive()) { try { cmd.undo(); } catch (e) {} status(\"debugging — edits are locked; stop the session (⇧F5) to edit\", \"bad\"); renderAll(); return false; }","old":"    if (running) { try { cmd.undo(); } catch (e) {} status(\"running — edit refused until the run delivers\", \"bad\"); return false; }","patch_id":"p231","time":1792785644116},{"author":"executive","facet":"js","label":"step debugger: undo locked while debugging","new":"    if (running) return;\n    if (dbgActive()) { status(\"debugging — stop the session (⇧F5) to undo\", \"bad\"); return; }\n    const cmd = undoStack.pop(); if (!cmd) return;","old":"    if (running) return;\n    const cmd = undoStack.pop(); if (!cmd) return;","patch_id":"p232","time":1792785651247},{"author":"executive","facet":"js","label":"step debugger: redo locked while debugging","new":"    if (running) return;\n    if (dbgActive()) { status(\"debugging — stop the session (⇧F5) to redo\", \"bad\"); return; }\n    const cmd = redoStack.pop(); if (!cmd) return;","old":"    if (running) return;\n    const cmd = redoStack.pop(); if (!cmd) return;","patch_id":"p233","time":1792785651253},{"author":"executive","facet":"js","label":"step debugger: no wire drag while debugging","new":"      if (running || dbgActive() || (p.which !== \"in\" && p.which !== \"out\")) return;\n      const terms = p.opIndex === -1 ? c.input : p.opIndex === -2 ? c.output","old":"      if (running || (p.which !== \"in\" && p.which !== \"out\")) return;\n      const terms = p.opIndex === -1 ? c.input : p.opIndex === -2 ? c.output","patch_id":"p234","time":1792785673440},{"author":"executive","facet":"js","label":"step debugger: no synchro drag while debugging","new":"      if (running || dbgActive() || !c.cmds[p.idx] || (p.which !== \"in\" && p.which !== \"out\")) return;","old":"      if (running || !c.cmds[p.idx] || (p.which !== \"in\" && p.which !==