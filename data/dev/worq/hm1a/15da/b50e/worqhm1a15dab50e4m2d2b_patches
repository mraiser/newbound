792603361468},{"author":"executive","facet":"js","label":"P5 step5: serialize+coalesce renderInstances (overlapping passes double-hosted every op)","new":"  // ONE pass at a time. renderAll fires renderInstances without awaiting, and\n  // a live mount renders twice back-to-back (graph prop, then the\n  // authoritative loadBody) — two overlapping passes each removed only the\n  // instances pushed so far and then BOTH addControl'd every op under the same\n  // key, so every op was hosted twice (scenehost keeps both; byKey only the\n  // last, so the first became unremovable). Calls during a pass coalesce into\n  // one more pass that reads the doc as it is by then.\n  let renderBusy = null, renderAgain = false;\n  function renderInstances() {\n    if (renderBusy) { renderAgain = true; return renderBusy; }\n    renderBusy = (async () => {\n      try { do { renderAgain = false; await renderInstancesOnce(); } while (renderAgain && !disposed); }\n      catch (e) { status(\"render failed: \" + (e && e.message ? e.message : e), \"bad\"); }\n      finally { renderBusy = null; }\n    })();\n    return renderBusy;\n  }\n  async function renderInstancesOnce() {\n    if (disposed) return;          // a late loadBody/mutation after teardown must not re-host\n","old":"  async function renderInstances() {\n    if (disposed) return;          // a late loadBody/mutation after teardown must not re-host\n","patch_id":"p110","time":1792603587745},{"author":"executive","facet":"js","label":"P5 step5: a pass outrun by a mutation stops (the coalesced pass redoes it)","new":"    for (let i = 0; i < c.cmds.length; i++) {\n      const op = c.cmds[i];\n      if (!op || renderAgain) break;   // outrun by a mutation: the coalesced next pass redoes it\n      const key = `d${activeDeck}_op${i}`;","old":"    for (let i = 0; i < c.cmds.length; i++) {\n      const op = c.cmds[i];\n      const key = `d${activeDeck}_op${i}`;","patch_id":"p111","time":1792603594249},{"author":"agent","facet":"html","label":"rail copy for live use: drop the P4 dev-speak label, plain-language help","new":"      <span class=\"lbl\">flow editor</span>","old":"      <span class=\"lbl\">P4 · run tokens + journal ride scenehost</span>","patch_id":"p112","time":1792603971794},{"author":"agent","facet":"html","label":"rail help paragraph in plain language","new":"      <p class=\"fe-ro\">Tap an output socket (or press <kbd>W</kbd>) to start a\n        wire, then tap an input to connect it. Click a node kind to add it; with\n        a wire selected, the new node is spliced into that wire. <kbd>Del</kbd>\n        removes the selected wire or node; <b>tidy</b>/<b>untangle</b> lay the\n        case out; <b>save</b> writes the flow body (if it changed on the server\n        meanwhile you choose whose version wins). <kbd>⌘Z</kbd>/<kbd>⇧⌘Z</kbd> undo/redo.</p>","old":"      <p class=\"fe-ro\"><b>editing on</b> — wiring gestures are flownode\n        behaviors on the host; the palette + layout author the FlowDoc. Tap an\n        output socket (or <kbd>W</kbd>) to wire; click a palette op to add it\n        (with a wire selected, to splice it in); <kbd>Del</kbd> unwires a wire\n        / deletes an op; tidy/untangle auto-layout; <b>save</b> persists the\n        body via <code>write_flow_body</code> (base-hash → conflict). <kbd>⌘Z</kbd>/<kbd>⇧⌘Z</kbd> undo/redo.</p>","patch_id":"p113","time":1792603978255},{"author":"executive plan-step","facet":"js","label":"GL fix: facade setScene keeps host-owned specs (was wiping every flownode instance on the real stage)","new":"    // re-attach the ghost specs if a wire is armed (they ride the facade scene).\n    // setScene is a WHOLE-scene replace on the real GL stage: it would destroy\n    // every spec the scenehost owns (the flownode instances, host links, run\n    // tokens) along with the facade - nothing pickable until renderInstances\n    // re-adds them, and never when only the facade re-renders. Carry the\n    // host-owned (non-fx_) specs through so the facade replaces only itself.\n    // (The headless null stage's setScene is a no-op, which hid this.)\n    const hostOwned = stage.objects\n      ? [...stage.objects.values()].filter((o) => o && o.spec && !String(o.spec.id).startsWith(\"fx_\")).map((o) => o.spec)\n      : [];\n    stage.setScene(specs.concat(ghostSpecs(), hostOwned), { lights: \"default\", grid: true, camera: null });","old":"    // re-attach the ghost specs if a wire is armed (they ride the facade scene)\n    stage.setScene(specs.concat(ghostSpecs()), { lights: \"default\", grid: true, camera: null });","patch_id":"p114","time":1792605046974},{"author":"executive plan-step","facet":"js","label":"GL fix: wire ghost upserts/removes only its two specs (no whole-scene rebuild per pointer move)","new":"  let ghostTip = null;\n  // the ghost touches ONLY its own two specs: upsert while armed, remove when\n  // not. (It used to re-render the whole facade - a setScene per pointer move\n  // that, on the real GL stage, also destroyed every hosted flownode, so the\n  // input you were wiring TO was no longer pickable.)\n  function syncGhost() {\n    if (!stage) return;\n    const g = ghostSpecs();\n    if (g.length) { for (const s of g) stage.upsert(s); }\n    else { stage.removeObject(\"fx_ghostwire\"); stage.removeObject(\"fx_ghosttip\"); }\n  }\n  function showGhost(at) { ghostTip = at; syncGhost(); }\n  function moveGhost(at) { ghostTip = at; if (armSrc || wireMode) syncGhost(); }\n  function cancelWireGhost() { armSrc = null; wireMode = null; ghostTip = null; syncGhost(); if (hostApi) hostApi.setState(\"wireSrc\", null); }","old":"  let ghostTip = null;\n  function showGhost(at) { ghostTip = at; renderFacade(); }\n  function moveGhost(at) { ghostTip = at; if (armSrc || wireMode) renderFacade(); }\n  function cancelWireGhost() { armSrc = null; wireMode = null; ghostTip = null; if (hostApi) hostApi.setState(\"wireSrc\", null); }","patch_id":"p115","time":1792605079071},{"author":"executive plan-step","facet":"js","label":"GL fix: cancel paths drop the ghost via cancelWireGhost (no facade rebuild)","new":"    if (armSrc || wireMode) { cancelWireGhost(); }","old":"    if (armSrc || wireMode) { cancelWireGhost(); renderFacade(); }","patch_id":"p116","time":1792605101337},{"author":"executive plan-step","facet":"js","label":"GL fix: Esc cancel drops the ghost via cancelWireGhost (no facade rebuild)","new":"if (e.key === \"Escape\") { e.preventDefault(); cancelWireGhost(); status(\"wiring cancelled\"); return; }","old":"if (e.key === \"Escape\") { e.preventDefault(); cancelWireGhost(); renderFacade(); status(\"wiring cancelled\"); return; }","patch_id":"p117","time":1792605101339},{"author":"executive plan-step","facet":"js","label":"GL fix: Esc-with-arm cancel drops the ghost via cancelWireGhost (no facade rebuild)","new":"if (armSrc) { cancelWireGhost(); status(\"wiring cancelled\"); }","old":"if (armSrc) { cancelWireGhost(); renderFacade(); status(\"wiring cancelled\"); }","patch_id":"p118","time":1792605101342},{"author":"executive plan-step","facet":"js","label":"GL fix: onOpDrag takes flownode's ONE payload {phase,opIndex,evt,which?}; body drag end commits a snapped moveOp","new":"      hostApi.setState(\"onOpDrag\", (p) => {\n        // drag an op body to move it (front-ortho plane, z kept). Undoable.\n        // flownode hands ONE payload {phase, key, opIndex, evt, which?, ord?}\n        // (it used to be read as (opIndex, evt), so no drag ever committed);\n        // the node live-follows the pointer itself, the move commits on end.\n        if (!p || p.which) return;                 // socket drags: not an op move\n        if (p.phase !== \"end\" || running) return;\n        const c = focusedCase(); const op = c && c.cmds[p.opIndex]; if (!op || !op.pos) return;\n        const evt = p.evt || {};\n        let to;\n        if (typeof evt.dx === \"number\" && typeof evt.dy === \"number\") {\n          if (Math.hypot(evt.dx, evt.dy) < 1e-6) return;\n      