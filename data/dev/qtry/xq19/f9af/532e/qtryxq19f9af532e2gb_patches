{"data":{"list":[{"author":"installer","facet":"html","label":"install sync","new":"<section class=\"nb-shelf\">\n  <header class=\"sh-head\">\n    <h1>The shelf</h1>\n    <p>Every library is a stack of cards. No folders, no tree — a library holds\n    assets and controls, a control holds everything else. Open a stack to fan\n    out its controls.</p>\n  </header>\n  <div class=\"sh-groups\"></div>\n  <div class=\"sh-fan\" hidden>\n    <div class=\"sh-fan-head\">\n      <span class=\"fh-name\"></span>\n      <span class=\"lbl\">controls — dots show which facets each card carries</span>\n    </div>\n    <p class=\"fh-desc\"></p>\n    <div class=\"fh-tools\" hidden>\n      <button class=\"fh-meta-btn\" hidden>meta ▸</button>\n      <button class=\"fh-assets-btn\">assets ▸</button>\n      <button class=\"fh-settings-btn\">rust settings ▸</button>\n    </div>\n    <form class=\"fh-meta\" hidden>\n      <input class=\"fm-desc\" placeholder=\"describe this library — agents discover it through desc\">\n      <input class=\"fm-groups\" placeholder=\"groups (comma-delimited)\">\n      <button type=\"submit\" class=\"fm-apply\">set</button>\n      <span class=\"fm-note\"></span>\n    </form>\n    <div class=\"fh-assets\" hidden>\n      <p class=\"fa-cap\">The library's <code>_ASSETS</code> files, served at\n      <code>/app/asset/&lt;lib&gt;/&lt;name&gt;</code>. Writes go through the\n      agent API (<code>write_asset</code>/<code>rename_asset</code>/\n      <code>delete_asset</code>), journal-free but admin-gated.</p>\n      <div class=\"fa-rows\"></div>\n      <form class=\"fa-new\" hidden>\n        <input class=\"fa-name\" placeholder=\"name (relative path, e.g. styles/x.css)\">\n        <textarea class=\"fa-content\" rows=\"3\"\n          placeholder=\"text content — OR leave empty and give a server-side file path below\"></textarea>\n        <input class=\"fa-tempfile\"\n          placeholder=\"server-side file path (for binary/large files; instance-local)\">\n        <button type=\"submit\" class=\"fa-write\">write asset</button>\n        <span class=\"fa-note\"></span>\n      </form>\n    </div>\n    <form class=\"fh-settings\" hidden>\n      <p class=\"fs-cap\">Rust settings — meta.json's <code>root</code>,\n      <code>cargo.crate_types</code>, <code>cargo.dependencies</code>. Inert\n      until this library contains Rust; editable so adding Rust later has a\n      defined home. Saved via <code>dev.libsettings.save_library_config</code>.</p>\n      <label class=\"lbl\">root <input class=\"fs-root\"></label>\n      <label class=\"lbl\">crate types (comma) <input class=\"fs-types\"></label>\n      <label class=\"lbl\">dependencies (one <code>name = spec</code> per line)\n        <textarea class=\"fs-deps\" rows=\"4\"></textarea></label>\n      <button type=\"submit\" class=\"fs-save\" hidden>save settings</button>\n      <span class=\"fs-note\"></span>\n    </form>\n    <div class=\"sh-cards\"></div>\n  </div>\n</section>\n","old":"","patch_id":"p1","time":1785011188686},{"author":"installer","facet":"css","label":"install sync","new":".nb-shelf {\n  height: 100%;\n  overflow: auto;\n  padding: 34px 42px 80px;\n}\n.nb-shelf .sh-head,\n.nb-shelf .sh-groups,\n.nb-shelf .sh-fan {\n  max-width: 980px;\n  margin: 0 auto;\n}\n.nb-shelf h1 {\n  font-family: var(--disp);\n  font-size: 22px;\n  font-weight: 500;\n  letter-spacing: 0.04em;\n  margin-bottom: 6px;\n  text-wrap: balance;\n}\n.nb-shelf .sh-head p {\n  color: var(--text-dim);\n  max-width: 62ch;\n  line-height: 1.55;\n}\n.nb-shelf .sh-group { margin-top: 30px; }\n.nb-shelf .sh-group > .lbl { display: block; margin-bottom: 12px; }\n.nb-shelf .sh-stacks {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\n  gap: 14px;\n}\n.nb-shelf .sh-stack {\n  position: relative;\n  text-align: left;\n  padding: 14px 16px 12px;\n  background: var(--panel);\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  transition: transform 0.12s ease, border-color 0.12s ease;\n}\n.nb-shelf .sh-stack::before,\n.nb-shelf .sh-stack::after {\n  content: \"\";\n  position: absolute;\n  left: 4px;\n  right: 4px;\n  top: -4px;\n  height: 4px;\n  border: 1px solid var(--line);\n  border-bottom: none;\n  border-radius: 6px 6px 0 0;\n  background: var(--panel);\n}\n.nb-shelf .sh-stack::after {\n  top: -7px;\n  left: 8px;\n  right: 8px;\n  opacity: 0.6;\n}\n.nb-shelf .sh-stack:hover {\n  transform: translateY(-2px);\n  border-color: var(--text-faint);\n}\n.nb-shelf .sh-stack.on { border-color: var(--accent-dim); }\n.nb-shelf .sh-stack .s-name {\n  font-family: var(--mono);\n  font-size: 14px;\n  margin-bottom: 5px;\n}\n.nb-shelf .sh-stack .s-meta {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.05em;\n  color: var(--text-faint);\n  font-variant-numeric: tabular-nums;\n}\n.nb-shelf .sh-fan { margin-top: 26px; }\n.nb-shelf .sh-fan-head {\n  display: flex;\n  align-items: baseline;\n  gap: 12px;\n  margin-bottom: 14px;\n}\n.nb-shelf .fh-name {\n  font-family: var(--mono);\n  font-size: 15px;\n  color: var(--accent);\n}\n.nb-shelf .sh-cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));\n  gap: 14px;\n}\n\n/* ── M4: library meta + Rust settings panel ──────────────── */\n.nb-shelf .fh-desc { font-size: 12.5px; color: var(--text-dim); margin: 2px 0 0; }\n.nb-shelf .fh-desc.empty { color: var(--text-faint); font-style: italic; }\n.nb-shelf .fh-tools { display: flex; gap: 14px; margin-top: 4px; }\n.nb-shelf .fh-tools button { font: 10.5px var(--mono); color: var(--accent); }\n.nb-shelf .fh-meta,\n.nb-shelf .fh-settings {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  align-items: center;\n  margin-top: 8px;\n  padding: 10px 12px;\n  background: var(--panel);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n}\n.nb-shelf .fh-meta[hidden],\n.nb-shelf .fh-settings[hidden] { display: none; }\n.nb-shelf .fh-meta input,\n.nb-shelf .fh-settings input,\n.nb-shelf .fh-settings textarea {\n  background: var(--panel-2);\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  padding: 4px 9px;\n  font: 11.5px var(--mono);\n  color: var(--text);\n  flex: 1 1 200px;\n}\n.nb-shelf .fh-settings { flex-direction: column; align-items: stretch; }\n.nb-shelf .fh-settings .fs-cap { font-size: 11.5px; color: var(--text-dim); }\n.nb-shelf .fh-settings label { display: flex; flex-direction: column; gap: 3px; }\n.nb-shelf .fh-meta .fm-apply,\n.nb-shelf .fh-settings .fs-save {\n  font: 11px var(--mono);\n  color: var(--ground);\n  background: var(--accent);\n  border-radius: 6px;\n  padding: 4px 12px;\n  align-self: flex-start;\n}\n.nb-shelf .fh-meta .fm-note,\n.nb-shelf .fh-settings .fs-note { font: 10.5px var(--mono); color: var(--danger); }\n.nb-shelf .fh-tools[hidden] { display: none; }\n\n/* ── asset browser (G-1) ─────────────────────────────────── */\n.nb-shelf .fh-assets {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin-top: 8px;\n  padding: 10px 12px;\n  background: var(--panel);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n}\n.nb-shelf .fh-assets[hidden] { display: none; }\n.nb-shelf .fh-assets .fa-cap { font-size: 11.5px; color: var(--text-dim); }\n.nb-shelf .fa-rows { display: flex; flex-direction: column; gap: 2px; }\n.nb-shelf .fa-rows.fa-empty { font: 11px var(--mono); color: var(--text-faint); }\n.nb-shelf .fa-row {\n  display: flex;\n  align-items: baseline;\n  gap: 12px;\n  padding: 4px 2px;\n  border-bottom: 1px solid var(--line-soft);\n  font-size: 12.5px;\n}\n.nb-shelf .fa-row:last-child { border-bottom: none; }\n.nb-shelf .fa-open { font-family: var(--mono); color: var(--text); text-decoration: none; }\n.nb-shelf .fa-open:hover { color: var(--accent); }\n.nb-shelf .fa-size { font: 10.5px var(--mono); color: var(--text-faint); }\n.nb-shelf .fa-act { font: 10.5px var(--mono); color: var(--accent); }\n.nb-shelf .fa-act.fa-danger { color: var(--danger); margin-left: auto; }\n.nb-shelf .fa-new { display: flex; flex-direction: column; gap: 6px; margin-top: 4px; }\n.nb-shelf .fa-new[hidden] { display: none; }\n.nb-shelf .fa-new input,\n.nb-shelf .fa-new textarea {\n  background: var(--panel-2);\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  padding: 4px 9px;\n  font: 11.5px var(--mono);\n  color: var(--text);\n}\n.nb-shelf .fa-new .fa-write {\n  align-self: flex-start;\n  font: 11px var(--mono);\n  color: var(--ground);\n  background: var(--accent);\n  border-radius: 6px;\n  padding: 4px 12px;\n}\n.nb-shelf .fa-new .fa-note { font: 10.5px var(--mono); color: var(--danger); }\n","old":"","patch_id":"p2","time":1785011188694},{"author":"installer","facet":"js","label":"install sync","new":"// shelf — libraries as stacks of cards, grouped by their `root` value\n// verbatim (pure metadata — the platform has no category concept, so the\n// shelf invents none; G-2). The fan carries the library's desc/groups meta\n// (set_library_meta) and the \"Rust settings\" panel (dev.libsettings).\n\nimport { mountControl } from \"../../assets/loader.js\";\nimport { store } from \"../../assets/store.js\";\n\nexport async function init(host, { openLib, openControl, toast }) {\n  const groupsEl = host.querySelector(\".sh-groups\");\n  const fanEl = host.querySelector(\".sh-fan\");\n  const cardsEl = host.querySelector(\".sh-cards\");\n  const stackEls = new Map();\n\n  const libs = await store.libs();\n  if (libs instanceof Error) {\n    toast.show(`could not list libraries: ${libs.message}`);\n    return {};\n  }\n  const writable = store.writable();\n  const patchApi = await store.patchApi();\n\n  const groups = new Map();\n  for (const lib of [...libs].sort((a, b) => a.id.localeCompare(b.id))) {\n    const label = `root · ${lib.root ?? \"?\"}`;\n    if (!groups.has(label)) groups.set(label, []);\n    groups.get(label).push(lib);\n  }\n\n  for (const [label, members] of [...groups.entries()].sort()) {\n    const group = document.createElement(\"div\");\n    group.className = \"sh-group\";\n    const lbl = document.createElement(\"span\");\n    lbl.className = \"lbl\";\n    lbl.textContent = label;\n    const grid = document.createElement(\"div\");\n    grid.className = \"sh-stacks\";\n    group.append(lbl, grid);\n    groupsEl.appendChild(group);\n\n    for (const lib of members) {\n      const stack = document.createElement(\"button\");\n      stack.className = \"sh-stack\";\n      stack.innerHTML =\n        `<span class=\"s-name\"></span><span class=\"s-meta\">v${lib.version ?? \"?\"}</span>`;\n      stack.querySelector(\".s-name\").textContent = lib.id;\n      if (lib.desc) stack.title = lib.desc;\n      stack.addEventListener(\"click\", () => openLib(lib.id));\n      grid.appendChild(stack);\n      stackEls.set(lib.id, stack);\n\n      store.controls(lib.id).then((controls) => {\n        if (!(controls instanceof Error)) {\n          stack.querySelector(\".s-meta\").textContent =\n            `${controls.length} controls · v${lib.version ?? \"?\"}`;\n        }\n      });\n    }\n  }\n\n  // ── library meta (set_library_meta) ───────────────────────\n  function renderLibMeta(lib) {\n    const descEl = host.querySelector(\".fh-desc\");\n    descEl.textContent = lib.desc\n      || \"no description — agents discover this library through desc\";\n    descEl.classList.toggle(\"empty\", !lib.desc);\n    host.querySelector(\".fh-tools\").hidden = false;\n    host.querySelector(\".fh-meta-btn\").hidden = !(writable && patchApi);\n  }\n\n  function wireLibMeta(lib) {\n    const form = host.querySelector(\".fh-meta\");\n    host.querySelector(\".fh-meta-btn\").onclick = () => {\n      form.hidden = !form.hidden;\n      if (!form.hidden) {\n        form.querySelector(\".fm-desc\").value = lib.desc ?? \"\";\n        form.querySelector(\".fm-groups\").value = lib.groups ?? \"\";\n        form.querySelector(\".fm-note\").textContent = \"\";\n        form.querySelector(\".fm-desc\").focus();\n      }\n    };\n    form.onsubmit = async (ev) => {\n      ev.preventDefault();\n      const note = form.querySelector(\".fm-note\");\n      const desc = form.querySelector(\".fm-desc\").value.trim();\n      const groupsV = form.querySelector(\".fm-groups\").value.trim();\n      const dArg = desc && desc !== (lib.desc ?? \"\") ? desc : \"\";\n      const gArg = groupsV && groupsV !== (lib.groups ?? \"\") ? groupsV : \"\";\n      if ((lib.desc && !desc) || (lib.groups && !groupsV)) {\n        note.textContent = \"v1 can't clear a field — set a new value instead\";\n      }\n      if (!dArg && !gArg) {\n        if (!note.textContent) note.textContent = \"nothing changed\";\n        return;\n      }\n      const r = await store.setLibraryMeta(lib.id, dArg, gArg);\n      if (r.status !== \"ok\") {\n        note.textContent = `failed: ${r.msg}`;\n        return;\n      }\n      if (dArg) lib.desc = dArg;\n      if (gArg) lib.groups = gArg;\n      form.hidden = true;\n      renderLibMeta(lib);\n      toast.show(\"set_library_meta → saved to meta.json (the instance re-reads it on restart)\");\n    };\n  }\n\n  // ── assets (G-1, the P1 agent commands) ───────────────────\n  function fmtSize(n) {\n    if (n < 1024) return `${n} B`;\n    if (n < 1024 * 1024) return `${(n / 1024).toFixed(1)} KB`;\n    return `${(n / 1024 / 1024).toFixed(1)} MB`;\n  }\n\n  function wireAssets(lib) {\n    const panel = host.querySelector(\".fh-assets\");\n    const rowsEl = panel.querySelector(\".fa-rows\");\n    const form = panel.querySelector(\".fa-new\");\n    const note = form.querySelector(\".fa-note\");\n\n    async function refresh() {\n      const r = await store.listAssets(lib.id);\n      if (r.status !== \"ok\") {\n        rowsEl.textContent = `assets need the agent API on a live connection — ${r.msg}`;\n        rowsEl.className = \"fa-rows fa-empty\";\n        return;\n      }\n      rowsEl.className = \"fa-rows\";\n      const assets = r.assets ?? [];\n      if (!assets.length) {\n        rowsEl.textContent = \"no assets yet\";\n        rowsEl.className = \"fa-rows fa-empty\";\n        return;\n      }\n      rowsEl.replaceChildren(...assets.map((a) => {\n        const row = document.createElement(\"div\");\n        row.className = \"fa-row\";\n        row.innerHTML = `<a class=\"fa-open\" target=\"_blank\"></a>\n          <span class=\"fa-size\"></span>`;\n        const link = row.querySelector(\".fa-open\");\n        link.textContent = a.name;\n        link.href = `/app/asset/${lib.id}/${a.name}`;\n        link.title = \"open in a new tab\";\n        row.querySelector(\".fa-size\").textContent = fmtSize(a.size ?? 0);\n        if (writable && patchApi) {\n          const ren = document.createElement(\"button\");\n          ren.className = \"fa-act\";\n          ren.textContent = \"rename ▸\";\n          ren.addEventListener(\"click\", async () => {\n            const to = prompt(`rename ${a.name} to (relative path):`, a.name);\n            if (!to || to === a.name) return;\n            const rr = await store.renameAsset(lib.id, a.name, to);\n            if (rr.status !== \"ok\") toast.show(`rename failed: ${rr.msg}`);\n            refresh();\n          });\n          const del = document.createElement(\"button\");\n          del.className = \"fa-act fa-danger\";\n          del.textContent = \"delete\";\n          del.addEventListener(\"click\", async () => {\n            // two-click confirm, §5.6 spirit without a modal\n            if (del.textContent !== \"really delete?\") {\n              del.textContent = \"really delete?\";\n              setTimeout(() => { del.textContent = \"delete\"; }, 2500);\n              return;\n            }\n            const rr = await store.deleteAsset(lib.id, a.name);\n            if (rr.status !== \"ok\") toast.show(`delete failed: ${rr.msg}`);\n            refresh();\n          });\n          row.append(ren, del);\n        }\n        return row;\n      }));\n    }\n\n    host.querySelector(\".fh-assets-btn\").onclick = () => {\n      panel.hidden = !panel.hidden;\n      if (!panel.hidden) {\n        form.hidden = !(writable && patchApi);\n        refresh();\n      }\n    };\n\n    form.onsubmit = async (ev) => {\n      ev.preventDefault();\n      const name = form.querySelector(\".fa-name\").value.trim();\n      const content = form.querySelector(\".fa-content\").value;\n      const tempfile = form.querySelector(\".fa-tempfile\").value.trim();\n      if (!name) {\n        note.textContent = \"a name is required\";\n        return;\n      }\n      const r = await store.writeAsset(lib.id, name, tempfile ? \"\" : content, tempfile);\n      if (r.status !== \"ok\") {\n        note.textContent = `failed: ${r.msg}`;\n        return;\n      }\n      note.textContent = \"\";\n      form.querySelector(\".fa-name\").value = \"\";\n      form.querySelector(\".fa-content\").value = \"\";\n      form.querySelector(\".fa-tempfile\").value = \"\";\n      toast.show(`write_asset → ${r.replaced ? \"replaced\" : \"created\"} · ${name} (${fmtSize(r.size ?? 0)})`);\n      refresh();\n    };\n  }\n\n  // ── Rust settings (dev.libsettings, G-3) ──────────────────\n  // meta.json's root + cargo.crate_types + cargo.dependencies. Meaningless\n  // until a library contains Rust — but editable, so adding Rust later has\n  // a defined home. save_library_config rebuilds all three fields from the\n  // form, so the form always round-trips get_library_config.\n  function wireSettings(lib) {\n    const panel = host.querySelector(\".fh-settings\");\n    host.querySelector(\".fh-settings-btn\").onclick = async () => {\n      panel.hidden = !panel.hidden;\n      if (panel.hidden) return;\n      const got = await store.invoke(\"dev\", \"libsettings\", \"get_library_config\", { id: lib.id });\n      if (got instanceof Error || got.envelope.status !== \"ok\") {\n        panel.querySelector(\".fs-note\").textContent =\n          `could not load settings: ${got instanceof Error ? got.message : got.envelope.msg}`;\n        return;\n      }\n      const cfg = got.envelope.data;\n      panel.querySelector(\".fs-root\").value = cfg.root ?? \"\";\n      panel.querySelector(\".fs-types\").value = (cfg.library_types ?? []).join(\", \");\n      panel.querySelector(\".fs-deps\").value = cfg.library_dependencies ?? \"\";\n      panel.querySelector(\".fs-save\").hidden = !writable;\n      panel.querySelector(\".fs-note\").textContent = \"\";\n    };\n    panel.onsubmit = async (ev) => {\n      ev.preventDefault();\n      const note = panel.querySelector(\".fs-note\");\n      const types = panel.querySelector(\".fs-types\").value\n        .split(\",\").map((t) => t.trim()).filter(Boolean);\n      const saved = await store.invoke(\"dev\", \"libsettings\", \"save_library_config\", {\n        data: {\n          id: lib.id,\n          library_root: panel.querySelector(\".fs-root\").value.trim(),\n          library_types: types,\n          library_dependencies: panel.querySelector(\".fs-deps\").value,\n        },\n      });\n      if (saved instanceof Error || saved.envelope.status !== \"ok\") {\n        note.textContent =\n          `save failed: ${saved instanceof Error ? saved.message : saved.envelope.msg}`;\n        return;\n      }\n      note.textContent = \"\";\n      toast.show(\"save_library_config → meta.json saved\");\n    };\n  }\n\n  async function showFan(libId) {\n    for (const [id, el] of stackEls) el.classList.toggle(\"on\", id === libId);\n    fanEl.hidden = false;\n    host.querySelector(\".fh-name\").textContent = libId;\n    host.querySelector(\".fh-meta\").hidden = true;\n    host.querySelector(\".fh-settings\").hidden = true;\n    host.querySelector(\".fh-assets\").hidden = true;\n    cardsEl.replaceChildren();\n\n    const lib = libs.find((l) => l.id === libId) ?? { id: libId };\n    renderLibMeta(lib);\n    wireLibMeta(lib);\n    wireSettings(lib);\n    wireAssets(lib);\n\n    const controls = await store.controls(libId);\n    if (controls instanceof Error) {\n      toast.show(`could not read ${libId}: ${controls.message}`);\n      return;\n    }\n    for (const ctl of controls) {\n      const slot = document.createElement(\"div\");\n      cardsEl.appendChild(slot);\n      const card = await mountControl(\"card\", slot, {\n        name: ctl.name,\n        onOpen: () => openControl(libId, ctl.id),\n      });\n      store.control(libId, ctl.id).then((record) => {\n        card.setRecord(record instanceof Error ? null : record);\n      });\n    }\n    fanEl.scrollIntoView({ behavior: \"smooth\", block: \"nearest\" });\n  }\n\n  return { showFan };\n}\n","old":"","patch_id":"p3","time":1785011188711},{"author":"installer","facet":"html","label":"install sync","new":"<section class=\"nb-shelf\">\n  <header class=\"sh-head\">\n    <h1>The shelf</h1>\n    <p>Every library is a stack of cards. No folders, no tree — a library holds\n    assets and controls, a control holds everything else. Open a stack to fan\n    out its controls.</p>\n  </header>\n  <div class=\"sh-groups\"></div>\n  <form class=\"sh-newlib\" hidden>\n    <button type=\"button\" class=\"sh-newlib-open\">+ new library</button>\n    <span class=\"sh-newlib-fields\" hidden>\n      <input class=\"sh-newlib-name\" placeholder=\"library name — lowercase, no spaces\"\n             aria-label=\"New library name\">\n      <button type=\"submit\" class=\"sh-newlib-go\">create</button>\n      <span class=\"sh-newlib-note\"></span>\n    </span>\n  </form>\n  <div class=\"sh-fan\" hidden>\n    <div class=\"sh-fan-head\">\n      <span class=\"fh-name\"></span>\n      <span class=\"lbl\">controls — dots show which facets each card carries</span>\n    </div>\n    <p class=\"fh-desc\"></p>\n    <div class=\"fh-tools\" hidden>\n      <button class=\"fh-meta-btn\" hidden>meta ▸</button>\n      <button class=\"fh-assets-btn\">assets ▸</button>\n      <button class=\"fh-settings-btn\">rust settings ▸</button>\n    </div>\n    <form class=\"fh-meta\" hidden>\n      <input class=\"fm-desc\" placeholder=\"describe this librar