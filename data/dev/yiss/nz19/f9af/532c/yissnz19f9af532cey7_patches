 border-color: var(--accent-dim);\n  background: rgba(240, 166, 60, 0.07);\n}\n.fr-connect .cn-live { display: flex; flex-direction: column; gap: 8px; }\n.fr-connect input {\n  background: var(--ground);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 8px 10px;\n  font: 12px var(--mono);\n  color: var(--text);\n}\n.fr-connect input::placeholder { color: var(--text-faint); }\n.fr-connect .cn-writable {\n  text-align: left;\n  padding: 9px 12px;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  font: 12px var(--mono);\n  color: var(--text-dim);\n}\n.fr-connect .cn-writable.on {\n  color: var(--danger);\n  border-color: var(--danger);\n  background: rgba(193, 90, 90, 0.08);\n}\n.fr-connect .cn-warn {\n  font-size: 11.5px;\n  color: var(--danger);\n  line-height: 1.5;\n  max-width: 48ch;\n}\n.fr-connect .cn-warn b { font-weight: 700; }\n.fr-connect .cn-actions { display: flex; gap: 9px; }\n.fr-connect .cn-go {\n  background: var(--accent);\n  color: #241a08;\n  font-weight: 600;\n  font-size: 13px;\n  border-radius: 8px;\n  padding: 8px 18px;\n}\n.fr-connect .cn-cancel {\n  font-size: 13px;\n  color: var(--text-dim);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 8px 14px;\n}\n.fr-connect .cn-err { color: var(--danger); font-size: 12px; max-width: 46ch; }\n","old":".nb-frame {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  height: 52px;\n  padding: 0 18px;\n  flex: none;\n  background: var(--panel);\n  border-bottom: 1px solid var(--line);\n  position: relative;\n  z-index: 40;\n}\n.nb-frame .fr-wordmark {\n  font-family: var(--disp);\n  font-size: 17px;\n  letter-spacing: 0.22em;\n  display: flex;\n  align-items: center;\n  gap: 9px;\n}\n.nb-frame .fr-wordmark .hex { color: var(--accent); font-size: 13px; }\n.nb-frame .fr-crumb {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font: 13px var(--mono);\n}\n.nb-frame .seg { color: var(--text-dim); padding: 4px 8px; border-radius: 6px; }\n.nb-frame 