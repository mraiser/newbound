on type=\"button\" class=\"cn-mode\" data-mode=\"mock\">mock — fixtures, no backend</button>\n      <button type=\"button\" class=\"cn-mode\" data-mode=\"live\">live — running instance</button>\n    </div>\n    <div class=\"cn-live\" hidden>\n      <input class=\"cn-url\" placeholder=\"base url\" aria-label=\"Base URL\">\n      <input class=\"cn-sid\" placeholder=\"sessionid (dev console of the tab newbound opens)\" aria-label=\"Session id\">\n      <button type=\"button\" class=\"cn-writable\" aria-pressed=\"false\">saves off — read-only connection</button>\n      <p class=\"cn-warn\" hidden>saves go through dev.save_control on whatever\n      instance this points at. Point it at a <b>disposable copy only</b> —\n      never the primary instance.</p>\n    </div>\n    <div class=\"cn-actions\">\n      <button type=\"button\" class=\"cn-go\">connect</button>\n      <button value=\"cancel\" class=\"cn-cancel\">cancel</button>\n    </div>\n    <p class=\"cn-err\" role=\"alert\" hidden></p>\n  </form>\n</dialog>\n","patch_id":"p8","time":1785024831227},{"author":"installer","facet":"css","label":"install sync","new":".nb-frame {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  height: 52px;\n  padding: 0 18px;\n  flex: none;\n  background: var(--panel);\n  border-bottom: 1px solid var(--line);\n  position: relative;\n  z-index: 40;\n}\n.nb-frame .fr-wordmark {\n  font-family: var(--disp);\n  font-size: 17px;\n  letter-spacing: 0.22em;\n  display: flex;\n  align-items: center;\n  gap: 9px;\n}\n.nb-frame .fr-wordmark .hex { color: var(--accent); font-size: 13px; }\n.nb-frame .fr-crumb {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font: 13px var(--mono);\n}\n.nb-frame .seg { color: var(--text-dim); padding: 4px 8px; border-radius: 6px; }\n.nb-frame button.seg:hover { color: var(--accent); }\n.nb-frame .seg.on { color: var(--text); background: var(--panel-2); }\n.nb-frame .sep { color: var(--text-faint); }\n.nb-frame .fr-cap {\n  font: 10px var(--mono