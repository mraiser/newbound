 border-radius: 8px;\n  font: 12px var(--mono);\n  color: var(--text-dim);\n}\n.fr-connect .cn-writable.on {\n  color: var(--danger);\n  border-color: var(--danger);\n  background: rgba(193, 90, 90, 0.08);\n}\n.fr-connect .cn-warn {\n  font-size: 11.5px;\n  color: var(--danger);\n  line-height: 1.5;\n  max-width: 48ch;\n}\n.fr-connect .cn-warn b { font-weight: 700; }\n.fr-connect .cn-actions { display: flex; gap: 9px; }\n.fr-connect .cn-go {\n  background: var(--accent);\n  color: #241a08;\n  font-weight: 600;\n  font-size: 13px;\n  border-radius: 8px;\n  padding: 8px 18px;\n}\n.fr-connect .cn-cancel {\n  font-size: 13px;\n  color: var(--text-dim);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 8px 14px;\n}\n.fr-connect .cn-err { color: var(--danger); font-size: 12px; max-width: 46ch; }\n\n/* the hidden attribute must always win (see tokens.css) */\n.nb-frame [hidden],\n.fr-connect [hidden] { display: none !important; }\n","old":".nb-frame {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  height: 52px;\n  padding: 0 18px;\n  flex: none;\n  background: var(--panel);\n  border-bottom: 1px solid var(--line);\n  position: relative;\n  z-index: 40;\n}\n.nb-frame .fr-wordmark {\n  font-family: var(--disp);\n  font-size: 17px;\n  letter-spacing: 0.22em;\n  display: flex;\n  align-items: center;\n  gap: 9px;\n}\n.nb-frame .fr-wordmark .hex { color: var(--accent); font-size: 13px; }\n.nb-frame .fr-crumb {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font: 13px var(--mono);\n}\n.nb-frame .seg { color: var(--text-dim); padding: 4px 8px; border-radius: 6px; }\n.nb-frame button.seg:hover { color: var(--accent); }\n.nb-frame .seg.on { color: var(--text); background: var(--panel-2); }\n.nb-frame .sep { color: var(--text-faint); }\n.nb-frame .fr-cap {\n  font: 10px var(--mono);\n  color: var(--text-faint);\n  letter-spacing: 0.06em;\n  margin-left: 4px;\n}\n.nb-frame .fr-spacer { flex: 1; }\n.nb-frame .fr-session {\n  padding: 7px 12px;