{"data":{"attachmentkeynames":["rs"],"desc":"Creates or wholly replaces a named timer on a control (Q7: replace-only). Writes the component record the runtime's timer loop consumes (cmd/cmddb/params/start/startunit/interval/intervalunit/repeat - the dev lib's edittimer shape), links it in the control record's timer array, registers it live immediately (same as the dev editor's timeron; replaces any prior registration), and journals the change on the control's _patches record (facet 'timer'). The command is resolved by name on this control.","import":"use flowlang::datastore::DataStore;\nuse flowlang::flowlang::system::time::time;\nuse flowlang::flowlang::system::unique_session_id::unique_session_id;\nuse flowlang::appserver::add_timer;\nuse flowlang::appserver::remove_timer;\nuse ndata::dataobject::DataObject;\nuse ndata::dataarray::DataArray;\n","params":[{"desc":"Library name.","name":"lib","type":"String"},{"desc":"Control name within the library.","name":"ctl","type":"String"},{"desc":"Timer name — the replace key: setting an existing name wholly replaces that timer's component record (Q7: replace-only, no partial patching).","name":"name","type":"String"},{"desc":"Command name on this control to run when the timer fires.","name":"cmd","type":"String"},{"desc":"Delay before the first firing, in startunit units (0 = immediately). An absolute epoch-milliseconds value with startunit milliseconds also works — the dev editor's third mode.","name":"start","type":"Integer"},{"desc":"one of: milliseconds, seconds, minutes, hours, days","name":"startunit","type":"String"},{"desc":"Repeat interval in intervalunit units (meaningful when repeat is true).","name":"interval","type":"Integer"},{"desc":"one of: milliseconds, seconds, minutes, hours, days","name":"intervalunit","type":"String"},{"desc":"true = fire every interval after the first firing; false = fire once.","name":"repeat","type":"Boolean"},{"desc":"Who is making the change, recorded in the journal. May be empty.","name":"author","type":"String"}],"returntype":"FLAT","type":"rust"},"id":"kxtnil19f99e8b05bj9cfd","readers":[],"time":1784993591387,"username":"system","writers":[]}