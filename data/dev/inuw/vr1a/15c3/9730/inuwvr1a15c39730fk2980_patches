{"data":{"list":[{"author":"executive","facet":"html","label":"flowview3d html: head/toolbar + scenehost + gate rail + inspector (P1 gate)","new":"<section class=\"nb-flowview3d\" tabindex=\"0\">\n  <div class=\"fv-head\">\n    <button class=\"fv-back\" title=\"Back (Esc)\">←</button>\n    <span class=\"fv-title\"></span>\n    <span class=\"fv-crumbs\"></span>\n    <span class=\"fv-spacer\"></span>\n    <span class=\"fv-status\" role=\"status\">booting…</span>\n    <span class=\"fv-decks\" role=\"tablist\" aria-label=\"case chain\"></span>\n    <button class=\"fv-proj\" aria-pressed=\"false\" title=\"Front-orthographic (2) / perspective (3)\">persp</button>\n    <button class=\"fv-frame\" title=\"Frame the deck (A)\">frame</button>\n  </div>\n\n  <div class=\"fv-main\">\n    <!-- the ONE runtime: an app:scenehost; ops are addControl'd into it and\n         the deck's scene facet (toSceneDoc) rides the stage. editing OFF. -->\n    <div class=\"data-control fv-host\" data-control=\"app:scenehost:{}\"></div>\n\n    <aside class=\"fv-rail\">\n      <span class=\"lbl\">P1 gate · read-only viewer rides scenehost</span>\n      <ul class=\"fv-gate\">\n        <li class=\"fv-g-host\">host booted — <b>pending</b></li>\n        <li class=\"fv-g-deck\">decks projected — <b>pending</b></li>\n        <li class=\"fv-g-select\">selection emphasis — <b>pending</b></li>\n        <li class=\"fv-g-camera\">camera toolbar — <b>pending</b></li>\n        <li class=\"fv-g-drill\">drill — <b>pending</b></li>\n      </ul>\n      <p class=\"fv-ro\"><b>read-only</b> — the gate that proves app:scenehost can\n        carry the editor. Decks, selection emphasis, drill, and the camera\n        toolbar ride the host; the scene facet is derived from the flow body\n        (toSceneDoc). Editing arrives in P2 as flownode behaviors.</p>\n      <p class=\"fv-keys lbl\">keys</p>\n      <ul class=\"fv-keys-list\">\n        <li><kbd>2</kbd> front-ortho · <kbd>3</kbd> perspective · <kbd>A</kbd> frame deck</li>\n        <li><kbd>[</kbd> <kbd>]</kbd> walk case chain · <kbd>Esc</kbd> back / clear</li>\n        <li><kbd>click</kbd> select · <kbd>dblclick</kbd> drill a local sub-flow</li>\n      </ul>\n    </aside>\n\n    <aside class=\"fv-inspect\">\n      <span class=\"lbl\">inspector</span>\n      <div class=\"fv-inspect-body\">\n        <p class=\"fv-empty\">Select an element. Local sub-flows drill in on\n          double-click — you are inside the program, not looking at a picture\n          of it.</p>\n      </div>\n    </aside>\n  </div>\n</section>\n<div class=\"data-control\" data-control=\"dev:flowdoc\" hidden></div>\n<div class=\"data-control\" data-control=\"dev:flowproject\" hidden></div>\n","old":"","patch_id":"p1","time":1792548654784},{"author":"executive","facet":"css","label":"flowview3d css: header/toolbar, main split (host + gate rail + inspector), gate pass/fail colors","new":".nb-flowview3d { display: flex; flex-direction: column; height: 100%; min-height: 0; background: var(--bg, #14171b); color: var(--fg, #d7dde3); font: 13px/1.45 system-ui, sans-serif; outline: none; }\n.nb-flowview3d .fv-head { display: flex; align-items: center; gap: 8px; padding: 6px 10px; border-bottom: 1px solid var(--line, #2a3138); background: var(--panel, #1b2127); }\n.nb-flowview3d .fv-head button { background: var(--btn, #232b33); color: inherit; border: 1px solid var(--line, #2a3138); border-radius: 6px; padding: 3px 10px; cursor: pointer; font: inherit; }\n.nb-flowview3d .fv-head button:hover { border-color: var(--acc, #62bd8c); }\n.nb-flowview3d .fv-proj[aria-pressed=\"true\"] { background: var(--acc, #62bd8c); color: #10151a; border-color: var(--acc, #62bd8c); }\n.nb-flowview3d .fv-title { font-weight: 600; }\n.nb-flowview3d .fv-crumbs { opacity: .75; font-size: 12px; }\n.nb-flowview3d .fv-crumbs .fv-crumb { cursor: pointer; }\n.nb-flowview3d .fv-crumbs .fv-crumb:hover { color: var(--acc, #62bd8c); }\n.nb-flowview3d .fv-spacer { flex: 1; }\n.nb-flowview3d .fv-status { font-size: 12px; opacity: .8; }\n.nb-flowview3d .fv-decks { display: flex; gap: 4px; }\n.nb-flowview3d .fv-deck-tab { background: var(--btn, #232b33); border: 1px solid var(--line, #2a3138); color: inherit; border-radius: 6px; padding: 2px 9px; cursor: pointer; font: inherit; font-size: 12px; }\n.nb-flowview3d .fv-deck-tab[aria-selected=\"true\"] { background: var(--acc, #62bd8c); color: #10151a; border-color: var(--acc, #62bd8c); }\n\n.nb-flowview3d .fv-main { display: flex; flex: 1; min-height: 0; }\n.nb-flowview3d .fv-host { flex: 1; min-width: 0; position: relative; }\n.nb-flowview3d .fv-rail, .nb-flowview3d .fv-inspect { width: 240px; flex: none; overflow: auto; padding: 10px 12px; border-left: 1px solid var(--line, #2a3138); background: var(--panel, #1b2127); }\n.nb-flowview3d .fv-rail { border-left: none; border-right: 1px solid var(--line, #2a3138); }\n.nb-flowview3d .lbl { display: block; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; opacity: .6; margin: 10px 0 6px; }\n.nb-flowview3d .fv-gate { list-style: none; margin: 0; padding: 0; }\n.nb-flowview3d .fv-gate li { padding: 3px 0; border-bottom: 1px dashed var(--line, #2a3138); }\n.nb-flowview3d .fv-gate li b { font-weight: 600; }\n.nb-flowview3d .fv-gate li.pass { color: #2e8b57; }\n.nb-flowview3d .fv-gate li.fail { color: #c15a5a; }\n.nb-flowview3d .fv-ro { font-size: 12px; opacity: .8; }\n.nb-flowview3d .fv-keys-list { list-style: none; margin: 0; padding: 0; font-size: 12px; }\n.nb-flowview3d .fv-keys-list li { padding: 2px 0; opacity: .85; }\n.nb-flowview3d kbd { background: var(--btn, #232b33); border: 1px solid var(--line, #2a3138); border-bottom-width: 2px; border-radius: 4px; padding: 0 4px; font-size: 11px; }\n.nb-flowview3d .fv-inspect-body { font-size: 12px; }\n.nb-flowview3d .fv-inspect-body .fv-row { display: flex; justify-content: space-between; gap: 8px; padding: 2px 0; border-bottom: 1px dashed var(--line, #2a3138); }\n.nb-flowview3d .fv-inspect-body .fv-row b { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.nb-flowview3d .fv-inspect-body .fv-row span { opacity: .65; }\n.nb-flowview3d .fv-empty { opacity: .7; }\n","old":"","patch_id":"p2","time":1792548686380}]},"id":"inuwvr1a15c39730fk2980_patches","readers":[],"time":1792548686380,"username":"system","writers":[]}