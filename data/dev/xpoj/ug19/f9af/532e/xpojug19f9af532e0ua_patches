args: JSON.stringify(args) };\n    let entry;\n    if (result instanceof Error) {\n      entry = pushTranscript({ ...entryBase, error: true, output: result.message });\n    } else {\n      const env = result.envelope;\n      // FLAT returns carry fields top-level (no data/msg) — show the envelope\n      const payload = env.status === \"ok\" ? (env.data ?? env.msg ?? env) : env.msg;\n      entry = pushTranscript({\n        ...entryBase,\n        ms: result.ms,\n        error: env.status !== \"ok\",\n        output: typeof payload === \"string\" ? payload : JSON.stringify(payload, null, 1),\n      });\n    }\n    renderCell(entry);\n    callInput.value = \"\";\n    argsInput.value = \"\";\n  }\n\n  /** Inline type-the-name confirm (DESIGN §5.6) — resolves true on exact match. */\n  function askConfirm(cmdName) {\n    return new Promise((resolve) => {\n      confirmEl.hidden = false;\n      confirmEl.querySelector(\".ss-confirm-msg\").textContent =\n        `\"${cmdName}\" may change data on the connected instance — type the command name to run it:`;\n      const input = confirmEl.querySelector(\".ss-confirm-input\");\n      input.value = \"\";\n      input.focus();\n      const done = (value) => {\n        confirmEl.hidden = true;\n        input.onkeydown = null;\n        resolve(value);\n      };\n      input.onkeydown = (event) => {\n        if (event.key === \"Enter\" && input.value === cmdName) done(true);\n        else if (event.key === \"Escape\") done(false);\n      };\n      confirmEl.querySelector(\".ss-confirm-cancel\").onclick = () => done(false);\n    });\n  }\n\n  runBtn.addEventListener(\"click\", run);\n  argsInput.addEventListener(\"keydown\", (event) => {\n    if (event.key === \"Enter\") run();\n  });\n\n  // ── the agent (ask ▸): chat_llm driven from the notebook ──\n  const askInput = host.querySelector(\".ss-ask\");\n  const sendBtn = host.querySelector(\".ss-send\");\n  const ctxRows = host.querySelector(\".ss-ctx-rows\");\n  const toolPick = host.querySelector(\".ss-toolpick\");\n  const toolList = host.querySelector(\".ss-toollist\");\n  const ctxChecked = new Map();\n  let mcpTools = null;\n\n  function renderContextRows() {\n    const snap = chatctx.snapshot();\n    ctxRows.replaceChildren(...snap.map(({ key, label }) => {\n      const l = document.createElement(\"label\");\n      const cb = document.createElement(\"input\");\n      cb.type = \"checkbox\";\n      cb.checked = ctxChecked.get(key) ?? true;\n      cb.addEventListener(\"change\", () => ctxChecked.set(key, cb.checked));\n      l.append(cb, document.createTextNode(label));\n      return l;\n    }));\n    if (snap.length === 0) {\n      const none = document.createElement(\"span\");\n      none.className = \"none\";\n      none.textContent = \"nothing open\";\n      ctxRows.appendChild(none);\n    }\n  }\n\n  function enabledTools() {\n    try {\n      return JSON.parse(localStorage.getItem(TOOLS_KEY)) ?? [];\n    } catch {\n      return [];\n    }\n  }\n\n  // The count on the button is the \"am I running tool-less?\" signal — the\n  // first live run went unanswered for want of it.\n  const toolsBtn = host.querySelector(\".ss-tools\");\n  function updateToolsBtn() {\n    toolsBtn.textContent = `tools ▸ (${enabledTools().length})`;\n  }\n  updateToolsBtn();\n\n  async function renderTools() {\n    const r = await store.listTools();\n    if (r.status !== \"ok\") {\n      toolList.textContent = `could not list tools: ${r.msg}`;\n      return;\n    }\n    mcpTools = r.tools ?? [];\n    const on = new Set(enabledTools());\n    toolList.replaceChildren(...mcpTools.map((tool) => {\n      const l = document.createElement(\"label\");\n      const cb = document.createElement(\"input\");\n      cb.type = \"checkbox\";\n      cb.checked = on.has(tool.name);\n      cb.addEventListener(\"change\", () => {\n        const set = new Set(enabledTools());\n        cb.checked ? set.add(tool.name) : set.delete(tool.name);\n        localStorage.setItem(TOOLS_KEY, JSON.stringify([...set]));\n        updateToolsBtn();\n      });\n      const nm = document.createElement(\"span\");\n      nm.textContent = tool.name;\n      const desc = document.createElement(\"span\");\n      desc.className = \"tdesc\";\n      desc.textContent = tool.description ?? \"\";\n      l.append(cb, nm, desc);\n      return l;\n    }));\n  }\n\n  toolsBtn.addEventListener(\"click\", async (e) => {\n    toolPick.hidden = !toolPick.hidden;\n    e.currentTarget.setAttribute(\"aria-pressed\", String(!toolPick.hidden));\n    if (!toolPick.hidden && mcpTools === null) await renderTools();\n  });\n\n  /** The agent's tool executor: a visible, gated notebook cell. */\n  async function execTool(call) {\n    const target = parseToolName(call.name);\n    let args = {};\n    try {\n      args = call.arguments ? JSON.parse(call.arguments) : {};\n    } catch { /* leave {} — the cell shows the raw string below */ }\n    if (!target) {\n      return `ERROR: tool name \"${call.name}\" is not lib-ctl-cmd shaped`;\n    }\n    const callText = `${target.lib}.${target.ctl}.${target.cmd}`;\n    if (!isReadListed(target.cmd)) {\n      if (!store.writable()) {\n        renderCell(pushTranscript({ agent: true, call: callText,\n          args: JSON.stringify(args), error: true,\n          output: \"blocked: mutating tool on a read-only connection\" }));\n        return \"BLOCKED: this connection is read-only; mutating tools are unavailable.\";\n      }\n      const confirmed = await askConfirm(target.cmd);\n      if (!confirmed) {\n        renderCell(pushTranscript({ agent: true, call: callText,\n          args: JSON.stringify(args), error: true,\n          output: \"denied by the user (typed confirm)\" }));\n        return \"DENIED: the user declined this action. Continue without it.\";\n      }\n    }\n    const result = await store.invoke(target.lib, target.ctl, target.cmd, args);\n    let entry;\n    let content;\n    if (result instanceof Error) {\n      entry = { agent: true, call: callText, args: JSON.stringify(args),\n                error: true, output: result.message };\n      content = `ERROR: ${result.message}`;\n    } else {\n      const env = result.envelope;\n      const payload = env.status === \"ok\" ? (env.data ?? env.msg ?? env) : env.msg;\n      const text = typeof payload === \"string\" ? payload : JSON.stringify(payload, null, 1);\n      entry = { agent: true, call: callText, args: JSON.stringify(args),\n                ms: result.ms, error: env.status !== \"ok\", output: text };\n      content = env.status === \"ok\" ? clamp(text, 4000) : `ERROR: ${env.msg}`;\n    }\n    renderCell(pushTranscript(entry));\n    return content;\n  }\n\n  /** Prior notebook cells, compacted for the agent's memory. */\n  function historyMessages() {\n    const cells = readTranscript().slice(-HISTORY_CELLS);\n    const messages = [];\n    const activity = [];\n    for (const e of cells) {\n      if (e.kind === \"chat-user\") {\n        messages.push({ role: \"user\", content: e.text });\n      } else if (e.kind === \"chat-agent\") {\n        messages.push({ role: \"assistant\", content: stripThink(e.text ?? \"\") });\n      } else {\n        activity.push(`· [${e.n}]${e.agent ? \" (you ran)\" : \"\"} ${e.call}(${e.args}) → ` +\n          (e.error ? \"err: \" : \"ok: \") + clamp(e.output ?? \"\", 400));\n      }\n    }\n    return { messages, activity };\n  }\n\n  async function ask() {\n    const message = askInput.value.trim();\n    if (!message) return;\n    if (store.mode() !== \"live\") {\n      toast.show(\"the agent needs a live connection (agent.llm on the instance)\");\n      return;\n    }\n    askInput.value = \"\";\n    sendBtn.disabled = true;\n    // history BEFORE the new cell lands, or this question shows up twice\n    const { messages: turns, activity } = historyMessages();\n    renderCell(pushTranscript({ kind: \"chat-user\", text: message }));\n    const busy = document.createElement(\"div\");\n    busy.className = \"ss-busy\";\n    busy.textContent = \"agent is thinking…\";\n    cellsEl.appendChild(busy);\n\n    try {\n      const included = chatctx.snapshot().filter((p) => ctxChecked.get(p.key) ?? true);\n      let ctxMsg = contextBlock(included);\n      if (activity.length) {\n        ctxMsg += (ctxMsg ? \"\\n\\n\" : \"\") + \"Recent notebook activity:\\n\" + activity.join(\"\\n\");\n      }\n      const tools = toolDefs(mcpTools ?? (await (async () => {\n        const r = await store.listTools();\n        mcpTools = r.status === \"ok\" ? (r.tools ?? []) : [];\n        return mcpTools;\n      })()), enabledTools());\n      // The prompt only claims tools when tools are attached — otherwise\n      // the model invents security policies to explain its empty hands.\n      const messages = [{ role: \"system\",\n        content: SYSTEM_PROMPT + (tools.length ? TOOLS_PROMPT : NO_TOOLS_PROMPT) }];\n      if (ctxMsg) {\n        messages.push({ role: \"user\",\n          content: \"[CONTEXT — what the user is looking at]\\n\\n\" + ctxMsg });\n      }\n      messages.push(...turns, { role: \"user\", content: message });\n\n      const text = await chatTurn({\n        messages,\n        tools,\n        execTool,\n        onRound: () => { busy.textContent = \"agent is using tools…\"; },\n      });\n      busy.remove();\n      renderCell(pushTranscript({ kind: \"chat-agent\", text }));\n    } catch (e) {\n      busy.remove();\n      let text = `error: ${e.message || \"the request failed (see the instance console)\"}`;\n      // chat_llm reads system.apps.agent.runtime (VLLM_URL/VLLM_MODEL) —\n      // absent when the agent app isn't exposed. Say so instead of leaving\n      // the panic bare.\n      if (/Key 'agent' not found/.test(e.message ?? \"\")) {\n        text += \"\\n\\nThis instance's agent app isn't configured: add `agent` to \" +\n          \"config.properties apps=, put VLLM_URL and VLLM_MODEL in \" +\n          \"runtime/agent/botd.properties, and restart \" +\n          \"(tools/scratch-instance.md has the recipe).\";\n      }\n      renderCell(pushTranscript({ kind: \"chat-agent\", error: true, text }));\n    }\n    sendBtn.disabled = false;\n    askInput.focus();\n  }\n\n  sendBtn.addEventListener(\"click\", ask);\n  askInput.addEventListener(\"keydown\", (event) => {\n    if (event.key === \"Enter\" && !event.shiftKey) {\n      event.preventDefault();\n      ask();\n    }\n  });\n\n  return {\n    open() {\n      root.classList.add(\"open\");\n      renderContextRows();\n      callInput.focus();\n    },\n    close,\n    isOpen() {\n      return root.classList.contains(\"open\");\n    },\n  };\n}\n","patch_id":"p8","time":1785029017500},{"author":"installer","facet":"html","label":"install sync","new":"<aside class=\"nb-session\" role=\"dialog\" aria-label=\"Session\">\n  <header class=\"ss-head\">\n    <span class=\"lbl ss-title\">▤ session</span>\n    <span class=\"ss-sub\">a notebook over your commands — every cell is a call, outputs stay put</span>\n    <button class=\"ss-close\" aria-label=\"Close session\">✕</button>\n  </header>\n  <div class=\"ss-body\">\n    <div class=\"ss-cells\"></div>\n    <div class=\"ss-new\">\n      <span class=\"ss-gutter\">[·]</span>\n      <input class=\"ss-call\" placeholder=\"lib.control.command\" autocomplete=\"off\"\n             aria-label=\"Command to run, as lib.control.command\">\n      <input class=\"ss-args\" placeholder='args json, e.g. {\"lib\":\"gudrun\"}'\n             aria-label=\"Arguments as JSON\">\n      <button class=\"ss-run\">run ▸</button>\n    </div>\n    <div class=\"ss-chatrow\">\n      <span class=\"ss-gutter\">[✳]</span>\n      <textarea class=\"ss-ask\" rows=\"1\"\n        placeholder=\"or ask in plain language — the agent sees your context and this notebook\"\n        aria-label=\"Ask the agent\"></textarea>\n      <button class=\"ss-send\">ask ▸</button>\n    </div>\n    <div class=\"ss-ctx\">\n      <span class=\"ctxlbl\">context</span>\n      <div class=\"ss-ctx-rows\"></div>\n      <button class=\"ss-tools\" aria-pressed=\"false\">tools ▸</button>\n    </div>\n    <div class=\"ss-toolpick\" hidden>\n      <p class=\"ss-toolcap\">Attached tools ride along with full schemas (a\n      sensible core set by default; pin/unpin here, persisted in this\n      browser). The agent can discover and call <b>every</b> command\n      regardless — find_tools/call_command — with the same per-call gates:\n      reads run directly, anything mutating stops at the typed confirm.</p>\n      <div class=\"ss-toollist\"></div>\n    </div>\n    <div class=\"ss-confirm\" hidden>\n      <span class=\"ss-confirm-msg\"></span>\n      <input class=\"ss-confirm-input\" aria-label=\"Type the command name to confirm\">\n      <button class=\"ss-confirm-cancel\">cancel</button>\n    </div>\n    <p class=\"ss-cap\">Read-listed commands run directly — yours and the\n    agent's. Anything else needs a writable connection and a typed\n    confirmation — same rules as the bench.</p>\n  </div>\n</aside>\n","old":"<aside class=\"nb-session\" role=\"dialog\" aria-label=\"Session\">\n  <header class=\"ss-head\">\n    <span class=\"lbl ss-title\">▤ session</span>\n    <span class=\"ss-sub\">a notebook over your commands — every cell is a call, outputs stay put</span>\n    <button class=\"ss-close\" aria-label=\"Close session\">✕</button>\n  </header>\n  <div class=\"ss-body\">\n    <div class=\"ss-cells\"></div>\n    <div class=\"ss-new\">\n      <span class=\"ss-gutter\">[·]</span>\n      <input class=\"ss-call\" placeholder=\"lib.control.command\" autocomplete=\"off\"\n             aria-label=\"Command to run, as lib.control.command\">\n      <input class=\"ss-args\" placeholder='args json, e.g. {\"lib\":\"gudrun\"}'\n             aria-label=\"Arguments as JSON\">\n      <button class=\"ss-run\">run ▸</button>\n    </div>\n    <div class=\"ss-chatrow\">\n      <span class=\"ss-gutter\">[✳]</span>\n      <textarea class=\"ss-ask\" rows=\"1\"\n        placeholder=\"or ask in plain language — the agent sees your context and this notebook\"\n        aria-label=\"Ask the agent\"></textarea>\n      <button class=\"ss-send\">ask ▸</button>\n    </div>\n    <div class=\"ss-ctx\">\n      <span class=\"ctxlbl\">context</span>\n      <div class=\"ss-ctx-rows\"></div>\n      <button class=\"ss-tools\" aria-pressed=\"false\">tools ▸</button>\n    </div>\n    <div class=\"ss-toolpick\" hidden>\n      <p class=\"ss-toolcap\">Commands the agent may call, as tools — all off by\n      default; the enabled set persists in this browser. Mutating tools still\n      stop at the typed confirm below.</p>\n      <div class=\"ss-toollist\"></div>\n    </div>\n    <div class=\"ss-confirm\" hidden>\n      <span class=\"ss-confirm-msg\"></span>\n      <input class=\"ss-confirm-input\" aria-label=\"Type the command name to confirm\">\n      <button class=\"ss-confirm-cancel\">cancel</button>\n    </div>\n    <p class=\"ss-cap\">Read-listed commands run directly — yours and the\n    agent's. Anything else needs a writable connection and a typed\n    confirmation — same rules as the bench.</p>\n  </div>\n</aside>\n","patch_id":"p9","time":1785059761614},{"author":"installer","facet":"css","label":"install sync","new":".nb-session {\n  position: fixed;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  height: 300px;\n  z-index: 60;\n  display: flex;\n  flex-direction: column;\n  background: var(--panel);\n  border-top: 1px solid var(--line);\n  border-radius: 14px 14px 0 0;\n  box-shadow: 0 -14px 44px rgba(0, 0, 0, 0.5);\n  transform: translateY(110%);\n  transition: transform 0.25s ease;\n}\n.nb-session.open { transform: translateY(0); }\n.nb-session .ss-head {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 18px;\n  border-bottom: 1px solid var(--line);\n  flex: none;\n}\n.nb-session .ss-title { color: var(--text); }\n.nb-session .ss-sub { font-size: 11px; color: var(--text-faint); }\n.nb-session .ss-close {\n  margin-left: auto;\n  color: var(--text-faint);\n  font-size: 15px;\n  padding: 2px 8px;\n}\n.nb-session .ss-close:hover { color: var(--text); }\n.nb-session .ss-body { flex: 1; overflow: auto; padding: 14px 18px; }\n.nb-session .ss-cell {\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  margin-bottom: 12px;\n  overflow: hidden;\n}\n.nb-session .ss-cell-in {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 9px 14px;\n  background: var(--panel-2);\n  font: 12px var(--mono);\n}\n.nb-session .ss-gutter { color: var(--accent); flex: none; font: 12px var(--mono); }\n.nb-session .ss-cell-in .call { color: var(--f-css); }\n.nb-session .ss-cell-in .args { color: #9ec98f; overflow: hidden; text-overflow: ellipsis; }\n.nb-session .ss-cell-in .ms { margin-left: auto; font-size: 10px; color: var(--text-faint); flex: none; }\n.nb-session .ss-cell-in .rerun {\n  font: 10px var(--mono);\n  letter-spacing: 0.1em;\n  color: var(--accent);\n  border: 1px solid var(--accent-dim);\n  border-radius: 6px;\n  padding: 3px 10px;\n  flex: none;\n}\n.nb-session .ss-cell-out {\n  padding: 10px 14px 12px 38px;\n  font: 11.5px/1.7 var(--mono);\n  color: var(--text-dim);\n  white-space: pre;\n  overflow-x: auto;\n  max-height: 140px;\n  overflow-y: auto;\n}\n.nb-session .ss-cell-out.err { color: var(--danger); }\n.nb-session .ss-new {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 4px 0;\n}\n.nb-session .ss-call, .nb-session .ss-args, .nb-session .ss-confirm-input {\n  background: var(--ground);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 8px 10px;\n  font: 12px var(--mono);\n  color: var(--text);\n}\n.nb-session .ss-call { width: 260px; }\n.nb-session .ss-args { flex: 1; }\n.nb-session .ss-call::placeholder, .nb-session .ss-args::placeholder { color: var(--text-faint); }\n.nb-session .ss-run {\n  font: 11px var(--mono);\n  letter-spacing: 0.1em;\n  color: var(--accent);\n  border: 1px solid var(--accent-dim);\n  border-radius: 7px;\n  padding: 8px 14px;\n}\n.nb-session .ss-run:hover { background: rgba(240, 166, 60, 0.1); }\n.nb-session .ss-confirm {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin-top: 8px;\n  padding: 9px 14px;\n  border: 1px solid var(--danger);\n  border-radius: 8px;\n  background: rgba(193, 90, 90, 0.08);\n  font-size: 12px;\n}\n.nb-session .ss-confirm-input { border-color: var(--danger); }\n.nb-session .ss-confirm-cancel {\n  font: 11px var(--mono);\n  color: var(--text-dim);\n  border: 1px solid var(--line);\n  border-radius: 6px;\n  padding: 5px 10px;\n}\n.nb-session .ss-cap { margin-top: 6px; font-size: 11px; color: var(--text-faint); }\n\n/* ── the agent in the notebook ────────────────────────────── */\n.nb-session .ss-chatrow {\n  display: flex;\n  align-items: flex-end;\n  gap: 10px;\n  margin-top: 8px;\n}\n.nb-session .ss-ask {\n  flex: 1;\n  resize: none;\n  background: var(--panel-2);\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 8px 10px;\n  font: 12px var(--mono);\n  color: var(--text);\n}\n.nb-session .ss-send {\n  font: 11px var(--mono);\n  color: var(--ground);\n  background: var(--accent);\n  border-radius: 7px;\n  padding: 7px 14px;\n}\n.nb-session .ss-send:disabled { opacity: 0.4; cursor: default; }\n.nb-session .ss-ctx {\n  display: flex;\n  align-items: baseline;\n  flex-wrap: wrap;\n  gap: 4px 14px;\n  margin-top: 6px;\n}\n.nb-session .ss-ctx .ctxlbl {\n  font: 9.5px var(--mono);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--text-faint);\n}\n.nb-session .ss-ctx-rows { display: flex; flex-wrap: wrap; gap: 4px 14px; }\n.nb-session .ss-ctx label {\n  display: flex;\n  gap: 6px;\n  align-items: center;\n  font: 11px var(--mono);\n  color: var(--text-dim);\n}\n.nb-session .ss-ctx .none { font: 11px var(--mono); color: var(--text-faint); font-style: italic; }\n.nb-session .ss-tools { font: 10.5px var(--mono); color: var(--accent); margin-left: auto; }\n.nb-session .ss-toolpick {\n  margin-top: 6px;\n  padding: