{"data":{"list":[{"author":"installer","facet":"html","label":"install sync","new":"<section class=\"nb-floweditor\">\n  <aside class=\"fe-palette\">\n    <span class=\"lbl\">node kinds</span>\n    <div class=\"fe-pal-item\"><span class=\"glyph\" aria-hidden=\"true\">▤</span>command call</div>\n    <div class=\"fe-pal-item\"><span class=\"glyph\" aria-hidden=\"true\">⚙</span>primitive</div>\n    <div class=\"fe-pal-item\"><span class=\"glyph\" aria-hidden=\"true\">▣</span>local sub-flow</div>\n    <div class=\"fe-pal-item\"><span class=\"glyph\" aria-hidden=\"true\">◇</span>constant / matcher</div>\n    <div class=\"fe-pal-item\"><span class=\"glyph\" aria-hidden=\"true\">⌘</span>params / return</div>\n    <p class=\"fe-pal-note\">Data falls top to bottom, Prograph-style. Branching\n    is a constant-matcher plus a condition rule chaining to the next case.\n    Editing lands in a later milestone — this is the viewer.</p>\n  </aside>\n  <div class=\"fe-canvas\">\n    <div class=\"fe-head\">\n      <button class=\"fe-back\">←</button>\n      <span class=\"fe-title\"></span>\n      <span class=\"fe-crumbs\"></span>\n    </div>\n    <div class=\"fe-svg-wrap\"></div>\n  </div>\n  <aside class=\"fe-inspect\">\n    <span class=\"lbl\">inspector</span>\n    <div class=\"fe-inspect-body\">\n      <p class=\"fe-empty\">Select a node. Local sub-flows open on double-click —\n      the graph is the code, not a picture of it.</p>\n    </div>\n  </aside>\n</section>\n","old":"","patch_id":"p1","time":1785011188511},{"author":"installer","facet":"css","label":"install sync","new":".nb-floweditor {\n  display: grid;\n  grid-template-columns: 180px 1fr 280px;\n  height: 100%;\n  overflow: hidden;\n}\n.nb-floweditor .fe-palette {\n  border-right: 1px solid var(--line);\n  padding: 22px 18px;\n  overflow: auto;\n}\n.nb-floweditor .fe-palette > .lbl { display: block; margin-bottom: 10px; }\n.nb-floweditor .fe-pal-item {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n  padding: