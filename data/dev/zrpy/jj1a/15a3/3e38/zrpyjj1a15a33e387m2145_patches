{"data":{"list":[{"author":"executive-plan-step","facet":"scene","label":"P0: generic op node shape (body+label+sockets)","new":"{\"env\":{\"camera\":{\"pos\":{\"x\":0,\"y\":0,\"z\":12},\"target\":{\"x\":0,\"y\":0,\"z\":0}},\"grid\":true,\"lights\":\"default\"},\"nodes\":[{\"id\":\"root\",\"kind\":\"group\",\"pos\":{\"x\":0,\"y\":0,\"z\":0}},{\"id\":\"body\",\"kind\":\"box\",\"material\":{\"token\":\"paper\"},\"parent\":\"root\",\"pos\":{\"x\":0,\"y\":0,\"z\":0}},{\"id\":\"label\",\"kind\":\"text\",\"params\":{\"size\":0.18,\"text\":\"op\"},\"parent\":\"root\",\"pos\":{\"x\":0,\"y\":0,\"z\":0.31}},{\"id\":\"sin\",\"kind\":\"sphere\",\"material\":{\"color\":\"#62bd8c\",\"emissive\":true},\"params\":{\"radius\":0.06},\"parent\":\"root\",\"pos\":{\"x\":0,\"y\":0.3,\"z\":0}},{\"id\":\"sout\",\"kind\":\"sphere\",\"material\":{\"color\":\"#62bd8c\",\"emissive\":true},\"params\":{\"radius\":0.06},\"parent\":\"root\",\"pos\":{\"x\":0,\"y\":-0.3,\"z\":0}}],\"state\":{\"name\":{\"default\":\"op\",\"type\":\"string\"},\"phase\":{\"default\":0,\"type\":\"number\"},\"sel\":{\"default\":false,\"type\":\"boolean\"}}}","old":"","patch_id":"p1","time":1792514727574},{"author":"executive-plan-step","facet":"js","label":"P0: animate/render/click/drag dummy behaviors","new":"// flownode — ONE flow op as a scene-facet node control (the P0 spike for the\n// floweditor3d → app-scene-stack conversion). Kind-parametrized by the\n// addControl seed (me.data): { opType, name, width, inTerms, outTerms, phase }.\n// The scene facet gives the SHAPE (body + label + in/out sockets, one generic\n// geometry for the spike); these behaviors are where the editing gestures live\n// in P2 (port hover/pick/drag, wire-ghost). For P0 they are deliberately\n// minimal: render bobs the body (proves the host frame loop reaches a control),\n// click reports through host.state.lastClick (proves tap dispatch + node id).\n\nvar me = this;\nvar ME = document.getElementById(me.UUID);\n\nme.ready = function () {\n  const d = me.data || {};\n  const kind = d.opType || \"primitive\";\n  const phase = (typeof d.phase === \"number\") ? d.phase : 0;\n\n  me.sceneBehaviors = {\n    default: {\n      // once, on add: fold the seed into the rig + shared state\n      animate(ctx) {\n        ctx.me.opType = kind;\n        ctx.me.opName = d.name || \"op\";\n        // stagger by phase so a deck of nodes doesn't bob in lockstep\n        ctx.me._phase = phase;\n      },\n\n      // every frame: a gentle bob — the visible proof that the scenehost frame\n      // loop drives a control-scene behavior (the P0 gate)\n      render(ctx, dt) {\n        if (!ctx || !ctx.rig) return;\n        const t = ctx.t || 0;\n        const base = (ctx.me.baseY !== undefined) ? ctx.me.baseY : (ctx.me.baseY = ctx.rig.pos.y);\n        const sel = ctx.host && ctx.host.state && ctx.host.state.selectedKey === ctx.key;\n        // selected nodes hold still & lift; the rest breathe\n        ctx.rig.pos.y = sel ? base + 0.15 : base + Math.sin(t * 1.4 + ctx.me._phase) * 0.04;\n      },\n\n      // tap → the host's raycast hit. hit = { node, specId, key }.\n      click(ctx, hit) {\n        if (!ctx.host) return;\n        ctx.host.setState(\"lastClick\", {\n          key: ctx.key, node: hit && hit.node, opType: ctx.me.opType, name: ctx.me.opName, t: Date.now(),\n        });\n        // selection emphasis rides the shared state (decision 1: per-deck\n        // grouping via host.state, not per-instance shape swaps)\n        ctx.host.setState(\"selectedKey\", ctx.key);\n      },\n\n      // drag gestures (P2 will turn this into op-move / wire-ghost). For P0 it\n      // just follows the pointer in the front plane so we can feel the affordance.\n      drag(ctx, evt) {\n        if (!ctx || !ctx.rig || !evt) return;\n        if (evt.phase === \"move\" && typeof evt.x === \"number\") {\n          ctx.rig.pos.x = evt.x;\n          if (typeof evt.y === \"number\") ctx.me.baseY = evt.y;\n        }\n      },\n\n      dispose(ctx) {\n        if (ctx.host && ctx.host.state && ctx.host.state.selectedKey === ctx.key) {\n          ctx.host.setState(\"selectedKey\", null);\n        }\n      },\n    },\n  };\n};\n","old":"","patch_id":"p2","time":1792514769167},{"author":"agent","facet":"scene","label":"P0: one flow op's scene facet — group root (rig target) + body/label/sockets","new":"{\"env\":{\"camera\":{\"pos\":{\"x\":0,\"y\":0,\"z\":6},\"target\":{\"x\":0,\"y\":0,\"z\":0}},\"grid\":false,\"lights\":\"default\"},\"nodes\":[{\"id\":\"root\",\"kind\":\"group\",\"meta\":{\"role\":\"op-root\"},\"pos\":{\"x\":0,\"y\":0,\"z\":0}},{\"id\":\"body\",\"kind\":\"box\",\"material\":{\"token\":\"paper\"},\"meta\":{\"role\":\"body\"},\"params\":{\"size\":{\"x\":1,\"y\":0.6,\"z\":0.6}},\"parent\":\"root\",\"pos\":{\"x\":0,\"y\":0,\"z\":0}},{\"id\":\"label\",\"kind\":\"text\",\"material\":{\"color\":\"#2d343c\"},\"meta\":{\"role\":\"label\"},\"params\":{\"size\":0.18,\"text\":\"op\"},\"parent\":\"root\",\"pos\":{\"x\":0,\"y\":0,\"z\":0.31}},{\"id\":\"in0\",\"kind\":\"sphere\",\"material\":{\"color\":\"#f0a63c\"},\"meta\":{\"role\":\"terminal\",\"which\":\"in\"},\"params\":{\"radius\":0.06},\"parent\":\"root\",\"pos\":{\"x\":-0.2,\"y\":0.3,\"z\":0}},{\"id\":\"out0\",\"kind\":\"sphere\",\"material\":{\"color\":\"#f0a63c\"},\"meta\":{\"role\":\"terminal\",\"which\":\"out\"},\"params\":{\"radius\":0.06},\"parent\":\"root\",\"pos\":{\"x\":0.2,\"y\":-0.3,\"z\":0}}],\"state\":{\"opType\":{\"default\":\"primitive\",\"type\":\"string\"},\"selected\":{\"default\":false,\"type\":\"boolean\"}}}","old":"{\"env\":{\"camera\":{\"pos\":{\"x\":0,\"y\":0,\"z\":12},\"target\":{\"x\":0,\"y\":0,\"z\":0}},\"grid\":true,\"lights\":\"default\"},\"nodes\":[{\"id\":\"root\",\"kind\":\"group\",\"pos\":{\"x\":0,\"y\":0,\"z\":0}},{\"id\":\"body\",\"kind\":\"box\",\"material\":{\"token\":\"paper\"},\"parent\":\"root\",\"pos\":{\"x\":0,\"y\":0,\"z\":0}},{\"id\":\"label\",\"kind\":\"text\",\"params\":{\"size\":0.18,\"text\":\"op\"},\"parent\