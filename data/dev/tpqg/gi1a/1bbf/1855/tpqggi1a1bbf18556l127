{"data":{"attachmentkeynames":["rs"],"desc":"Internal shared facet storage and journal module. Uses temp+fsync+rename for facet/record writes, serializes journal transactions, and keeps every patch in a small independent record with an atomic index as commit point. Legacy monolithic journals migrate once and are archived, never appended. list_control_patches preserves newest-first patch objects.","import":"use ndata::dataobject::DataObject;\nuse flowlang::datastore::DataStore;\nuse std::sync::{Mutex, MutexGuard, OnceLock};\nuse std::fs;\nuse std::io::Write;\nuse std::path::Path;\npub fn lock() -> MutexGuard<'static, ()> {\n    static LOCK: OnceLock<Mutex<()>> = OnceLock::new();\n    LOCK.get_or_init(|| Mutex::new(())).lock().unwrap_or_else(|e| e.into_inner())\n}\npub fn atomic_write(path: &Path, bytes: &[u8]) -> Result<(), String> {\n    let parent = path.parent().ok_or_else(|| \"path has no parent\".to_string())?;\n    fs::create_dir_all(parent).map_err(|e| e.to_string())?;\n    let tmp = parent.join(format!(\".{}.tmp-{}-{}\", path.file_name().unwrap().to_string_lossy(), std::process::id(), flowlang::flowlang::system::unique_session_id::unique_session_id()));\n    {\n        let mut f = fs::File::create(&tmp).map_err(|e| format!(\"create {}: {}\", tmp.display(), e))?;\n        f.write_all(bytes).map_err(|e| format!(\"write {}: {}\", tmp.display(), e))?;\n        f.sync_all().map_err(|e| format!(\"sync {}: {}\", tmp.display(), e))?;\n    }\n    fs::rename(&tmp, path).map_err(|e| format!(\"rename {} -> {}: {}\", tmp.display(), path.display(), e))?;\n    if let Ok(dir) = fs::File::open(parent) { let _ = dir.sync_all(); }\n    Ok(())\n}\npub fn write_record(store: &DataStore, lib: &str, id: &str, record: &DataObject) -> Result<(), String> {\n    let mut rec = record.deep_copy();\n    let mut data = rec.get_object(\"data\");\n    if data.has(\"attachmentkeynames\") {\n        let keys = data.get_array(\"attachmentkeynames\");\n        for kk in keys.objects() {\n            let key = kk.string();\n            if !data.has(&key) { continue; }\n            let text = ndata::data::Data::as_string(data.get_property(&key));\n            let path = store.get_data_file(lib, &format!(\"{}.{}\", id, key));\n            atomic_write(&path, text.as_bytes())?;\n            data.remove_property(&key);\n        }\n    }\n    atomic_write(&store.get_data_file(lib, id), rec.to_string().as_bytes())\n}\nfn entry_id(id: &str, n: i64) -> String { format!(\"{}_jp_{:08}\", id, n) }\nfn index_id(id: &str) -> String { format!(\"{}_jp_index\", id) }\nfn empty_record(lib: &str, id: &str) -> DataObject {\n    let mut rec = DataObject::new(); rec.put_string(\"id\", id); rec.put_string(\"username\", \"system\");\n    rec.put_string(\"db\", lib); rec.put_array(\"readers\", ndata::dataarray::DataArray::new());\n    rec.put_array(\"writers\", ndata::dataarray::DataArray::new()); rec\n}\nfn index_record(lib: &str, id: &str, next: i64) -> DataObject {\n    let mut rec = empty_record(lib, &index_id(id));\n    rec.put_int(\"time\", flowlang::flowlang::system::time::time());\n    let mut d = DataObject::new(); d.put_int(\"next\", next); d.put_int(\"count\", next - 1);\n    rec.put_object(\"data\", d); rec\n}\nfn read_index(store: &DataStore, lib: &str, id: &str) -> Result<i64, String> {\n    let iid = index_id(id);\n    if store.exists(lib, &iid) {\n        let d = store.get_data(lib, &iid).get_object(\"data\");\n        let next = d.try_get_int(\"next\").unwrap_or(1).max(1);\n        if next > 1 && !store.exists(lib, &entry_id(id, next - 1)) {\n            return Err(format!(\"journal index {} points past its last patch\", iid));\n        }\n        return Ok(next);\n    }\n    let legacy_id = format!(\"{}_patches\", id);\n    let mut next = 1i64;\n    if store.exists(lib, &legacy_id) {\n        let legacy = store.get_data(lib, &legacy_id);\n        let list = legacy.get_object(\"data\").get_array(\"list\");\n        // Migrate to a temporary namespace first. An interruption can leave an\n        // incomplete migration, but never a published index over missing entries.\n        for i in 0..list.len() {\n            let eid = entry_id(id, next);\n            let mut rec = empty_record(lib, &eid);\n            let mut d = DataObject::new(); d.put_object(\"patch\", list.get_object(i)); rec.put_object(\"data\", d);\n            write_record(store, lib, &eid, &rec)?;\n            next += 1;\n        }\n        let migrated_id = format!(\"{}.migrated-{}\", legacy_id, flowlang::flowlang::system::time::time());\n        let mut archived = legacy.deep_copy(); archived.put_int(\"time\", flowlang::flowlang::system::time::time());\n        let mut ad = archived.get_object(\"data\"); ad.put_string(\"migrated_to\", &index_id(id)); archived.put_object(\"data\", ad);\n        write_record(store, lib, &migrated_id, &archived)?;\n    }\n    write_record(store, lib, &index_id(id), &index_record(lib, id, next))?;\n    Ok(next)\n}\npub fn list(store: &DataStore, lib: &str, id: &str, limit: i64) -> Result<ndata::dataarray::DataArray, String> {\n    let next = read_index(store, lib, id)?;\n    let total = next - 1;\n    let n = if limit <= 0 { total } else { total.min(limit) };\n    let mut out = ndata::dataarray::DataArray::new();\n    for k in 0..n {\n        let eid = entry_id(id, next - 1 - k);\n        if !store.exists(lib, &eid) { return Err(format!(\"missing facet journal entry {}\", eid)); }\n        out.push_object(store.get_data(lib, &eid).get_object(\"data\").get_object(\"patch\"));\n    }\n    Ok(out)\n}\npub fn append(store: &DataStore, lib: &str, id: &str, facet: &str, old: String, new: String, label: String, author: String) -> Result<String, String> {\n    let next = read_index(store, lib, id)?;\n    let patch_id = format!(\"p{}\", next);\n    let mut patch = DataObject::new(); patch.put_string(\"patch_id\", &patch_id); patch.put_string(\"author\", &author);\n    patch.put_string(\"facet\", facet); patch.put_string(\"old\", &old); patch.put_string(\"new\", &new);\n    patch.put_int(\"time\", flowlang::flowlang::system::time::time()); patch.put_string(\"label\", &label);\n    let eid = entry_id(id, next);\n    let mut rec = empty_record(lib, &eid);\n    let mut d = DataObject::new(); d.put_object(\"patch\", patch); rec.put_object(\"data\", d);\n    write_record(store, lib, &eid, &rec)?;\n    // The index is the commit point. Entry and index are tiny atomic files;\n    // a stale index never exposes a partially-written patch as committed.\n    write_record(store, lib, &index_id(id), &index_record(lib, id, next + 1))?;\n    Ok(patch_id)\n}","params":[{"name":"lib","type":"String"},{"name":"id","type":"String"}],"returntype":"JSONObject","type":"rust"},"id":"tpqggi1a1bbf18556l127","readers":[],"time":1794156342903,"username":"system","writers":[]}