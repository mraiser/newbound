{"data":{"attachmentkeynames":["rs"],"cmd":"setuser","ctl":"security","desc":"Creates a new user or updates an existing one, returning the complete user record as a JSONObject. Takes the String `id` (the account's primary key), the String `displayname`, the String `password`, and a JSONArray `groups` of group names; plus `keepalive`, `address` and `port` (Any), each stored only when its string form is not \"null\", so a null leaves that property unset.","import":"use ndata::dataarray::DataArray;\nuse ndata::data::Data;\nuse crate::security::security::init::get_user;\nuse crate::security::security::init::set_user;\n","lib":"security","params":[{"desc":"The unique identifier for the user account, serving as the primary key for retrieving and storing user data.","name":"id","type":"String"},{"desc":"The user's human-readable name, used for display purposes rather than identification.","name":"displayname","type":"String"},{"desc":"The user's authentication password. This string value is stored for verifying user identity during login.","name":"password","type":"String"},{"desc":"A JSON array specifying the groups a user belongs to, with each element being a string identifier for a particular group.","name":"groups","type":"JSONArray"},{"desc":"Indicates whether the user's connection or session should be kept alive. This setting is activated when its string representation evaluates to \"true\".","name":"keepalive","type":"Any"},{"desc":"Network address to associate with the account; stored only when its string form is not \"null\". Pass null when not applicable — the param is still required.","name":"address","type":"Any"},{"desc":"Network port to associate with the account; stored as both \"port\" and \"p2pport\" when its string form is not \"null\". Pass null when not applicable — the param is still required.","name":"port","type":"Any"}],"returntype":"JSONObject","type":"rust"},"id":"soqxoo1836bb51d5dy2","readers":[],"time":1786036037458,"username":"system","writers"