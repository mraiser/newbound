not an inline style","new":"    <div class='hudcrates adminonly'>","old":"    <div class='hudcrates adminonly' style='display:none;'>","patch_id":"p19","time":1793480061430},{"author":"alex89romanov","facet":"css","label":"F7: .adminonly hidden by default, shown under .isadmin","new":".inline.iconmode{\n  width:150px;\n  height:150px;\n}\n\n/* F7: everything admin-only hides until the panel root (.hudpanel, set in\n   the js) earns .isadmin from the remote current_user check. Scoped to the\n   panel so dashboard-mounted controls' own classes are untouched. */\n.hudpanel .adminonly {\n  display: none;\n}\n\n.hudpanel.isadmin .adminonly {\n  display: revert;\n}","old":".inline.iconmode{\n  width:150px;\n  height:150px;\n}","patch_id":"p20","time":1793480064946},{"author":"alex89romanov","facet":"js","label":"F7: isadmin class shows every .adminonly, not just the first","new":"      // F7: one class on the panel root shows EVERY .adminonly element\n      // (menu items and the Platform block), not just the first one found.\n      if (result.data.groups.indexOf('admin') != -1) ME.classList.add('isadmin');","old":"      if (result.data.groups.indexOf('admin') != -1) ME.querySelector('.adminonly').style.display = 'block';","patch_id":"p21","time":1793480070480},{"author":"agent","facet":"html","label":"F8: a place for the save-failure words next to Stay connected","new":"    <label class=\"plaincheckbox\">\n      <input type='checkbox' id='keepalive'>\n      <span>Stay connected</span>\n    </label>\n    <span class='keepalive-status'></span>","old":"    <label class=\"plaincheckbox\">\n      <input type='checkbox' id='keepalive'>\n      <span>Stay connected</span>\n    </label>","patch_id":"p22","time":1793482232737},{"author":"agent","facet":"js","label":"F8: read keepalive honestly, leave the box alone mid-save","new":"    // F8: keepalive is stored as a string — \"false\" must not read as ticked;\n    // and while a save is in flight, the save owns the box, not this refresh.\n    if (!me.keepaliveSaving) {\n      var ka = ME.DATA.keepalive;\n      ME.querySelector('#keepalive').checked = (ka === true || ka === 'true');\n    }","old":"    ME.querySelector('#keepalive').checked = !!ME.DATA.keepalive;","patch_id":"p23","time":1793482239129},{"author":"agent","facet":"js","label":"F8: Stay connected saves through setuser, reverts and explains on failure","new":"// F5/F8/F11: the words for a refused or failed call. Session 1's helper lives\n// in peer.peer (published as document.body.peerErrorText); fall back to the\n// same wording when the panel is mounted outside the peer page.\nfunction errText(result){\n  var f = document.body.peerErrorText;\n  if (f) return f(result);\n  var msg = result && result.msg ? String(result.msg) : '';\n  if (msg == 'UNAUTHORIZED' || msg.indexOf('UNAUTHORIZED') == 0) return 'Unauthorized';\n  return 'Error: ' + (msg ? msg : 'no reply');\n}\n\n// F8: Stay connected saves through security/setuser on THIS instance — it is\n// our setting for that peer. The record's other fields come fresh from\n// security/users (never from ME.DATA) so nothing else gets overwritten; while\n// the save is in flight me.update leaves the box alone; a failure reverts the\n// box and says why; success re-reads what the server actually holds.\nME.querySelector('#keepalive').addEventListener('change', function(){\n  var box = this;\n  var want = box.checked;\n  var status = ME.querySelector('.keepalive-status');\n  status.textContent = '';\n  me.keepaliveSaving = true;\n  function fail(result){\n    box.checked = !want;\n    status.textContent = errText(result);\n    me.keepaliveSaving = false;\n  }\n  json('../security/users', null, function(result){\n    var u = result.status == 'ok' && result.data ? result.data[ME.DATA.id] : null;\n    if (!u) { fail(result.status == 'ok' ? {msg:'no local user record for this peer'} : result); return; }\n    var params = 'id=' + encodeURIComponent(ME.DATA.id)\n      + '&displayname=' + encodeURIComponent(u.displayname || '')\n      + '&password=' + encodeURIComponent(u.password || '')\n      + '&groups=' + encodeURIComponent(JSON.stringify(u.groups || []))\n      + '&keepalive=' + want\n      + '&address=' + (u.address ? encodeURIComponent(u.address) : 'null')\n      + '&port=' + (u.port ? encodeURIComponent(u.port) : 'null');\n    json('../security/setuser', params, function(r){\n      if (r.status != 'ok') { fail(r); return; }\n      json('../security/users', null, function(rr){\n        var u2 = rr.status == 'ok' && rr.data ? rr.data[ME.DATA.id] : null;\n        if (u2) box.checked = (u2.keepalive === true || u2.keepalive === 'true');\n        me.keepaliveSaving = false;\n      });\n    });\n  });\n});\n\nme.update = function(){\n  if (me.check == ME.querySelector('.rp-uuid')) {","old":"me.update = function(){\n  if (me.check == ME.querySelector('.rp-uuid')) {","patch_id":"p24","time":1793482252430},{"author":"agent","facet":"css","label":"F8: style for the keepalive save-failure words","new":".hudpanel.isadmin .adminonly {\n  display: revert;\n}\n\n/* F8: the save-failure words next to Stay connected */\n.hudpanel .keepalive-status {\n  color: #d06060;\n  font-size: 12px;\n  margin-left: 6px;\n}","old":".hudpanel.isadmin .adminonly {\n  display: revert;\n}","patch_id":"p25","time":1793482258048},{"author":"agent","facet":"js","label":"F11: a failed first read (other than NOT FOUND) disables Add Control","new":"  json('../peer/remote/'+ME.DATA.id+'/app/read', \"lib=runtime&id=controls_shared\", function(result){\n    if (result.status != 'ok'){\n      // F3: result.msg is untrusted — set it as text\n      ME.querySelector('.hudapps').textContent = result.msg;\n      me.data = { \"list\": [] };\n      // F11: 'NOT FOUND' only means this peer has never shared a control.\n      // Any OTHER failure makes adding unsafe (a write would replace a list\n      // we never saw), so the menu item goes dark with the reason on it.\n      if (result.msg != 'NOT FOUND') disableAddControl(errText(result));\n    }\n    else {\n      me.data = result.data;\n      buildControls();\n    }\n  });","old":"  json('../peer/remote/'+ME.DATA.id+'/app/read', \"lib=runtime&id=controls_shared\", function(result){\n    if (result.status != 'ok'){\n      // F3: result.msg is untrusted — set it as text\n      ME.querySelector('.hudapps').textContent = result.msg;\n      me.data = { \"list\": [] };\n    }\n    else {\n      me.data = result.data;\n      buildControls();\n    }\n  });","patch_id":"p26","time":1793482289899},{"author":"agent","facet":"js","label":"F11: re-read controls_shared right before writing; errors never write","new":"      el.querySelectorAll('.add-ctl-item').forEach(function(item){\n        item.addEventListener('click', function(){\n          var d = me.available[this.dataset.id];\n          // F11: never write over a list we haven't just seen — a stale or\n          // empty me.data would replace the peer's real dashboard. Re-read\n          // controls_shared NOW and push onto the fresh list. 'NOT FOUND'\n          // means the peer has never shared a control (start empty); any\n          // other failure writes nothing and says why in the popup.\n          var errEl = ME.querySelector('.add-control-error');\n          errEl.textContent = '';\n          json('../peer/remote/'+ME.DATA.id+'/app/read', \"lib=runtime&id=controls_shared\", function(rr){\n            var fresh;\n            if (rr.status == 'ok') fresh = rr.data && rr.data.list ? rr.data : { \"list\": [] };\n            else if (rr.msg == 'NOT FOUND') fresh = { \"list\": [] };\n            else { errEl.textContent = errText(rr); return; }\n            fresh.list.push(d);\n            json('../peer/remote/'+ME.DATA.id+'/app/write', \"lib=runtime&id=controls_shared&readers=[]&writers=[]&data=\"+encodeURIComponent(JSON.stringify(fresh)), function(result){\n              if (result.status != 'ok') { errEl.textContent = errText(result); return; }\n              me.data = fresh;\n              me.refresh();\n              ME.querySelector('.add-control-popup-close').click();\n            });\n          });\n        });\n      });","old":"      el.querySelectorAll('.add-ctl-item').forEach(function(item){\n        item.addEventListener('click', function(){\n          var d = me.available[this.dataset.id];\n          me.data.list.push(d);\n          json('../peer/remote/'+ME.DATA.id+'/app/write', \"lib=runtime&id=controls_shared&readers=[]&writers=[]&data=\"+encodeURIComponent(JSON.stringify(me.data)), function(result){\n            me.refresh();\n            ME.querySelector('.add-control-popup-close').click();\n          });\n        });\n      });","patch_id":"p27","time":1793482301113},{"author":"agent","facet":"js","label":"F11: disableAddControl — strip data-popup, dim, explain in the title","new":"  if (msg == 'UNAUTHORIZED' || msg.indexOf('UNAUTHORIZED') == 0) return 'Unauthorized';\n  return 'Error: ' + (msg ? msg : 'no reply');\n}\n\n// F11: the Add Control menu item opens its popup through its data-popup\n// attribute (initPopups reads it at click time), so removing the attribute\n// IS the disable; the title carries the reason.\nfunction disableAddControl(reason){\n  var td = ME.querySelector('.control-settings-popup td[data-popup*=\"add-control-popup\"]');\n  if (!td) return;\n  td.removeAttribute('data-popup');\n  td.classList.add('menuitem-disabled');\n  td.title = 'Add Control is unavailable: ' + reason;\n}","old":"  if (msg == 'UNAUTHORIZED' || msg.indexOf('UNAUTHORIZED') == 0) return 'Unauthorized';\n  return 'Error: ' + (msg ? msg : 'no reply');\n}","patch_id":"p28","time":1793482311449},{"author":"agent","facet":"html","label":"F11: a place for write-path errors in the Add Control popup","new":"    <div class='card-text'>\n      <div class = 'add-control-available'></div>\n      <div class='add-control-error'></div>\n    </div>","old":"    <div class='card-text'>\n      <div class = 'add-control-available'></div>\n    </div>","patch_id":"p29","time":1793482317599},{"author":"agent","facet":"css","label":"F11: styles for the disabled menu item and popup errors","new":"/* F8: the save-failure words next to Stay connected */\n.hudpanel .keepalive-status {\n  color: #d06060;\n  font-size: 12px;\n  margin-left: 6px;\n}\n\n/* F11: a menu item whose action is unavailable (Add Control after a failed\n   first read) keeps its row but loses its popup and its affordance. */\n.hudpanel .menuitem-disabled {\n  opacity: 0.4;\n  cursor: default;\n}\n\n/* F11: write-path errors in the Add Control popup */\n.add-control-error {\n  color: #d06060;\n  font-size: 12px;\n  padding: 4px 8px;\n}","old":"/* F8: the save-failure words next to Stay connected */\n.hudpanel .keepalive-status {\n  color: #d06060;\n  font-size: 12px;\n  margin-left: 6px;\n}","patch_id":"p30","time":1793482321939},{"author":"agent","facet":"js","label":"F15 follow-up: latency reads — while the link is down","new":"    // F15 follow-up (Phase 1 review): a down peer's last measured latency is\n    // stale — show an em dash under the grey dots until the link is back.\n    var isdown = st ? st.kind == 'down' : !(ME.DATA.tcp || ME.DATA.udp || ME.DATA.connected);\n    var l = isdown ? '—' : ME.DATA.latency ? ME.DATA.latency+'ms' : '--';\n    ME.querySelector('.connectionlatency').textContent = l;","old":"    var l = ME.DATA.latency ? ME.DATA.latency+'ms' : '--';\n    ME.querySelector('.connectionlatency').textContent = l;","patch_id":"p31","time":1793482347547},{"author":"agent","facet":"js","label":"F7: isadmin resets on re-mount — the host element is reused","new":"// F7: the panel root carries the css scope — .hudpanel hides every .adminonly\n// until the remote current_user check earns .isadmin. The host element is\n// REUSED across mounts (installControl swaps innerHTML only), so a previous\n// peer's verdict must not linger: drop isadmin until this mount earns it.\nME.classList.add('hudpanel');\nME.classList.remove('isadmin');","old":"// F7: the panel root carries the css scope — .hudpanel hides every .adminonly\n// until the remote current_user check earns .isadmin.\nME.classList.add('hudpanel');","patch_id":"p32","time":1793482499947},{"author":"alex89romanov","facet":"js","label":"F12: drop the dead author gate in the panel's update list","new":"        if (mylib) {\n          // F12: the old author gate (if (true) //...) stays off on purpose —\n          // a mismatch marks the chip below instead of hiding it.\n          {\n            if (mylib.version > theirlib.version) {","old":"        if (mylib) {\n          var author = mylib.author;\n          var authorkey = mylib.authorkey;\n          if (true) { //(author && authorkey && theirlib.author == author && theirlib.authorkey == authorkey) {\n            if (mylib.version > theirlib.version) {","patch_id":"p33","time":1793483741299},{"author":"alex89romanov","facet":"js","label":"F12: mark different-author chips in the panel","new":"              chip.appendChild(x);\n              // F12: published by peer.peer, like peerstatus — mark (and\n              // deselect) a different-author chip instead of hiding it.\n              if (document.body.peerAuthorWarn) document.body.peerAuthorWarn(chip, mylib, theirlib);\n\n              ME.querySelector('.availableupgrades').style.display = 'block';","old":"              chip.appendChild(x);\n\n              ME.querySelector('.availableupgrades').style.display = 'block';","patch_id":"p34","time":1793483746388},{"author":"alex89romanov","facet":"js","label":"F10: remove me.install — the shared peerupdater replaces it","new":"// F10: me.install/updateNext are gone — the panel's updates run through the\n// shared document.body.peerupdater (see the .updateall handler below).","old":"me.install = function(lib, v, cb) {\n  var myuuid = document.querySelector('.localpeerid').textContent;\n  var uuid = ME.DATA.id;\n  var el = ME.querySelector('#U_'+lib);\n  animateTo(el, {width:'100%', height:'60px'}, 300, function(){\n    el.insertAdjacentHTML('beforeend', \"<div class='progressbar myprogress'></div>\");\n    document.body.api.ui.initProgress(ME);\n    el.querySelector('.myprogress').setProgress('indeterminate');\n  });\n  var d = 'uuid='+myuuid+'&lib='+lib;\n  json('../peer/remote/'+uuid+'/dev/install_lib', d, function(result){\n    if (result.status == \"ok\") {\n      recompile = recompile || result.data;\n      el.querySelector('.myprogress').setProgress(100);\n      animateTo(el, {width:'0px', height:'0px'}, 300, function(){\n        el.remove();\n      });\n      if (cb) cb();\n    }\n    else {\n      var prog = el.querySelector('.myprogress');\n      if (prog) prog.remove();\n      // F3: result.msg is untrusted — build the error line as text\n      var err = document.createElement('div');\n      err.className = 'progerr';\n      var f = document.createElement('font');\n      f.setAttribute('color', 'red');\n      f.textContent = 'Error: ' + result.msg;\n      err.appendChild(f);\n      el.appendChild(err);\n    }\n  });\n}","patch_id":"p35","time":1793483755810},{"author":"alex89romanov","facet":"js","label":"F10: Update All runs through the shared peerupdater","new":"// F10: the panel's chain runs through the shared updater in peer.peer\n// (document.body.peerupdater): a failure marks its own chip with Retry and\n// the rest still install; the recompile result shows instead of a silent\n// fade-out; the section stays visible with one summary line, and the\n// Update All / Cancel buttons come back when the run ends.\nfunction upgradeSummary(text){\n  var el = ME.querySelector('.upgradesummary');\n  if (!el) {\n    el = document.createElement('div');\n    el.className = 'upgradesummary';\n    ME.querySelector('.availableupgrades').insertBefore(el, ME.querySelector('.updatebuttons'));\n  }\n  el.textContent = text;   // F3: summaries carry peer-reported error text\n}\nME.querySelector('.updateall').addEventListener('click', function(){\n  var up = document.body.peerupdater;\n  if (!up || up.running(ME.DATA.id)) return;\n  var items = [];\n  ME.querySelectorAll('.upgradelist .chip').forEach(function(chip){\n    var el = chip.querySelector('.clickupdate');\n    if (!el || chip.dataset.done == '1') return;\n    // F12: a different-author chip rides only when the user clicked it in\n    if (chip.classList.contains('authwarn') && chip.dataset.included != '1') return;\n    items.push({ lib: el.dataset.lib, version: el.dataset.version, chipEl: chip });\n  });\n  if (items.length == 0) { upgradeSummary('Nothing to update'); return; }\n  var buttons = ME.querySelector('.updatebuttons');\n  buttons.style.display = 'none';\n  up.run(ME.DATA.id, items, {\n    onStart: function(it){ if (it.recompile) upgradeSummary('Recompiling Rust...'); },\n    onDone: function(it){},\n    onError: function(it, text){},\n    onFinish: function(summary){\n      upgradeSummary(summary.text);\n      buttons.style.display = '';\n    }\n  });\n});","old":"function updateNext(){\n  if (ulist.length > 0) {\n    var el = ulist.shift();\n    var lib = el[0];\n    var v = el[1];\n    me.install(lib, v, updateNext);\n  }\n  else {\n    if (recompile){\n      recompile = false;\n      var uuid = ME.DATA.id;\n      ME.querySelector('.upgradelist').innerHTML = \"<i>Recompiling Rust...</i>\";\n      json('../peer/remote/'+uuid+'/dev/compile_rust', null, function(result){\n        updateNext();\n      });\n    }\n    else{\n      var el = ME.querySelector('.availableupgrades');\n      animateTo(el, {opacity:'0'}, 300, function(){\n        el.style.display = 'none';\n        el.style.opacity = '';\n      });\n    }\n  }\n}\n\nvar ulist = [];\nvar recompile = false;\nME.querySelector('.updateall').addEventListener('click', function(){\n  ME.querySelector('.updatebuttons').style.display = 'none';\n  ulist = [];\n  ME.querySelectorAll('.upgradelist .chip').forEach(function(chip){\n    var el = chip.querySelector('.clickupdate');\n    ulist.push([el.dataset.lib, el.dataset.version]);\n  });\n  updateNext();\n});","patch_id":"p36","time":1793483768835},{"author":"agent","facet":"js","label":"3b: the panel counts the chips it skips","new":"  var items = [];\n  var skipped = 0;   // 3b: deselected different-author chips, named in the summary\n  ME.querySelectorAll('.upgradelist .chip').forEach(function(chip){\n    var el = chip.querySelector('.clickupdate');\n    if (!el || chip.dataset.done == '1') return;\n    // F12: a different-author chip rides only when the user clicked it in\n    if (chip.classList.contains('authwarn') && chip.dataset.included != '1') { skipped++; return; }\n    items.push({ lib: el.dataset.lib, version: el.dataset.version, chipEl: chip });\n  });\n  if (items.length == 0) {\n    upgradeSummary('Nothing to update' + (skipped > 0 ? ' — ' + skipped + ' skipped (different author)' : ''));\n    return;\n  }","old":"  var items = [];\n  ME.querySelectorAll('.upgradelist .chip').forEach(function(chip){\n    var el = chip.querySelector('.clickupdate');\n    if (!el || chip.dataset.done == '1') return;\n    // F12: a different-author chip rides only when the user clicked it in\n    if (chip.classList.contains('authwarn') && chip.dataset.included != '1') return;\n    items.push({ lib: el.dataset.lib, version: el.dataset.version, chipEl: chip });\n  });\n  if (items.length == 0) { upgradeSummary('Nothing to update'); return; }","patch_id":"p37","time":1793515041202},{"author":"agent","facet":"js","label":"3b: the panel hands its skipped count to the run","new":"      buttons.style.display = '';\n    }\n  }, skipped);\n});","old":"      buttons.style.display = '';\n    }\n  });\n});","patch_id":"p38","time":1793515045443},{"author":"alex89romanov","facet":"html","label":"F13: address expand/close buttons leave .abspos (overlapped P2P Port)","new":"    <img src='../app/asset/app/icons/ui/accent/more.svg' class='roundbutton-small addressexpandbutton'><img src='../app/asset/app/icons/ui/accent/clos