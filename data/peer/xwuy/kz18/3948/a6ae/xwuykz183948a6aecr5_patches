ME.DATA.p2p_port || '—';\n    ME.querySelector('.hud_http_port').textContent = ME.DATA.http_port || '—';","old":"    ME.querySelector('.hud_ipaddr').textContent = ME.DATA.address || ME.DATA.remote_address || '';\n    ME.querySelector('.hud_port').textContent = ME.DATA.p2p_port;\n    ME.querySelector('.hud_http_port').textContent = ME.DATA.http_port;","patch_id":"p61","time":1793539793372},{"author":"claude (peers-app-fixes phase 7)","facet":"js","label":"7.5: ⋯ titled with the address count; dim +N next to the IP","new":"    // 7.5: the bare ⋯ says what it opens, and a dim +N beside the IP says\n    // the peer reported more than the one address shown.\n    ME.querySelector('.addressexpandbutton').title = 'Show all addresses (' + addrs.length + ')';\n    var cnt = ME.querySelector('.hud_addr_count');\n    if (cnt) {\n      if (addrs.length > 1) { cnt.textContent = '+' + (addrs.length - 1); cnt.classList.remove('hideme'); }\n      else { cnt.textContent = ''; cnt.classList.add('hideme'); }\n    }\n\n    // F15: all three dots share the orb's colour verdict (document.body.peerstatus\n    // from peer.peer): the first `dots` are lit, the rest keep a faint outline in\n    // the same colour; down fills all three grey. Hover says kind + last check.","old":"    // F15: all three dots share the orb's colour verdict (document.body.peerstatus\n    // from peer.peer): the first `dots` are lit, the rest keep a faint outline in\n    // the same colour; down fills all three grey. Hover says kind + last check.","patch_id":"p62","time":1793539837094},{"author":"promote","cmd":"","facet":"memory","label":"promote: fold -> peer.headsup","new":"[\n{\"claim\": \"headsup renders remote-sourced text - result.msg lines, .upgradelist library chips, address chips - with textContent, never innerHTML\", \"detail\": \"F3 (commit a3aa0206), same rule as peer.peer: anything a peer or the network supplies is untrusted. me.update's address chips and the upgrade-list chips are DOM-built with textContent; error msgs are appended as text nodes. The rule applies to every future line touched in this control, not just the F3 spots.\", \"tags\": \"peer.headsup,xss,security,F3\", \"source\": {\"lib\": \"peer\", \"ctl\": \"headsup\", \"facet\": \"js\", \"hash\": \"b7346f6136d1595e\"}, \"confidence\": \"high\", \"time\": 1793417931028},\n{\"claim\": \"#headsupdisplay is one reused container across orb focuses, so state classes set on it (isadmin) leak into the next peer's panel unless reset at mount.\", \"detail\": \"Found on the rig during F7 QA (commit 3a3ae14a, peers-app-fixes): an admin peer's panel earned .isadmin, then a refusing peer's panel opened in the same #headsupdisplay and still showed every admin-only element. The mount handler now strips state classes before wiring. Any future headsup state carried as a class or dataset on the panel root needs the same reset-at-mount discipline.\", \"tags\": \"peer.headsup,peer.peer,ui,mount,state-leak,unreviewed\", \"confidence\": \"high\", \"time\": 1793484067319},\n{\"claim\": \"To exercise the HUD panel without driving the 3D scene, mount peer.headsup directly into #headsupdisplay - that is all onSceneFocus does when an orb gains focus.\", \"detail\": \"Used in the F10 panel QA because the scene-host api handle is awkward to reach from a test script; the direct mount runs the identical code path the orb-focus flow runs, so panel behavior (chips, updater, summaries) is fully testable headlessly this way.\", \"tags\": \"peer.headsup,peer.peer,testing,qa,unreviewed\", \"confidence\": \"medium\", \"time\": 1793485879002},\n{\"claim\": \"Stubbing peer data for HUD tests must drive #headsupdisplay's api directly - wrapping the json() global never intercepts the panel's 10s poll\", \"detail\": \"The panel's periodic peer re-read calls the closure-scoped send_peers binding, not the json global, so a json() stub is bypassed. Working recipe: mutate the orb's live DATA record (e.g. set address:'' and remote_address) and call document.getElementById('headsupdisplay').api.update() - that api object IS the panel's me. Restore the record afterwards. Found while testing F13's remote_address fallback.\", \"tags\": \"peer.headsup,peer.peer,qa,testing,stub,unreviewed\", \"confidence\": \"high\", \"time\": 1793518275981},\n{\"claim\": \"The .hideme utility class cannot hide the HUD's round buttons on its own: the shared app css declares .roundbutton-small { display: inline-flex } after .hideme at equal specificity, so .hideme's display:none loses the cascade — hiding such a button needs a more specific rule (headsup now carries .hudpanel .closeaddressbutton.hideme { display:none }).\", \"detail\": \"Root cause of the F13 stray ✕ (fixed in commit cd43ddeb, journal patch p43): the close-address button was never actually hidden by .hideme; it merely sat invisible under the ⋯ button while .abspos stacked them, and became visible the moment Phase 4 removed .abspos. The expand/collapse click handlers set inline style.display, which outranks the new rule, so toggling still works. General lesson: any element combining .hideme with a class the app css later gives an explicit display value will render; check computed style, not class lists.\", \"tags\": \"peer.headsup,css,hideme,roundbutton,cascade,specificity,unreviewed\", \"confidence\": \"high\", \"time\": 1793521886147},\n{\"claim\": \"Scripted instant close-then-reopen of the peer HUD races the close animation: the close's async onfinish fires after the reopen and stamps display:none onto the hud, blanking the fresh panel — a test-harness artifact, not a product bug.\", \"detail\": \"Hit during Phase 5b step-4 verification (close panel, immediately reopen via hostData.onFocus). Real users cannot trigger it: the 300ms close animation finishes before an orb can be re-tapped, and watchHud guards. Test scripts driving the HUD must either wait out the close animation before reopening or restore display after the stale onfinish lands.\", \"tags\": \"peer.headsup,peer.peer,testing,animation,race,unreviewed\", \"confidence\": \"high\", \"time\": 1793521892425},\n{\"claim\": \"Pixel sampling proves only that the expected content is present — it cannot reveal the unexpected. When screenshots cannot be viewed, every control in the photographed region must also be checked for visibility (getComputedStyle display, getBoundingClientRect), not just the elements the test case names.\", \"detail\": \"Phase 5 of peers-app-fixes marked M22 PASS while its own collapsed shot showed a stray orange ✕ (a Phase 4 regression): the sampler counted the pixels the case expected and had no way to notice an extra button. The 5b fix (cd43ddeb) was only found by a human viewing the image. Standing QA rule for this rig: enumerate the interactive elements in the shot region and assert each one's computed visibility matches the state being photographed.\", \"tags\": \"peer.headsup,peer.peer,qa,screenshots,pixel-sampling,unreviewed\", \"confidence\": \"high\", \"time\": 1793522133686},\n{\"claim\": \"Evidence screenshots must be produced by real user actions with the window visible (document.hidden false); states manufactured by directly toggling classes or styles photograph UI no user can reach. For tabbed UI, assert the tab header and the content agree (.navbar-tab1.selected together with .tab1.selected) before shooting.\", \"detail\": \"The Phase 5b m22 retakes were taken while document.hidden with the Info CONTENT forced visible by script after buildControls had auto-switched the panel header to Dashboard — a header/content combination no in-page click can produce (initNavbar toggles both sides synchronously). The byte-identical files were the tell. Phase 6 retook them with the window visible, Info clicked as a user, and both selected-class pairs verified in agreement. Related quirk: agent.browser.act refuses navbar-tab divs as 'disabled' (same as <tr> rows) — use the plain click tool.\", \"tags\": \"peer.headsup,peer.peer,qa,screenshots,document.hidden,tabs,unreviewed\", \"confidence\": \"high\", \"time\": 1793522141739},\n{\"claim\": \"The headsup panel's tabs are not isolated from the page's: app ui initNavbar clears 'selected' from every .tab-content under its el scope, so clicking the Add Connection dialog's LAN/Connect tabs (page scope) blanks the panel's content while its header stays highlighted; and buildControls in peer.headsup clicks document.querySelector('.navbar-tab2') document-wide, auto-yanking every fresh panel to Dashboard.\", \"detail\": \"Measured on the rig (MEDIUM Phase 6, 2026-11-01): with the panel on Info, Add Connection → Connect left navbar-tab1 selected but .tab1 content stripped (display none) — a real-user header/content mismatch; master has the same code. The full fix (scoping initNavbar's content sweep to the tabs' own container) is a shared app change for Marc; the buildControls lookup could be scoped to ME in peer.headsup. Filed in 3-LOW.md 'To check'. Any control that mounts tabbed sub-controls inside a tabbed page inherits this hazard.\", \"tags\": \"peer.headsup,peer.peer,app.ui,initNavbar,tabs,scope,unreviewed\", \"confidence\": \"medium\", \"time\": 1793522149115, \"adjudicated\": 1793529070388},\n{\"claim\": \"Stubbing app/read replies in page tests must match the POST body, not the URL: the record-id discriminator (e.g. id=controls_shared) rides in the POST data, so a URL-only matcher silently passes every request through unstubbed.\", \"detail\": \"Found during peers LOW Phase 1 while stubbing controls_shared/controls_available failures for F16: the correct stub predicate is a match against url + ' ' + postData. This corrects the §3.4 stub recipe in the peers-app-fixes spec, which matched the URL alone and therefore appeared to stub while actually intercepting nothing.\", \"tags\": \"peer.headsup,peer.peer,qa,stubbing,app-read,unreviewed\", \"confidence\": \"high\", \"time\": 1793525474520},\n{\"claim\": \"peer.headsup remembers the user's tab pick per peer on t