{"data":{"attachmentkeynames":["rs"],"cmd":"info","ctl":"peer","desc":"Reports this instance's system and network information as a JSONObject: local IP addresses, machine and application identifiers, service ports and its own public key (`publickey`). Takes the String `nn_sessionid` supplied by the frame, plus `uuid` (Any) and `salt` (Any) — when `uuid` carries a list of salted peer-id hashes, the matching peers' connection details are included under `connections` and the public keys this instance holds for them under `keys` ({uuid: publickey}), which is how a trusted peer vouches for a key (see peer.peer.peer_key). Nulls for both give local information only.","import":"//use local_ip_address::list_afinet_netifas;\nuse ndata::dataarray::DataArray;\nuse flowlang::datastore::DataStore;\nuse ndata::data::Data;\nuse crate::peer::peer::peers::user_to_peer;\nuse crate::security::security::users::users;\nuse flowlang::blake2b::Blake2b;\nuse crate::peer::service::listen::to_hex;\nuse std::collections::HashMap;\nuse flowlang::flowlang::system::time::time;\nuse flowlang::flowlang::system::system_call::system_call;\n","lib":"peer","params":[{"desc":"The unique session ID assigned to this request","name":"nn_sessionid","type":"String"},{"desc":"A list of peer IDs to retrieve details about. Pass null for none — the param is still required (newbound commands have no optional parameters).","name":"uuid","type":"Any"},{"desc":"The cryptographic salt used together with `uuid` when resolving peer details. Pass null when `uuid` is null — the param is still required.","name":"salt","type":"Any"}],"returntype":"JSONObject","type":"rust"},"id":"tkwkml18390d46728m8","readers":[],"time":1795177424966,"username":"system","writers":[]}