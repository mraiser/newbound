--panel, rgba(20,20,24,0.9));\n}","patch_id":"p10","time":1793905359031},{"author":"agent","facet":"js","label":"R2.7: the status no longer paints outside the slot — drop the stale sentence","new":"// R2.6: every string here is peer-reported (msg, err, the peer name) —\n// textContent only, one div per line so the err text and the update\n// sentence read apart.","old":"// R2.6: every string here is peer-reported (msg, err, the peer name) —\n// textContent only, one div per line so the err text and the update\n// sentence read apart. The status paints under the tile's fixed box.","patch_id":"p11","time":1793905362137},{"author":"promote","cmd":"","facet":"memory","label":"promote: fold -> peer.reboot","new":"[\n{\"claim\": \"The peer.reboot dashboard tile draws a fixed 150x150 canvas but its status line (.rebootstatus) sits in normal flow BELOW the canvas, so a long message grows the tile and pushes the rows below it down instead of painting over a neighbour.\", \"detail\": \"R2.7 (2026-11-05). The icon slot in peer.headsup css (D4) is min-height:150px, not a fixed height, so the tile grows with its status. peer.reboot's redraw() sizes the canvas square from the slot WIDTH (h = w), never clientHeight, so the drawing stays 150x150 however tall the status gets. The status is textContent-only, one div per line. Verified in the rig at 1440x900, panel 360px, and with the tiles reordered Reboot->Camera: the ~374-char Linux failure sentence grew the reboot tile to 412px and the camera tile moved down a clean 12px gap with no overlap.\", \"tags\": \"peer,reboot,ui,dashboard,layout,R2.7\", \"source\": {\"lib\": \"peer\", \"ctl\": \"reboot\", \"facet\": \"css\", \"hash\": \"f9d4f8149276162a\"}, \"confidence\": \"high\", \"time\": 1793907057123},\n{\"end\": true}]\n","old":"","patch_id":"p12","time":1793907059405},{"author":"claude","facet":"js","label":"reboot tile: status lines can carry an explanation behind an info button","new":"// `why`, when given, is the explanation behind an unverified line: an\n// info button on the first line opens it underneath (a tap, not a hover,\n// so it works on phones too).\nfunction setStatus(lines, why){\n  var el = ME.querySelector('.rebootstatus');\n  if (!el) return;\n  el.textContent = '';\n  var first = null;\n  (lines || []).forEach(function(t){\n    if (!t) return;\n    var d = document.createElement('div');\n    d.textContent = t;\n    el.appendChild(d);\n    if (!first) first = d;\n  });\n  if (why && first) {\n    var detail = document.createElement('div');\n    detail.className = 'rebootwhy';\n    detail.textContent = why;\n    detail.hidden = true;\n    var b = document.createElement('button');\n    b.type = 'button';\n    b.className = 'rebootinfo';\n    b.title = 'Why \"probably\"?';\n    b.setAttribute('aria-label', 'Why \"probably\"?');\n    b.setAttribute('aria-expanded', 'false');\n    var img = document.createElement('img');\n    img.src = '../app/asset/app/icons/ui/dark/info.svg';\n    img.alt = '';\n    b.appendChild(img);\n    b.addEventListener('click', function(e){\n      e.stopPropagation();\n      detail.hidden = !detail.hidden;\n      b.setAttribute('aria-expanded', detail.hidden ? 'false' : 'true');\n    });\n    first.appendChild(b);\n    first.parentNode.insertBefore(detail, first.nextSibling);\n  }\n}","old":"function setStatus(lines){\n  var el = ME.querySelector('.rebootstatus');\n  if (!el) return;\n  el.textContent = '';\n  (lines || []).forEach(function(t){\n    if (!t) return;\n    var d = document.createElement('div');\n    d.textContent = t;\n    el.appendChild(d);\n  });\n}","patch_id":"p13","time":1794219170687},{"author":"claude","facet":"js","label":"reboot tile: watch the peer go offline and come back","new":"// The peer's link as peer.peer's poll keeps it: true down, false up,\n// null when the page has no record for it.\nfunction peerDown(){\n  var d = peerDiv();\n  var p = d && d.DATA ? d.DATA : null;\n  if (!p) return null;\n  if (document.body.peerstatus) return document.body.peerstatus(p).kind == 'down';\n  return !(p.tcp || p.udp || p.relay || p.connected);\n}\n\n// The link closed while the reboot request waited for its answer: the\n// machine most likely went down before it could reply (Linux does, the\n// moment systemctl starts the shutdown). Its own failures arrive while\n// it is still up, as an answer with the reason, so they never land here.\nfunction droppedLink(result){\n  var msg = null;\n  if (!result) return false;\n  if (result.status != 'ok') msg = result.msg;\n  else if (result.data && typeof result.data == 'object' && result.data.status == 'err') msg = result.data.msg;\n  return /P2P connection closed|stale P2P connection/i.test(String(msg || ''));\n}\n\nvar WHY_UNVERIFIED = function(){\n  return peerName() + ' stopped responding right after the reboot request, before it could confirm. That usually means it\\'s restarting, but it can\\'t be verified from here.';\n};\n\n// R2.2, extended: after a reboot request, report what the peer's own\n// record shows (peer.peer's poll keeps it fresh) - it goes offline, then\n// comes back - instead of claiming a reboot nobody saw. `unverified` is\n// the dropped-link case, whose lines keep the explanation until the peer\n// is back. Still connected after 60 s is its own answer; offline for\n// 15 min stops the watch with the line as it stands.\nfunction watchRestart(unverified){\n  if (me.watch) clearInterval(me.watch);\n  var start = Date.now();\n  var wentDown = 0;\n  var why = unverified ? WHY_UNVERIFIED() : null;\n  var t = me.watch = setInterval(function(){\n    if (!ME.isConnected) { clearInterval(t); return; }\n    var down = peerDown();\n    if (!wentDown) {\n      if (down) {\n        wentDown = Date.now();\n        // the tile is free again once the peer is offline; the watch for\n        // its return goes on until a new request replaces it\n        me.busy = false;\n        setStatus([peerName() + ' went offline, as expected for a restart.', 'It reconnects once Newbound is running there again.'], why);\n      }\n      else if (Date.now() - start >= 60000) {\n        clearInterval(t);\n        me.busy = false;\n        setStatus([peerName() + ' is still connected; the reboot may not have run.']);\n      }\n    }\n    else if (down === false) {\n      clearInterval(t);\n      setStatus([peerName() + ' is back online.']);\n    }\n    else if (Date.now() - wentDown >= 15 * 60000) {\n      clearInterval(t);\n      setStatus([peerName() + \" hasn't come back yet.\", 'It reconnects once Newbound is running there again.'], why);\n    }\n  }, 2000);\n}","old":"// R2.2: success means the machine is going down — watch the peer's own\n// record (peer.peer's poll keeps it fresh) until the link drops; the orb\n// greys on its own. Still connected after 60 s is its own answer.\nfunction watchDown(){\n  var start = Date.now();\n  var t = setInterval(function(){\n    if (!ME.isConnected) { clearInterval(t); return; }\n    var d = peerDiv();\n    var p = d && d.DATA ? d.DATA : null;\n    var down = p ? !(p.tcp || p.udp || p.relay || p.connected) : false;\n    if (p && document.body.peerstatus) down = document.body.peerstatus(p).kind == 'down';\n    if (down) {\n      clearInterval(t);\n      me.busy = false;\n      setStatus([]);\n    }\n    else if (Date.now() - start >= 60000) {\n      clearInterval(t);\n      me.busy = false;\n      setStatus([peerName() + \" hasn't gone down yet.\"]);\n    }\n  }, 2000);\n}","patch_id":"p14","time":1794219184924},{"author":"claude","facet":"js","label":"reboot tile: a dropped link reads as probably restarting","new":"    if (droppedLink(result)) {\n      // no answer, so no claim: say what was seen, explain behind ⓘ,\n      // and let the peer's record show what really happens next\n      setStatus(['Connection lost: probably restarting.'], WHY_UNVERIFIED());\n      watchRestart(true);\n      return;\n    }\n    var err = replyError(result);\n    if (err != null) { setStatus([err]); me.busy = false; return; }","old":"    var err = replyError(result);\n    if (err != null) { setStatus([err]); me.busy = false; return; }","patch_id":"p15","time":1794219195487},{"author":"claude","facet":"js","label":"reboot tile: a confirmed reboot is watched to its return too","new":"      // R2.2: the machine named the command it ran — now wait for it to\n      // actually go down and come back (watchRestart clears me.busy).\n      setStatus(['Rebooting…']);\n      watchRestart(false);","old":"      // R2.2: the machine named the command it ran — now wait for it to\n      // actually go down (watchDown clears me.busy).\n      setStatus(['Rebooting…']);\n      watchDown();","patch_id":"p16","time":1794219195499},{"author":"claude","facet":"css","label":"reboot tile: style the info button and its explanation","new":".rebootstatus:empty {\n  display: none;\n}\n\n/* the ⓘ after an unverified line, and the explanation it opens */\n.rebootinfo {\n  display: inline-flex;\n  vertical-align: middle;\n  margin-left: 4px;\n  padding: 2px;\n  border: 0;\n  border-radius: 4px;\n  background: transparent;\n  cursor: pointer;\n  opacity: 0.75;\n}\n\n.rebootinfo:hover,\n.rebootinfo:focus-visible,\n.rebootinfo[aria-expanded=\"true\"] {\n  opacity: 1;\n}\n\n.rebootinfo img {\n  width: 14px;\n  height: 14px;\n  display: block;\n}\n\n.rebootwhy {\n  margin-top: 4px;\n  padding: 6px 8px;\n  border-radius: 4px;\n  background: rgba(255, 255, 255, 0.06);\n  color: var(--text-muted, #aaa);\n}","old":".rebootstatus:empty {\n  display: none;\n}","patch_id":"p17","time":1794219195507},{"author":"claude","facet":"js","label":"reboot tile: a new request stops the previous watch","new":"  me.busy = true;\n  // a new request replaces the last one's watch for the peer's return\n  if (me.watch) { clearInterval(me.watch); me.watch = null; }\n  setStatus([]);","old":"  me.busy = true;\n  setStatus([]);","patch_id":"p18","time":1794219201956},{"author":"claude","facet":"css","label":"reboot tile: use t