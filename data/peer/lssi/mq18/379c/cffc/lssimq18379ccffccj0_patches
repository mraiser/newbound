ppendChild(document.createTextNode('Error: ' + result.msg));\n              }","old":"              else {\n                chip.style.color = 'rgba(255,0,0,0.5)';\n                chip.insertAdjacentHTML('beforeend', '<br>Error: '+result.msg);\n              }","patch_id":"p69","time":1793391335179},{"author":"agent","facet":"js","label":"F3: crate-update status line set as text","new":"              var st = row.querySelector('.rowstatus');\n              st.innerHTML = '<i></i>';\n              st.firstChild.textContent = 'Updating platform crates to flowlang '+fl+' / ndata '+nd+'...';","old":"              row.querySelector('.rowstatus').innerHTML = \"<i>Updating platform crates to flowlang \"+fl+\" / ndata \"+nd+\"...</i>\";","patch_id":"p70","time":1793391341811},{"author":"agent","facet":"js","label":"F3: update_crates error message set as text","new":"                if (result.status == 'ok') row.querySelector('.rowstatus').innerHTML = \"<i>crate update launched — open the peer's panel for progress and the restart verdict</i>\";\n                else {\n                  // F3: result.msg is untrusted — set it as text\n                  var est = row.querySelector('.rowstatus');\n                  est.innerHTML = '<font color=\"red\"></font>';\n                  est.firstChild.textContent = 'Error: ' + result.msg;\n                }","old":"                if (result.status == 'ok') row.querySelector('.rowstatus').innerHTML = \"<i>crate update launched — open the peer's panel for progress and the restart verdict</i>\";\n                else row.querySelector('.rowstatus').innerHTML = '<font color=\"red\">Error: '+result.msg+'</font>';","patch_id":"p71","time":1793391348746},{"author":"agent","facet":"js","label":"F4: in-flight add registry","new":"me.peers = [];\n\n// F4: app.scenehost.addControl is async — the key lands in byId/children only\n// after its awaits — so overlapping syncPeers calls (waitReady and the\n// send_info callback both fire it) would add the same peer twice. me.adding\n// marks the in-flight adds, keyed by peer id.\nme.adding = {};\n\nme.uiReady = function(ui){","old":"me.peers = [];\n\nme.uiReady = function(ui){","patch_id":"p72","time":1793392463675},{"author":"agent","facet":"js","label":"F4: guard async orb adds; remove unwanted late-resolvers","new":"function syncPeers(){\n  if (!me.host) return;\n  var want = {};\n  var list = peerList();\n  for (var i in list) {\n    var p = list[i];\n    // no self-orb: your own position carries no information\n    if (me.info && p.id == me.info.uuid) continue;\n    want[p.id] = p;\n    // F4: skip a peer whose orb exists OR whose add is still in flight\n    if (!me.adding[p.id] && (!me.host.byId || !me.host.byId(p.id))) addPeerOrb(p);\n  }\n  for (var k = me.host.children.length - 1; k >= 0; k--) {\n    var inst = me.host.children[k];\n    // F4: an in-flight add is not a leftover — its settle handler decides\n    if (!want[inst.key] && !me.adding[inst.key]) me.host.removeControl(inst.key);\n  }\n}\n\n// F4: one guarded add per peer. The flag clears when the host's promise\n// settles (success or failure); a peer that left while its add was in\n// flight is removed straight away.\nfunction addPeerOrb(p){\n  var id = p.id;\n  me.adding[id] = true;\n  function settled(added){\n    delete me.adding[id];\n    if (!added) return;\n    var gone = !getByProperty(peerList(), 'id', id) || (me.info && id == me.info.uuid);\n    if (gone && me.host.byId && me.host.byId(id)) me.host.removeControl(id);\n  }\n  try {\n    var pr = me.host.addControl('peer', 'peer_model', p, id);\n    if (pr && pr.then) pr.then(function(){ settled(true); }, function(){ settled(false); });\n    else settled(true);\n  } catch (x) {\n    settled(false);\n  }\n}","old":"function syncPeers(){\n  if (!me.host) return;\n  var want = {};\n  var list = peerList();\n  for (var i in list) {\n    var p = list[i];\n    // no self-orb: your own position carries no information\n    if (me.info && p.id == me.info.uuid) continue;\n    want[p.id] = p;\n    if (!me.host.byId || !me.host.byId(p.id)) me.host.addControl('peer', 'peer_model', p, p.id);\n  }\n  for (var k = me.host.children.length - 1; k >= 0; k--) {\n    var inst = me.host.children[k];\n    if (!want[inst.key]) me.host.removeControl(inst.key);\n  }\n}","patch_id":"p73","time":1793392475336},{"author":"agent","facet":"js","label":"F5: rows always resolve — Unauthorized/error states, local libs fetched first","new":"// F5: the words for a refused or failed peer call — shared with the F10\n// update-flow rewrite (session 2), so keep it a tiny helper. 'Unauthorized'\n// is Alex's exact word for a refusal.\nfunction peerErrorText(result){\n  if (result && result.msg == 'UNAUTHORIZED') return 'Unauthorized';\n  return 'Error: ' + (result && result.msg ? result.msg : 'no reply');\n}\n\n// F5: end a row in its error state — dim red text, checkbox disabled.\nfunction rowError(uuid, text){\n  var el = ME.querySelector('.r_'+uuid);\n  if (!el) return;\n  var status = el.querySelector('.rowstatus');\n  status.innerHTML = '';\n  var sp = document.createElement('span');\n  sp.className = 'rowerror';\n  sp.textContent = text;   // F3: error text is untrusted — never HTML\n  status.appendChild(sp);\n  var box = el.querySelector('.libupdate');\n  if (box) { box.checked = false; box.disabled = true; }\n}\n\nfunction checkForUpdates(peer) {\n  var uuid = peer.id;\n  // F5: the local library list may not have landed yet — fetch it first,\n  // then compare. Never drop the row silently.\n  if (document.body.locallibraries) compareWithPeer();\n  else json('../app/libs', null, function(r){\n    if (r.status == 'ok' && r.data) document.body.locallibraries = r.data;\n    compareWithPeer();\n  });\n\n  function compareWithPeer(){\n    json('../peer/remote/'+uuid+'/app/libs', null, function(result){\n      // F5: a refusal ({status:err, msg:UNAUTHORIZED}) or any other error\n      // resolves the row instead of leaving it on pending... forever.\n      if (result.status != 'ok' || !result.data) { rowError(uuid, peerErrorText(result)); return; }\n      if (!document.body.locallibraries) { rowError(uuid, 'Error: local library list unavailable'); return; }\n      // F3: library ids and versions come from the remote peer — chips are\n      // built with DOM calls and textContent, never innerHTML.\n      var chips = [];\n      for (var i in result.data) {\n        var theirlib = result.data[i];\n        var mylib = getByProperty(document.body.locallibraries, 'id', theirlib.id);\n        if (mylib) {\n          var author = mylib.author;\n          var authorkey = mylib.authorkey;\n          if (true) { //(author && authorkey && theirlib.author == author && theirlib.authorkey == authorkey) {\n            if (mylib.version > theirlib.version) {\n              var chip = document.createElement('span');\n              chip.className = 'chip ispos';\n              chip.id = 'U_' + mylib.id;\n              var click = document.createElement('span');\n              click.className = 'clickupdate';\n              click.dataset.lib = mylib.id;\n              click.dataset.version = mylib.version;\n              click.textContent = mylib.id + ' v' + theirlib.version + ' ➤ ' + mylib.version;\n              chip.appendChild(click);\n              chip.appendChild(chipCloseImg());\n              chips.push(chip);\n            }\n          }\n        }\n      }\n      // crate pins ride the same row: a peer lagging the local flowlang/ndata\n      // versions gets a distinct chip (clickcrates, NOT clickupdate - the lib\n      // installer must never treat it as a library). A refused crate_versions\n      // just leaves the chip out (F5 keeps that).\n      json('../peer/remote/'+uuid+'/dev/crate_versions', null, function(cr){\n        var lc = me.localcrates;\n        if (cr && cr.status == 'ok' && lc && lc.status == 'ok' && (cr.flowlang != lc.flowlang || cr.ndata != lc.ndata)) {\n          var chip = document.createElement('span');\n          chip.className = 'chip clickcrates';\n          chip.dataset.flowlang = lc.flowlang;\n          chip.dataset.ndata = lc.ndata;\n          chip.textContent = 'crates: flowlang ' + cr.flowlang + ' ➤ ' + lc.flowlang + ' / ndata ' + cr.ndata + ' ➤ ' + lc.ndata;\n          chip.appendChild(chipCloseImg());\n          chips.push(chip);\n        }\n        var el = ME.querySelector('.r_'+uuid);\n        if (!el) return;\n        if (chips.length == 0) el.remove();\n        else {\n          var status = el.querySelector('.rowstatus');\n          status.innerHTML = '';\n          chips.forEach(function(c){ status.appendChild(c); status.appendChild(document.createTextNode(' ')); });\n          el.querySelectorAll('.removeupdate').forEach(function(x){\n            x.addEventListener('click', function(){\n              this.closest('.chip').remove();\n            });\n          });\n        }\n      });\n    });\n  }\n}","old":"function checkForUpdates(peer) {\n  var uuid = peer.id;\n  json('../peer/remote/'+uuid+'/app/libs', null, function(result){\n    if (result.data && document.body.locallibraries) {\n      // F3: library ids and versions come from the remote peer — chips are\n      // built with DOM calls and textContent, never innerHTML.\n      var chips = [];\n      for (var i in result.data) {\n        var theirlib = result.data[i];\n        var mylib = getByProperty(document.body.locallibraries, 'id', theirlib.id);\n        if (mylib) {\n          var author = mylib.author;\n          var authorkey = mylib.authorkey;\n          if (true) { //(author && authorkey && theirlib.author == author && theirlib.authorkey == authorkey) {\n            if (mylib.version > theirlib.version) {\n              var chip = document.createElement('span');\n              chip.className = 'chip ispos';\n              chip.id = 'U_' + mylib.id;\n              var click = document.createElement('span');\n              click.className = 'clickupdate';\n              click.dataset.lib = mylib.id;\n              click.dataset.version = mylib.version;\n              click.textContent = mylib.id + ' v' + theirlib.version + ' ➤ ' + mylib.version;\n              chip.appendChild(click);\n              chip.appendChild(chipCloseImg());\n              chips.push(chip);\n            }\n          }\n        }\n      }\n      // crate pins ride the same row: a peer lagging the local flowlang/ndata\n      // versions gets a distinct chip (clickcrates, NOT clickupdate - the lib\n      // installer must never treat it as a library)\n      json('../peer/remote/'+uuid+'/dev/crate_versions', null, function(cr){\n        var lc = me.localcrates;\n        if (cr && cr.status == 'ok' && lc && lc.status == 'ok' && (cr.flowlang != lc.flowlang || cr.ndata != lc.ndata)) {\n          var chip = document.createElement('span');\n          chip.className = 'chip clickcrates';\n          chip.dataset.flowlang = lc.flowlang;\n          chip.dataset.ndata = lc.ndata;\n          chip.textContent = 'crates: flowlang ' + cr.flowlang + ' ➤ ' + lc.flowlang + ' / ndata ' + cr.ndata + ' ➤ ' + lc.ndata;\n          chip.appendChild(chipCloseImg());\n          chips.push(chip);\n        }\n        var el = ME.querySelector('.r_'+uuid);\n        if (!el) return;\n        if (chips.length == 0) el.remove();\n        else {\n          var status = el.querySelector('.rowstatus');\n          status.innerHTML = '';\n          chips.forEach(function(c){ status.appendChild(c); status.appendChild(document.createTextNode(' ')); });\n          el.querySelectorAll('.removeupdate').forEach(function(x){\n            x.addEventListener('click', function(){\n              this.closest('.chip').remove();\n            });\n          });\n        }\n      });\n    }\n  });\n}","patch_id":"p74","time":1793392513639},{"author":"agent","facet":"css","label":"F5: dim-red row error text","new":".peerupdatelist{\n  width:600px;\n  height:300px;\n  overflow-y:scroll;\n  padding:10px;\n}\n\n/* F5: a row that ended in an error — dim red (its checkbox is disabled) */\n.rowerror{\n  color: rgba(255, 0, 0, 0.6);\n}","old":".peerupdatelist{\n  width:600px;\n  height:300px;\n  overflow-y:scroll;\n  padding:10px;\n}","patch_id":"p75","time":1793392520140},{"author":"agent","facet":"js","label":"F5: proxied refusals carry 'UNAUTHORIZED: <cmd>' — prefix-match them","new":"function peerErrorText(result){\n  // the peer proxy suffixes the refused command ('UNAUTHORIZED: libs'), so\n  // any UNAUTHORIZED-prefixed msg is the same refusal\n  var msg = result && result.msg ? String(result.msg) : '';\n  if (msg == 'UNAUTHORIZED' || msg.indexOf('UNAUTHORIZED') == 0) return 'Unauthorized';\n  return 'Error: ' + (msg ? msg : 'no reply');\n}","old":"function peerErrorText(result){\n  if (result && result.msg == 'UNAUTHORIZED') return 'Unauthorized';\n  return 'Error: ' + (result && result.msg ? result.msg : 'no reply');\n}","patch_id":"p76","time":1793392927358},{"author":"promote","cmd":"","facet":"memory","label":"promote: fold -> peer.peer","new":"[\n{\"claim\": \"COMMAND IDS ARE THE PEER-TO-PEER WIRE CONTRACT. The jsapi send_* wrappers resolve a command name to the CALLING instance's command id and ship the id to the remote (app.app.exec takes lib + id; the remote does Command::new(db, id) and panics 'Missing file data/...' when the id is absent). Signature compatibility is irrelevant if ids differ. Consequences: (1) NEVER delete_command + re-upsert a command that remote peers call - upsert_command alone already preserves BOTH the command record id and the rust source id for an existing name, so plain upsert is always the id-safe edit; delete-first is only for genuinely retiring a command; (2) dev.code.patch_command_body with an empty old_snippet is BROKEN - it ballooned a 1.8KB source record to 3.7MB of nested content (fold2, 2026-08-11) - use upsert_command for full-body rewrites; (3) save_command requires a live HTTP session (its app_read fails with Key 'data' not found over MCP). This id contract is what broke the owner's first v52 rollout against v51 peers, and retroactively explains the original v44-lineage 'incompatibility' too.\", \"tags\": \"platform-api,p2p,exec,ids,wire,upsert,patch_command_body,bug\", \"source\": {\"doc\": \"live v51 peer panic log from the owner + app.app.exec source + fold2/fold3 verification, 2026-08-11\"}, \"confidence\": \"high\", \"time\": 1786447774149},\n{\"claim\": \"The peer proxy cannot stream InputStream command results: peer.local (newbound_core) creates a peer stream (begin_stream/write_stream pump) ONLY for `file` responses - a bytes `body` (an InputStream return like camera live) is a process-local DataBytes ref that cannot cross the wire, so the viewer-side peer.remote finds neither stream_id nor usable body and returns its 404 sentinel. Symptom: remote live view falls back to JPEG polling instantly (File-returning commands - snapshot, last_keyframe, play - stream fine over peers, which is why everything else works in the HUD). Fix sketch (platform, owner blessing required per the boundary doctrine): a third branch in peer.local mirroring the file branch - when body is bytes, begin_stream and pump DataBytes.read into write_stream until close, carrying the mime type; peer.remote already join_streams. Found 2026-08-12 diagnosing the owner HUD report.\", \"tags\": \"peer,streaming,inputstream,proxy,live,platform-gap\", \"source\": {\"doc\": \"newbound_core/src/peer/peer/local.rs + remote.rs read, owner HUD report, 2026-08-12\"}, \"confidence\": \"high\", \"time\": 1786542476727},\n{\"claim\": \"InputStream-over-peers landed on newbound branch claude/peer-stream-bytes-bodies (2026-08-12, standalone off master, awaiting owner review): peer.peer.local gained a bytes-body branch (begin_stream + DataBytes pump, 16KB chunks, mime carried, 30s starvation cap) and peer.service.listen gained the s_4 close-back - s_2 detects a dead local reader (write false / entry gone) and answers s_4, whose handler retires the matching STREAMWRITERS entry so the senders write_stream fails and its pump stops ~1s after viewer disconnect. Wire-compatible with old peers in both directions. Two-instance lab verification: same-host peering works via discovery master/slave + setuser with keepalive (maintenance auto-connects; peer users must be in a group check_security accepts - production uses admin; a non-admin group 404s every proxied command instantly, which is also the diagnostic signature of an unauthorized peer). Remote status/file/live all green; live delivers ffprobe-clean fMP4 into an in-page Chromium fetch with correct avc1 codec parse. CRITICAL build gotcha: dev.code patches on a STATIC library regenerate src and build the rlib but do NOT relink the host binary - test runs silently exercise the old code until a cargo build relinks (~2s); check strings <binary> for a new literal before trusting a static-lib test.\", \"tags\": \"peer,streaming,s4,close-back,inputstream,lab,static-lib-relink\", \"source\": {\"doc\": \"two-disposable peer lab, newbound claude/peer-stream-bytes-bodies, 2026-08-12\"}, \"confidence\": \"medium\", \"time\": 1786546269385, \"adjudicated\": 1793394746425},\n{\"claim\": \"The popup machinery centers a dialog card at its open-time height and never re-centers, so content that fills in after open (e.g. the LAN discovery list) grows the card past the bottom of the viewport.\", \"detail\": \"Found fixing F2 (Add Connection clipping): dropping the fixed card height alone is not enough - the tab body needs its own scroll cap (calc(50vh + 40px) used) so late-arriving rows scroll instead of growing the card, and an empty tab needs a min-height close to the populated tab so the open-time measurement that drives centering is honest.\", \"tags\": \"peer.peer,frontend,popup,css,dialogs,unreviewed\", \"confidence\": \"high\", \"time\": 1793392959847},\n{\"claim\": \"syncPeers guards app.scenehost's async addControl with me.adding, so each peer gets exactly one orb\", \"detail\": \"scenehost.addControl registers the key in byId/children only after its awaits, and syncPeers fires from both the waitReady and send_info callbacks, so unguarded overlap added every peer twice - and the duplicate stayed a frozen ghost because syncPeerData updates only the byId instance. Fix (F4, commit ad6575f9) lives entirely in peer.peer js: me.adding[id] marks the in-flight add; syncPeers skips a peer when byId(id) or me.adding[id] is set; the remove loop never removes a key still in me.adding; addPeerOrb's settle handler (resolve or reject) clears the flag and immediately removes the orb if its peer left while the add was in flight. app.scenehost is shared - fix callers, never the host.\", \"tags\": \"peer.peer,scenehost,orbs,race,F4\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417921382},\n{\"claim\": \"peerErrorText(result) is the single wording for a failed peer call: 'Unauthorized' for an UNAUTHORIZED msg (prefix match), else 'Error: <msg>'\", \"detail\": \"F5 (commit 2f7e40a2). Every Update Peers row must end in one of three states - chips, removed (nothing to update), or an error - never 'pending...'. rowError paints the status cell with .rowerror (dim red) and disables the row's checkbox. The peer proxy suffixes the refused command ('UNAUTHORIZED: libs'), hence the prefix match. checkForUpdates fetches ../app/libs first when document.body.locallibraries hasn't landed; a refused dev/crate_versions just leaves the crates chip out. 'Unauthorized' is Alex's exact chosen word; the F10 update-flow rewrite (session 2) must keep calling peerErrorText.\", \"tags\": \"peer.peer,update-peers,errors,F5\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417925088},\n{\"claim\": \"Untrusted strings on the Peers page go into the DOM with textContent and dataset, never innerHTML\", \"detail\": \"F3 (commit a3aa0206). Discovery names ride unauthenticated LAN UDP packets (port 5770), and peer display names, library ids/versions and error msgs come from remote peers. The LAN table rows, buildUpdateDialog's rows, the update/crates chips, and the #updateallpeersnow error lines are built with DOM calls + textContent; data-* carriers use dataset, never concatenated HTML. Static shells may stay literal innerHTML. Server side is still open: discovery.rs stores packet bytes 40+ as the name with no authentication - follow-up for Marc.\", \"tags\": \"peer.peer,xss,security,F3\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417928260},\n{\"claim\": \"The Add Connection card (.addusercard) sizes to content and the TAB BODY scrolls - the card itself must not, because the popup machinery centers the card at its open-time height\", \"detail\": \"F2 (commit 2ec3bf86). The fixed 367px height is gone: .addusercard caps at calc(100vh - 80px), width 600px (calc(100vw - 32px) under 640px). .addusercard .tab-content gets overflow:auto with max-height calc(50vh + 40px): the cap stays near half the viewport so a LAN list that grows AFTER the open can never push the card's bottom off screen. .discovered keeps min-height:280px so the empty LAN tab measures near the Connect tab's height at open-time centering. .card is overflow:hidden by the shared kit - don't fight it, scroll the tab body.\", \"tags\": \"peer.peer,css,layout,add-connection,F2\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"css\", \"hash\": \"d45055d480860ed7\"}, \"confidence\": \"high\", \"time\": 1793417934613},\n{\"claim\": \"buildUpdateDialog reads peer names from me.peers (the same objects as #peer_<id>.DATA), not from a json reply - stub a name in tests by mutating that live record\", \"detail\": \"Session-1 QA (H05): wrapping the page's json() helper cannot stub display names in the Update Peers dialog because no json call carries them; mutate document.getElementById('peer_'+id).DATA.name (shared with me.peers) instead. Also relevant for QA: agent.browser.act refuses to click <tr> rows (reports them disabled) - use the plain click tool for table rows.\", \"tags\": \"peer.peer,testing,qa,stubs\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"medium\", \"time\": 1793417937428},\n{\"end\": true}]\n","old":"[\n  {\n    \"claim\": \"COMMAND IDS ARE THE PEER-TO-PEER WIRE CONTRACT. The jsapi send_* wrappers resolve a command name to the CALLING instance's command id and ship the id to the remote (app.app.exec takes lib + id; the remote does Command::new(db, id) and panics 'Missing file data/...' when the id is absent). Signature compatibility is irrelevant if ids differ. Consequences: (1) NEVER delete_command + re-upsert a command that remote peers call - upsert_command alone already preserves BOTH the command record id and the rust source id for an existing name, so plain upsert is always the id-safe edit; delete-first is only for genuinely retiring a command; (2) dev.code.patch_command_body with an empty old_snippet is BROKEN - it ballooned a 1.8KB source record to 3.7MB of nested content (fold2, 2026-08-11) - use upsert_command for full-body rewrites; (3) save_command requires a live HTTP session (its app_read fails with Key 'data' not found over MCP). This id contract is what broke the owner's first v52 rollout against v51 peers, and retroactively explains the original v44-lineage 'incompatibility' too.\",\n    \"tags\": \"platform-api,p2p,exec,ids,wire,upsert,patch_command_body,bug\",\n    \"source\": {\n      \"doc\": \"live v51 peer panic log from the owner + app.app.exec source + fold2/fold3 verification, 2026-08-11\"\n    },\n    \"confidence\": \"high\",\n    \"time\": 1786447774149\n  },\n  {\n    \"claim\": \"The peer proxy cannot stream InputStream command results: peer.local (newbound_core) creates a peer stream (begin_stream/write_stream pump) ONLY for `file` responses - a bytes `body` (an InputStream return like camera live) is a process-local DataBytes ref that cannot cross the wire, so the viewer-side peer.remote finds neither stream_id nor usable body and returns its 404 sentinel. Symptom: remote live view falls back to JPEG polling instantly (File-returning commands - snapshot, last_keyframe, play - stream fine over peers, which is why everything else works in the HUD). Fix sketch (platform, owner blessing required per the boundary doctrine): a third branch in peer.local mirroring the file branch - when body is bytes, begin_stream and pump DataBytes.read into write_stream until close, carrying the mime type; peer.remote already join_streams. Found 2026-08-12 diagnosing the owner HUD report.\",\n    \"tags\": \"peer,streaming,inputstream,proxy,live,platform-gap\",\n    \"source\": {\n      \"doc\": \"newbound_core/src/peer/peer/local.rs + remote.rs read, owner HUD report, 2026-08-12\"\n    },\n    \"confidence\": \"high\",\n    \"time\": 1786542476727\n  },\n  {\n    \"claim\": \"InputStream-over-peers landed on newbound branch claude/peer-stream-bytes-bodies (2026-08-12, standalone off master, awaiting owner review): peer.peer.local gained a bytes-body branch (begin_stream + DataBytes pump, 16KB chunks, mime carried, 30s starvation cap) and peer.service.listen gained the s_4 close-back - s_2 detects a dead local reader (write false / entry gone) and answers s_4, whose handler retires the matching STREAMWRITERS entry so the senders write_stream fails and its pump stops ~1s after viewer disconnect. Wire-compatible with old peers in both directions. Two-instance lab verification: same-host peering works via discovery master/slave + setuser with keepalive (maintenance auto-connects; peer users must be in a group check_security accepts - production uses admin; a non-admin group 404s every proxied command instantly, which is also the diagnostic signature of an unauthorized peer). Remote status/file/live all green; live delivers ffprobe-clean fMP4 into an in-page Chromium fetch with correct avc1 codec parse. CRITICAL build gotcha: dev.code patches on a STATIC library regenerate src and build the rlib but do NOT relink the host binary - test runs silently exercise the old code until a cargo build relinks (~2s); check strings <binary> for a new literal before trusting a static-lib test.\",\n    \"tags\": \"peer,streaming,s4,close-back,inputstream,lab,static-lib-relink\",\n    \"source\": {\n      \"doc\": \"two-disposable peer lab, newbound claude/peer-stream-bytes-bodies, 2026-08-12\"\n    },\n    \"confidence\": \"high\",\n    \"time\": 1786546269385\n  }\n]\n","patch_id":"p77","time":1793417942419},{"author":"agent","facet":"js","label":"use the new close icon in chipCloseImg (master icons PR follow-through)","new":"  x.src = '../app/asset/app/icons/ui/dark/close.svg';","old":"  x.src = '../app/asset/app/close-white.png';","patch_id":"p78","time":1793476742711},{"author":"agent","facet":"js","label":"F6+F15: publish document.body.peerstatus — the one link-state verdict","new":"me.adding = {};\n\n// F6 + F15: ONE source of truth for a peer's link state, shared by the orb's\n// tint (peer.peer_model) and the panel's dots (peer.headsup) so sphere and\n// dots always read as the same colour. Hues are tint()'s, frozen at full\n// strength (hsl 132/212/48, s .46/.48/.60, l .54) as one hex per kind.\nvar STATUS_COLORS = { tcp: '#54c069', udp: '#5186c2', relay: '#d0b443', down: '#9e9e9e' };\ndocument.body.peerstatus = function(p, now){\n  p = p || {};\n  if (!now) now = Date.now();\n  var kind = p.tcp ? 'tcp' : p.udp ? 'udp' : (p.relay || p.connected) ? 'relay' : 'down';\n  var age = p.last_contact ? Math.max(0, now - p.last_contact) : Infinity;\n  var f = 0;\n  if (isFinite(age)) {\n    if (age <= 30000) f = 1;\n    else if (age < 900000) f = 1 - (age - 30000) / (900000 - 30000);\n  }\n  var dots = kind == 'down' ? 0 : age <= 30000 ? 3 : age <= 300000 ? 2 : 1;\n  return { kind: kind, color: STATUS_COLORS[kind], freshness: f, dots: dots };\n};\n\nme.uiReady = function(ui){","old":"me.adding = {};\n\nme.uiReady = function(ui){","patch_id":"p79","time":1793478048805},{"author":"agent","facet":"js","label":"F6: re-read peers every 10 s so last_contact stays honest","new":"function startFeed(){\n  if (me.feed || !me.host || !me.info) return;\n  feedTick();\n  if (!me.feed) me.feed = setInterval(feedTick, FEED_MS);\n  startPoll();\n}\n\n// F6: me.peers only changed on UPDATE events, so a quiet-but-connected peer's\n// last_contact never advanced and its orb faded to grey. Re-read the peer list\n// every 10 s — upsertPeerDiv refreshes the hidden data divs (headsup reads\n// them) and the feed loop's syncPeerData pushes the records into the orbs.\n// Never faster than 10 s; the timer stops itself once the control is gone.\nvar POLL_MS = 10000;\nfunction startPoll(){\n  if (me.poll) return;\n  me.poll = setInterval(function(){\n    if (!ME.isConnected) { clearInterval(me.poll); me.poll = null; return; }\n    send_peers(function(result){\n      if (result.status != 'ok' || !result.data) return;\n      me.peers = [];\n      for (var i in result.data) {\n        me.peers.push(result.data[i]);\n        upsertPeerDiv(result.data[i]);\n      }\n    });\n  }, POLL_MS);\n}","old":"function startFeed(){\n  if (me.feed || !me.host || !me.info) return;\n  feedTick();\n  if (!me.feed) me.feed = setInterval(feedTick, FEED_MS);\n}","patch_id":"p80","time":1793478058024},{"author":"agent","facet":"js","label":"F11: publish peerErrorText for the headsup panel","new":"  if (msg == 'UNAUTHORIZED' || msg.indexOf('UNAUTHORIZED') == 0) return 'Unauthorized';\n  return 'Error: ' + (msg ? msg : 'no reply');\n}\n// Session 2 (F8/F11): headsup shows the same words — published the way\n// peerstatus is, so both controls keep one vocabulary.\ndocument.body.peerErrorText = peerErrorText;","old":"  if (msg == 'UNAUTHORIZED' || msg.indexOf('UNAUTHORIZED') == 0) return 'Unauthorized';\n  return 'Error: ' + (msg ? msg : 'no reply');\n}","patch_id":"p81","time":1793482280447},{"author":"alex89romanov","facet":"js","label":"F10+F12: shared peerupdater + author-warn helper, published on document.body","new":"// Session 2 (F8/F11): headsup shows the same words — published the way\n// peerstatus is, so both controls keep one vocabulary.\ndocument.body.peerErrorText = peerErrorText;\n\n// F12: the old author/authorkey gate was disabled (if (true)) — Marc may have\n// done that on purpose, so it stays off. Instead, when BOTH sides carry an\n// author and authorkey and they differ, the chip is marked: warning text, a\n// title naming who wrote each copy, and it starts DESELECTED (dimmed, left\n// out of Update All / Update Selected) until the user clicks it to include\n// it. Published for peer.headsup, like peerstatus and peerErrorText.\nfunction applyAuthorWarn(chip, mylib, theirlib){\n  var a1 = mylib.author, k1 = mylib.authorkey;\n  var a2 = theirlib.author, k2 = theirlib.authorkey;\n  if (!(a1 && k1 && a2 && k2)) return;\n  if (a1 == a2 && k1 == k2) return;\n  chip.classList.add('authwarn');\n  chip.dataset.included = '0';\n  chip.style.opacity = '0.45';\n  // F3: author names are untrusted — a title is a plain attribute, never markup\n  chip.title = 'Different author — local copy by ' + a1 + ', peer\\'s copy by ' + a2 + '. Click to include this update anyway.';\n  var w = document.createElement('span');\n  w.className = 'authwarntext';\n  w.style.color = '#b26a00';\n  w.textContent = ' ⚠ different author';\n  var x = chip.querySelector('.removeupdate');\n  if (x) chip.insertBefore(w, x); else chip.appendChild(w);\n  chip.addEventListener('click', function(ev){\n    if (ev.target.closest && ev.target.closest('.removeupdate, .chipretry')) return;\n    var inc = chip.dataset.included == '1';\n    chip.dataset.included = inc ? '0' : '1';\n    chip.style.opacity = inc ? '0.45' : '1';\n  });\n}\ndocument.body.peerAuthorWarn = applyAuthorWarn;\n\n// F10: ONE updater behind both update flows — the Update Peers dialog's rows\n// and the panel's \"can be updated\" list. Installs run in the order the chips\n// are shown (shift, never pop) and the chip of the library ACTUALLY being\n// installed is the one marked. A failure turns its own chip red (textContent),\n// grows a Retry link, and never stops the rest. After the libraries, a crates\n// item replaces the recompile (the crate runner rebuilds+recompiles itself);\n// otherwise one compile_rust runs when any install answered data:true, and\n// its failure is an error, not a silent success. One run per peer at a time —\n// a second start for a running peer is ignored (run() answers false).\nvar updaterRuns = {};\ndocument.body.peerupdater = {\n  running: function(peerId){ return !!updaterRuns[peerId]; },\n  run: function(peerId, items, hooks){\n    if (updaterRuns[peerId]) return false;\n    updaterRuns[peerId] = true;\n    hooks = hooks || {};\n    var lp = document.querySelector('.localpeerid');\n    var myuuid = me.info ? me.info.uuid : (lp ? lp.textContent : '');\n    var libs = [], cratesItem = null;\n    (items || []).forEach(function(it){\n      if (it && it.crates) cratesItem = it;\n      else if (it && it.lib) libs.push(it);\n    });\n    var sum = { updated: 0, failed: 0, crates: null, recompile: null, recompile_msg: '' };\n    var needRecompile = false;\n\n    function call(h, a, b){ try { if (hooks[h]) hooks[h](a, b); } catch (x) { console.error(x); } }\n    function chipStart(it){\n      var c = it.chipEl;\n      if (!c || !c.isConnected) return;\n      c.style.color = 'rgba(0,0,0,0.5)';\n      var x = c.querySelector('.removeupdate');\n      if (x) x.remove();\n    }\n    function chipDone(it){\n      var c = it.chipEl;\n      if (!c || !c.isConnected) return;\n      c.dataset.done = '1';\n      var ok = document.createElement('span');\n      ok.style.color = '#2e7d32';\n      ok.textContent = ' ✓';\n      c.appendChild(ok);\n    }\n    function chipError(it, text){\n      var c = it.chipEl;\n      if (!c || !c.isConnected) return;\n      c.style.color = '#b00020';\n      var br = document.createElement('br');\n      var sp = document.createElement('span');\n      sp.className = 'chiperr';\n      sp.textContent = text;   // F3: error text is untrusted — never HTML\n      var r = document.createElement('a');\n      r.className = 'chipretry';\n      r.textContent = ' Retry';\n      r.style.cursor = 'pointer';\n      r.style.textDecoration = 'underline';\n      c.appendChild(br); c.appendChild(sp); c.appendChild(r);\n      r.addEventListener('click', function(ev){\n        ev.stopPropagation();\n        br.remove(); sp.remove(); r.remove();\n        c.style.color = '';\n        var again = it.crates ? { crates: it.crates, chipEl: c } : { lib: it.lib, version: it.version, chipEl: c };\n        document.body.peerupdater.run(peerId, [again], hooks);\n      });\n    }\n    function buildText(s){\n      var t = '';\n      if (s.failed > 0) t = s.updated + ' updated, ' + s.failed + ' failed';\n      else if (s.updated > 0) t = 'All updated';\n      if (s.crates == 'launched') t += (t ? ' — ' : '') + \"crate update launched — open the peer's panel for progress and the restart verdict\";\n      else if (s.crates == 'failed') t += (t ? ' — ' : '') + 'crate update failed';\n      if (s.recompile == 'ok') t += (t ? ' — ' : '') + 'Rust recompiled';\n      else if (s.recompile == 'failed') t += (t ? ' — ' : '') + 'recompile failed: ' + s.recompile_msg;\n      if (!t) t = 'Nothing to update';\n      return t;\n    }\n    function finish(){\n      sum.text = buildText(sum);\n      delete updaterRuns[peerId];\n      call('onFinish', sum);\n    }\n    function nextLib(){\n      if (libs.length == 0) { afterLibs(); return; }\n      var it = libs.shift();\n      call('onStart', it);\n      chipStart(it);\n      json('../peer/remote/'+peerId+'/dev/install_lib', 'uuid='+encodeURIComponent(myuuid)+'&lib='+encodeURIComponent(it.lib), function(result){\n        if (result && result.status == 'ok') {\n          sum.updated++;\n          if (result.data === true) needRecompile = true;\n          chipDone(it);\n          call('onDone', it);\n        }\n        else {\n          sum.failed++;\n          var text = peerErrorText(result);\n          chipError(it, text);\n          call('onError', it, text);\n        }\n        nextLib();\n      });\n    }\n    function afterLibs(){\n      if (cratesItem) {\n        var it = cratesItem;\n        call('onStart', it);\n        chipStart(it);\n        var p = 'flowlang='+encodeURIComponent(it.crates.flowlang)+'&ndata='+encodeURIComponent(it.crates.ndata);\n        json('../peer/remote/'+peerId+'/dev/update_crates', p, function(result){\n          if (result && result.status == 'ok') { sum.crates = 'launched'; chipDone(it); call('onDone', it); }\n          else { sum.crates = 'failed'; var text = peerErrorText(result); chipError(it, text); call('onError', it, text); }\n          finish();\n        });\n      }\n      else if (needRecompile) {\n        var it = { recompile: true };\n        call('onStart', it);\n        json('../peer/remote/'+peerId+'/dev/compile_rust', null, function(result){\n          if (result && result.status == 'ok') { sum.recompile = 'ok'; call('onDone', it); }\n          else {\n            sum.recompile = 'failed';\n            sum.recompile_msg = result && result.msg ? String(result.msg) : 'no reply';\n            call('onError', it, sum.recompile_msg);\n          }\n          finish();\n        });\n      }\n      else finish();\n    }\n    nextLib();\n    return true;\n  }\n};","old":"// Session 2 (F8/F11): headsup shows the same words — published the way\n// peerstatus is, so both controls keep one vocabulary.\ndocument.body.peerErrorText = peerErrorText;","patch_id":"p82","time":1793483647713},{"author":"alex89romanov","facet":"js","label":"F12: drop the dead author gate in checkForUpdates","new":"        if (mylib) {\n          // F12: the old author gate (if (true) //...) stays off on purpose —\n          // a mismatch marks the chip below (applyAuthorWarn) instead of\n          // hiding it.\n          {\n            if (mylib.version > theirlib.version) {","old":"        if (mylib) {\n          var author = mylib.author;\n          var authorkey = mylib.authorkey;\n          if (true) { //(author && authorkey && theirlib.author == author && theirlib.authorkey == authorkey) {\n            if (mylib.version > theirlib.version) {","patch_id":"p83","time":1793483655073},{"author":"alex89romanov","facet":"js","label":"F12: mark different-author chips in the dialog","new":"              chip.appendChild(chipCloseImg());\n              applyAuthorWarn(chip, mylib, theirlib);\n              chips.push(chip);","old":"              chip.appendChild(chipCloseImg());\n              chips.push(chip);","patch_id":"p84","time":1793483661230},{"author":"alex89romanov","facet":"js","label":"F10: track pending update checks","new":"  var tbody = el.querySelector('tbody');\n  // F10: rows still checking — when the last one resolves and none is left,\n  // the dialog says so (checkDone) instead of sitting there as an empty table.\n  me.upPending = 0;\n  for (var i in me.peers) {","old":"  var tbody = el.querySelector('tbody');\n  for (var i in me.peers) {","patch_id":"p85","time":1793483670128},{"author":"alex89romanov","facet":"js","label":"F10: count rows, settle the no-connected-peers case","new":"      tbody.appendChild(tr);\n      me.upPending++;\n      checkForUpdates(p);\n    }\n  }\n  if (me.upPending == 0) { me.upPending = 1; checkDone(); }\n  el.querySelector('.toggleallupdates').addEventListener('click', function(){","old":"      tbody.appendChild(tr);\n      checkForUpdates(p);\n    }\n  }\n  el.querySelector('.toggleallupdates').addEventListener('click', function(){","patch_id":"p86","time":1793483675233},{"author":"alex89romanov","facet":"js","label":"F10: checkDone — say 'All connected peers are up to date' instead of an empty table","new":"  var box = el.querySelector('.libupdate');\n  if (box) { box.checked = false; box.disabled = true; }\n}\n\n// F10: one check resolved. When every row has resolved and none remains\n// (every connected peer's chips came back empty), say so — the old code\n// removed the rows and left a silent empty table.\nfunction checkDone(){\n  me.upPending--;\n  if (me.upPending > 0) return;\n  var list = ME.querySelector('.peerupdatelist');\n  if (list && !list.querySelector('.uprow')) list.innerHTML = '<div class=\"padme\"><i>All connected peers are up to date</i></div>';\n}","old":"  var box = el.querySelector('.libupdate');\n  if (box) { box.checked = false; box.disabled = true; }\n}","patch_id":"p87","time":1793483682169},{"author":"alex89romanov","facet":"js","label":"F10: error paths resolve the pending check","new":"      if (result.status != 'ok' || !result.data) { rowError(uuid, peerErrorText(result)); checkDone(); return; }\n      if (!document.body.locallibraries) { rowError(uuid, 'Error: local library list unavailable'); checkDone(); return; }","old":"      if (result.status != 'ok' || !result.data) { rowError(uuid, peerErrorText(result)); return; }\n      if (!document.body.locallibraries) { rowError(uuid, 'Error: local library list unavailable'); return; }","patch_id":"p88","time":1793483688282},{"author":"alex89romanov","facet":"js","label":"F10: the chip-building terminal resolves the pending check","new":"        var el = ME.querySelector('.r_'+uuid);\n        if (!el) { checkDone(); return; }\n        if (chips.length == 0) el.remove();\n        else {\n          var status = el.querySelector('.rowstatus');\n          status.innerHTML = '';\n          chips.forEach(function(c){ status.appendChild(c); status.appendChild(document.createTextNode(' ')); });\n          el.querySelectorAll('.removeupdate').forEach(function(x){\n            x.addEventListener('click', function(){\n              this.closest('.chip').remove();\n            });\n          });\n        }\n        checkDone();\n      });","old":"        var el = ME.querySelector('.r_'+uuid);\n        if (!el) return;\n        if (chips.length == 0) el.remove();\n        else {\n          var status = el.querySelector('.rowstatus');\n          status.innerHTML = '';\n          chips.forEach(function(c){ status.appendChild(c); status.appendChild(document.createTextNode(' ')); });\n          el.querySelectorAll('.removeupdate').forEach(function(x){\n            x.addEventListener('click', function(){\n              this.closest('.chip').remove();\n            });\n          });\n        }\n      });","patch_id":"p89","time":1793483703474},{"author":"alex89romanov","facet":"js","label":"F10: Update Selected Peers runs through the shared peerupdater","new":"// F10: both flows run through document.body.peerupdater. The button goes\n// dark while any selected row runs (a second click, or a second start for a\n// peer already running, is ignored); rows never vanish — each keeps its\n// chips and shows one summary line that stays until the dialog closes.\nME.querySelector('#updateallpeersnow').addEventListener('click', function(){\n  var btn = this;\n  if (btn.disabled) return;\n  var up = document.body.peerupdater;\n  var pending = 0;\n  function rowNote(row, text){\n    var n = row.querySelector('.rowsummary');\n    if (!n) {\n      n = document.createElement('div');\n      n.className = 'rowsummary';\n      row.querySelector('.rowstatus').appendChild(n);\n    }\n    n.textContent = text;   // F3: summaries carry peer-reported error text\n  }\n  ME.querySelectorAll('.libupdate').forEach(function(el){\n    if (!el.checked || el.disabled) return;\n    var row = el.closest('.uprow');\n    var peer = row.dataset.peer;\n    var items = [];\n    row.querySelectorAll('.clickupdate').forEach(function(click){\n      var chip = click.closest('.chip');\n      if (!chip || chip.dataset.done == '1') return;\n      // F12: a different-author chip rides only when the user clicked it in\n      if (chip.classList.contains('authwarn') && chip.dataset.included != '1') return;\n      items.push({ lib: click.dataset.lib, version: click.dataset.version, chipEl: chip });\n    });\n    var cratechip = row.querySelector('.clickcrates');\n    if (cratechip && cratechip.dataset.done != '1') {\n      items.push({ crates: { flowlang: cratechip.dataset.flowlang, ndata: cratechip.dataset.ndata }, chipEl: cratechip });\n    }\n    if (items.length == 0) return;\n    pending++;\n    var started = up.run(peer, items, {\n      onStart: function(it){\n        if (it.recompile) rowNote(row, 'Recompiling Rust...');\n        else if (it.crates) rowNote(row, 'Updating platform crates to flowlang ' + it.crates.flowlang + ' / ndata ' + it.crates.ndata + '...');\n      },\n      onDone: function(it){},\n      onError: function(it, text){},\n      onFinish: function(summary){\n        rowNote(row, summary.text);\n        pending--;\n        if (pending <= 0) btn.disabled = false;\n      }\n    });\n    if (!started) pending--;\n  });\n  if (pending > 0) btn.disabled = true;\n});","old":"ME.querySelector('#updateallpeersnow').addEventListener('click', function(){\n  var myuuid = document.querySelector('.localpeerid').textContent;\n  ME.querySelectorAll('.libupdate').forEach(function(el){\n    if (el.checked) {\n      var row = el.closest('.uprow');\n      var peer = row.dataset.peer;\n      var libs = [];\n      row.querySelectorAll('.clickupdate').forEach(function(chip){\n        libs.push(chip.dataset.lib);\n      });\n\n      if (libs.length > 0 || row.querySelector('.clickcrates')) {\n\n        var recompile = false;\n\n        function fetchNext() {\n          if (libs.length > 0) {\n            var lib = libs.pop();\n            console.log(peer+\"/\"+lib);\n            var x = row.querySelector('.removeupdate');\n            var chip = x.parentElement;\n            chip.style.color = 'rgba(0,0,0,0.5)';\n            x.remove();\n\n            var d = 'uuid='+myuuid+'&lib='+lib;\n            json('../peer/remote/'+peer+'/dev/install_lib', d, function(result){\n              if (result.status == \"ok\") {\n                recompile = recompile || result.data;\n                chip.remove();\n                fetchNext();\n              }\n              else {\n                chip.style.color = 'rgba(255,0,0,0.5)';\n                // F3: result.msg is untrusted — append it as text\n                chip.appendChild(document.createElement('br'));\n                chip.appendChild(document.createTextNode('Error: ' + result.msg));\n              }\n            });\n          }\n          else {\n            var cratechip = row.querySelector('.clickcrates');\n            if (cratechip) {\n              // the crate runner's own rebuild+recompile covers everything a\n              // compile_rust would have done, so it replaces that step\n              var fl = cratechip.dataset.flowlang;\n              var nd = cratechip.dataset.ndata;\n              var st = row.querySelector('.rowstatus');\n              st.innerHTML = '<i></i>';\n              st.firstChild.textContent = 'Updating platform crates to flowlang '+fl+' / ndata '+nd+'...';\n              json('../peer/remote/'+peer+'/dev/update_crates', 'flowlang='+encodeURIComponent(fl)+'&ndata='+encodeURIComponent(nd), function(result){\n                if (result.status == 'ok') row.querySelector('.rowstatus').innerHTML = \"<i>crate update launched — open the peer's panel for progress and the restart verdict</i>\";\n                else {\n                  // F3: result.msg is untrusted — set it as text\n                  var est = row.querySelector('.rowstatus');\n                  est.innerHTML = '<font color=\"red\"></font>';\n                  est.firstChild.textContent = 'Error: ' + result.msg;\n                }\n              });\n            }\n            else if (recompile) {\n              row.querySelector('.rowstatus').innerHTML = \"<i>Recompiling Rust...</i>\";\n              json('../peer/remote/'+peer+'/dev/compile_rust', null, function(result){\n                row.remove();\n              });\n            }\n            else row.remove();\n          }\n        }\n        fetchNext();\n      }\n    }\n  });\n});","patch_id":"p90","time":1793483734125},{"author":"agent","facet":"js","label":"3b: run() takes the callers' skipped-chip count","new":"  run: function(peerId, items, hooks, skipped){\n    if (updaterRuns[peerId]) return false;\n    updaterRuns[peerId] = true;\n    hooks = hooks || {};","old":"  run: function(peerId, items, hooks){\n    if (updaterRuns[peerId]) return false;\n    updaterRuns[peerId] = true;\n    hooks = hooks || {};","patch_id":"p91","time":1793514978599},{"author":"agent","facet":"js","label":"3b: the summary carries the skipped count","new":"    var sum = { updated: 0, failed: 0, skipped: skipped > 0 ? skipped : 0, crates: null, recompile: null, recompile_msg: '' };","old":"    var sum = { updated: 0, failed: 0, crates: null, recompile: null, recompile_msg: '' };","patch_id":"p92","time":1793514983357},{"author":"agent","facet":"js","label":"3b: Retry guards a running peer; error gets its own readable line","new":"    function chipError(it, text){\n      var c = it.chipEl;\n      if (!c || !c.isConnected) return;\n      // 3b: the chip is a nowrap flex row, so a <br> never broke the line and\n      // #b00020 was unreadable on the graphite chip — the error lives on its\n      // own wrapped line (.chiperrline, peer.peer css) in a readable red.\n      c.classList.add('chiperrored');\n      c.style.color = '#ff8a80';\n      var line = document.createElement('span');\n      line.className = 'chiperrline';\n      var sp = document.createElement('span');\n      sp.className = 'chiperr';\n      sp.textContent = text;   // F3: error text is untrusted — never HTML\n      var r = document.createElement('a');\n      r.className = 'chipretry';\n      r.textContent = 'Retry';\n      r.style.cursor = 'pointer';\n      r.style.textDecoration = 'underline';\n      line.appendChild(sp); line.appendChild(r);\n      c.appendChild(line);\n      r.addEventListener('click', function(ev){\n        ev.stopPropagation();\n        // 3b: while this peer's run is still going, run() would refuse — do\n        // nothing rather than wipe the error off a chip that can't restart.\n        // (Single-threaded: past this guard, run() below always starts.)\n        if (document.body.peerupdater.running(peerId)) return;\n        line.remove();\n        c.classList.remove('chiperrored');\n        c.style.color = '';\n        var again = it.crates ? { crates: it.crates, chipEl: c } : { lib: it.lib, version: it.version, chipEl: c };\n        document.body.peerupdater.run(peerId, [again], hooks, sum.skipped);\n      });\n    }","old":"    function chipError(it, text){\n      var c = it.chipEl;\n      if (!c || !c.isConnected) return;\n      c.style.color = '#b00020';\n      var br = document.createElement('br');\n      var sp = document.createElement('span');\n      sp.className = 'chiperr';\n      sp.textContent = text;   // F3: error text is untrusted — never HTML\n      var r = document.createElement('a');\n      r.className = 'chipretry';\n      r.textContent = ' Retry';\n      r.style.cursor = 'pointer';\n      r.style.textDecoration = 'underline';\n      c.appendChild(br); c.appendChild(sp); c.appendChild(r);\n      r.addEventListener('click', function(ev){\n        ev.stopPropagation();\n        br.remove(); sp.remove(); r.remove();\n        c.style.color = '';\n        var again = it.crates ? { crates: it.crates, chipEl: c } : { lib: it.lib, version: it.version, chipEl: c };\n        document.body.peerupdater.run(peerId, [again], hooks);\n      });\n    }","patch_id":"p93","time":1793514996494},{"author":"agent","facet":"js","label":"3b: summary names the skipped different-author chips","new":"      if (!t) t = 'Nothing to update';\n      // 3b: a deselected different-author chip was left out on purpose — the\n      // summary says so instead of claiming 'All updated' past it.\n      if (s.skipped > 0) t += ' — ' + s.skipped + ' skipped (different author)';\n      return t;","old":"      if (!t) t = 'Nothing to update';\n      return t;","patch_id":"p94","time":1793515002276},{"author":"agent","facet":"js","label":"3b: the author warning's gap survives flex whitespace trimming","new":"  var w = document.createElement('span');\n  w.className = 'authwarntext';\n  w.style.color = '#b26a00';\n  // 3b: the chip is a flex row — a flex item's leading space is trimmed (it\n  // rendered as '17⚠'), so the gap is a margin instead of a space.\n  w.style.marginLeft = '6px';\n  w.textContent = '⚠ different author';","old":"  var w = document.createElement('span');\n  w.className = 'authwarntext';\n  w.style.color = '#b26a00';\n  w.textContent = ' ⚠ different author';","patch_id":"p95","time":1793515008235},{"author":"agent","facet":"js","label":"3b: the dialog counts the chips it skips","new":"    var items = [];\n    var skipped = 0;   // 3b: deselected different-author chips, named in the summary\n    row.querySelectorAll('.clickupdate').forEach(function(click){\n      var chip = click.closest('.chip');\n      if (!chip || chip.dataset.done == '1') return;\n      // F12: a different-author chip rides only when the user clicked it in\n      if (chip.classList.contains('authwarn') && chip.dataset.included != '1') { skipped++; return; }\n      items.push({ lib: click.dataset.lib, version: click.dataset.version, chipEl: chip });\n    });","old":"    var items = [];\n    row.querySelectorAll('.clickupdate').forEach(function(click){\n      var chip = click.closest('.chip');\n      if (!chip || chip.dataset.done == '1') return;\n      // F12: a different-author chip rides only when the user clicked it in\n      if (chip.classList.contains('authwarn') && chip.dataset.included != '1') return;\n      items.push({ lib: click.dataset.lib, version: click.dataset.version, chipEl: chip });\n    });","patch_id":"p96","time":1793515014973},{"author":"agent","facet":"js","label":"3b: an all-skipped row still gets a summary line","new":"    if (items.length == 0) {\n      // 3b: a row whose only chips are deselected ⚠ ones runs nothing — say so\n      if (skipped > 0) rowNote(row, 'Nothing to update — ' + skipped + ' skipped (different author)');\n      return;\n    }\n    pending++;\n    var started = up.run(peer, items, {","old":"    if (items.length == 0) return;\n    pending++;\n    var started = up.run(peer, items, {","patch_id":"p97","time":1793515020306},{"author":"agent","facet":"js","label":"3b: the dialog hands its skipped count to the run","new":"    }, skipped);\n    if (!started) pending--;","old":"    });\n    if (!started) pending--;","patch_id":"p98","time":1793515024241},{"author":"agent","facet":"css","label":"3b: wrapped, readable chip error line","new":"/* F5: a row that ended in an error — dim red (its checkbox is disabled) */\n.rowerror{\n  color: rgba(255, 0, 0, 0.6);\n}\n\n/* 3b: a failed chip grows an error line. .chip (app.ui) is a nowrap flex\n   row, so the chip must wrap for the error to land on its own line, and\n   the red is picked to read on the graphite chip (#b00020 didn't). The\n   headsup panel's chips live on this page too, so these cover both flows. */\n.chip.chiperrored {\n  height: auto;\n  flex-wrap: wrap;\n  white-space: normal;\n  line-height: 1.5;\n  padding-top: 5px;\n  padding-bottom: 5px;\n}\n.chiperrline {\n  flex-basis: 100%;\n  display: block;\n}\n.chiperrline .chiperr {\n  color: #ff8a80;\n}\n.chiperrline .chipretry {\n  margin-left: 8px;\n}","old":"/* F5: a row that ended in an error — dim red (its checkbox is disabled) */\n.rowerror{\n  color: rgba(255, 0, 0, 0.6);\n}","patch_id":"p99","time":1793515033444},{"author":"promote","cmd":"","facet":"memory","label":"promote: fold -> peer.peer","new":"[\n{\"claim\": \"COMMAND IDS ARE THE PEER-TO-PEER WIRE CONTRACT. The jsapi send_* wrappers resolve a command name to the CALLING instance's command id and ship the id to the remote (app.app.exec takes lib + id; the remote does Command::new(db, id) and panics 'Missing file data/...' when the id is absent). Signature compatibility is irrelevant if ids differ. Consequences: (1) NEVER delete_command + re-upsert a command that remote peers call - upsert_command alone already preserves BOTH the command record id and the rust source id for an existing name, so plain upsert is always the id-safe edit; delete-first is only for genuinely retiring a command; (2) dev.code.patch_command_body with an empty old_snippet is BROKEN - it ballooned a 1.8KB source record to 3.7MB of nested content (fold2, 2026-08-11) - use upsert_command for full-body rewrites; (3) save_command requires a live HTTP session (its app_read fails with Key 'data' not found over MCP). This id contract is what broke the owner's first v52 rollout against v51 peers, and retroactively explains the original v44-lineage 'incompatibility' too.\", \"tags\": \"platform-api,p2p,exec,ids,wire,upsert,patch_command_body,bug\", \"source\": {\"doc\": \"live v51 peer panic log from the owner + app.app.exec source + fold2/fold3 verification, 2026-08-11\"}, \"confidence\": \"high\", \"time\": 1786447774149},\n{\"claim\": \"The peer proxy cannot stream InputStream command results: peer.local (newbound_core) creates a peer stream (begin_stream/write_stream pump) ONLY for `file` responses - a bytes `body` (an InputStream return like camera live) is a process-local DataBytes ref that cannot cross the wire, so the viewer-side peer.remote finds neither stream_id nor usable body and returns its 404 sentinel. Symptom: remote live view falls back to JPEG polling instantly (File-returning commands - snapshot, last_keyframe, play - stream fine over peers, which is why everything else works in the HUD). Fix sketch (platform, owner blessing required per the boundary doctrine): a third branch in peer.local mirroring the file branch - when body is bytes, begin_stream and pump DataBytes.read into write_stream until close, carrying the mime type; peer.remote already join_streams. Found 2026-08-12 diagnosing the owner HUD report.\", \"tags\": \"peer,streaming,inputstream,proxy,live,platform-gap\", \"source\": {\"doc\": \"newbound_core/src/peer/peer/local.rs + remote.rs read, owner HUD report, 2026-08-12\"}, \"confidence\": \"high\", \"time\": 1786542476727},\n{\"claim\": \"InputStream-over-peers landed on newbound branch claude/peer-stream-bytes-bodies (2026-08-12, standalone off master, awaiting owner review): peer.peer.local gained a bytes-body branch (begin_stream + DataBytes pump, 16KB chunks, mime carried, 30s starvation cap) and peer.service.listen gained the s_4 close-back - s_2 detects a dead local reader (write false / entry gone) and answers s_4, whose handler retires the matching STREAMWRITERS entry so the senders write_stream fails and its pump stops ~1s after viewer disconnect. Wire-compatible with old peers in both directions. Two-instance lab verification: same-host peering works via discovery master/slave + setuser with keepalive (maintenance auto-connects; peer users must be in a group check_security accepts - production uses admin; a non-admin group 404s every proxied command instantly, which is also the diagnostic signature of an unauthorized peer). Remote status/file/live all green; live delivers ffprobe-clean fMP4 into an in-page Chromium fetch with correct avc1 codec parse. CRITICAL build gotcha: dev.code patches on a STATIC library regenerate src and build the rlib but do NOT relink the host binary - test runs silently exercise the old code until a cargo build relinks (~2s); check strings <binary> for a new literal before trusting a static-lib test.\", \"tags\": \"peer,streaming,s4,close-back,inputstream,lab,static-lib-relink\", \"source\": {\"doc\": \"two-disposable peer lab, newbound claude/peer-stream-bytes-bodies, 2026-08-12\"}, \"confidence\": \"medium\", \"time\": 1786546269385, \"adjudicated\": 1793394746425},\n{\"claim\": \"The popup machinery centers a dialog card at its open-time height and never re-centers, so content that fills in after open (e.g. the LAN discovery list) grows the card past the bottom of the viewport.\", \"detail\": \"Found fixing F2 (Add Connection clipping): dropping the fixed card height alone is not enough - the tab body needs its own scroll cap (calc(50vh + 40px) used) so late-arriving rows scroll instead of growing the card, and an empty tab needs a min-height close to the populated tab so the open-time measurement that drives centering is honest.\", \"tags\": \"peer.peer,frontend,popup,css,dialogs,unreviewed\", \"confidence\": \"high\", \"time\": 1793392959847},\n{\"claim\": \"syncPeers guards app.scenehost's async addControl with me.adding, so each peer gets exactly one orb\", \"detail\": \"scenehost.addControl registers the key in byId/children only after its awaits, and syncPeers fires from both the waitReady and send_info callbacks, so unguarded overlap added every peer twice - and the duplicate stayed a frozen ghost because syncPeerData updates only the byId instance. Fix (F4, commit ad6575f9) lives entirely in peer.peer js: me.adding[id] marks the in-flight add; syncPeers skips a peer when byId(id) or me.adding[id] is set; the remove loop never removes a key still in me.adding; addPeerOrb's settle handler (resolve or reject) clears the flag and immediately removes the orb if its peer left while the add was in flight. app.scenehost is shared - fix callers, never the host.\", \"tags\": \"peer.peer,scenehost,orbs,race,F4\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417921382},\n{\"claim\": \"peerErrorText(result) is the single wording for a failed peer call: 'Unauthorized' for an UNAUTHORIZED msg (prefix match), else 'Error: <msg>'\", \"detail\": \"F5 (commit 2f7e40a2). Every Update Peers row must end in one of three states - chips, removed (nothing to update), or an error - never 'pending...'. rowError paints the status cell with .rowerror (dim red) and disables the row's checkbox. The peer proxy suffixes the refused command ('UNAUTHORIZED: libs'), hence the prefix match. checkForUpdates fetches ../app/libs first when document.body.locallibraries hasn't landed; a refused dev/crate_versions just leaves the crates chip out. 'Unauthorized' is Alex's exact chosen word; the F10 update-flow rewrite (session 2) must keep calling peerErrorText.\", \"tags\": \"peer.peer,update-peers,errors,F5\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417925088},\n{\"claim\": \"Untrusted strings on the Peers page go into the DOM with textContent and dataset, never innerHTML\", \"detail\": \"F3 (commit a3aa0206). Discovery names ride unauthenticated LAN UDP packets (port 5770), and peer display names, library ids/versions and error msgs come from remote peers. The LAN table rows, buildUpdateDialog's rows, the update/crates chips, and the #updateallpeersnow error lines are built with DOM calls + textContent; data-* carriers use dataset, never concatenated HTML. Static shells may stay literal innerHTML. Server side is still open: discovery.rs stores packet bytes 40+ as the name with no authentication - follow-up for Marc.\", \"tags\": \"peer.peer,xss,security,F3\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417928260},\n{\"claim\": \"The Add Connection card (.addusercard) sizes to content and the TAB BODY scrolls - the card itself must not, because the popup machinery centers the card at its open-time height\", \"detail\": \"F2 (commit 2ec3bf86). The fixed 367px height is gone: .addusercard caps at calc(100vh - 80px), width 600px (calc(100vw - 32px) under 640px). .addusercard .tab-content gets overflow:auto with max-height calc(50vh + 40px): the cap stays near half the viewport so a LAN list that grows AFTER the open can never push the card's bottom off screen. .discovered keeps min-height:280px so the empty LAN tab measures near the Connect tab's height at open-time centering. .card is overflow:hidden by the shared kit - don't fight it, scroll the tab body.\", \"tags\": \"peer.peer,css,layout,add-connection,F2\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"css\", \"hash\": \"d45055d480860ed7\"}, \"confidence\": \"high\", \"time\": 1793417934613},\n{\"claim\": \"buildUpdateDialog reads peer names from me.peers (the same objects as #peer_<id>.DATA), not from a json reply - stub a name in tests by mutating that live record\", \"detail\": \"Session-1 QA (H05): wrapping the page's json() helper cannot stub display names in the Update Peers dialog because no json call carries them; mutate document.getElementById('peer_'+id).DATA.name (shared with me.peers) instead. Also relevant for QA: agent.browser.act refuses to click <tr> rows (reports them disabled) - use the plain click tool for table rows.\", \"tags\": \"peer.peer,testing,qa,stubs\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"medium\", \"time\": 1793417937428},\n{\"claim\": \"Peer discovery still stores unauthenticated UDP-5770 packet bytes as device names server-side (discovery.rs); only the client rendering was hardened.\", \"detail\": \"The F3 fix (peers-app-fixes, 2026-10) made the Peers UI render LAN-discovered names with textContent so injected strings are inert, but the server's discovery path accepts and records whatever bytes arrive on the UDP broadcast port with no validation or authentication. Any host on the LAN can plant arbitrary device-name strings in the discovery cache. Validating/authenticating discovery payloads is open, deferred to Marc at the session-1 hand-back.\", \"tags\": \"peer.peer,peer.service,discovery,security,udp,unreviewed\", \"confidence\": \"high\", \"time\": 1793418142452},\n{\"claim\": \"Automation opens a peer's HUD by calling the scene host's hostData.onFocus(<peer-uuid>) directly - the exact handler an orb tap fires - instead of attempting a WebGL canvas click.\", \"detail\": \"Used in peers-app-fixes Phase 0: orb hit-testing inside the WebGL canvas is impractical to drive from scripts, but app.scenehost exposes the focus handler on hostData, and invoking it with the target UUID exercises the same code path as a real tap, opening peer.headsup with the correct record.\", \"tags\": \"peer.peer,peer.headsup,app.scenehost,qa,webgl,unreviewed\", \"confidence\": \"high\", \"time\": 1793479277272},\n{\"claim\": \"A peer's last_contact cannot show real TCP recency: the server stamps last_contact = now for any live TCP link, and drops the field entirely for a disconnected peer.\", \"detail\": \"Confirmed during F6/F15 (peers-app-fixes MEDIUM phase 1): a connected TCP peer always renders full brightness and 3 freshness dots because every read sees last_contact = now, and a down peer shows 'last check unknown' because the field is absent - both are honest renderings of what the server records, not UI bugs. Making the dots reflect actual TCP check recency requires a backend change (flagged as a follow-up for Marc in the phase 5 report).\", \"tags\": \"peer.peer,peer.headsup,last_contact,recency,f6,f15,unreviewed\", \"confidence\": \"high\", \"time\": 1793482251381},\n{\"claim\": \"initPopups reads a trigger's data-popup attribute at click time, so stripping or restoring the attribute enables/disables a popup menu item live, with no re-init.\", \"detail\": \"Used for F11 (peers-app-fixes): when the first controls_shared read fails with a non-NOT-FOUND error, the Add Control menu item's data-popup attribute is removed (plus a title explaining why), and the popup can never open - clicks do nothing because the attribute lookup happens per click, not at wiring time. Restoring the attribute re-arms it.\", \"tags\": \"peer.peer,peer.headsup,popup,frontend,unreviewed\", \"confidence\": \"high\", \"time\": 1793484080057},\n{\"claim\": \"document.body.peerupdater is the ONE shared library-update engine: peer.peer's js installs it, and both the Update Peers dialog and the headsup panel's Update All drive their installs through run(peerId, items, hooks) instead of their own chains (F10); document.body.peerAuthorWarn is the shared author-mismatch marker (F12).\", \"detail\": \"Contract (commit 88629f82, peers-app-fixes): items are {lib, version, chipEl} plus an optional {crates, chipEl}; hooks onStart/onDone/onError/onFinish. Installs run in chip order with the chip actually being installed marked; a failure reds ITS OWN chip with the error as textContent plus a Retry link and the chain continues; one run per peer (second start ignored), done-chips skipped on re-run; after the libraries a crates item replaces the recompile, else one compile_rust runs when any install answered data:true and its failure lands in the row summary. peerAuthorWarn: when both sides carry author+authorkey and they differ, the chip gets '⚠ different author', a title naming both, and starts dimmed/deselected until clicked in. Future edits to either update flow go through these helpers, never a re-grown per-control install chain.\", \"tags\": \"peer.peer,peer.headsup,updater,f10,f12,unreviewed\", \"confidence\": \"high\", \"time\": 1793485870442},\n{\"claim\": \"app.ui's .chip is a nowrap inline-flex row, so multiline chip content needs a block child with flex-basis:100% plus flex-wrap on the chip\", \"detail\": \"A <br> cannot break a flex container, and flex trims a text item's edge whitespace - which is why an error message and its Retry action ran together inside an update chip. The Phase 3b fix (commit b70a4fe9): put the error text in a block .chiperrline (flex-basis:100%), give the chip flex-wrap and auto height, and use margins (not whitespace) for gaps between inline items. Applies to any multiline content inside the shared chip style.\", \"tags\": \"app.ui,peer.peer,css,chip,flex,frontend,unreviewed\", \"confidence\": \"high\", \"time\": 1793516462188},\n{\"claim\": \"data/peer carries stale non-live copies of the peers command source that still contain already-fixed bugs\", \"detail\": \"Records like irxu…cp4.rs, '…cp4 copy.rs', and x.rs sit beside the live impl (ywokvt…2l8) and still hold the publickkey typo after the F18b fix - a grep of data/peer for an old bug string hits this debris and can look like the fix never landed. They were deliberately left untouched during Phase 4.\", \"tags\": \"peer.peer,store,grep,gotcha,unreviewed\", \"confidence\": \"high\", \"time\": 1793518287722},\n{\"end\": true}]\n","old":"[\n{\"claim\": \"COMMAND IDS ARE THE PEER-TO-PEER WIRE CONTRACT. The jsapi send_* wrappers resolve a command name to the CALLING instance's command id and ship the id to the remote (app.app.exec takes lib + id; the remote does Command::new(db, id) and panics 'Missing file data/...' when the id is absent). Signature compatibility is irrelevant if ids differ. Consequences: (1) NEVER delete_command + re-upsert a command that remote peers call - upsert_command alone already preserves BOTH the command record id and the rust source id for an existing name, so plain upsert is always the id-safe edit; delete-first is only for genuinely retiring a command; (2) dev.code.patch_command_body with an empty old_snippet is BROKEN - it ballooned a 1.8KB source record to 3.7MB of nested content (fold2, 2026-08-11) - use upsert_command for full-body rewrites; (3) save_command requires a live HTTP session (its app_read fails with Key 'data' not found over MCP). This id contract is what broke the owner's first v52 rollout against v51 peers, and retroactively explains the original v44-lineage 'incompatibility' too.\", \"tags\": \"platform-api,p2p,exec,ids,wire,upsert,patch_command_body,bug\", \"source\": {\"doc\": \"live v51 peer panic log from the owner + app.app.exec source + fold2/fold3 verification, 2026-08-11\"}, \"confidence\": \"high\", \"time\": 1786447774149},\n{\"claim\": \"The peer proxy cannot stream InputStream command results: peer.local (newbound_core) creates a peer stream (begin_stream/write_stream pump) ONLY for `file` responses - a bytes `body` (an InputStream return like camera live) is a process-local DataBytes ref that cannot cross the wire, so the viewer-side peer.remote finds neither stream_id nor usable body and returns its 404 sentinel. Symptom: remote live view falls back to JPEG polling instantly (File-returning commands - snapshot, last_keyframe, play - stream fine over peers, which is why everything else works in the HUD). Fix sketch (platform, owner blessing required per the boundary doctrine): a third branch in peer.local mirroring the file branch - when body is bytes, begin_stream and pump DataBytes.read into write_stream until close, carrying the mime type; peer.remote already join_streams. Found 2026-08-12 diagnosing the owner HUD report.\", \"tags\": \"peer,streaming,inputstream,proxy,live,platform-gap\", \"source\": {\"doc\": \"newbound_core/src/peer/peer/local.rs + remote.rs read, owner HUD report, 2026-08-12\"}, \"confidence\": \"high\", \"time\": 1786542476727},\n{\"claim\": \"InputStream-over-peers landed on newbound branch claude/peer-stream-bytes-bodies (2026-08-12, standalone off master, awaiting owner review): peer.peer.local gained a bytes-body branch (begin_stream + DataBytes pump, 16KB chunks, mime carried, 30s starvation cap) and peer.service.listen gained the s_4 close-back - s_2 detects a dead local reader (write false / entry gone) and answers s_4, whose handler retires the matching STREAMWRITERS entry so the senders write_stream fails and its pump stops ~1s after viewer disconnect. Wire-compatible with old peers in both directions. Two-instance lab verification: same-host peering works via discovery master/slave + setuser with keepalive (maintenance auto-connects; peer users must be in a group check_security accepts - production uses admin; a non-admin group 404s every proxied command instantly, which is also the diagnostic signature of an unauthorized peer). Remote status/file/live all green; live delivers ffprobe-clean fMP4 into an in-page Chromium fetch with correct avc1 codec parse. CRITICAL build gotcha: dev.code patches on a STATIC library regenerate src and build the rlib but do NOT relink the host binary - test runs silently exercise the old code until a cargo build relinks (~2s); check strings <binary> for a new literal before trusting a static-lib test.\", \"tags\": \"peer,streaming,s4,close-back,inputstream,lab,static-lib-relink\", \"source\": {\"doc\": \"two-disposable peer lab, newbound claude/peer-stream-bytes-bodies, 2026-08-12\"}, \"confidence\": \"medium\", \"time\": 1786546269385, \"adjudicated\": 1793394746425},\n{\"claim\": \"The popup machinery centers a dialog card at its open-time height and never re-centers, so content that fills in after open (e.g. the LAN discovery list) grows the card past the bottom of the viewport.\", \"detail\": \"Found fixing F2 (Add Connection clipping): dropping the fixed card height alone is not enough - the tab body needs its own scroll cap (calc(50vh + 40px) used) so late-arriving rows scroll instead of growing the card, and an empty tab needs a min-height close to the populated tab so the open-time measurement that drives centering is honest.\", \"tags\": \"peer.peer,frontend,popup,css,dialogs,unreviewed\", \"confidence\": \"high\", \"time\": 1793392959847},\n{\"claim\": \"syncPeers guards app.scenehost's async addControl with me.adding, so each peer gets exactly one orb\", \"detail\": \"scenehost.addControl registers the key in byId/children only after its awaits, and syncPeers fires from both the waitReady and send_info callbacks, so unguarded overlap added every peer twice - and the duplicate stayed a frozen ghost because syncPeerData updates only the byId instance. Fix (F4, commit ad6575f9) lives entirely in peer.peer js: me.adding[id] marks the in-flight add; syncPeers skips a peer when byId(id) or me.adding[id] is set; the remove loop never removes a key still in me.adding; addPeerOrb's settle handler (resolve or reject) clears the flag and immediately removes the orb if its peer left while the add was in flight. app.scenehost is shared - fix callers, never the host.\", \"tags\": \"peer.peer,scenehost,orbs,race,F4\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417921382},\n{\"claim\": \"peerErrorText(result) is the single wording for a failed peer call: 'Unauthorized' for an UNAUTHORIZED msg (prefix match), else 'Error: <msg>'\", \"detail\": \"F5 (commit 2f7e40a2). Every Update Peers row must end in one of three states - chips, removed (nothing to update), or an error - never 'pending...'. rowError paints the status cell with .rowerror (dim red) and disables the row's checkbox. The peer proxy suffixes the refused command ('UNAUTHORIZED: libs'), hence the prefix match. checkForUpdates fetches ../app/libs first when document.body.locallibraries hasn't landed; a refused dev/crate_versions just leaves the crates chip out. 'Unauthorized' is Alex's exact chosen word; the F10 update-flow rewrite (session 2) must keep calling peerErrorText.\", \"tags\": \"peer.peer,update-peers,errors,F5\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417925088},\n{\"claim\": \"Untrusted strings on the Peers page go into the DOM with textContent and dataset, never innerHTML\", \"detail\": \"F3 (commit a3aa0206). Discovery names ride unauthenticated LAN UDP packets (port 5770), and peer display names, library ids/versions and error msgs come from remote peers. The LAN table rows, buildUpdateDialog's rows, the update/crates chips, and the #updateallpeersnow error lines are built with DOM calls + textContent; data-* carriers use dataset, never concatenated HTML. Static shells may stay literal innerHTML. Server side is still open: discovery.rs stores packet bytes 40+ as the name with no authentication - follow-up for Marc.\", \"tags\": \"peer.peer,xss,security,F3\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417928260},\n{\"claim\": \"The Add Connection card (.addusercard) sizes to content and the TAB BODY scrolls - the card itself must not, because the popup machinery centers the card at its open-time height\", \"detail\": \"F2 (commit 2ec3bf86). The fixed 367px height is gone: .addusercard caps at calc(100vh - 80px), width 600px (calc(100vw - 32px) under 640px). .addusercard .tab-content gets overflow:auto with max-height calc(50vh + 40px): the cap stays near half the viewport so a LAN list that grows AFTER the open can never push the card's bottom off screen. .discovered keeps min-height:280px so the empty LAN tab measures near the Connect tab's height at open-time centering. .card is overflow:hidden by the shared kit - don't fight it, scroll the tab body.\", \"tags\": \"peer.peer,css,layout,add-connection,F2\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"css\", \"hash\": \"d45055d480860ed7\"}, \"confidence\": \"high\", \"time\": 1793417934613},\n{\"claim\": \"buildUpdateDialog reads peer names from me.peers (the same objects as #peer_<id>.DATA), not from a json reply - stub a name in tests by mutating that live record\", \"detail\": \"Session-1 QA (H05): wrapping the page's json() helper cannot stub display names in the Update Peers dialog because no json call carries them; mutate document.getElementById('peer_'+id).DATA.name (shared with me.peers) instead. Also relevant for QA: agent.browser.act refuses to click <tr> rows (reports them disabled) - use the plain click tool for table rows.\", \"tags\": \"peer.peer,testing,qa,stubs\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"medium\", \"time\": 1793417937428},\n{\"end\": true}]\n","patch_id":"p100","time":1793522153522},{"author":"alex89romanov","facet":"js","label":"F17: LAN list — no self, 'this machine' chips sorted last, ellipsis + title","new":"    // F17: our own UUID is never a connection you can add, so it never\n    // lists. Loopback entries are other Newbound instances on THIS\n    // machine, not LAN devices — keep them, chip them 'this machine',\n    // and sort them after the real LAN devices.\n    function isLocalAddr(a){\n      a = String(a || '');\n      return a == '::1' || a == 'localhost' || a.indexOf('127.') == 0 || a.indexOf('::1:') == 0;\n    }\n    var tbl = document.createElement('table');\n    tbl.className = 'lantable';\n    var now = new Date().getTime();\n    var found = [];\n    for (var sip in result.data) {\n      var rds = result.data[sip];\n      if (now - rds.time < 30000 && !getByProperty(me.peers, \"id\", rds.uuid)\n          && !(me.info && rds.uuid == me.info.uuid)) {\n        found.push({ sip: sip, rds: rds, local: isLocalAddr(rds.address) || isLocalAddr(sip) });\n      }\n    }\n    found.sort(function(a, b){ return (a.local ? 1 : 0) - (b.local ? 1 : 0); });\n    for (var fi = 0; fi < found.length; fi++) {\n      var fsip = found[fi].sip;\n      var frds = found[fi].rds;\n      var tr = document.createElement('tr');\n      tr.className = 'clickme';\n      tr.dataset.sip = fsip;\n      // F17: long values ellipsize (.lantable is fixed-layout now); each\n      // cell's title carries the full text. F3 holds: textContent only.\n      var td = document.createElement('td');\n      td.textContent = fsip;\n      td.title = fsip;\n      tr.appendChild(td);\n      td = document.createElement('td');\n      td.textContent = frds.name;\n      td.title = frds.name;\n      if (found[fi].local) {\n        var mch = document.createElement('span');\n        mch.className = 'lanlocalchip';\n        mch.textContent = 'this machine';\n        td.appendChild(mch);\n      }\n      tr.appendChild(td);\n      td = document.createElement('td');\n      var sm = document.createElement('span');\n      sm.className = 'smalltext';\n      sm.textContent = frds.uuid;\n      td.appendChild(sm);\n      td.title = frds.uuid;\n      tr.appendChild(td);\n      tbl.appendChild(tr);\n    }","old":"    var tbl = document.createElement('table');\n    tbl.className = 'lantable';\n    var now = new Date().getTime();\n    for (sip in result.data) {\n      var rds = result.data[sip];\n      if (now - rds.time < 30000 && !getByProperty(me.peers, \"id\", rds.uuid)) {\n        var tr = document.createElement('tr');\n        tr.className = 'clickme';\n        tr.dataset.sip = sip;\n        var td = document.createElement('td');\n        td.textContent = sip;\n        tr.appendChild(td);\n        td = document.createElement('td');\n        td.textContent = rds.name;\n        tr.appendChild(td);\n        td = document.createElement('td');\n        var sm = document.createElement('span');\n        sm.className = 'smalltext';\n        sm.textContent = rds.uuid;\n        td.appendChild(sm);\n        tr.appendChild(td);\n        tbl.appendChild(tr);\n      }\n    }","patch_id":"p101","time":1793524311923},{"author":"alex89romanov","facet":"css","label":"F17: dialog header anchoring, LAN table ellipsis, this-machine chip","new":".chiperrline .chipretry {\n  margin-left: 8px;\n}\n\n/* F17: both dialogs' ✕ hung mid-right over the body — .upper-right\n   (app.ui) is absolute at top:50%, and with nothing positioned between\n   it and the card it centered on the whole card. Anchor it to the\n   header's title row instead. And .dialog-header (app.ui) is a flex\n   ROW, which sat the Add Connection title BESIDE the tabs and wrapped\n   it — stack the header's rows instead. */\n.addusercard .dialog-header,\n.updateallpeerscard .dialog-header {\n  display: block;\n}\n.addusercard .dialog-header > .padme,\n.updateallpeerscard .dialog-header > .padme {\n  position: relative;\n  white-space: nowrap;\n}\n\n/* F17: long names and UUIDs stay inside the card — fixed table layout,\n   each cell ellipsizes and carries the full value in its title. */\n.lantable {\n  table-layout: fixed;\n}\n.lantable td {\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n/* F17: 'this machine' — another Newbound instance on this host, not a\n   LAN device */\n.lanlocalchip {\n  display: inline-block;\n  margin-left: 8px;\n  padding: 0 8px;\n  border-radius: 9px;\n  background: var(--panel-3);\n  color: var(--text-dim);\n  font-size: x-small;\n  line-height: 18px;\n  vertical-align: middle;\n  white-space: nowrap;\n}","old":".chiperrline .chipretry {\n  margin-left: 8px;\n}","patch_id":"p102","time":1793524324206},{"author":"agent-3-low","facet":"js","label":"1b: LAN name ellipsizes in its own slot so the chip stays visible","new":"      td = document.createElement('td');\n      // 1b: the chip used to ride in the same ellipsized cell as the name,\n      // so a long name shoved it under overflow:hidden. The name ellipsizes\n      // in its own flex slot now and the chip never shrinks; the wrapper div\n      // keeps the td a real table-cell. F3 holds: textContent only.\n      td.title = frds.name;\n      var nwrap = document.createElement('div');\n      nwrap.className = 'lannamewrap';\n      var nspan = document.createElement('span');\n      nspan.className = 'lanname';\n      nspan.textContent = frds.name;\n      nwrap.appendChild(nspan);\n      if (found[fi].local) {\n        var mch = document.createElement('span');\n        mch.className = 'lanlocalchip';\n        mch.textContent = 'this machine';\n        nwrap.appendChild(mch);\n      }\n      td.appendChild(nwrap);\n      tr.appendChild(td);","old":"      td = document.createElement('td');\n      td.textContent = frds.name;\n      td.title = frds.name;\n      if (found[fi].local) {\n        var mch = document.createElement('span');\n        mch.className = 'lanlocalchip';\n        mch.textContent = 'this machine';\n        td.appendChild(mch);\n      }\n      tr.appendChild(td);","patch_id":"p103","time":1793527167862},{"author":"agent-3-low","facet":"css","label":"1b: flex name cell keeps the this-machine chip visible","new":".lanlocalchip {\n  display: inline-block;\n  margin-left: 8px;\n  padding: 0 8px;\n  border-radius: 9px;\n  background: var(--panel-3);\n  color: var(--text-dim);\n  font-size: x-small;\n  line-height: 18px;\n  vertical-align: middle;\n  white-space: nowrap;\n}\n\n/* 1b: the name cell is a flex row — the name shrinks and ellipsizes in\n   its own slot, the chip keeps its full size whatever the name's length. */\n.lannamewrap {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n}\n.lannamewrap .lanname {\n  flex: 0 1 auto;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.lannamewrap .lanlocalchip {\n  flex: none;\n}","old":".lanlocalchip {\n  display: inline-block;\n  margin-left: 8px;\n  padding: 0 8px;\n  border-radius: 9px;\n  background: var(--panel-3);\n  color: var(--text-dim);\n  font-size: x-small;\n  line-height: 18px;\n  vertical-align: middle;\n  white-space: nowrap;\n}","patch_id":"p104","time":1793527172912},{"author":"alex89romanov","facet":"html","label":"F18a: peer-list fallback markup","new":"<div class='viewer'></div>\n<!-- F18a: the plain peer list shown in place of the 3D view when WebGL is\n     unavailable (or forced with ?view=list) -->\n<div class='peerlistwrap' style='display:none;'>\n  <div class='peerlistnote'></div>\n  <div class='peerlist'></div>\n</div>","old":"<div class='viewer'></div>","patch_id":"p105","time":1793529299602},{"author":"alex89romanov","facet":"css","label":"F18a: peer-list fallback styles","new":".lannamewrap .lanlocalchip {\n  flex: none;\n}\n\n/* F18a: the plain peer list — shown in place of the 3D view when WebGL is\n   unavailable (or forced with ?view=list). The .viewer stays visible as the\n   black backdrop the corner overlays rely on; the list floats over it like\n   they do. The dots keep the panel's .connectionindicator metrics and share\n   peerstatus's colours, so list, orbs and panel all read as one verdict. */\n.peerlistwrap {\n  position: fixed;\n  top: 70px;\n  left: 20px;\n  right: 20px;\n  bottom: 220px;\n  max-width: 860px;\n  overflow-y: auto;\n  color: white;\n}\n\n.peerlistnote {\n  color: #ffffff73;\n  font-size: 13px;\n  margin-bottom: 10px;\n}\n\n.peerlistrow {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 10px 14px;\n  margin-bottom: 8px;\n  border: thin solid #ffffff22;\n  border-radius: 6px;\n  background: #ffffff0a;\n  cursor: pointer;\n}\n\n.peerlistrow:hover {\n  background: #ffffff1d;\n}\n\n.pl-dots {\n  flex: none;\n  line-height: 0;\n}\n\n.pl-dot {\n  display: inline-block;\n  width: 10px;\n  height: 10px;\n  border-radius: 10px;\n  margin-right: 3px;\n}\n\n.pl-name {\n  flex: 0 1 auto;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 15px;\n}\n\n.pl-kind {\n  flex: none;\n  font-size: 13px;\n  color: #ffffffb3;\n}\n\n.pl-last {\n  flex: none;\n  margin-left: auto;\n  font-size: 13px;\n  color: #ffffff73;\n}\n\n.peerlistempty {\n  color: #ffffff73;\n  font-style: italic;\n}","old":".lannamewrap .lanlocalchip {\n  flex: none;\n}","patch_id":"p106","time":1793529310813},{"author":"alex89romanov","facet":"js","label":"F18a: list-mode helpers (probe, switch, render, row click)","new":"// F18a: without WebGL the page was black apart from the local device box —\n// no way to reach a peer. Detect it (own context probe, scenehost's own\n// headless verdict, or a host that never becomes ready within 5 s) and show\n// a plain peer list in place of the canvas. ?view=list forces the list even\n// with WebGL — the test switch, also handy on slow machines.\nme.listMode = false;\n\nfunction probeWebGL(){\n  try {\n    var c = document.createElement('canvas');\n    return !!(c.getContext('webgl2') || c.getContext('webgl'));\n  } catch (x) { return false; }\n}\n\nfunction showPeerList(reason){\n  if (me.listMode) return;\n  me.listMode = true;\n  var wrap = ME.querySelector('.peerlistwrap');\n  wrap.style.display = 'block';\n  ME.querySelector('.peerlistnote').textContent = reason == 'forced'\n    ? 'List view (?view=list).'\n    : '3D view needs WebGL; showing the list instead.';\n  renderPeerList();\n  startPoll();   // the same 10 s re-read the 3D view uses\n}\n\n// One row per peer: the orbs' colour verdict (document.body.peerstatus —\n// the same dots the panel shows), the transport kind, and the last check.\n// Clicking a row opens the same headsup panel an orb's tap does; clicking\n// the open peer's row again closes it, like tapping its orb again.\nfunction renderPeerList(){\n  if (!me.listMode) return;\n  var list = ME.querySelector('.peerlist');\n  list.innerHTML = '';\n  var now = Date.now();\n  var labels = { tcp: 'TCP', udp: 'UDP', relay: 'Relay', down: 'Disconnected' };\n  var peers = peerList();\n  var shown = 0;\n  for (var i = 0; i < peers.length; i++) {\n    var p = peers[i];\n    if (me.info && p.id == me.info.uuid) continue;\n    var st = document.body.peerstatus(p, now);\n    var row = document.createElement('div');\n    row.className = 'peerlistrow';\n    row.dataset.peer = p.id;\n    var dots = document.createElement('span');\n    dots.className = 'pl-dots';\n    for (var d = 0; d < 3; d++) {\n      var dot = document.createElement('span');\n      dot.className = 'pl-dot';\n      var lit = st.kind == 'down' || d < st.dots;\n      dot.style.backgroundColor = lit ? st.color : 'transparent';\n      dot.style.border = '1px solid ' + (lit ? st.color : st.color + '66');\n      dots.appendChild(dot);\n    }\n    row.appendChild(dots);\n    var name = document.createElement('span');\n    name.className = 'pl-name';\n    name.textContent = p.name;   // F3: peer names are untrusted — never HTML\n    name.title = p.name;\n    row.appendChild(name);\n    var kind = document.createElement('span');\n    kind.className = 'pl-kind';\n    kind.textContent = labels[st.kind];\n    if (st.kind == 'down') kind.style.color = st.color;\n    row.appendChild(kind);\n    var last = document.createElement('span');\n    last.className = 'pl-last';\n    var ago = p.last_contact ? Math.max(0, now - p.last_contact) : -1;\n    last.textContent = 'last check ' + (ago < 0 ? 'unknown'\n      : ago < 60000 ? Math.round(ago / 1000) + ' s ago'\n      : ago < 3600000 ? Math.round(ago / 60000) + ' min ago'\n      : Math.round(ago / 3600000) + ' h ago');\n    row.appendChild(last);\n    row.addEventListener('click', listRowClick);\n    list.appendChild(row);\n    shown++;\n  }\n  if (shown == 0) list.innerHTML = '<div class=\"peerlistempty\"><i>No peers connected yet — add one with the + button below.</i></div>';\n}\n\nfunction listRowClick(){\n  var id = this.dataset.peer;\n  var el = document.getElementById('headsupdisplay');\n  var open = el && getComputedStyle(el).display != 'none' && el.offsetWidth >= 40;\n  if (open && me.listFocus == id) { me.listFocus = null; onSceneFocus(null); }\n  else { me.listFocus = id; onSceneFocus(id); }\n}\n\nme.ready = function(){\n  // The 3D constellation is hosted by app:scenehost.","old":"me.ready = function(){\n  // The 3D constellation is hosted by app:scenehost.","patch_id":"p107","time":1793529330047},{"author":"alex89romanov","facet":"js","label":"F18a: WebGL detection gates the scenehost mount","new":"  // F18a: WebGL before the host — a forced ?view=list or a failed context\n  // probe goes straight to the list and never mounts the scene. Otherwise\n  // the host gets 5 s to become ready, and its own GL-less verdict\n  // (api.headless — how scenehost reports booting without WebGL) also\n  // means the orbs can't draw.\n  var forced = new URLSearchParams(location.search).get('view') == 'list';\n  if (forced || !probeWebGL()) {\n    showPeerList(forced ? 'forced' : 'nowebgl');\n  }\n  else {\n    var hostTimer = setTimeout(function(){ showPeerList('nowebgl'); }, 5000);\n    installControl(ME.querySelector('.viewer'), 'app', 'scenehost', function(api){\n      me.host = api;\n      api.waitReady(function(){\n        clearTimeout(hostTimer);\n        if (api.headless) { showPeerList('nowebgl'); return; }\n        if (me.listMode) return;   // the 5 s timeout already swapped views\n        api.hostData = { onFocus: onSceneFocus };\n        syncPeers();\n        startFeed();\n      });\n    }, {});\n  }","old":"  installControl(ME.querySelector('.viewer'), 'app', 'scenehost', function(api){\n    me.host = api;\n    api.waitReady(function(){\n      api.hostData = { onFocus: onSceneFocus };\n      syncPeers();\n      startFeed();\n    });\n  }, {});","patch_id":"p108","time":1793529338984},{"author":"alex89romanov","facet":"js","label":"F18a: UPDATE events refresh the list rows","new":"    upsertPeerDiv(data);\n    syncPeers();\n    wakeFeed();\n    if (me.listMode) renderPeerList();","old":"    upsertPeerDiv(data);\n    syncPeers();\n    wakeFeed();","patch_id":"p109","time":1793529345669},{"author":"alex89romanov","facet":"js","label":"F18a: first peer load renders the list rows","new":"      syncPeers();\n      startFeed();\n      if (me.listMode) renderPeerList();\n    });\n  });\n};","old":"      syncPeers();\n      startFeed();\n    });\n  });\n};","patch_id":"p110","time":1793529350668},{"author":"alex89romanov","facet":"js","label":"F18a: the 10 s poll refreshes the list rows","new":"      me.peers = [];\n      for (var i in result.data) {\n        me.peers.push(result.data[i]);\n        upsertPeerDiv(result.data[i]);\n      }\n      if (me.listMode) renderPeerList();\n    });","old":"      me.peers = [];\n      for (var i in result.data) {\n        me.peers.push(result.data[i]);\n        upsertPeerDiv(result.data[i]);\n      }\n    });","patch_id":"p111","time":1793529356199},{"author":"alex89romanov","facet":"js","label":"F18a: list mode never starts the scene feed","new":"function startFeed(){\n  // F18a: in list mode there is no scene to feed — the list renders off the\n  // 10 s poll instead, so headless orb instances are never added.\n  if (me.feed || !me.host || !me.info || me.listMode) return;","old":"function startFeed(){\n  if (me.feed || !me.host || !me.info) return;","patch_id":"p112","time":1793529362059},{"author":"agent-session3","facet":"css","label":"F18a step 0: the plain list uses the app font","new":".peerlistwrap {\n  position: fixed;\n  top: 70px;\n  left: 20px;\n  right: 20px;\n  bottom: 220px;\n  max-width: 860px;\n  overflow-y: auto;\n  color: white;\n  /* the list floats on the raw page, outside any .wrap — give it the\n     app font or it falls back to the browser serif */\n  font-family: var(--font-family);\n}","old":".peerlistwrap {\n  position: fixed;\n  top: 70px;\n  left: 20px;\n  right: 20px;\n  bottom: 220px;\n  max-width: 860px;\n  overflow-y: auto;\n  color: white;\n}","patch_id":"p113","time":1793529868368},{"author":"promote","cmd":"","facet":"memory","label":"promote: fold -> peer.peer","new":"[\n{\"claim\": \"COMMAND IDS ARE THE PEER-TO-PEER WIRE CONTRACT. The jsapi send_* wrappers resolve a command name to the CALLING instance's command id and ship the id to the remote (app.app.exec takes lib + id; the remote does Command::new(db, id) and panics 'Missing file data/...' when the id is absent). Signature compatibility is irrelevant if ids differ. Consequences: (1) NEVER delete_command + re-upsert a command that remote peers call - upsert_command alone already preserves BOTH the command record id and the rust source id for an existing name, so plain upsert is always the id-safe edit; delete-first is only for genuinely retiring a command; (2) dev.code.patch_command_body with an empty old_snippet is BROKEN - it ballooned a 1.8KB source record to 3.7MB of nested content (fold2, 2026-08-11) - use upsert_command for full-body rewrites; (3) save_command requires a live HTTP session (its app_read fails with Key 'data' not found over MCP). This id contract is what broke the owner's first v52 rollout against v51 peers, and retroactively explains the original v44-lineage 'incompatibility' too.\", \"tags\": \"platform-api,p2p,exec,ids,wire,upsert,patch_command_body,bug\", \"source\": {\"doc\": \"live v51 peer panic log from the owner + app.app.exec source + fold2/fold3 verification, 2026-08-11\"}, \"confidence\": \"high\", \"time\": 1786447774149},\n{\"claim\": \"The peer proxy cannot stream InputStream command results: peer.local (newbound_core) creates a peer stream (begin_stream/write_stream pump) ONLY for `file` responses - a bytes `body` (an InputStream return like camera live) is a process-local DataBytes ref that cannot cross the wire, so the viewer-side peer.remote finds neither stream_id nor usable body and returns its 404 sentinel. Symptom: remote live view falls back to JPEG polling instantly (File-returning commands - snapshot, last_keyframe, play - stream fine over peers, which is why everything else works in the HUD). Fix sketch (platform, owner blessing required per the boundary doctrine): a third branch in peer.local mirroring the file branch - when body is bytes, begin_stream and pump DataBytes.read into write_stream until close, carrying the mime type; peer.remote already join_streams. Found 2026-08-12 diagnosing the owner HUD report.\", \"tags\": \"peer,streaming,inputstream,proxy,live,platform-gap\", \"source\": {\"doc\": \"newbound_core/src/peer/peer/local.rs + remote.rs read, owner HUD report, 2026-08-12\"}, \"confidence\": \"high\", \"time\": 1786542476727},\n{\"claim\": \"InputStream-over-peers landed on newbound branch claude/peer-stream-bytes-bodies (2026-08-12, standalone off master, awaiting owner review): peer.peer.local gained a bytes-body branch (begin_stream + DataBytes pump, 16KB chunks, mime carried, 30s starvation cap) and peer.service.listen gained the s_4 close-back - s_2 detects a dead local reader (write false / entry gone) and answers s_4, whose handler retires the matching STREAMWRITERS entry so the senders write_stream fails and its pump stops ~1s after viewer disconnect. Wire-compatible with old peers in both directions. Two-instance lab verification: same-host peering works via discovery master/slave + setuser with keepalive (maintenance auto-connects; peer users must be in a group check_security accepts - production uses admin; a non-admin group 404s every proxied command instantly, which is also the diagnostic signature of an unauthorized peer). Remote status/file/live all green; live delivers ffprobe-clean fMP4 into an in-page Chromium fetch with correct avc1 codec parse. CRITICAL build gotcha: dev.code patches on a STATIC library regenerate src and build the rlib but do NOT relink the host binary - test runs silently exercise the old code until a cargo build relinks (~2s); check strings <binary> for a new literal before trusting a static-lib test.\", \"tags\": \"peer,streaming,s4,close-back,inputstream,lab,static-lib-relink\", \"source\": {\"doc\": \"two-disposable peer lab, newbound claude/peer-stream-bytes-bodies, 2026-08-12\"}, \"confidence\": \"medium\", \"time\": 1786546269385, \"adjudicated\": 1793394746425},\n{\"claim\": \"The popup machinery centers a dialog card at its open-time height and never re-centers, so content that fills in after open (e.g. the LAN discovery list) grows the card past the bottom of the viewport.\", \"detail\": \"Found fixing F2 (Add Connection clipping): dropping the fixed card height alone is not enough - the tab body needs its own scroll cap (calc(50vh + 40px) used) so late-arriving rows scroll instead of growing the card, and an empty tab needs a min-height close to the populated tab so the open-time measurement that drives centering is honest.\", \"tags\": \"peer.peer,frontend,popup,css,dialogs,unreviewed\", \"confidence\": \"high\", \"time\": 1793392959847},\n{\"claim\": \"syncPeers guards app.scenehost's async addControl with me.adding, so each peer gets exactly one orb\", \"detail\": \"scenehost.addControl registers the key in byId/children only after its awaits, and syncPeers fires from both the waitReady and send_info callbacks, so unguarded overlap added every peer twice - and the duplicate stayed a frozen ghost because syncPeerData updates only the byId instance. Fix (F4, commit ad6575f9) lives entirely in peer.peer js: me.adding[id] marks the in-flight add; syncPeers skips a peer when byId(id) or me.adding[id] is set; the remove loop never removes a key still in me.adding; addPeerOrb's settle handler (resolve or reject) clears the flag and immediately removes the orb if its peer left while the add was in flight. app.scenehost is shared - fix callers, never the host.\", \"tags\": \"peer.peer,scenehost,orbs,race,F4\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417921382},\n{\"claim\": \"peerErrorText(result) is the single wording for a failed peer call: 'Unauthorized' for an UNAUTHORIZED msg (prefix match), else 'Error: <msg>'\", \"detail\": \"F5 (commit 2f7e40a2). Every Update Peers row must end in one of three states - chips, removed (nothing to update), or an error - never 'pending...'. rowError paints the status cell with .rowerror (dim red) and disables the row's checkbox. The peer proxy suffixes the refused command ('UNAUTHORIZED: libs'), hence the prefix match. checkForUpdates fetches ../app/libs first when document.body.locallibraries hasn't landed; a refused dev/crate_versions just leaves the crates chip out. 'Unauthorized' is Alex's exact chosen word; the F10 update-flow rewrite (session 2) must keep calling peerErrorText.\", \"tags\": \"peer.peer,update-peers,errors,F5\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417925088},\n{\"claim\": \"Untrusted strings on the Peers page go into the DOM with textContent and dataset, never innerHTML\", \"detail\": \"F3 (commit a3aa0206). Discovery names ride unauthenticated LAN UDP packets (port 5770), and peer display names, library ids/versions and error msgs come from remote peers. The LAN table rows, buildUpdateDialog's rows, the update/crates chips, and the #updateallpeersnow error lines are built with DOM calls + textContent; data-* carriers use dataset, never concatenated HTML. Static shells may stay literal innerHTML. Server side is still open: discovery.rs stores packet bytes 40+ as the name with no authentication - follow-up for Marc.\", \"tags\": \"peer.peer,xss,security,F3\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417928260},\n{\"claim\": \"The Add Connection card (.addusercard) sizes to content and the TAB BODY scrolls - the card itself must not, because the popup machinery centers the card at its open-time height\", \"detail\": \"F2 (commit 2ec3bf86). The fixed 367px height is gone: .addusercard caps at calc(100vh - 80px), width 600px (calc(100vw - 32px) under 640px). .addusercard .tab-content gets overflow:auto with max-height calc(50vh + 40px): the cap stays near half the viewport so a LAN list that grows AFTER the open can never push the card's bottom off screen. .discovered keeps min-height:280px so the empty LAN tab measures near the Connect tab's height at open-time centering. .card is overflow:hidden by the shared kit - don't fight it, scroll the tab body.\", \"tags\": \"peer.peer,css,layout,add-connection,F2\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"css\", \"hash\": \"d45055d480860ed7\"}, \"confidence\": \"high\", \"time\": 1793417934613},\n{\"claim\": \"buildUpdateDialog reads peer names from me.peers (the same objects as #peer_<id>.DATA), not from a json reply - stub a name in tests by mutating that live record\", \"detail\": \"Session-1 QA (H05): wrapping the page's json() helper cannot stub display names in the Update Peers dialog because no json call carries them; mutate document.getElementById('peer_'+id).DATA.name (shared with me.peers) instead. Also relevant for QA: agent.browser.act refuses to click <tr> rows (reports them disabled) - use the plain click tool for table rows.\", \"tags\": \"peer.peer,testing,qa,stubs\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"medium\", \"time\": 1793417937428},\n{\"claim\": \"Peer discovery still stores unauthenticated UDP-5770 packet bytes as device names server-side (discovery.rs); only the client rendering was hardened.\", \"detail\": \"The F3 fix (peers-app-fixes, 2026-10) made the Peers UI render LAN-discovered names with textContent so injected strings are inert, but the server's discovery path accepts and records whatever bytes arrive on the UDP broadcast port with no validation or authentication. Any host on the LAN can plant arbitrary device-name strings in the discovery cache. Validating/authenticating discovery payloads is open, deferred to Marc at the session-1 hand-back.\", \"tags\": \"peer.peer,peer.service,discovery,security,udp,unreviewed\", \"confidence\": \"high\", \"time\": 1793418142452},\n{\"claim\": \"Automation opens a peer's HUD by calling the scene host's hostData.onFocus(<peer-uuid>) directly - the exact handler an orb tap fires - instead of attempting a WebGL canvas click.\", \"detail\": \"Used in peers-app-fixes Phase 0: orb hit-testing inside the WebGL canvas is impractical to drive from scripts, but app.scenehost exposes the focus handler on hostData, and invoking it with the target UUID exercises the same code path as a real tap, opening peer.headsup with the correct record.\", \"tags\": \"peer.peer,peer.headsup,app.scenehost,qa,webgl,unreviewed\", \"confidence\": \"high\", \"time\": 1793479277272},\n{\"claim\": \"A peer's last_contact cannot show real TCP recency: the server stamps last_contact = now for any live TCP link, and drops the field entirely for a disconnected peer.\", \"detail\": \"Confirmed during F6/F15 (peers-app-fixes MEDIUM phase 1): a connected TCP peer always renders full brightness and 3 freshness dots because every read sees last_contact = now, and a down peer shows 'last check unknown' because the field is absent - both are honest renderings of what the server records, not UI bugs. Making the dots reflect actual TCP check recency requires a backend change (flagged as a follow-up for Marc in the phase 5 report).\", \"tags\": \"peer.peer,peer.headsup,last_contact,recency,f6,f15,unreviewed\", \"confidence\": \"high\", \"time\": 1793482251381},\n{\"claim\": \"initPopups reads a trigger's data-popup attribute at click time, so stripping or restoring the attribute enables/disables a popup menu item live, with no re-init.\", \"detail\": \"Used for F11 (peers-app-fixes): when the first controls_shared read fails with a non-NOT-FOUND error, the Add Control menu item's data-popup attribute is removed (plus a title explaining why), and the popup can never open - clicks do nothing because the attribute lookup happens per click, not at wiring time. Restoring the attribute re-arms it.\", \"tags\": \"peer.peer,peer.headsup,popup,frontend,unreviewed\", \"confidence\": \"high\", \"time\": 1793484080057},\n{\"claim\": \"document.body.peerupdater is the ONE shared library-update engine: peer.peer's js installs it, and both the Update Peers dialog and the headsup panel's Update All drive their installs through run(peerId, items, hooks) instead of their own chains (F10); document.body.peerAuthorWarn is the shared author-mismatch marker (F12).\", \"detail\": \"Contract (commit 88629f82, peers-app-fixes): items are {lib, version, chipEl} plus an optional {crates, chipEl}; hooks onStart/onDone/onError/onFinish. Installs run in chip order with the chip actually being installed marked; a failure reds ITS OWN chip with the error as textContent plus a Retry link and the chain continues; one run per peer (second start ignored), done-chips skipped on re-run; after the libraries a crates item replaces the recompile, else one compile_rust runs when any install answered data:true and its failure lands in the row summary. peerAuthorWarn: when both sides carry author+authorkey and they differ, the chip gets '⚠ different author', a title naming both, and starts dimmed/deselected until clicked in. Future edits to either update flow go through these helpers, never a re-grown per-control install chain.\", \"tags\": \"peer.peer,peer.headsup,updater,f10,f12,unreviewed\", \"confidence\": \"high\", \"time\": 1793485870442},\n{\"claim\": \"app.ui's .chip is a nowrap inline-flex row, so multiline chip content needs a block child with flex-basis:100% plus flex-wrap on the chip\", \"detail\": \"A <br> cannot break a flex container, and flex trims a text item's edge whitespace - which is why an error message and its Retry action ran together inside an update chip. The Phase 3b fix (commit b70a4fe9): put the error text in a block .chiperrline (flex-basis:100%), give the chip flex-wrap and auto height, and use margins (not whitespace) for gaps between inline items. Applies to any multiline content inside the shared chip style.\", \"tags\": \"app.ui,peer.peer,css,chip,flex,frontend,unreviewed\", \"confidence\": \"high\", \"time\": 1793516462188},\n{\"claim\": \"data/peer carries stale non-live copies of the peers command source that still contain already-fixed bugs\", \"detail\": \"Records like irxu…cp4.rs, '…cp4 copy.rs', and x.rs sit beside the live impl (ywokvt…2l8) and still hold the publickkey typo after the F18b fix - a grep of data/peer for an old bug string hits this debris and can look like the fix never landed. They were deliberately left untouched during Phase 4.\", \"tags\": \"peer.peer,store,grep,gotcha,unreviewed\", \"confidence\": \"high\", \"time\": 1793518287722},\n{\"claim\": \"An instance's own UDP-5770 broadcast can land in its own discovery cache: the server-side own-UUID skip in peer/service/discovery.rs runs only when my_uuid is non-empty.\", \"detail\": \"Found on master during LOW F17 (2026-11-01): nb-peers-b's own broadcast appeared in its own LAN discovery list. The F17 fix filters self client-side in peer.peer's js, but the server-side gap remains and is a follow-up candidate for the hand-back to Marc.\", \"tags\": \"peer.peer,peer.service,discovery,lan,unreviewed\", \"confidence\": \"high\", \"time\": 1793525482954},\n{\"claim\": \"A programmatic element.click() opens a non-modal popup menu at the viewport's top-left corner: initPopups positions the me.popup card from the click event's clientX/clientY, and synthetic clicks carry (0,0).\", \"detail\": \"Diagnostic signature for 'menu opens in the corner' reports - it is the caller's coordinates, not a layout bug. QA automation must dispatch a MouseEvent with real clientX/clientY to exercise menu positioning; with real coordinates the menu opens beside the trigger and clamps on-screen. Also beware an armed once-close document handler from a prior open consuming the next synthetic click, yielding a 0x0 menu in screenshots.\", \"tags\": \"peer.peer,popup,initPopups,qa,automation,unreviewed\", \"confidence\": \"high\", \"time\": 1793529078342},\n{\"claim\": \"UNFIXED (found 2026-11, handed to Marc): the non-modal popup's off-screen clamp ignores the popup card's 20px margin, so even a real click near the right viewport edge leaves the menu overhanging by ~10px (rect right 1450 at viewport width 1440).\", \"detail\": \"Same me.popup non-modal path as the clientX/clientY positioning. Found verifying peers-app-fixes LOW Phase 1b item 4; the corner-opening complaint itself was synthetic-click (0,0) coordinates, but this margin-blind clamp is a real residual bug in the shared popup machinery.\", \"tags\": \"peer.peer,popup,clamp,bug,unreviewed\", \"confidence\": \"high\", \"time\": 1793529085886},\n{\"claim\": \"peer.peer renders through two paths: the 3D scene and a plain peer list (F18a). List mode is chosen by ?view=list, a failed WebGL probe, scenehost reporting headless, or a 5 s ready timeout, and it never mounts the scene or the feed.\", \"detail\": \"Commits 72965cd9 + 0a5fa7cb (peers-app-fixes). Rows are built from document.body.peerstatus (coloured dots, kind, last check) with textContent, inherit the app font via .peerlistwrap, refresh on the same 10 s re-read, and a row click opens the same peer.headsup panel an orb tap does. A dim note explains the fallback. Any future change to peer rendering, status wording, or the panel-open path must cover BOTH paths. QA: /peer/?view=list forces the list; in Noobscape, webgl.disabled must be removed from prefs.js with the browser closed to restore WebGL (removing user.js alone isn't enough). The headless and 5 s-timeout branches are code-reviewed only, because the WebGL probe fails first when WebGL is off.\", \"tags\": \"peer.peer,peer.headsup,f18a,webgl,fallback,list\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"d182dd1ea232bfa4\"}, \"confidence\": \"high\", \"time\": 1793532065963},\n{\"claim\": \"The Add Connection LAN tab curates discovery client-side: this instance's own UUID is dropped, loopback entries (127.0.0.1 / ::1 / localhost) carry a dim 'this machine' chip and sort after real LAN devices, and names/UUIDs ellipsize inside the card with title tooltips (F17).\", \"detail\": \"Commits 33ad124a + 6af60d76 (peers-app-fixes). Both the Add Connection and Update Peers cards anchor their close ✕ in the card header row, with the title on one line and the tabs below. The 'this machine' chip survives arbitrarily long names because the name ellipsizes in its own flex:1/min-width:0 span while the chip is flex:none — keep that split when touching the row layout. The self-entry exists because an instance's own UDP-5770 broadcast lands in its own discovery cache (the server-side own-UUID skip in peer/service/discovery.rs runs only when my_uuid is non-empty); the client filter is the only guard until that is fixed server-side.\", \"tags\": \"peer.peer,f17,lan,discovery,layout\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"d182dd1ea232bfa4\"}, \"confidence\": \"high\", \"time\": 1793532070319},\n{\"end\": true}]\n","old":"[\n{\"claim\": \"COMMAND IDS ARE THE PEER-TO-PEER WIRE CONTRACT. The jsapi send_* wrappers resolve a command name to the CALLING instance's command id and ship the id to the remote (app.app.exec takes lib + id; the remote does Command::new(db, id) and panics 'Missing file data/...' when the id is absent). Signature compatibility is irrelevant if ids differ. Consequences: (1) NEVER delete_command + re-upsert a command that remote peers call - upsert_command alone already preserves BOTH the command record id and the rust source id for an existing name, so plain upsert is always the id-safe edit; delete-first is only for genuinely retiring a command; (2) dev.code.patch_command_body with an empty old_snippet is BROKEN - it ballooned a 1.8KB source record to 3.7MB of nested content (fold2, 2026-08-11) - use upsert_command for full-body rewrites; (3) save_command requires a live HTTP session (its app_read fails with Key 'data' not found over MCP). This id contract is what broke the owner's first v52 rollout against v51 peers, and retroactively explains the original v44-lineage 'incompatibility' too.\", \"tags\": \"platform-api,p2p,exec,ids,wire,upsert,patch_command_body,bug\", \"source\": {\"doc\": \"live v51 peer panic log from the owner + app.app.exec source + fold2/fold3 verification, 2026-08-11\"}, \"confidence\": \"high\", \"time\": 1786447774149},\n{\"claim\": \"The peer proxy cannot stream InputStream command results: peer.local (newbound_core) creates a peer stream (begin_stream/write_stream pump) ONLY for `file` responses - a bytes `body` (an InputStream return like camera live) is a process-local DataBytes ref that cannot cross the wire, so the viewer-side peer.remote finds neither stream_id nor usable body and returns its 404 sentinel. Symptom: remote live view falls back to JPEG polling instantly (File-returning commands - snapshot, last_keyframe, play - stream fine over peers, which is why everything else works in the HUD). Fix sketch (platform, owner blessing required per the boundary doctrine): a third branch in peer.local mirroring the file branch - when body is bytes, begin_stream and pump DataBytes.read into write_stream until close, carrying the mime type; peer.remote already join_streams. Found 2026-08-12 diagnosing the owner HUD report.\", \"tags\": \"peer,streaming,inputstream,proxy,live,platform-gap\", \"source\": {\"doc\": \"newbound_core/src/peer/peer/local.rs + remote.rs read, owner HUD report, 2026-08-12\"}, \"confidence\": \"high\", \"time\": 1786542476727},\n{\"claim\": \"InputStream-over-peers landed on newbound branch claude/peer-stream-bytes-bodies (2026-08-12, standalone off master, awaiting owner review): peer.peer.local gained a bytes-body branch (begin_stream + DataBytes pump, 16KB chunks, mime carried, 30s starvation cap) and peer.service.listen gained the s_4 close-back - s_2 detects a dead local reader (write false / entry gone) and answers s_4, whose handler retires the matching STREAMWRITERS entry so the senders write_stream fails and its pump stops ~1s after viewer disconnect. Wire-compatible with old peers in both directions. Two-instance lab verification: same-host peering works via discovery master/slave + setuser with keepalive (maintenance auto-connects; peer users must be in a group check_security accepts - production uses admin; a non-admin group 404s every proxied command instantly, which is also the diagnostic signature of an unauthorized peer). Remote status/file/live all green; live delivers ffprobe-clean fMP4 into an in-page Chromium fetch with correct avc1 codec parse. CRITICAL build gotcha: dev.code patches on a STATIC library regenerate src and build the rlib but do NOT relink the host binary - test runs silently exercise the old code until a cargo build relinks (~2s); check strings <binary> for a new literal before trusting a static-lib test.\", \"tags\": \"peer,streaming,s4,close-back,inputstream,lab,static-lib-relink\", \"source\": {\"doc\": \"two-disposable peer lab, newbound claude/peer-stream-bytes-bodies, 2026-08-12\"}, \"confidence\": \"medium\", \"time\": 1786546269385, \"adjudicated\": 1793394746425},\n{\"claim\": \"The popup machinery centers a dialog card at its open-time height and never re-centers, so content that fills in after open (e.g. the LAN discovery list) grows the card past the bottom of the viewport.\", \"detail\": \"Found fixing F2 (Add Connection clipping): dropping the fixed card height alone is not enough - the tab body needs its own scroll cap (calc(50vh + 40px) used) so late-arriving rows scroll instead of growing the card, and an empty tab needs a min-height close to the populated tab so the open-time measurement that drives centering is honest.\", \"tags\": \"peer.peer,frontend,popup,css,dialogs,unreviewed\", \"confidence\": \"high\", \"time\": 1793392959847},\n{\"claim\": \"syncPeers guards app.scenehost's async addControl with me.adding, so each peer gets exactly one orb\", \"detail\": \"scenehost.addControl registers the key in byId/children only after its awaits, and syncPeers fires from both the waitReady and send_info callbacks, so unguarded overlap added every peer twice - and the duplicate stayed a frozen ghost because syncPeerData updates only the byId instance. Fix (F4, commit ad6575f9) lives entirely in peer.peer js: me.adding[id] marks the in-flight add; syncPeers skips a peer when byId(id) or me.adding[id] is set; the remove loop never removes a key still in me.adding; addPeerOrb's settle handler (resolve or reject) clears the flag and immediately removes the orb if its peer left while the add was in flight. app.scenehost is shared - fix callers, never the host.\", \"tags\": \"peer.peer,scenehost,orbs,race,F4\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417921382},\n{\"claim\": \"peerErrorText(result) is the single wording for a failed peer call: 'Unauthorized' for an UNAUTHORIZED msg (prefix match), else 'Error: <msg>'\", \"detail\": \"F5 (commit 2f7e40a2). Every Update Peers row must end in one of three states - chips, removed (nothing to update), or an error - never 'pending...'. rowError paints the status cell with .rowerror (dim red) and disables the row's checkbox. The peer proxy suffixes the refused command ('UNAUTHORIZED: libs'), hence the prefix match. checkForUpdates fetches ../app/libs first when document.body.locallibraries hasn't landed; a refused dev/crate_versions just leaves the crates chip out. 'Unauthorized' is Alex's exact chosen word; the F10 update-flow rewrite (session 2) must keep calling peerErrorText.\", \"tags\": \"peer.peer,update-peers,errors,F5\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417925088},\n{\"claim\": \"Untrusted strings on the Peers page go into the DOM with textContent and dataset, never innerHTML\", \"detail\": \"F3 (commit a3aa0206). Discovery names ride unauthenticated LAN UDP packets (port 5770), and peer display names, library ids/versions and error msgs come from remote peers. The LAN table rows, buildUpdateDialog's rows, the update/crates chips, and the #updateallpeersnow error lines are built with DOM calls + textContent; data-* carriers use dataset, never concatenated HTML. Static shells may stay literal innerHTML. Server side is still open: discovery.rs stores packet bytes 40+ as the name with no authentication - follow-up for Marc.\", \"tags\": \"peer.peer,xss,security,F3\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"high\", \"time\": 1793417928260},\n{\"claim\": \"The Add Connection card (.addusercard) sizes to content and the TAB BODY scrolls - the card itself must not, because the popup machinery centers the card at its open-time height\", \"detail\": \"F2 (commit 2ec3bf86). The fixed 367px height is gone: .addusercard caps at calc(100vh - 80px), width 600px (calc(100vw - 32px) under 640px). .addusercard .tab-content gets overflow:auto with max-height calc(50vh + 40px): the cap stays near half the viewport so a LAN list that grows AFTER the open can never push the card's bottom off screen. .discovered keeps min-height:280px so the empty LAN tab measures near the Connect tab's height at open-time centering. .card is overflow:hidden by the shared kit - don't fight it, scroll the tab body.\", \"tags\": \"peer.peer,css,layout,add-connection,F2\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"css\", \"hash\": \"d45055d480860ed7\"}, \"confidence\": \"high\", \"time\": 1793417934613},\n{\"claim\": \"buildUpdateDialog reads peer names from me.peers (the same objects as #peer_<id>.DATA), not from a json reply - stub a name in tests by mutating that live record\", \"detail\": \"Session-1 QA (H05): wrapping the page's json() helper cannot stub display names in the Update Peers dialog because no json call carries them; mutate document.getElementById('peer_'+id).DATA.name (shared with me.peers) instead. Also relevant for QA: agent.browser.act refuses to click <tr> rows (reports them disabled) - use the plain click tool for table rows.\", \"tags\": \"peer.peer,testing,qa,stubs\", \"source\": {\"lib\": \"peer\", \"ctl\": \"peer\", \"facet\": \"js\", \"hash\": \"9068e44b817d47be\"}, \"confidence\": \"medium\", \"time\": 1793417937428},\n{\"claim\": \"Peer discovery still stores unauthenticated UDP-5770 packet bytes as device names server-side (discovery.rs); only the client rendering was hardened.\", \"detail\": \"The F3 fix (peers-app-fixes, 2026-10) made the Peers UI render LAN-discovered names with textContent so injected strings are inert, but the server's discovery path accepts and records whatever bytes arrive on the UDP broadcast port with no validation or authentication. Any host on the LAN can plant arbitrary device-name strings in the discovery cache. Validating/authenticating discovery payloads is open, deferred to Marc at the session-1 hand-back.\", \"tags\": \"peer.peer,peer.service,discovery,security,udp,unreviewed\", \"confidence\": \"high\", \"time\": 1793418142452},\n{\"claim\": \"Automation opens a peer's HUD by calling the scene host's hostData.onFocus(<peer-uuid>) directly - the exact handler an orb tap fires - instead of attempting a WebGL canvas click.\", \"detail\": \"Used in peers-app-fixes Phase 0: orb hit-testing inside the WebGL canvas is impractical to drive from scripts, but app.scenehost exposes the focus handler on hostData, and invoking it with the target UUID exercises the same code path as a real tap, opening peer.headsup with the correct record.\", \"tags\": \"peer.peer,peer.headsup,app.scenehost,qa,webgl,unreviewed\", \"confidence\": \"high\", \"time\": 1793479277272},\n{\"claim\": \"A peer's last_contact cannot show real TCP recency: the server stamps last_contact = now for any live TCP link, and drops the field entirely for a disconnected peer.\", \"detail\": \"Confirmed during F6/F15 (peers-app-fixes MEDIUM phase 1): a connected TCP peer always renders full brightness and 3 freshness dots because every read sees last_contact = now, and a down peer shows 'last check unknown' b