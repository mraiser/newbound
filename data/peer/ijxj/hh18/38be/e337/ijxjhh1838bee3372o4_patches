g\",\"kind\":\"text\",\"pos\":{\"x\":0,\"y\":1.2,\"z\":0},\"text\":\"peer\"}],\"state\":[{\"name\":\"displayname\",\"type\":\"string\",\"value\":\"peer\"},{\"name\":\"connected\",\"type\":\"boolean\",\"value\":false}],\"v\":1,\"wires\":[{\"do\":[{\"emit\":\"open\"}],\"on\":\"orb.tap\"}]}","patch_id":"p2","time":1785719807851},{"author":"agent","facet":"scene","label":"peer_model as a component: shape (orb + label) as data, per-instance behaviors (animate/render/click) as code","new":"{\"env\":{\"grid\":false,\"lights\":\"default\"},\"nodes\":[{\"affordances\":{\"tap\":true},\"id\":\"orb\",\"kind\":\"sphere\",\"material\":{\"token\":\"accent\"},\"radius\":0.5},{\"id\":\"tag\",\"kind\":\"text\",\"pos\":{\"x\":0,\"y\":0.9,\"z\":0},\"text\":\"peer\"}],\"v\":1}","old":"{\"bindings\":[{\"expr\":\"connected ? 'good' : 'accent'\",\"target\":\"orb.material.token\"},{\"expr\":\"t * 0.4\",\"target\":\"orb.rot.y\"},{\"expr\":\"displayname\",\"target\":\"tag.text\"},{\"expr\":\"tint\",\"target\":\"orb.material.color\"}],\"nodes\":[{\"affordances\":{\"hover\":true,\"tap\":true},\"id\":\"orb\",\"kind\":\"ico\",\"material\":{\"token\":\"accent\"},\"radius\":0.5},{\"id\":\"tag\",\"kind\":\"text\",\"pos\":{\"x\":0,\"y\":1.2,\"z\":0},\"text\":\"peer\"}],\"state\":[{\"name\":\"displayname\",\"type\":\"string\",\"value\":\"peer\"},{\"name\":\"connected\",\"type\":\"boolean\",\"value\":false},{\"name\":\"tint\",\"type\":\"string\",\"value\":\"#6b7280\"}],\"v\":1,\"wires\":[{\"do\":[{\"emit\":\"open\"}],\"on\":\"orb.tap\"}]}","patch_id":"p3","time":1792364917355},{"author":"agent","facet":"js","label":"peer_model on scenehost: a control IS a 3D object — shape as data, per-instance animate/render/click as code","new":"var me = this;\nvar ME = document.getElementById(me.UUID);\n\n// A peer_model IS a 3D object (the scenegraph model, on scenehost). Its shape\n// is the scene facet (sphere orb + text label — data). Its behaviors are HERE,\n// per-instance, on this control's own js facet — the host (scenehost) calls\n// them as this control's own `me`, with full closure over this facet (no cage).\n//   me.rig    — this instance's transform {pos, rot, scale}; the host syncs it\n//   me.scene  — the scenehost api; me.scene.children = my sibling orbs\n//   me.data   — the peer record the front-end passed to addControl\n// The constellation's physics is the OLD peer.render: each orb computes the\n// force ON ITSELF from its siblings and applies it to its own rig.\n\n// Orb colour: hue by transport, saturation fading as the last contact recedes —\n// the headsup panel's convention, computed per-orb here.\nfunction hslHex(h, s, l){\n  var c = (1 - Math.abs(2*l - 1)) * s, hp = h / 60;\n  var x = c * (1 - Math.abs(hp % 2 - 1)), m = l - c/2;\n  var r = 0, g = 0, b = 0;\n  if (hp < 1) { r = c; g = x; } else if (hp < 2) { r = x; g = c; }\n  else if (hp < 3) { g = c; b = x; } else if (hp < 4) { g = x; b = c; }\n  else if (hp < 5) { r = x; b = c; } else { r = c; b = x; }\n  function hx(v){ var n = Math.round((v + m) * 255);\n    return (n < 16 ? '0' : '') + Math.max(0, Math.min(255, n)).toString(16); }\n  return '#' + hx(r) + hx(g) + hx(b);\n}\nfunction freshness(ageMs){\n  if (!isFinite(ageMs) || ageMs < 0) return 0;\n  if (ageMs <= 30000) return 1;\n  if (ageMs >= 900000) return 0;\n  return 1 - (ageMs - 30000) / (900000 - 30000);\n}\nfunction tint(){\n  var p = me.data, now = Date.now();\n  var h = 210, s0 = 0;                                   // grey: disconnected\n  if (p.tcp) { h = 132; s0 = 0.46; }                     // green\n  else if (p.udp) { h = 212; s0 = 0.48; }                // blue\n  else if (p.relay || p.connected) { h = 48; s0 = 0.60; } // yellow\n  var age = p.last_contact ? Math.max(0, now - p.last_contact) : Infinity;\n  var f = freshness(age);\n  return hslHex(h, s0 * (0.16 + 0.84 * f), 0.54 - (1 - f) * 0.12);\n}\n\n// ── animate: once, at setup. Seed the rig (deterministic ring by id so a fresh\n// constellation doesn't stack) and stamp the label. me.lines = connection\n// link-spec ids this orb owns.\nme.animate = function (ctx) {\n  var id = (me.data && me.data.id) || ctx.key;\n  me.peerId = id;\n  me.vx = 0; me.vy = 0; me.vz = 0;\n  me.lines = {};\n  // deterministic ring seed from the id's first bytes\n  var h = 0; for (var i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0;\n  var a = (h % 360) * Math.PI / 180;\n  ctx.rig.pos.x = Math.cos(a) * 2.6;\n  ctx.rig.pos.z = Math.sin(a) * 2.6;\n  ctx.rig.pos.y = 0.5;\n  ctx.setRig(\"tag\", \"text\", me.data.displayname || me.data.name || id);\n  ctx.setRig(\"orb\", \"material\", { color: tint() });\n};\n\n// ── render: every frame. The force ON ME from my siblings, applied to my rig —\n// plus connection springs for my links, and my tint/label upkeep.\nme.render = function (ctx, dt) {\n  if (!dt || dt <= 0) dt = 0.016;\n  var fx = 0, fy = 0, fz = 0;\n  var siblings = ctx.host.children;\n  var count = 0;\n  for (var k = 0; k < siblings.length; k++) {\n    var s = siblings[k];\n    if (s === ctx.me || !s.rig) continue;\n    var dx = ctx.rig.pos.x - s.rig.pos.x, dy = ctx.rig.pos.y - s.rig.pos.y, dz = ctx.rig.pos.z - s.rig.pos.z;\n    var d2 = Math.max(0.04, dx*dx + dy*dy + dz*dz), d = Math.sqrt(d2);\n    var f = 2.0 / d2;                                   // 1/d² repulsion\n    fx += (dx/d)*f; fy += (dy/d)*f; fz += (dz/d)*f; count++;\n    // a connection to this sibling? a weak spring toward it, and own the link\n    var rid = s.me && s.me.peerId;\n    if (rid && me.data.peers && me.data.peers[rid]) {\n      var op = me.data.peers[rid];\n      var sf = 0.05 * d;                                 // spring pull\n      fx -= (dx/d)*sf; fy -= (dy/d)*sf; fz -= (dz/d)*sf;\n      me._wantLink(ctx, s, op);\n    }\n  }\n  // weak pull to centre (the constellation's gravity)\n  fx -= ctx.rig.pos.x * 0.4; fy -= (ctx.rig.pos.y - 0.5) * 0.8; fz -= ctx.rig.pos.z * 0.4;\n  me.vx = (me.vx + fx * dt) * 0.86;\n  me.vy = (me.vy + fy * dt) * 0.86;\n  me.vz = (me.vz + fz * dt) * 0.86;\n  ctx.rig.pos.x += me.vx * dt;\n  ctx.rig.pos.y += me.vy * dt;\n  ctx.rig.pos.z += me.vz * dt;\n\n  // tint by transport + staleness; spin the orb lazily\n  if ((me._tintTick = (me._tintTick || 0) + dt) > 0.5) {\n    me._tintTick = 0;\n    ctx.setRig(\"orb\", \"material\", { color: tint() });\n    var name = me.data.displayname || me.data.name || me.peerId;\n    if (me._shownName !== name) { me._shownName = name; ctx.setRig(\"tag\", \"text\", name); }\n  }\n  ctx.rig.rot.y += dt * 0.4;\n};\n\n// own a connection link to a sibling (idempotent; the host owns link specs)\nme._wantLink = function (ctx, sibling, transport) {\n  var rid = sibling.me.peerId;\n  if (me.lines[rid]) return;\n  me.lines[rid] = true;\n  var key = me.peerId < rid ? me.peerId + \"|\" + rid : rid + \"|\" + me.peerId;\n  var tone = transport && transport.startsWith(\"tcp#\") ? \"good\"\n    : transport && transport.startsWith(\"udp#\") ? \"human\" : \"wire\";\n  ctx.host.addLink(key, ctx.key, sibling.key, tone);\n};\n\n// ── click: bring up MY heads-up panel (the front-end's channel, or default).\nme.click = function (ctx) {\n  var cb = ctx.host.hostData && ctx.host.hostData.onFocus;\n  if (typeof cb === \"function\") cb(me.peerId, me.data, ctx);\n};\n\nme.ready = function () {};\n","old":"var me = this;\nvar ME = $('#'+me.UUID)[0];\n\nme.click = function(e) {\n  var el = $('#headsupdisplay');\n  el.width(0).css('display', 'block').animate({width:680}, 300);\n  installControl(el[0], 'peer', 'headsup', function(api){\n    me.viewer.wrangler.focus(me);\n  }, ME.DATA);\n};\n\nme.animate = function(model) {\n  var group = me.model;\n  group.add(sphereMesh());\n  group.add(textMesh(ME.DATA.displayname));\n  me.lines = {};\n  me.div = ME;\n};\n\nvar v = new THREE.Vector3();\nvar dv = new THREE.Vector3();\nvar count = 0;\n\nfunction sphereMesh(){\n  var geometry = new THREE.IcosahedronGeometry( 1, 1 );\n  var d = {\n    color: 0x00ff00,\n    metalness: 0.5,\n    flatShading : true \n  };\n  var material = new THREE.MeshStandardMaterial( d );\n  var sphere = me.sphere = new THREE.Mesh( geometry, material );\n  return sphere;\n}\n\nfunction textMesh(name){\n  var d = {\n    color: 0xffffff,\n    metalness: 0.5,\n    flatShading : true \n  };\n  geometry = new THREE.TextGeometry( name, {\n    font: document.body.font,\n    size: 80,\n    height: 5,\n    curveSegments: 12,\n    bevelEnabled: false,\n    bevelThickness: 10,\n    bevelSize: 8,\n    bevelSegments: 5\n  } );\n  geometry.center();\n  material = new THREE.MeshStandardMaterial( d );\n  var mesh = me.text = new THREE.Mesh( geometry, material );\n  mesh.scale.x = 0.01;\n  mesh.scale.y = 0.01;\n  mesh.scale.z = 0.01;\n  mesh.position.y = 1.5;\n  mesh.text = name;\n  return mesh;\n}\n\nme.render = function(){\n  var speed = me.sphere.rotation.speed ? me.sphere.rotation.speed : 0.01;\n  me.sphere.rotation.y += speed;\n  var pos1 = me.model.position;\n  count = 0;\n  dv.set(0,0,0);\n  \n  if (ME.DATA.connected){\n    d = pos1.distanceTo(dv);\n    dv.sub(pos1).normalize().multiplyScalar(0.1*d*d);\n    count++;\n  }\n\n  for (var i in me.viewer.children) {\n    var p = me.viewer.children[i].api;\n    if (p.model && p != me) {\n      var pos2 = p.model.position;\n      d = pos2.distanceTo(pos1);\n      v.copy(pos1).sub(pos2).normalize().multiplyScalar(1/(d*d));\n      dv.add(v);\n      count++;\n      \n      var rid = p.div.DATA.id;\n//      console.log(ME.DATA.connections);\n//      console.log(ME.DATA.peers);\n//      console.log(ME.DATA.peersx);\n      if (ME.DATA.peers && ME.DATA.peers[rid]) {\n        var op = ME.DATA.peers[rid];\n        if (!me.lines[rid]) {\n          p.div.DATA.connected = true;\n          var points = [];\n          points.push(new THREE.Vector3(pos1.x,pos1.y,pos1.z));\n          points.push(new THREE.Vector3(pos2.x,pos2.y,pos2.z));\n          var geometry = new THREE.BufferGeometry().setFromPoints( points );\n          var color = op.startsWith('tcp#') ? 0x00ff00 : op.startsWith('udp#') ? 0x0000ff : 0xffff00;\n          var m = {\n            color: color, \n            linewidth: 1\n          };\n          var material = new THREE.LineBasicMaterial(m);\n          var mesh = new THREE.Line(geometry, material);\n          me.viewer.scene.add(mesh);\n          me.lines[rid] = mesh;\n        }\n        \n        var line = me.lines[rid];\n        line.geometry.computeBoundingBox();\n        \n        var p = line.geometry.attributes.position.array;\n        p[0] = pos1.x;\n        p[1] = pos1.y;\n        p[2] = pos1.z;\n        p[3] = pos2.x;\n        p[4] = pos2.y;\n        p[5] = pos2.z;\n        line.geometry.computeBoundingSphere();\n        line.geometry.attributes.position.needsUpdate = true;\n        \n        var tcp = op.startsWith('tcp#');\n        var udp = op.startsWith('udp#');\n        if (tcp || udp){\n          d = pos2.distanceTo(pos1);\n          v.copy(pos2).sub(pos1).normalize().multiplyScalar(0.01*d*d);\n          dv.add(v);\n          count++;\n          line.material.color.r = 0;\n          line.material.color.g = tcp ? 0.5 : 0;\n          line.material.color.b = udp ? 0.5 : 0;\n        }\n        else{\n          line.material.color.r = 0.5;\n          line.material.color.g = 0.5;\n          line.material.color.b = 0;\n        }\n        \n        \n        \n      }\n    }\n  }\n  \n  if (count>0){\n    dv.multiplyScalar(1/count);\n    \n    pos1.x += dv.x;\n    pos1.y += dv.y;\n    pos1.z += dv.z;\n  }\n\n  tex = me.text;\n  if (tex.text != ME.DATA.displayname) {\n\tme.model.remove(tex);\n    me.model.add(textMesh(ME.DATA.displayname));\n  }\n  \n  let delta = Math.max(0, new Date().getTime() - ME.DATA.last_contact - 30000);\n  var c = 1 - Math.min(1, 1/(delta/15000));\n  if (ME.DATA.connected){\n    if (ME.DATA.tcp) me.sphere.material.color.setRGB(c,1,c);\n    else if (ME.DATA.udp) me.sphere.material.color.setRGB(c,c,1);\n    else me.sphere.material.color.setRGB(1,1,c);\n  }\n  else me.sphere.material.color.setRGB(1,1,1);\n\n  var mrot = me.model.rotation;\n  var crot = me.viewer.camera.rotation;\n  mrot.x = crot.x;\n  mrot.y = crot.y;\n  mrot.z = crot.z;\n};","patch_id":"p4","time":1792365001190},{"author":"agent","facet":"js","label":"guard render against a missing data record","new":"me.render = function (ctx, dt) {\n  if (!dt || dt <= 0) dt = 0.016;\n  if (!me.data) me.data = {};\n  var fx = 0, fy = 0, fz = 0;","old":"me.render = function (ctx, dt) {\n  if (!dt || dt <= 0) dt = 0.016;\n  var fx = 0, fy = 0, fz = 0;","patch_id":"p5","time":1792365653413},{"author":"agent","facet":"js","label":"guard animate + tint against missing data","new":"me.animate = function (ctx) {\n  if (!me.data) me.data = {};\n  var id = (me.data && me.data.id) || ctx.key;\n  me.peerId = id;\n  me.vx = 0; me.vy = 0; me.vz = 0;\n  me.lines = {};\n  // deterministic ring seed from the id's first bytes\n  var h = 0; for (var i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0;\n  var a = (h % 360) * Math.PI / 180;\n  ctx.rig.pos.x = Math.cos(a) * 2.6;\n  ctx.rig.pos.z = Math.sin(a) * 2.6;\n  ctx.rig.pos.y = 0.5;\n  ctx.setRig(\"tag\", \"text\", me.data.displayname || me.data.name || id);\n  ctx.setRig(\"orb\", \"material\", { color: tint() });\n};","old":"me.animate = function (ctx) {\n  var id = (me.data && me.data.id) || ctx.key;\n  me.peerId = id;\n  me.vx = 0; me.vy = 0; me.vz = 0;\n  me.lines = {};\n  // deterministic ring seed from the id's first bytes\n  var h = 0; for (var i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) >>> 0;\n  var a = (h % 360) * Math.PI / 180;\n  ctx.rig.pos.x = Math.cos(a) * 2.6;\n  ctx.rig.pos.z = Math.sin(a) * 2.6;\n  ctx.rig.pos.y = 0.5;\n  ctx.setRig(\"tag\", \"text\", me.data.displayname || me.data.name || id);\n  ctx.setRig(\"orb\", \"material\", { color: tint() });\n};","patch_id":"p6","time":1792365673245},{"author":"agent","facet":"js","label":"guard tint against missing data","new":"function tint(){\n  var p = me.data || {}, now = Date.now();","old":"function tint(){\n  var p = me.data, now = Date.now();","patch_id":"p7","time":1792365688486},{"author":"agent","facet":"js","label":"tune the constellation: gentler repulsion, firmer centre pull, Y flattened into a slab","new":"    var dx = ctx.rig.pos.x - s.rig.pos.x, dy = ctx.rig.pos.y - s.rig.pos.y, dz = ctx.rig.pos.z - s.rig.pos.z;\n    var d2 = Math.max(0.04, dx*dx + dy*dy + dz*dz), d = Math.sqrt(d2);\n    var f = 1.2 / d2;                                   // 1/d² repulsion\n    fx += (dx/d)*f; fy += (dy/d)*f; fz += (dz/d)*f; count++;\n    // a connection to this sibling? a weak spring toward it, and own the link\n    var rid = s.me && s.me.peerId;\n    if (rid && me.data.peers && me.data.peers[rid]) {\n      var op = me.data.peers[rid];\n      var sf = 0.05 * d;                                 // spring pull\n      fx -= (dx/d)*sf; fy -= (dy/d)*sf; fz -= (dz/d)*sf;\n      me._wantLink(ctx, s, op);\n    }\n  }\n  // pull to centre (the constellation's gravity); Y pulled harder → a slab\n  fx -= ctx.rig.pos.x * 0.55; fy -= (ctx.rig.pos.y - 0.5) * 1.4; fz -= ctx.rig.pos.z * 0.55;","old":"    var dx = ctx.rig.pos.x - s.rig.pos.x, dy = ctx.rig.pos.y - s.rig.pos.y, dz = ctx.rig.pos.z - s.rig.pos.z;\n    var d2 = Math.max(0.04, dx*dx + dy*dy + dz*dz), d = Math.sqrt(d2);\n    var f = 2.0 / d2;                                   // 1/d² repulsion\n    fx += (dx/d)*f; fy += (dy/d)*f; fz += (dz/d)*f; count++;\n    // a connection to this sibling? a weak spring toward it, and own the link\n    var rid = s.me && s.me.peerId;\n    if (rid && me.data.peers && me.data.peers[rid]) {\n      var op = me.data.peers[rid];\n      var sf = 0.05 * d;                                 // spring pull\n      fx -= (dx/d)*sf; fy -= (dy/d)*sf; fz -= (dz/d)*sf;\n      me._wantLink(ctx, s, op);\n    }\n  }\n  // weak pull to centre (the constellation's gravity)\n  fx -= ctx.rig.pos.x * 0.4; fy -= (ctx.rig.pos.y - 0.5) * 0.8; fz -= ctx.rig.pos.z * 0.4;","patch_id":"p8",