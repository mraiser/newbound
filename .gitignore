# Canon policy: deny by default, allow only what ships.
# A fresh clone must build the platform and boot with the core libraries;
# everything else on a user's machine — local state, generated output,
# overlaid repos — stays untracked by construction.
*

# Root files
!.gitignore
!.gitattributes
!.mcp.json
!CLAUDE.md
!README.md
!license.md
!Cargo.toml
!Cargo.lock
!build.sh
!debug.sh
!downgrade.sh
!hardreset.sh
!newbound.sh
!default.nix
!config.properties_example

# Core store libraries (the data/ tree is the product)
!data/
!data/app/
!data/app/**
!data/dev/
!data/dev/**
!data/peer/
!data/peer/**
!data/security/
!data/security/**

# Core runtime crates
!runtime/
!runtime/app/
!runtime/app/**
!runtime/dev/
!runtime/dev/**
!runtime/peer/
!runtime/peer/**
!runtime/security/
!runtime/security/**

# Build trees
!html/
!html/**
!newbound_core/
!newbound_core/**
!src/
!src/**

# --- Re-exclusions inside allowed trees ---
# Generated typed API, one per crate src/ (builder-written, overlay-aware)
**/src/api.rs
# Per-instance local state inside tracked runtime/dev
runtime/dev/libraries/
runtime/dev/repos.json
runtime/dev/plugins.json

# Stuff that shouldn't be generated
runtime/src
runtime/Cargo.toml

#Per-instance botd.properties files
runtime/app/botd.properties
runtime/dev/botd.properties
runtime/peer/botd.properties
runtime/security/botd.properties
