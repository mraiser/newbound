/Cargo (copy).toml
/cmd/Cargo (copy).toml
/cmd (copy)
/src (copy)
/generated/
version.txt
botd.properties
/html
/cmd
/target
/users
/config.properties
/Cargo.lockx
/venv
/requirements.txt
/repositories
/.claude/

# The store and the runtime tree are local-first state: nothing in them
# ships except the core libraries, so ignore by RULE and re-include the
# tracked ones. A new library (data/foo, runtime/foo) is invisible to
# canon by construction - no per-library list to maintain.
/data/*
!/data/app
!/data/dev
!/data/peer
!/data/security
/runtime/*
!/runtime/app
!/runtime/dev
!/runtime/peer
!/runtime/security
# per-instance local state inside the tracked runtime/dev
/runtime/dev/libraries/
/runtime/dev/repos.json
/runtime/dev/plugins.json

# The agent library set (mraiser/newbound-agent) overlays here via
# symlinks (its tools/overlay.sh). Its crate dirs land at the root.
# (data/agent, data/kb, data/scratch are covered by the /data/* rule.)
/agent
/kb
/scratch

# The generated typed API (one per crate src/): builder-written and
# overlay-aware - it absorbs whatever libraries the local checkout
# carries, so it must never be tracked anywhere.
**/src/api.rs
